lua_type                                                            *lua_type()*
>c
    int lua_type (lua_State *L, int index);
<
        返回给定可接受索引处值的类型；对于无效索引（即指向“空”栈位置的索引），
        返回 `LUA_TNONE`。`lua_type` 返回的类型由 `lua.h` 中定义的以下常量编
        码：`LUA_TNIL`、`LUA_TNUMBER`、`LUA_TBOOLEAN`、`LUA_TSTRING`、
        `LUA_TTABLE`、`LUA_TFUNCTION`、`LUA_TUSERDATA`、`LUA_TTHREAD` 和
        `LUA_TLIGHTUSERDATA`。

lua_typename                                                    *lua_typename()*
>c
    const char *lua_typename  (lua_State *L, int tp);
<
        返回由值 `tp` 编码的类型名，`tp` 必须是 `lua_type` 返回的某个值。

lua_Writer                                                          *lua_Writer*
>c
    typedef int (*lua_Writer) (lua_State *L,
                               const void* p,
                               size_t sz,
                               void* ud);
<
        `lua_dump`（见 |lua_dump()|）使用的 writer 函数。每当产生 chunk 的另
        一块时，`lua_dump` 就调用该 writer，并传入要写入的 buffer（`p`）、其
        大小（`sz`），以及提供给 `lua_dump` 的 `data` 参数。

        writer 返回一个错误码：0 表示没有错误；其它任何值表示出错，并阻止
        `lua_dump` 再次调用该 writer。

lua_xmove                                                          *lua_xmove()*
>c
    void lua_xmove (lua_State *from, lua_State *to, int n);
<
        在 `同一` 全局 state 的不同 thread 之间交换值。

        此函数从栈 `from` 中弹出 `n` 个值，并把它们压入栈 `to`。

lua_yield                                                          *lua_yield()*
>c
    int lua_yield (lua_State *L, int nresults);
<
        让一个协程让出。

        此函数只应作为 C 函数的返回表达式来调用，如下所示：
>c
               return lua_yield (L, nresults);
<
        当 C 函数以这种方式调用 `lua_yield` 时，正在运行的协程会暂停执行，而
        启动该协程的那次 `lua_resume` 调用（见 |lua_resume()|）会返回。参数
        `nresults` 是栈中作为结果传给 `lua_resume` 的值的个数。

                                                           *lua-stackexample*
        作为栈操作的例子，如果栈起初为 `10 20 30 40 50*`（从底到顶；`*` 标
        记栈顶），那么
>
               lua_pushvalue(L, 3)    --> 10 20 30 40 50 30*
               lua_pushvalue(L, -1)   --> 10 20 30 40 50 30 30*
               lua_remove(L, -3)      --> 10 20 30 40 30 30*
               lua_remove(L,  6)      --> 10 20 30 40 30*
               lua_insert(L,  1)      --> 30 10 20 30 40*
               lua_insert(L, -1)      --> 30 10 20 30 40*  (no effect)
               lua_replace(L, 2)      --> 30 40 20 30*
               lua_settop(L, -3)      --> 30 40*
               lua_settop(L,  6)      --> 30 40 nil nil nil nil*
<

==============================================================================
3.8  The Debug Interface                                       *lua-apiDebug*

Lua 没有内置的调试设施。取而代之的是，它通过函数和钩子提供一套特殊接口。
该接口允许构造各种调试器、性能分析器，以及其它需要解释器中“内部信息”的工具。

lua_Debug                                                            *lua_Debug*

>c
    typedef struct lua_Debug {
        int event;
        const char *name;           /* (n) */
        const char *namewhat;       /* (n) */
        const char *what;           /* (S) */
        const char *source;         /* (S) */
        int currentline;            /* (l) */
        int nups;                   /* (u) number of upvalues */
        int linedefined;            /* (S) */
        int lastlinedefined;        /* (S) */
        char short_src[LUA_IDSIZE]; /* (S) */
        /* private part */
        other fields
    } lua_Debug;
<

用于携带关于活动函数的不同信息的结构。`lua_getstack`（见 |lua_getstack()|）
只填充该结构的私有部分，以供后续使用。要用有用信息填充 `lua_Debug` 的其它
字段，请调用 `lua_getinfo`（见 |lua_getinfo()|）。

`lua_Debug` 的各字段含义如下：

- `source`             如果函数定义在字符串中，那么 `source` 就是该字符串。
                     如果函数定义在文件中，那么 `source` 以 `@` 开头，后跟
                     文件名。
- `short_src`          `source` 的“可打印”版本，用于错误消息。
- `linedefined`        函数定义开始处的行号。
- `lastlinedefined`    函数定义结束处的行号。
- `what`               如果函数是 Lua 函数，则为字符串 `"Lua"`；如果是 C
                     函数，则为 `"C"`；如果是 chunk 的主要部分，则为
                     `"main"`；如果是做尾调用的函数，则为 `"tail"`。在后
                     一种情况下，Lua 没有关于该函数的其它信息。
- `currentline`        给定函数当前正在执行的行。当没有行信息可用时，
                     `currentline` 被设为 -1。
- `name`               给定函数的一个合理名称。由于 Lua 中的函数是一等值，它们
                     没有固定名称：有些函数可能是多个全局变量的值，而另一些可
                     能只存在表的某个字段中。`lua_getinfo` 函数会检查该函数是
                     如何被调用的，以找出合适的名称。如果找不到名称，则把
                     `name` 设为 `NULL`。
- `namewhat`           解释 `name` 字段。根据函数被调用的方式，`namewhat` 的值
                     可以是 `"global"`、`"local"`、`"method"`、`"field"`、
                     `"upvalue"` 或 `""`（空字符串）。（当其它选项似乎都不适用
                     时，Lua 使用空字符串。）`nups`  该函数的 upvalue 个数。

lua_gethook                                                      *lua_gethook()*
>c
    lua_Hook lua_gethook (lua_State *L);
<
        返回当前的钩子函数。

lua_gethookcount                                            *lua_gethookcount()*
>c
    int lua_gethookcount (lua_State *L);
<
        返回当前的钩子计数。

lua_gethookmask                                              *lua_gethookmask()*
>c
    int lua_gethookmask (lua_State *L);
<
        返回当前的钩子掩码。

lua_getinfo                                                      *lua_getinfo()*
>c
    int lua_getinfo (lua_State *L, const char *what, lua_Debug *ar);
<
        返回关于特定函数或函数调用的信息。

        要获取关于某次函数调用的信息，参数 `ar` 必须是一个有效的活动记录，它
        由先前对 `lua_getstack`（见 |lua_getstack()|）的调用填充，或作为参数
        传给某个钩子（见 |lua_Hook|）。

        要获取关于某个函数的信息，需要把该函数压入栈，并让 `what` 字符串以
        字符 `>` 开头。（这种情况下，`lua_getinfo` 会弹出栈顶的函数。）例
        如，要了解函数 `f` 定义在哪一行，可以写下面这段代码：
>c
               lua_Debug ar;
               lua_getfield(L, LUA_GLOBALSINDEX, "f");  /* get global 'f' */
               lua_getinfo(L, ">S", &ar);
               printf("%d\n", ar.linedefined);
<
        `what` 字符串中的每个字符选择结构 `ar` 的一些字段去填充，或者把一个值
        压入栈：

        `'n'`  填充字段 `name` 与 `namewhat`
        `'S'`  填充字段 `source`、`short_src`、`linedefined`、
             `lastlinedefined` 与 `what`
        `'l'`  填充字段 `currentline`
        `'u'`  填充字段 `nups`
        `'f'`  把在给定层级上运行的函数压入栈
        `'L'`  把一个表压入栈，该表的索引是此函数上有效行的行号。（`有效
             行` 是指带有相关代码的行，也就是可以设置断点的行。无效行
             包括空行与注释。）

        此函数出错时（例如 `what` 中有无效选项）返回 0。

lua_getlocal                                                    *lua_getlocal()*
>c
    const char *lua_getlocal (lua_State *L, lua_Debug *ar, int n);
<
        获取给定活动记录的某个局部变量的信息。参数 `ar` 必须是由先前对
        `lua_getstack`（见 |lua_getstack()|）的调用填充过的有效活动记录，或
        作为参数传给钩子（见 |lua_Hook|）。索引 `n` 选择要检视哪个局部变
        量（1 是第一个参数或活动局部变量，依此类推，直到最后一个活动局部
        变量）。`lua_getlocal` 把该变量的值压入栈并返回它的名称。

        以 `(`（左圆括号）开头的变量名表示内部变量（循环控制变量、临时变
        量，以及 C 函数的局部变量）。

        当索引大于活动局部变量的个数时，返回 `NULL`（并且不压入任何东西）。

lua_getstack                                                    *lua_getstack()*
>c
    int lua_getstack (lua_State *L, int level, lua_Debug *ar);
<
        获取解释器运行时栈的信息。

        该函数用给定层级上正在执行的函数的 `活动记录` 标识来填充 `lua_Debug`
        （见 |lua_Debug|）结构的一部分。层级 0 是当前正在运行的函数，而层
        级 `n+1` 是调用了层级 `n` 的那个函数。没有错误时，`lua_getstack` 返
        回 1；当传入的层级大于栈深度时，它返回 0。

lua_getupvalue                                                *lua_getupvalue()*
>c
    const char *lua_getupvalue (lua_State *L, int funcindex, int n);
<
        获取闭包的一个 upvalue 的信息。（对 Lua 函数来说，upvalue 就是该函
        数使用的外部局部变量，因而被包含在它的闭包中。）`lua_getupvalue` 取
        出索引 `n` 处的 upvalue，把该 upvalue 的值压入栈，并返回它的名称。
        `funcindex` 指向栈中的该闭包。（upvalue 没有特定的顺序，因为它们在
        整个函数中都是活动的。因此，它们按任意顺序编号。）

        当索引大于 upvalue 的个数时，返回 `NULL`（并且不压入任何东西）。
        对 C 函数，此函数对所有 upvalue 都使用空字符串 `""` 作为名称。

lua_Hook                                                              *lua_Hook*
>c
    typedef void (*lua_Hook) (lua_State *L, lua_Debug *ar);
<
        调试钩子函数的类型。

        每当钩子被调用时，它的 `ar` 参数的 `event` 字段被设为触发该钩子的
        特定事件。Lua 用以下常量标识这些事件：`LUA_HOOKCALL`、
        `LUA_HOOKRET`、`LUA_HOOKTAILRET`、`LUA_HOOKLINE` 与 `LUA_HOOKCOUNT`。
        此外，对于行事件，还会设置 `currentline` 字段。要获取 `ar` 中任何
        其它字段的值，钩子必须调用 `lua_getinfo`（见 |lua_getinfo()|）。对
        于返回事件，`event` 可能是 `LUA_HOOKRET`（正常值），也可能是
        `LUA_HOOKTAILRET`。在后一种情况下，Lua 正在模拟从一个做了尾调用的
        函数返回；此时调用 `lua_getinfo` 没有意义。

        Lua 在运行钩子期间会禁用其它钩子调用。因此，如果一个钩子回调 Lua
        去执行某个函数或 chunk，这次执行不会产生任何钩子调用。


lua_sethook                                                      *lua_sethook()*
>c
    int lua_sethook (lua_State *L, lua_Hook f, int mask, int count);
<
        设置调试钩子函数。

        参数 `f` 是钩子函数。`mask` 指定在哪些事件上调用钩子：它由常量
        `LUA_MASKCALL`、`LUA_MASKRET`、`LUA_MASKLINE` 与 `LUA_MASKCOUNT`
        按位 `or` 组成。`count` 参数只有在 mask 包含 `LUA_MASKCOUNT` 时才有
        意义。对每个事件，钩子的调用方式如下所述：

        - `调用钩子`：在解释器调用一个函数时被调用。钩子在 Lua 进入新函数之
          后、该函数取得其参数之前被调用。
        - `返回钩子`：在解释器从一个函数返回时被调用。钩子在 Lua 离开该函数
          之前被调用。你无法访问该函数将要返回的值。
        - `行钩子`：在解释器即将开始执行新的一行代码时，或者当它在代码中往
          回跳转时（即使跳到同一行）被调用。（此事件只在 Lua 执行 Lua 函
          数期间发生。）
        - `计数钩子`：在解释器每执行 `count` 条指令后被调用。（此事件只在
          Lua 执行 Lua 函数期间发生。）

        把 `mask` 设为零即禁用钩子。

lua_setlocal                                                    *lua_setlocal()*
>c
    const char *lua_setlocal (lua_State *L, lua_Debug *ar, int n);
<
        设置给定活动记录的某个局部变量的值。参数 `ar` 与 `n` 的用法同
        `lua_getlocal`（见 |lua_getlocal()|）。`lua_setlocal` 把栈顶的值赋给
        该变量并返回它的名称。它还会把该值从栈中弹出。

        当索引大于活动局部变量的个数时，返回 `NULL`（并且不弹出任何东西）。

lua_setupvalue                                                *lua_setupvalue()*
>c
    const char *lua_setupvalue (lua_State *L, int funcindex, int n);
<
        设置闭包的某个 upvalue 的值。它把栈顶的值赋给该 upvalue 并返回它的
        名称。它还会把该值从栈中弹出。参数 `funcindex` 与 `n` 的用法同
        `lua_getupvalue`（见 |lua_getupvalue()|）。

        当索引大于 upvalue 的个数时，返回 `NULL`（并且不弹出任何东西）。

                                                           *lua-debugexample*
        作为示例，下面的函数列出栈上给定层级处某个函数的所有局部变量与
        upvalue 的名称：
>c
               int listvars (lua_State *L, int level) {
                 lua_Debug ar;
                 int i;
                 const char *name;
                 if (lua_getstack(L, level, &ar) == 0)
                   return 0;  /* failure: no such level in the stack */
                 i = 1;
                 while ((name = lua_getlocal(L, &ar, i++)) != NULL) {
                   printf("local %d %s\n", i-1, name);
                   lua_pop(L, 1);  /* remove variable value */
                 }
                 lua_getinfo(L, "f", &ar);  /* retrieves function */
                 i = 1;
                 while ((name = lua_getupvalue(L, -1, i++)) != NULL) {
                   printf("upvalue %d %s\n", i-1, name);
                   lua_pop(L, 1);  /* remove upvalue value */
                 }
                 return 1;
               }
<

==============================================================================
4  辅助库                                                          *lua-aux*

辅助库提供了若干便利函数，用于让 C 与 Lua 对接。基础 API 提供了 C 与 Lua
之间所有交互所需的原始函数，而辅助库则为某些常见任务提供了更高层的函数。

辅助库的所有函数都定义在头文件 `lauxlib.h` 中，并带有前缀 `luaL_`。

辅助库中的所有函数都构建在基础 API 之上，因此它们提供的功能用该 API 同样
可以做到。

辅助库中有若干函数用于检查 C 函数的参数。它们的名称总是 `luaL_check*` 或
`luaL_opt*`。所有这些函数在检查不满足时都会抛出错误。由于错误消息是按参数
格式化的（例如 "bad argument #1"），你不应把这些函数用于其它栈值。

==============================================================================
4.1  函数与类型                                   *lua-auxFunctions*

下面按字母顺序列出辅助库的全部函数与类型。

luaL_addchar                                                    *luaL_addchar()*
>c
    void luaL_addchar (luaL_Buffer *B, char c);
<
        把字符 `c` 添加到 buffer `B` 中（见 |luaL_Buffer|）。

luaL_addlstring                                              *luaL_addlstring()*
>c
    void luaL_addlstring (luaL_Buffer *B, const char *s, size_t l);
<
        把 `s` 指向的、长度为 `l` 的字符串添加到 buffer `B` 中（见
        |luaL_Buffer|）。该字符串可以包含嵌入的零字符。

luaL_addsize                                                    *luaL_addsize()*
>c
    void luaL_addsize (luaL_Buffer *B, size_t n);
<
        把先前复制到 buffer 区域（见 |luaL_prepbuffer()|）的、长度为 `n` 的
        字符串添加到 buffer `B`（见 |luaL_Buffer|）中。

luaL_addstring                                                *luaL_addstring()*
>c
    void luaL_addstring (luaL_Buffer *B, const char *s);
<
        把 `s` 指向的、以零结尾的字符串添加到 buffer `B` 中（见
        |luaL_Buffer|）。该字符串不得包含嵌入的零字符。

luaL_addvalue                                                  *luaL_addvalue()*
>c
    void luaL_addvalue (luaL_Buffer *B);
<
        把栈顶的值添加到 buffer `B` 中（见 |luaL_Buffer|）。并弹出该值。

        这是 string buffer 上唯一一个可以（也必须）在栈上额外带一个元素被调
        用的函数，这个元素就是要添加进 buffer 的值。

luaL_argcheck                                                  *luaL_argcheck()*
>c
    void luaL_argcheck (lua_State *L,
                        int cond,
                        int narg,
                        const char *extramsg);
<
        检查 `cond` 是否为真。若不为真，则抛出带有以下消息的错误，其中
        `func` 从调用栈中取得：
>
               bad argument #<narg> to <func> (<extramsg>)
<

luaL_argerror                                                  *luaL_argerror()*
>c
    int luaL_argerror (lua_State *L, int narg, const char *extramsg);
<
        抛出带有以下消息的错误，其中 `func` 从调用栈中取得：
>
               bad argument #<narg> to <func> (<extramsg>)
<
        此函数永不返回，但在 C 函数中的惯用法是写成
        `return luaL_argerror(` `args` `)`。

luaL_Buffer                                                        *luaL_Buffer*
>c
    typedef struct luaL_Buffer luaL_Buffer;
<
        `string buffer` 的类型。

        string buffer 允许 C 代码分片构建 Lua 字符串。它的使用模式如下：

        - 首先声明一个类型为 `luaL_Buffer` 的变量 `b`。
        - 然后用 `luaL_buffinit(L, &b)` 调用初始化它（见 |luaL_buffinit()|）。
        - 接着调用任意 `luaL_add*` 函数，把字符串片段添加到 buffer 中。
        - 最后调用 `luaL_pushresult(&b)`（见 |luaL_pushresult()|）来完成。
          该调用会把最终的字符串留在栈顶。

        在正常运作过程中，一个 string buffer 会占用数量可变的栈槽。因此，在
        使用 buffer 期间，你不能假定自己知道栈顶在哪里。你可以在相邻两次
        buffer 操作调用之间使用栈，只要这种使用是平衡的；也就是说，当你调用
        一次 buffer 操作时，栈所处的层级与紧接上一次 buffer 操作之后相同。
        （此规则唯一的例外是 `luaL_addvalue` |luaL_addvalue()|。）调用
        `luaL_pushresult` 之后，栈回到 buffer 被初始化时的层级，再加上栈顶
        的最终字符串。

luaL_buffinit                                                  *luaL_buffinit()*
>c
    void luaL_buffinit (lua_State *L, luaL_Buffer *B);
<
        初始化 buffer `B`。此函数不分配任何空间；buffer 必须声明为变量
        （见 |luaL_Buffer|）。

luaL_callmeta                                                  *luaL_callmeta()*
>c
    int luaL_callmeta (lua_State *L, int obj, const char *e);
<
        调用一个元方法。

        如果索引 `obj` 处的对象有元表，且该元表有字段 `e`，则此函数调用该字
        段，并把该对象作为唯一的参数传入。这种情况下，此函数返回 1，并把该
        调用返回的值压入栈。如果没有元表或没有元方法，则此函数返回
        0（不向栈压入任何值）。

luaL_checkany                                                  *luaL_checkany()*
>c
    void luaL_checkany (lua_State *L, int narg);
<
        检查函数在位置 `narg` 处是否有任意类型（包括 `nil`）的参数。

luaL_checkint                                                  *luaL_checkint()*
>c
    int luaL_checkint (lua_State *L, int narg);
<
        检查函数参数 `narg` 是否为数字，并把该数字转换为 `int` 返回。

luaL_checkinteger                                          *luaL_checkinteger()*
>c
    lua_Integer luaL_checkinteger (lua_State *L, int narg);
<
        检查函数参数 `narg` 是否为数字，并把该数字转换为 `lua_Integer`
        （见 |lua_Integer|）返回。

luaL_checklong                                                *luaL_checklong()*
>c
    long luaL_checklong (lua_State *L, int narg);
<
        检查函数参数 `narg` 是否为数字，并把该数字转换为 `long` 返回。

luaL_checklstring                                          *luaL_checklstring()*
>c
    const char *luaL_checklstring (lua_State *L, int narg, size_t *l);
<
        检查函数参数 `narg` 是否为字符串并返回该字符串；如果 `l` 不为
        `NULL`，则把该字符串的长度填入 `*l`。

luaL_checknumber                                            *luaL_checknumber()*
>c
    lua_Number luaL_checknumber (lua_State *L, int narg);
<
        检查函数参数 `narg` 是否为数字，并返回该数字（见 |lua_Number|）。

luaL_checkoption                                            *luaL_checkoption()*
>c
    int luaL_checkoption (lua_State *L,
                          int narg,
                          const char *def,
                          const char *const lst[]);
<
        检查函数参数 `narg` 是否为字符串，并在数组 `lst`（必须以 NULL 结尾）
        中搜索该字符串。返回该字符串在数组中被找到的索引。若参数不是字符
        串，或该字符串无法找到，则抛出错误。

        如果 `def` 不为 `NULL`，则在没有参数 `narg`、或该参数为 `nil` 时，
        函数把 `def` 用作默认值。

        这是一个用于把字符串映射到 C 枚举的有用函数。（Lua 库中的通常约定是
        使用字符串而不是数字来选择选项。）

luaL_checkstack                                              *luaL_checkstack()*
>c
    void luaL_checkstack (lua_State *L, int sz, const char *msg);
<
        把栈大小增长到 `top + sz` 个元素，若栈无法增长到该大小则抛出错误。
        `msg` 是要加入错误消息的附加文本。

luaL_checkstring                                            *luaL_checkstring()*
>c
    const char *luaL_checkstring (lua_State *L, int narg);
<
        检查函数参数 `narg` 是否为字符串，并返回该字符串。

luaL_checktype                                                *luaL_checktype()*
>c
    void luaL_checktype (lua_State *L, int narg, int t);
<
        检查函数参数 `narg` 是否为类型 `t`（见 |lua_type()|）。

luaL_checkudata                                              *luaL_checkudata()*
>c
    void *luaL_checkudata (lua_State *L, int narg, const char *tname);
<
        检查函数参数 `narg` 是否为类型 `tname` 的 userdata（见
        |luaL_newmetatable()|）。

luaL_dofile                                                      *luaL_dofile()*
>c
    int luaL_dofile (lua_State *L, const char *filename);
<
        加载并运行给定的文件。它被定义为以下宏：
>c
               (luaL_loadfile(L, filename) || lua_pcall(L, 0, LUA_MULTRET, 0))
<
        若没有错误则返回 0，若有错误则返回 1。

luaL_dostring                                                  *luaL_dostring()*
>c
    int luaL_dostring (lua_State *L, const char *str);
<
        加载并运行给定的字符串。它被定义为以下宏：
>c
               (luaL_loadstring(L, str) || lua_pcall(L, 0, LUA_MULTRET, 0))
<
        若没有错误则返回 0，若有错误则返回 1。

luaL_error                                                        *luaL_error()*
>c
    int luaL_error (lua_State *L, const char *fmt, ...);
<
        抛出错误。错误消息格式由 `fmt` 加上任何额外参数给出，遵循
        `lua_pushfstring`（见 |lua_pushfstring()|）的相同规则。如果该信息
        可用，它还会在消息开头加上错误发生处的文件名与行号。

        此函数永不返回，但在 C 函数中的惯用法是写成
        `return luaL_error(` `args` `)`。

luaL_getmetafield                                          *luaL_getmetafield()*
>c
    int luaL_getmetafield (lua_State *L, int obj, const char *e);
<
        把索引 `obj` 处对象的元表中的字段 `e` 压入栈。如果该对象没有元表，
        或者元表没有该字段，则返回 0 并且不压入任何东西。

luaL_getmetatable                                          *luaL_getmetatable()*
>c
    void luaL_getmetatable (lua_State *L, const char *tname);
<
        把注册表中与名称 `tname` 关联的元表压入栈（见 |luaL_newmetatable()|）。

luaL_gsub                                                          *luaL_gsub()*
>c
    const char *luaL_gsub (lua_State *L,
                           const char *s,
                           const char *p,
                           const char *r);
<
        通过把字符串 `p` 的任何出现替换为字符串 `r`，创建字符串 `s` 的副本。
        把结果字符串压入栈并返回它。

luaL_loadbuffer                                              *luaL_loadbuffer()*
>c
    int luaL_loadbuffer (lua_State *L,
                         const char *buff,
                         size_t sz,
                         const char *name);
<
        把一个 buffer 作为 Lua chunk 加载。此函数用 `lua_load`（见
        |lua_load()|）加载 `buff` 指向的、大小为 `sz` 的 buffer 中的 chunk。

        此函数返回与 `lua_load` 相同的结果。`name` 是 chunk 名称，用于调试
        信息与错误消息。

luaL_loadfile                                                  *luaL_loadfile()*
>c
    int luaL_loadfile (lua_State *L, const char *filename);
<
        把文件作为 Lua chunk 加载。此函数用 `lua_load`（见 |lua_load()|）加
        载名为 `filename` 的文件中的 chunk。如果 `filename` 为 `NULL`，则从
        标准输入加载。若文件第一行以 `#` 开头，则忽略该行。

        此函数返回与 `lua_load` 相同的结果，但若它无法打开/读取该文件，会多
        一个错误码 `LUA_ERRFILE`。

        与 `lua_load` 一样，此函数只加载 chunk；它并不运行它。

luaL_loadstring                                              *luaL_loadstring()*
>c
    int luaL_loadstring (lua_State *L, const char *s);
<
        把字符串作为 Lua chunk 加载。此函数用 `lua_load`（见 |lua_load()|）
        加载以零结尾的字符串 `s` 中的 chunk。

        此函数返回与 `lua_load` 相同的结果。

        也与 `lua_load` 一样，此函数只加载 chunk；它并不运行它。

luaL_newmetatable                                          *luaL_newmetatable()*
>c
    int luaL_newmetatable (lua_State *L, const char *tname);
<
        如果注册表中已经有键 `tname`，则返回 0。否则，创建一个新表用作
        userdata 的元表，以键 `tname` 把它加入注册表，并返回 1。

        两种情况下都会把注册表中与 `tname` 关联的最终值压入栈。

luaL_newstate                                                  *luaL_newstate()*
>c
    lua_State *luaL_newstate (void);
<
        创建一个新的 Lua state。它调用 `lua_newstate`（见 |lua_newstate()|），
        使用基于标准 C `realloc` 函数的分配器，然后设置一个 panic 函数
        （见 |lua_atpanic()|），在发生致命错误时把错误消息打印到标准错误
        输出。

        返回新的 state，若发生内存分配错误则返回 `NULL`。

luaL_openlibs                                                  *luaL_openlibs()*
>c
    void luaL_openlibs (lua_State *L);
<
        把全部标准 Lua 库打开到给定的 state 中。关于如何打开单个库的细节，
        另见 |lua-openlibs|。

luaL_optint                                                      *luaL_optint()*
>c
    int luaL_optint (lua_State *L, int narg, int d);
<
        如果函数参数 `narg` 是数字，则返回转换为 `int` 的该数字。如果该参数
        缺失或是 `nil`，则返回 `d`。否则抛出错误。

luaL_optinteger                                              *luaL_optinteger()*
>c
    lua_Integer luaL_optinteger (lua_State *L,
                                 int narg,
                                 lua_Integer d);
<
        如果函数参数 `narg` 是数字，则返回转换为 `lua_Integer`（见
        |lua_Integer|）的该数字。如果该参数缺失或是 `nil`，则返回 `d`。
        否则抛出错误。

luaL_optlong                                                    *luaL_optlong()*
>c
    long luaL_optlong (lua_State *L, int narg, long d);
<
        如果函数参数 `narg` 是数字，则返回转换为 `long` 的该数字。如果该参
        数缺失或是 `nil`，则返回 `d`。否则抛出错误。

luaL_optlstring                                              *luaL_optlstring()*
>c
    const char *luaL_optlstring (lua_State *L,
                                 int narg,
                                 const char *d,
                                 size_t *l);
<
        如果函数参数 `narg` 是字符串，则返回该字符串。如果该参数缺失或是
        `nil`，则返回 `d`。否则抛出错误。

        如果 `l` 不为 `NULL`，则把结果的长度填入位置 `*l`。

luaL_optnumber                                                *luaL_optnumber()*
>c
    lua_Number luaL_optnumber (lua_State *L, int narg, lua_Number d);
<
        如果函数参数 `narg` 是数字，则返回该数字。如果该参数缺失或是
        `nil`，则返回 `d`。否则抛出错误。

luaL_optstring                                                *luaL_optstring()*
>c
    const char *luaL_optstring (lua_State *L,
                                int narg,
                                const char *d);
<
        如果函数参数 `narg` 是字符串，则返回该字符串。如果该参数缺失或是
        `nil`，则返回 `d`。否则抛出错误。

luaL_prepbuffer                                              *luaL_prepbuffer()*
>c
    char *luaL_prepbuffer (luaL_Buffer *B);
<
        返回一块大小为 `LUAL_BUFFERSIZE` 的空间的地址，你可以把要添加到
        buffer `B`（见 |luaL_Buffer|）的字符串复制到这里。把字符串复制到
        该空间之后，你必须以字符串的大小调用 `luaL_addsize`（见
        |luaL_addsize()|），才能真正把它加入 buffer。

luaL_pushresult                                              *luaL_pushresult()*
>c
    void luaL_pushresult (luaL_Buffer *B);
<
        结束 buffer `B` 的使用，把最终的字符串留在栈顶。

luaL_ref                                                            *luaL_ref()*
>c
    int luaL_ref (lua_State *L, int t);
<
        为栈顶的对象在索引 `t` 处的表中创建并返回一个 `引用`（该对象会被
        弹出）。

        引用是一个唯一的整数键。只要你不手动把整数键加入表 `t`，`luaL_ref`
        就会确保它返回的键唯一。你可以调用 `lua_rawgeti(L, t, r)`（见
        |lua_rawgeti()|）取出引用 `r` 所指的对象。函数 `luaL_unref`（见
        |luaL_unref()|）释放一个引用及其关联的对象。

        如果栈顶的对象是 `nil`，则 `luaL_ref` 返回常量 `LUA_REFNIL`。常量
        `LUA_NOREF` 保证与 `luaL_ref` 返回的任何引用都不同。

luaL_Reg                                                              *luaL_Reg*
>c
    typedef struct luaL_Reg {
        const char *name;
        lua_CFunction func;
    } luaL_Reg;
<
        供 `luaL_register`（见 |luaL_register()|）注册的函数数组的类型。
        `name` 是函数名，`func` 是指向该函数的指针。任何 `luaL_Reg` 数组都
        必须以一个哨兵项结尾，该项中 `name` 与 `func` 都是 `NULL`。

luaL_register                                                  *luaL_register()*
>c
    void luaL_register (lua_State *L,
                        const char *libname,
                        const luaL_Reg *l);
<
        打开一个库。

        当以等于 `NULL` 的 `libname` 调用时，它只是把列表 `l`（见 |luaL_Reg|）
        中的所有函数注册到栈顶的表中。

        当以非空的 `libname` 调用时，`luaL_register` 创建一个新表 `t`，把它
        设为全局变量 `libname` 的值，把它设为 `package.loaded[libname]` 的值，
        并在其上注册列表 `l` 中的所有函数。如果 `package.loaded[libname]` 中
        或变量 `libname` 中已有一个表，则复用该表而不创建新表。

        无论哪种情况，该函数都会把该表留在栈顶。

luaL_typename                                                  *luaL_typename()*
>c
    const char *luaL_typename (lua_State *L, int idx);
<
        返回索引 `idx` 处值的类型名称。

luaL_typerror                                                  *luaL_typerror()*
>c
    int luaL_typerror (lua_State *L, int narg, const char *tname);
<
        生成一个类似以下消息的错误：

          `location`  `: bad argument`  `narg`  `to`  `'func'`  `(`  `tname`
          `expected, got`  `rt`  `)`

        其中 `location` 由 `luaL_where`（见 |luaL_where()|）产生，`func` 是
        当前函数的名称，而 `rt` 是实参的类型名称。

luaL_unref                                                        *luaL_unref()*
>c
    void luaL_unref (lua_State *L, int t, int ref);
<
        从索引 `t` 处的表中释放引用 `ref`（见 |luaL_ref()|）。该项会从表中
        移除，以便所指的对象可以被回收。引用 `ref` 也会被释放以便再次使用。

        如果 `ref` 是 `LUA_NOREF` 或 `LUA_REFNIL`，则 `luaL_unref` 不做任何
        事。

luaL_where                                                        *luaL_where()*
>c
    void luaL_where (lua_State *L, int lvl);
<
        把标识调用栈中层级 `lvl` 处当前控制位置的字符串压入栈。这个字符串
        通常具有以下格式：

            `chunkname:currentline:`

        层级 0 是正在运行的函数，层级 1 是调用正在运行的函数的那个函数，
        依此类推。

        这个函数用于为错误消息构造前缀。

==============================================================================
5  标准库                                                         *lua-lib*

标准库提供了一些直接通过 C API 实现的有用函数。其中有些函数为语言本身提供
基本服务（如 `type` 与 `getmetatable`）；有些提供对“外部”服务的访问（如
I/O）；还有一些本可以用 Lua 自身实现，但它们相当有用，或有苛刻的性能要求，
值得用 C 实现（如 `sort`）。

所有库都通过官方 C API 实现，并以独立的 C 模块提供。目前 Lua 有下列标准库：

- 基本库；
- package 库；
- 字符串操纵；
- 表操纵；
- 数学函数（sin、log 等）；
- 输入与输出；
- 操作系统设施；
- 调试设施。

除基本库与 package 库外，每个库都以全局表的字段或对象方法的形式提供其全部
函数。

                                                               *lua-openlibs*
要访问这些库，C host 程序应调用 `luaL_openlibs` 函数，它会打开所有标准库
（见 |luaL_openlibs()|）。另一种做法是，host 程序逐个打开各个库：调用
`luaopen_base`（基本库）、`luaopen_package`（package 库）、
`luaopen_string`（字符串库）、`luaopen_table`（表库）、`luaopen_math`（数学
库）、`luaopen_io`（I/O 库与操作系统库）以及 `luaopen_debug`（调试库）。
这些函数声明在 `lualib.h` 中，不应被直接调用：你必须像调用其它任何 Lua C
函数那样调用它们，例如通过 `lua_call`（见 |lua_call()|）。

==============================================================================
5.1  基本函数                                               *lua-lib-core*

基本库为 Lua 提供了一些核心函数。如果你的应用程序不包含这个库，就应当仔细
检查是否需要为它的一些设施提供实现。

assert({v} [, {message}])                               *assert()*
    当实参 `v` 的值为假（即 `nil` 或 `false`）时抛出一个错误；否则返回它的
    所有实参。`message` 是一条错误消息；缺省时默认为 "assertion failed!"

collectgarbage({opt} [, {arg}])                         *collectgarbage()*
        这个函数是垃圾回收器的通用接口。它根据第一个实参 {opt} 执行不同的
        操作：

        `"stop"`       停止垃圾回收器。
        `"restart"`    重启垃圾回收器。
        `"collect"`    执行一次完整的垃圾回收循环。
        `"count"`      返回 Lua 正在使用的内存总量（以 K 字节计）。
        `"step"`       执行一个垃圾回收步。步的“大小”由 {arg} 以未指定的
                     方式控制（值越大意味着步数越多）。如果你想控制步的
                     大小，必须通过实验来调整 {arg} 的值。如果这一步完成了
                     一个回收循环，则返回 `true`。
        `"setpause"`   把 {arg} /100 设为回收器 `pause` 的新值（见 |lua-gc|）。
        `"setstepmul"` 把 {arg} /100 设为回收器 `step multiplier` 的新值
                     （见 |lua-gc|）。

dofile({filename})                                      *dofile()*
        打开指定名称的文件，并把它作为 Lua chunk 执行其内容。不带实参调用
        时，`dofile` 执行标准输入（`stdin`）的内容。返回该 chunk 返回的
        所有值。发生错误时，`dofile` 把错误传播给调用者（也就是说，`dofile`
        不在保护模式下运行）。

error({message} [, {level}])                            *error()*
        终止最后被调用的受保护函数，并把 `message` 作为错误消息返回。函数
        {error} 从不返回。

        通常 {error} 会在消息开头添加一些关于错误位置的信息。{level} 实参
        指定如何获得错误位置。层级为 1（默认值）时，错误位置就是调用
        {error} 函数的地方。层级 2 把错误指向调用 {error} 的那个函数被调用
        的地方；依此类推。传入层级 0 可以避免在消息中添加错误位置信息。

_G                                                      *_G*
        一个全局变量（不是函数），它持有全局环境（即 `_G._G = _G`）。Lua
        自身并不使用这个变量；改变它的值不会影响任何环境，反之亦然。
        （要改变环境，请使用 `setfenv`。）

getfenv({f})                                            *getfenv()*
        返回该函数当前使用的环境。{f} 可以是一个 Lua 函数，也可以是一个
        数字，后者指定栈中该层级的函数：层级 1 是调用 `getfenv` 的函数。
        如果给定的函数不是 Lua 函数，或者 {f} 为 0，则 `getfenv` 返回全局
        环境。{f} 的默认值是 1。

getmetatable({object})                                  *getmetatable()*
        如果 {object} 没有 metatable，则返回 `nil`。否则，如果该对象的
        metatable 含有一个 `"__metatable"` 字段，则返回关联的值。否则返回
        给定对象的 metatable。

ipairs({t})                                             *ipairs()*
        返回三个值：一个 |iterator| 函数、表 {t} 以及 0，从而使得如下构造

               `for i,v in ipairs(t) do`  `body`  `end`

        会遍历（`1,t[1]`）、（`2,t[2]`）、…… 这些对，直到表里第一个缺失的
        整数键为止。

load({func} [, {chunkname}])                            *load()*
        用函数 {func} 取得各个片段来加载一个 chunk。每次调用 {func} 都必须
        返回一个字符串，它与此前的结果拼接起来。返回 `nil`（或不返回值）
        表示该 chunk 结束。

        如果没有错误，则把编译后的 chunk 作为函数返回；否则返回 `nil` 加上
        错误消息。所返回函数的环境是全局环境。

        {chunkname} 用作错误消息与调试信息中的 chunk 名称。

loadfile([{filename}])                                  *loadfile()*
        与 `load` 类似（见 |load()|），但它从文件 {filename} 取得 chunk，
        如果没有给出文件名，则从标准输入取得。

loadstring({string} [, {chunkname}])                    *loadstring()*
        与 `load` 类似（见 |load()|），但它从给定的 {string} 取得 chunk。

        要加载并运行给定的字符串，请使用如下惯用法：
>lua
               assert(loadstring(s))()
<

next({table} [, {index}])                               *next()*
        允许程序遍历表的所有字段。它的第一个实参是一个表，第二个实参是
        该表中的一个索引。`next` 返回该表的下一个索引及其关联的值。以 `nil`
        作为第二个实参调用时，`next` 返回一个初始索引及其关联的值。以最后
        一个索引调用时，或者在空表中以 `nil` 调用时，`next` 返回 `nil`。
        如果第二个实参缺省，则把它解释为 `nil`。特别地，你可以用 `next(t)`
        检查一个表是否为空。

        索引被枚举的顺序未作规定，即使对于数值索引也是如此。（要按数值顺序
        遍历一个表，请使用数值 `for` 或 |ipairs()| 函数。）

        如果在遍历过程中给表中不存在的字段赋了任何值，则 `next` 的行为是
        `undefined`。不过你可以修改既有的字段。特别地，你可以清除既有的
        字段。

pairs({t})                                              *pairs()*
        返回三个值：|next()| 函数、表 {t} 以及 `nil`，从而使得如下构造

               `for k,v in pairs(t) do`  `body`  `end`

        会遍历表 {t} 的所有键值对。

pcall({f}, {arg1}, {...})                               *pcall()*
        以 `protected mode`（保护模式）用给定的实参调用函数 {f}。这意味
        着 {f} 内部的任何错误都不会被传播；`pcall` 会捕获该错误并返回一个
        状态码。它的第一个结果是状态码（一个布尔值），如果调用成功且没有
        错误，则为 `true`。这种情况下，`pcall` 还会返回这次调用返回的所有
        结果（在第一个结果之后）。如果有任何错误，`pcall` 返回 `false` 加上
        错误消息。

print({...})                                            *print()*
        接收任意数量的实参，把它们的值打印到 `stdout`，并用 `tostring`
        |tostring()| 函数把它们转换成字符串。`print` 并不用于格式化输出，
        只作为快速显示某个值的手段，通常用于调试。要格式化输出，请使用
        `string.format`（见 |string.format()|）。

rawequal({v1}, {v2})                                    *rawequal()*
        检查 {v1} 是否等于 {v2}，不调用任何元方法。返回一个布尔值。

rawget({table}, {index})                                *rawget()*
        取得 `table[index]` 的真实值，不调用任何元方法。{table} 必须是一个
        表；{index} 可以是任何值。

rawset({table}, {index}, {value})                       *rawset()*
        把 `table[index]` 的真实值设为 {value}，不调用任何元方法。{table}
        必须是一个表，{index} 是任何不同于 `nil` 的值，而 {value} 是任何
        Lua 值。

        这个函数返回 {table}。

select({index}, {...})                                  *select()*
        如果 {index} 是一个数字，则返回第 {index} 个实参之后的所有实参。
        否则 {index} 必须是字符串 `"#"`，此时 `select` 返回它收到的额外
        实参的总数。

setfenv({f}, {table})                                   *setfenv()*
        设置给定函数要使用的环境。{f} 可以是一个 Lua 函数，也可以是一个
        数字，后者指定栈中该层级的函数：层级 1 是调用 `setfenv` 的函数。
        `setfenv` 返回给定的那个函数。

        作为一种特殊情况，当 {f} 为 0 时，`setfenv` 改变正在运行的线程的
        环境。这种情况下，`setfenv` 不返回任何值。

setmetatable({table}, {metatable})                      *setmetatable()*
        设置给定表的 metatable。（在 Lua 中不能改变其它类型的 metatable，
        只能从 C 中改变。）如果 {metatable} 为 `nil`，则移除给定表的
        metatable。如果原来的 metatable 含有 `"__metatable"` 字段，则抛出
        一个错误。

        这个函数返回 {table}。

tonumber({e} [, {base}])                                *tonumber()*
        尝试把其实参转换为一个数字。如果实参已经是一个数字，或者是一个可
        转换为数字的字符串，则 `tonumber` 返回这个数字；否则返回 `nil`。

        可选实参指定解释该数值时所用的进制。进制可以是 2 到 36 之间（含
        端点）的任何整数。在大于 10 的进制中，字母 `A`（大写或小写皆可）
        表示 10，`B` 表示 11，依此类推，直到 `Z'` 表示 35。在 10 进制
        （默认值）下，数字可以有小数部分，还可以有可选的指数部分（见
        |lua-lexical|）。在其它进制下，只接受无符号整数。

tostring({e})                                           *tostring()*
        接收一个任何类型的实参，并把它按合理的格式转换为字符串。要完全
        控制数字的转换方式，请使用 `string.format`（见 |string.format()|）。

                                                        *__tostring*
        如果 {e} 的 metatable 含有 `"__tostring"` 字段，`tostring` 就以
        {e} 为实参调用对应的值，并把该调用的结果作为自己的结果。

type({v})                                               *lua-type()*
        返回其唯一实参的类型，以字符串编码。这个函数可能的结果有 `"nil"`
        （一个字符串，而不是值 `nil`）、`"number"`、`"string"`、`"boolean`、
        `"table"`、`"function"`、`"thread"` 以及 `"userdata"`。

unpack({list} [, {i} [, {j}]])                          *unpack()*
        返回给定表中的各个元素。这个函数等价于
>lua
          return list[i], list[i+1], ..., list[j]
<
        只不过上面那段代码只能针对固定数量的元素写出。默认情况下 {i} 为 1，
        {j} 为列表的长度，该长度由长度运算符定义（见 |lua-length|）。

_VERSION                                                *_VERSION*
        一个全局变量（不是函数），它持有含当前解释器版本的字符串。这个
        字符串当前的内容是 `"Lua 5.1"` 。

xpcall({f}, {err})                                      *xpcall()*
        这个函数与 `pcall` 类似（见 |pcall()|），区别在于你可以设置一个
        新的错误处理器。

        `xpcall` 在保护模式下调用函数 {f}，并用 {err} 作为错误处理器。{f}
        内部的任何错误都不会被传播；`xpcall` 会捕获该错误，以最初的错误
        对象调用 {err} 函数，并返回一个状态码。它的第一个结果是状态码（一个
        布尔值），如果调用成功且没有错误，则为 true。这种情况下，`xpcall`
        还会返回这次调用返回的所有结果（在第一个结果之后）。如果有任何
        错误，`xpcall` 返回 `false` 加上来自 {err} 的结果。

==============================================================================
5.2  协程操纵                                 *lua-lib-coroutine*

与协程相关的操作构成基本库的一个子库，它们位于表 `coroutine` 中。关于
协程的一般性描述，见 |lua-coroutine|。

coroutine.create({f})                                       *coroutine.create()*
        创建一个新协程，其函数体为 {f}。{f} 必须是一个 Lua 函数。返回这个
        新协程，即类型为 `"thread"` 的对象。

coroutine.resume({co} [, {val1}, {...}])                    *coroutine.resume()*
        开始或继续执行协程 {co}。第一次恢复一个协程时，它开始运行自己的
        函数体。值 {val1}、{...} 作为实参传给该函数体。如果该协程已经让出，
        `resume` 会重新启动它；值 {val1}、{...} 作为 `yield` 的结果传入。

        如果协程运行过程中没有任何错误，`resume` 返回 `true` 加上传给
        `yield` 的任何值（如果协程让出），或者加上函数体返回的任何值（如果
        协程终止）。如果有任何错误，`resume` 返回 `false` 加上错误消息。

coroutine.running()                                        *coroutine.running()*
        返回正在运行的协程；如果由主线程调用，则返回 `nil`。

coroutine.status({co})                                     *coroutine.status()*
        以字符串返回协程 {co} 的状态：`"running"`，如果该协程正在运行
        （也就是说它调用了 `status`）；`"suspended"`，如果该协程在调用
        `yield` 时被挂起，或者它尚未开始运行；`"normal"`，如果该协程是活动
        的但并未运行（也就是说它恢复了另一个协程）；以及 `"dead"`，如果该
        协程已经结束其函数体，或者它因错误而停止。

coroutine.wrap({f})                                           *coroutine.wrap()*
        创建一个新协程，其函数体为 {f}。{f} 必须是一个 Lua 函数。返回一个
        函数，每次调用它都会恢复该协程。传给这个函数的任何实参都作为
        `resume` 的额外实参。它返回 `resume` 返回的那些值，只除第一个布尔
        值。发生错误时，它会传播该错误。

coroutine.yield({...})                                       *coroutine.yield()*
        挂起调用它的那个协程的执行。该协程不能正在运行一个 C 函数、一个
        元方法或一个 |iterator|。传给 `yield` 的任何实参都作为额外结果传给
        `resume`。

==============================================================================
5.3  模块                                                     *lua-modules*

package 库为在 Lua 中加载与构建模块提供基本设施。它把其中两个函数直接导出
到全局环境中：`require` 与 `module`（见 |require()| 与 |module()|）。其它
一切都导出在表 `package` 中。

module({name} [, {...}])                                *module()*
        创建一个模块。如果 `package.loaded[name]` 中已有一个表，则该表就是
        这个模块。否则，如果存在一个具有该给定名称的全局表 `t`，则该表
        就是这个模块。再否则，创建一个新表 `t`，并把它设为全局变量 {name}
        的值以及 `package.loaded[name]` 的值。这个函数还会把 `t._NAME`
        初始化为给定的名称，把 `t._M` 初始化为该模块（即 `t` 自身），把
        `t._PACKAGE` 初始化为 package 名（完整模块名去掉最后一个组件；见
        下文）。最后，`module` 把 `t` 设为当前函数的新环境，并把它设为
        `package.loaded[name]` 的新值，从而使 |require()| 返回 `t`。

        如果 {name} 是一个复合名称（即其各组件以点号分隔），`module` 会为
        每个组件创建表（如果它们已经存在则复用）。例如，如果 {name} 是
        `a.b.c`，则 `module` 把模块表存放在全局 `a` 的字段 `b` 的字段 `c`
        中。

        这个函数可以在模块名之后接收可选的 `options`，其中每个选项都是一个
        要施加于该模块的函数。

require({modname})                                      *require()*
        加载给定的模块。这个函数首先查看 `package.loaded` 表，判断
        {modname} 是否已经加载。如果是，则 `require` 返回存放在
        `package.loaded[modname]` 处的值。否则，它尝试为该模块找到一个
        `loader`（加载器）。

        为了找到一个 loader，`require` 首先查询 `package.preload[modname]`。
        如果它有值，这个值（应当是一个函数）就是 loader。否则 `require` 用
        `package.path` 中存放的路径搜索一个 Lua loader。如果这也失败，它就
        用 `package.cpath` 中存放的路径搜索一个 C loader。如果这也失败，
        它就尝试一个 `all-in-one` loader（见下文）。

        加载 C 库时，`require` 首先使用动态链接设施把应用程序与该库链接
        起来。然后它尝试在这个库中找到一个用作 loader 的 C 函数。这个 C
        函数的名字是字符串 `"luaopen_"` 拼接上模块名的一份副本，其中每个
        点号都替换为下划线。此外，如果模块名中含有连字符，则要移除其到
        （并包含）第一个连字符为止的前缀。例如，如果模块名是 `a.v1-b.c`，
        则函数名将是 `luaopen_b_c`。

        如果 `require` 既没有找到该模块的 Lua 库，也没有找到它的 C 库，它就
        调用 `all-in-one loader`。这个 loader 在 C 路径中搜索给定模块根名的
        库。例如，在 require `a.b.c` 时，它会搜索 `a` 的 C 库。如果找到，
        它就在其中查找该子模块的 open 函数；在我们的例子中，那会是
        `luaopen_a_b_c`。借助这个设施，一个 package 可以把若干 C 子模块打包
        进单个库中，而每个子模块都保留其原有的 open 函数。

        一旦找到 loader，`require` 就以单个实参 {modname} 调用该 loader。
        如果 loader 返回任何值，`require` 就把该返回值赋给
        `package.loaded[modname]`。如果 loader 不返回值，也没有给
        `package.loaded[modname]` 赋任何值，则 `require` 把 `true` 赋给这个
        条目。无论哪种情况，`require` 都返回 `package.loaded[modname]` 的
        最终值。

        如果加载或运行该模块时出现任何错误，或者它找不到该模块的任何
        loader，则 `require` 发出一个错误。

package.cpath                                                    *package.cpath*
        `require` 用来搜索 C loader 的路径。

        Lua 初始化 C 路径 `package.cpath` 的方式与它初始化 Lua 路径
        `package.path` 的方式相同：使用环境变量 `LUA_CPATH`（再加上
        `luaconf.h` 中定义的另一个默认路径）。

package.loaded                                                  *package.loaded*
        `require` 用来控制哪些模块已经加载的表。当你 require 一个模块
        `modname` 且 `package.loaded[modname]` 不为 false 时，`require` 直接
        返回存放在那里的值。

package.loadlib({libname}, {funcname})                       *package.loadlib()*
        把 host 程序与 C 库 {libname} 动态链接起来。在这个库内部，查找一个
        函数 {funcname}，并把该函数作为 C 函数返回。（因此 {funcname} 必须
        遵循该协议，见 |lua_CFunction|）。

        这是一个底层函数。它完全绕过 package 与模块系统。与 `require` 不同，
        它不执行任何路径搜索，也不会自动添加扩展名。{libname} 必须是该 C
        库的完整文件名，必要时包含路径与扩展名。{funcname} 必须是该 C 库
        导出的准确名称（这可能取决于所用的 C 编译器与链接器）。

        这个函数不受 ANSI C 支持。因此它只在某些平台上可用（Windows、
        Linux、Mac OS X、Solaris、BSD，以及其它支持 `dlfcn` 标准的 Unix
        系统）。

package.path                                                      *package.path*
        `require` 用来搜索 Lua loader 的路径。

        启动时，Lua 用环境变量 `LUA_PATH` 的值来初始化这个变量；如果该环境
        变量没有定义，则使用 `luaconf.h` 中定义的默认路径。环境变量的值中
        任何 `";;"` 都会被替换成默认路径。

        一条路径是用分号分隔的一串 `templates`。对每个 template，`require`
        会把该 template 中的每个问号替换为 `filename`，后者是把 `modname`
        中的每个点号替换成“目录分隔符”（在 Unix 中如 `"/"`）得到的；然后
        它尝试加载得到的文件名。因此，例如，如果 Lua 路径是
>
               "./?.lua;./?.lc;/usr/local/?/init.lua"
<
        则搜索模块 `foo` 的 Lua loader 会依次尝试加载文件 `./foo.lua`、
        `./foo.lc` 与 `/usr/local/foo/init.lua`。

package.preload                                              *package.preload*
        用来存放特定模块的 loader 的表（见 |require()|）。

package.seeall({module})                                      *package.seeall()*
        为 {module} 设置一个 metatable，其 `__index` 字段指向全局环境，从而
        使这个模块继承全局环境中的值。用作函数 {module} 的一个选项。

==============================================================================
5.4  字符串操纵                                            *lua-lib-string*

这个库为字符串操纵提供通用函数，例如查找与提取子串，以及模式匹配。在 Lua
中对字符串作索引时，第一个字符位于位置 1（而不是像 C 中那样位于 0）。索引
允许为负，此时被解释为从字符串末尾向前的索引。因此最后一个字符位于位置
-1，依此类推。

字符串库把它的全部函数放在表 `string` 中。它还为字符串设置了一个
metatable，其中 `__index` 字段指向 `string` 表。因此你可以用面向对象的
风格使用字符串函数。例如，`string.byte(s, i)` 可以写成 `s:byte(i)`。

string.byte({s} [, {i} [, {j}]])                                 *string.byte()*
        返回字符 `s[i]`、`s[i+1]`、……、`s[j]` 的内部数值编码。{i} 的默认
        值是 1；{j} 的默认值是 {i}。

        注意数值编码不一定可跨平台移植。

string.char({...})                                               *string.char()*
        接收零个或多个整数。返回一个长度等于实参个数的字符串，其中每个字符
        的内部数值编码都等于其对应的实参。

        注意数值编码不一定可跨平台移植。

string.dump({function})                                          *string.dump()*
        返回一个含给定函数二进制表示形式的字符串，以便之后对这个字符串执行
        |loadstring()| 时得到该函数的一份副本。{function} 必须是一个没有
        upvalue 的 Lua 函数。

string.find({s}, {pattern} [, {init} [, {plain}]])               *string.find()*
        在字符串 {s} 中查找 {pattern} 的第一次匹配。如果找到匹配，则
        {find} 返回 {s} 中该出现开始与结束处的索引；否则返回 `nil`。第三个
        可选数值实参 {init} 指定从何处开始搜索；它的默认值为 1，且可以为
        负。第四个可选实参 {plain} 取值为 {true} 时关闭模式匹配设施，于是
        该函数执行的是普通的“查找子串”操作，{pattern} 中没有任何字符被
        视为“魔法字符”。注意，如果给出了 {plain}，那么也必须给出 {init}。

        如果模式含有捕获，则在一次成功的匹配中，两个索引之后还会返回捕获到
        的值。

string.format({formatstring}, {...})                           *string.format()*
        按第一个实参（必须是字符串）中给出的描述，返回其数量可变的实参的
        格式化版本。格式字符串遵循标准 C 函数中 `printf` 家族的相同规则。
        仅有的差别是不支持选项/修饰符 `*`、`l`、`L`、`n`、`p` 与 `h`，
        并且多出一个选项 `q`。`q` 选项把字符串格式化成适合 Lua 解释器安全
        读回的形式：字符串写在双引号之间，其中的所有双引号、换行、内嵌
        零字符与反斜杠在写出时都会被正确转义。例如，调用
>lua
               string.format('%q', 'a string with "quotes" and \n new line')
<
        会产生字符串：
>lua
               "a string with \"quotes\" and \
                new line"
<
        选项 `c`、`d`、`E`、`e`、`f`、`g`、`G`、`i`、`o`、`u`、`X` 与 `x`
        都期望以数字为实参，而 `q` 与 `s` 期望以字符串为实参。

        这个函数不接受含有内嵌零字符的字符串值。

string.gmatch({s}, {pattern})                                  *string.gmatch()*
        返回一个 |iterator| 函数，每次调用它都返回 {pattern} 在字符串 {s}
        上的下一个捕获。

        如果 {pattern} 不指定任何捕获，则每次调用都会产生整个匹配。

        作为示例，下面的循环
>lua
               s = "hello world from Lua"
               for w in string.gmatch(s, "%a+") do
                 print(w)
               end
<
        会遍历字符串 {s} 中的所有单词，每行打印一个。下一个例子把给定字符串
        中的所有 `key=value` 对收集到一个表中：
>lua
               t = {}
               s = "from=world, to=Lua"
               for k, v in string.gmatch(s, "(%w+)=(%w+)") do
                 t[k] = v
               end
<

string.gsub({s}, {pattern}, {repl} [, {n}])                      *string.gsub()*
        返回 {s} 的一份副本，其中 {pattern} 的所有出现都已被 {repl} 指定的
        替换字符串所替换，{repl} 可以是字符串、表或函数。`gsub` 还作为
        第二个值返回所作替换的总次数。

        如果 {repl} 是字符串，则用它的值作替换。字符 `%` 起转义字符的
        作用：{repl} 中任何形如 `%n` 的序列（其中 {n} 在 1 到 9 之间）都
        代表第 {n} 个捕获子串的值（见下文）。序列 `%0` 代表整个匹配。序列
        `%%` 代表单个 `%`。

        如果 {repl} 是表，则对每次匹配都用第一个捕获作为键去查询该表；如果
        模式不指定捕获，则用整个匹配作为键。

        如果 {repl} 是函数，则每次发生匹配时都以所有捕获到的子串按顺序作为
        实参调用这个函数；如果模式不指定捕获，则把整个匹配作为唯一的实参
        传入。

        如果表查询或函数调用返回的值是字符串或数字，则用它作替换字符串；
        否则，如果它是 `false` 或 `nil`，则不作替换（也就是说，原始匹配
        保留在字符串中）。

        可选的最后一个参数 {n} 限制发生的替换最大次数。例如，当 {n} 为 1
        时，只替换 `pattern` 的第一次出现。

        以下是一些示例：
>lua
           x = string.gsub("hello world", "(%w+)", "%1 %1")
           --> x="hello hello world world"

           x = string.gsub("hello world", "%w+", "%0 %0", 1)
           --> x="hello hello world"

           x = string.gsub("hello world from Lua", "(%w+)%s*(%w+)", "%2 %1")
           --> x="world hello Lua from"

           x = string.gsub("home = $HOME, user = $USER", "%$(%w+)", os.getenv)
           --> x="home = /home/roberto, user = roberto"

           x = string.gsub("4+5 = $return 4+5$", "%$(.-)%$", function (s)
                 return loadstring(s)()
               end)
           --> x="4+5 = 9"

           local t = {name="lua", version="5.1"}
           x = string.gsub("$name%-$version.tar.gz", "%$(%w+)", t)
           --> x="lua-5.1.tar.gz"
<

string.len({s})                                                   *string.len()*
        接收一个字符串并返回其长度。空字符串 `""` 的长度为 0。内嵌零字符
        会被计入，因此 `"a\000b\000c"` 的长度为 5。

string.lower({s})                                               *string.lower()*
        接收一个字符串，并返回把其中所有大写字母改为小写后的副本。其它所有
        字符保持不变。什么算作大写字母，其定义取决于当前的 locale。

string.match({s}, {pattern} [, {init}])                         *string.match()*
        在字符串 {s} 中查找 {pattern} 的第一次匹配。如果找到，则 `match`
        返回该模式中的捕获；否则返回 `nil`。如果 {pattern} 不指定捕获，则
        返回整个匹配。第三个可选数值实参 {init} 指定从何处开始搜索；它的
        默认值为 1，且可以为负。

string.rep({s}, {n})                                              *string.rep()*
        返回由字符串 {s} 的 {n} 份副本连接而成的字符串。

string.reverse({s})                                           *string.reverse()*
        返回把字符串 {s} 反转后的字符串。

string.sub({s}, {i} [, {j}])                                      *string.sub()*
        返回 {s} 的子串，它从 {i} 开始，一直延续到 {j}；{i} 与 {j} 可以
        为负。如果 {j} 缺省，则假定它等于 `-1`（这与字符串长度相同）。特别
        地，调用 `string.sub(s,1,j)` 返回 {s} 的一个长度为 {j} 的前缀，而
        `string.sub(s,-i)` 返回 {s} 的一个长度为 {i} 的后缀。

string.upper({s})                                               *string.upper()*
        接收一个字符串，并返回把其中所有小写字母改为大写后的副本。其它所有
        字符保持不变。什么算作小写字母，其定义取决于当前的 locale。

------------------------------------------------------------------------------
5.4.1  模式                                                  *lua-pattern*

字符类用来表示一组字符。在描述字符类时允许使用下列组合：

    - `x`   （其中 `x` 不是魔法字符 `^$()%.[]*+-?` 之一）表示字符 `x`
          本身。
    - `.`   （一个点）表示所有字符。
    - `%a`  表示所有字母。
    - `%c`  表示所有控制字符。
    - `%d`  表示所有数字。
    - `%l`  表示所有小写字母。
    - `%p`  表示所有标点字符。
    - `%s`  表示所有空白字符。
    - `%u`  表示所有大写字母。
    - `%w`  表示所有字母数字字符。
    - `%x`  表示所有十六进制数字。
    - `%z`  表示表示形式为 `0` 的字符。
    - `%x`  （其中 `x` 是任何非字母数字字符）表示字符 `x`。这是转义魔法
          字符的标准做法。任何标点字符（即使是非魔法字符）在模式中用来
          表示自身时，都可以在前面加一个 `%`。

    - `[set]`  表示类，即 `set` 中所有字符的并集。字符范围可以通过用 `-`
         分隔范围的端点字符来指定。上面描述的所有类 `%x` 也可以用作
         `set` 中的组件。`set` 中其它所有字符都表示它们自身。例如，
         `[%w_]`（或 `[_%w]`）表示所有字母数字字符加下划线，`[0-7]` 表示
         八进制数字，而 `[0-7%l%-]` 表示八进制数字加小写字母加 `-` 字符。

         范围与类之间的相互作用未作定义。因此，像 `[%a-z]` 或 `[a-%%]`
         这样的模式没有意义。

    - `[^set]`  表示 `set` 的补集，其中 `set` 按上面的方式解释。

对于所有以单个字母表示的类（`%a`、`%c` 等），对应的大写字母表示该类的
补集。例如，`%S` 表示所有非空白字符。

字母、空白以及其它字符组的定义取决于当前的 locale。特别地，类 `[a-z]` 可能
并不等价于 `%l`。

模式项                                                     *lua-patternitem*

一个模式项可以是

   - 单个字符类，匹配该类中的任意单个字符；
   - 单个字符类后跟 `*`，匹配该类中字符的 0 次或多次重复。这些重复项总是
      匹配可能的最长序列；
   - 单个字符类后跟 `+`，匹配该类中字符的 1 次或多次重复。这些重复项总是
      匹配可能的最长序列；
                                                     *lua-nongreedy*
   - 单个字符类后跟 `-`，同样匹配该类中字符的 0 次或多次重复。与 `*` 不同，
      这些重复项总是匹配可能的最短序列；
   - 单个字符类后跟 `?`，匹配该类中字符的 0 次或 1 次出现；
   - `%n`，其中 `n` 介于 1 与 9 之间；这样的项匹配与第 `n` 个被捕获串相等的
      子串（见下文）；
   - `%bxy`，其中 `x` 与 `y` 是两个不同字符；这样的项匹配以 `x` 开头、
      以 `y` 结尾、且其中 `x` 与 `y` 成对的字符串。这意味着，若从左向右
      读取该字符串，对 `x` 计 `+1`、对 `y` 计 `-1`，则结尾的那个 `y` 就是
      计数首次到达 0 的 `y`。例如，项 `%b()` 匹配圆括号成对的表达式。

模式

模式是若干模式项构成的序列。模式开头的 `^` 将匹配锚定在目标字符串的开头。
模式末尾的 `$` 将匹配锚定在目标字符串的末尾。在其它位置，`^` 与 `$` 没有
特殊含义，只代表它们自身。

捕获                                                             *lua-capture*

模式中可以包含用圆括号括起的子模式；它们描述捕获。当匹配成功时，目标字符串
中与捕获相匹配的子串会被存储（捕获）起来以供后续使用。捕获按其左圆括号的
顺序编号。例如，在模式 `"(a*(.)%w(%s*))"` 中，与 `"a*(.)%w(%s*)"` 匹配的
那部分字符串被存储为第一个捕获（因而其编号为 1）；与 `.` 匹配的字符被捕获
为编号 2，与 `%s*` 匹配的部分编号为 3。

作为一种特殊情况，空捕获 `()` 捕获当前的字符串位置（一个数字）。例如，若对
字符串 `"flaaap"` 应用模式 `"()aa()"`，将得到两个捕获：3 和 5。

模式不能包含内嵌的零字节。请改用 `%z`。

==============================================================================
5.5  Table 操纵                                            *lua-lib-table*

本库提供用于操纵 table 的通用函数。它把所有函数都放在 table `table` 内。

table 库中大多数函数都假定该 table 表示一个数组或一个列表。对于这些函数，
当我们谈到一个 table 的“长度”时，指的是长度运算符的结果。

table.concat({table} [, {sep} [, {i} [, {j}]]])                 *table.concat()*
        给定一个所有元素都是字符串或数字的数组，返回
        `table[i]..sep..table[i+1] ... sep..table[j]`。{sep} 的默认值为空
        字符串，{i} 的默认值为 1，{j} 的默认值为该 table 的长度。若 {i}
        大于 {j}，则返回空字符串。

table.foreach({table}, {f})                                    *table.foreach()*
        对 {table} 的所有元素执行给定的 {f}。对每个元素，{f} 以索引和相应
        的值作为参数被调用。若 {f} 返回非 `nil` 值，则循环中断，该值作为
        `table.foreach` 的最终值返回。

        关于 table 遍历的额外信息，见 |next()|。

table.foreachi({table}, {f})                                  *table.foreachi()*
        对 {table} 的数值索引执行给定的 {f}。对每个索引，{f} 以索引和相应
        的值作为参数被调用。索引按顺序访问，从 1 到 `n`，其中 `n` 是该
        table 的长度。若 {f} 返回非 `nil` 值，则循环中断，该值作为
        `table.foreachi` 的结果返回。

table.insert({table}, [{pos},] {value})                         *table.insert()*
        将元素 {value} 插入 {table} 中的位置 {pos}，必要时上移其它元素
        以腾出空间。{pos} 的默认值为 `n+1`，其中 `n` 是该 table 的长度
        （见 |lua-length|），因此调用 `table.insert(t,x)` 会把 `x` 插入
        table `t` 的末尾。

table.maxn({table})                                               *table.maxn()*
        返回给定 table 的最大正数值索引，若该 table 没有正数值索引则返回
        零。（为完成此工作，该函数会对整个 table 做一次线性遍历。）

table.remove({table} [, {pos}])                                 *table.remove()*
        从 {table} 中移除位置 {pos} 处的元素，必要时下移其它元素以填补
        空位。返回被移除元素的值。{pos} 的默认值为 `n`，其中 `n` 是该
        table 的长度（见 |lua-length|），因此调用 `table.remove(t)` 会
        移除 table `t` 的最后一个元素。

table.sort({table} [, {comp}])                                    *table.sort()*
        按给定顺序对 table 元素就地（`in-place`）排序，从 `table[1]` 到
        `table[n]`，其中 `n` 是该 table 的长度（见 |lua-length|）。若给定
        {comp}，则它必须是一个接收两个 table 元素的函数，并在第一个小于
        第二个时返回真（这样排序后 `not comp(a[i+1],a[i])` 将为真）。若
        未给定 {comp}，则改用标准 Lua 运算符 `<`。

该排序算法不稳定，也就是说，按给定顺序被认为相等的元素，其相对位置
可能被该排序改变。

==============================================================================
5.6  数学函数                                                *lua-lib-math*

本库是标准 C 数学库大部分函数的接口。它把所有函数都放在 table `math` 内。

math.abs({x})                                                       *math.abs()*
        返回 {x} 的绝对值。

math.acos({x})                                                     *math.acos()*
        返回 {x} 的反余弦（单位为弧度）。

math.asin({x})                                                     *math.asin()*
        返回 {x} 的反正弦（单位为弧度）。

math.atan({x})                                                     *math.atan()*
        返回 {x} 的反正切（单位为弧度）。

math.atan2({x}, {y})                                              *math.atan2()*
        返回 `x/y` 的反正切（单位为弧度），但会用两个参数的符号来确定结果的
        象限。（它也能正确处理 {y} 为零的情形。）

math.ceil({x})                                                     *math.ceil()*
        返回大于或等于 {x} 的最小整数。

math.cos({x})                                                       *math.cos()*
        返回 {x} 的余弦（假定以弧度为单位）。

math.cosh({x})                                                     *math.cosh()*
        返回 {x} 的双曲余弦。

math.deg({x})                                                       *math.deg()*
        返回以度为单位的角 {x}（{x} 以弧度给出）。

math.exp({x})                                                       *math.exp()*
        返回 `e^x` 的值。

math.floor({x})                                                   *math.floor()*
        返回小于或等于 {x} 的最大整数。

math.fmod({x}, {y})                                                *math.fmod()*
        返回 {x} 除以 {y} 的余数。

math.frexp({x})                                                   *math.frexp()*
        返回 `m` 与 `e`，使得 `x = m * 2^e`，`e` 为整数且 `m` 的绝对值
        位于范围 `[0.5, 1)` 内（当 {x} 为零时为零）。

math.huge                                                            *math.huge*
        值 `HUGE_VAL`，一个大于或等于任何其它数值的值。

math.ldexp({m}, {e})                                              *math.ldexp()*
        返回 `m * 2^e`（`e` 应为整数）。

math.log({x})                                                       *math.log()*
        返回 {x} 的自然对数。

math.log10({x})                                                   *math.log10()*
        返回 {x} 的以 10 为底的对数。

math.max({x}, {...})                                                *math.max()*
        返回其各参数中的最大值。

math.min({x}, {...})                                                *math.min()*
        返回其各参数中的最小值。

math.modf({x})                                                     *math.modf()*
        返回两个数字，{x} 的整数部分与 {x} 的小数部分。

math.pi                                                                *math.pi*
        值 `pi`。

math.pow({x}, {y})                                                  *math.pow()*
        返回 `x^y`。（你也可以用表达式 `x^y` 计算该值。）

math.rad({x})                                                       *math.rad()*
        返回以弧度为单位的角 {x}（{x} 以度给出）。

math.random([{m} [, {n}]])                                       *math.random()*
        该函数是 ANSI C 提供的简单伪随机生成函数 `rand` 的接口。（对其统计
        特性不作任何保证。）

        不带参数调用时，返回范围 `[0,1)` 内的伪随机实数。以一个数字 {m}
        调用时，`math.random` 返回范围 `[1, m]` 内的伪随机整数。以两个数字
        {m} 与 {n} 调用时，`math.random` 返回范围 `[m, n]` 内的伪随机整数。

math.randomseed({x})                                         *math.randomseed()*
        将 {x} 设为伪随机生成器的“种子”：相同的种子产生相同的数字序列。

math.sin({x})                                                       *math.sin()*
        返回 {x} 的正弦（假定以弧度为单位）。

math.sinh({x})                                                     *math.sinh()*
        返回 {x} 的双曲正弦。

math.sqrt({x})                                                     *math.sqrt()*
        返回 {x} 的平方根。（你也可以用表达式 `x^0.5` 计算该值。）

math.tan({x})                                                       *math.tan()*
        返回 {x} 的正切（假定以弧度为单位）。

math.tanh({x})                                                     *math.tanh()*
        返回 {x} 的双曲正切。

==============================================================================
5.6  输入输出设施                                            *lua-lib-io*

I/O 库提供两种不同的文件操纵风格。第一种使用隐式文件描述符；也就是说，有
一些操作用来设定默认输入文件与默认输出文件，所有输入/输出操作都作用于这些
默认文件。第二种风格使用显式文件描述符。

使用隐式文件描述符时，所有操作由 table `io` 提供。使用显式文件描述符时，
操作 `io.open` 返回一个文件描述符，随后所有操作都作为该文件描述符的方法
提供。

table `io` 还提供三个预定义的文件描述符，其含义与 C 中的通常含义一致：
`io.stdin`、`io.stdout` 与 `io.stderr`。

除非另有说明，所有 I/O 函数在失败时返回 `nil`（外加一条错误消息作为第二个
结果），在成功时返回某个不同于 `nil` 的值。

io.close([{file}])                                                  *io.close()*
        等价于 `file:close`。不带 {file} 时关闭默认输出文件。

io.flush()                                                          *io.flush()*
        等价于对默认输出文件调用 `file:flush`。

io.input([{file}])                                                  *io.input()*
        以文件名调用时，它打开该名字的文件（文本模式），并将其句柄设为默认
        输入文件。以文件句柄调用时，它只是把该文件句柄设为默认输入文件。
        不带参数调用时，它返回当前的默认输入文件。

        出错时该函数会抛出错误，而不返回错误码。

io.lines([{filename}])                                              *io.lines()*
        以读模式打开给定的文件名，并返回一个 |iterator| 函数，该函数每次
        被调用时返回文件中的新一行。因此，下面的构造

        `for line in io.lines(filename) do`  `body`  `end`

        将遍历该文件的所有行。当迭代函数检测到文件结尾时，它返回 `nil`
        （以结束循环）并自动关闭该文件。

        调用 `io.lines()`（不带文件名）等价于 `io.input():lines()`；也就是
        说，它遍历默认输入文件的行。在这种情形下，循环结束时它不会关闭该
        文件。

io.open({filename} [, {mode}])                                       *io.open()*
        该函数以字符串 {mode} 指定的模式打开一个文件。它返回一个新的文件
        句柄，或在出错时返回 `nil` 外加一条错误消息。

        {mode} 字符串可以是下列之一：

         - `"r"`   读模式（默认）；
         - `"w"`   写模式；
         - `"a"`   追加模式；
         - `"r+"`  更新模式，保留先前的全部数据；
         - `"w+"`  更新模式，抹除先前的全部数据；
         - `"a+"`  追加更新模式，保留先前的数据，只允许在文件末尾写入。

        {mode} 字符串末尾还可以有一个 `b`，在某些系统中以二进制模式打开
        文件时需要它。该字符串正是标准 C 函数 `fopen` 中所用的内容。

io.output([{file}])                                                *io.output()*
        类似于 `io.input`，但作用于默认输出文件。

io.popen({prog} [, {mode}])                                         *io.popen()*
        在独立进程中启动程序 {prog}，并返回一个文件句柄，你可以用它从该
        程序读取数据（若 {mode} 为 `"r"`，即默认值）或向该程序写入数据
        （若 {mode} 为 `"w"`）。

        该函数依赖于系统，并非在所有平台上都可用。

io.read({...})                                                       *io.read()*
        等价于 `io.input():read`。

io.tmpfile()                                                      *io.tmpfile()*
        返回一个临时文件的句柄。该文件以更新模式打开，并在程序结束时自动
        被移除。

io.type({obj})                                                       *io.type()*
        检查 {obj} 是否为有效的文件句柄。若 {obj} 是已打开的文件句柄则返回
        字符串 `"file"`，若 {obj} 是已关闭的文件句柄则返回 `"closed file"`，
        若 {obj} 不是文件句柄则返回 `nil`。

io.write({...})                                                     *io.write()*
        等价于 `io.output():write`。

file:close()                                               *file:close()*
        关闭 `file`。注意，文件在其句柄被垃圾回收时会自动关闭，但发生这
        件事所需的时长不可预测。

file:flush()                                               *file:flush()*
        把已写入的任何数据保存到 `file`。

file:lines()                                               *file:lines()*
        返回一个 |iterator| 函数，该函数每次被调用时返回文件中的新一行。
        因此，下面的构造

               `for line in file:lines() do`  `body`  `end`

        将遍历该文件的所有行。（与 `io.lines` 不同，循环结束时该函数不会
        关闭该文件。）

file:read({...})                                            *file:read()*
        按给定的格式（这些格式指定要读什么）读取文件 `file`。对每种格式，
        该函数返回一个包含所读字符的字符串（或一个数字），若无法按指定
        格式读取数据则返回 `nil`。不带格式调用时，它使用一个读取整个下一
        行的默认格式（见下文）。

        可用的格式为

         `"*n"`    读取一个数字；这是唯一返回数字而非字符串的格式。
         `"*a"`    从当前位置开始读取整个文件。在文件结尾时，返回空字符串。
         `"*l"`    读取下一行（跳过行尾），在文件结尾时返回 `nil`。这是
                 默认格式。
         `number`  读取最多为该数字个字符的字符串，在文件结尾时返回 `nil`。
                 若该数字为零，则不读取任何内容并返回空字符串，或在文件
                 结尾时返回 `nil`。

file:seek([{whence}] [, {offset}])                          *file:seek()*
        把按自文件开头计量的文件位置设定并获取为 {offset} 加上由字符串
        {whence} 指定的基准所给出的位置，如下所示：

         - `"set"`：基准为位置 0（文件开头）；
         - `"cur"`：基准为当前位置；
         - `"end"`：基准为文件结尾；

        成功时，函数 `seek` 返回最终的文件位置，以自文件开头计的字节数
        计量。若该函数失败，它返回 `nil`，外加一个描述该错误的字符串。

        {whence} 的默认值为 `"cur"`，{offset} 的默认值为 0。因此，调用
        `file:seek()` 返回当前文件位置而不改变它；调用 `file:seek("set")`
        把位置设为文件开头（并返回 0）；而调用 `file:seek("end")` 把位置
        设为文件结尾，并返回其大小。

file:setvbuf({mode} [, {size}])                          *file:setvbuf()*
        设定输出文件的缓冲模式。可用的模式有三种：

         `"no"`    不缓冲；任何输出操作的结果立即出现。
         `"full"`  全缓冲；只有在缓冲已满时才执行输出操作（或在你显式
                 `flush` 该文件时（见 |io.flush()|）。
         `"line"`  行缓冲；输出被缓冲，直到输出一个换行符，或从某些特殊
                 文件（如终端设备）有任何输入。

        对于后两种情形，{size} 指定缓冲的大小，以字节为单位。默认值为
        一个合适的尺寸。

file:write({...})                                          *file:write()*
        把其每个参数的值写入 `file`。参数必须是字符串或数字。若要写入
        其它值，请在 `write` 之前使用 `tostring` |tostring()| 或
        `string.format` |string.format()|。

==============================================================================
5.8  操作系统的设施                                          *lua-lib-os*

本库通过 table `os` 实现。

os.clock()                                                          *os.clock()*
        返回该程序所用 CPU 时间量的近似值，以秒为单位。

os.date([{format} [, {time}]])                                       *os.date()*
        返回包含日期与时间的字符串或 table，按给定的字符串 {format} 格式化。

        若存在 {time} 参数，则这就是要格式化的时间（关于该值的描述见
        `os.time` 函数 |os.time()|）。否则，`date` 格式化当前时间。

        若 {format} 以 `!` 开头，则日期按协调世界时格式化。在此可选字符
        之后，若 {format} 为字符串 `"*t"`，则 `date` 返回一个 table，其中
        包含下列字段：`year`（四位）、`month`（1-12）、`day`（1-31）、
        `hour`（0-23）、`min`（0-59）、`sec`（0-61）、`wday`（星期几，
        星期日为 1）、`yday`（一年中的第几天）以及 `isdst`（夏令时标志，
        一个布尔值）。

        若 {format} 不是 `"*t"`，则 `date` 返回作为字符串的日期，按与 C
        函数 `strftime` 相同的规则格式化。

        不带参数调用时，`date` 返回一个合理的日期与时间表示，它取决于宿主
        系统与当前 locale（也就是说，`os.date()` 等价于
        `os.date("%c")`）。

os.difftime({t2}, {t1})                                          *os.difftime()*
        返回从时间 {t1} 到时间 {t2} 的秒数。在 POSIX、Windows 以及某些其它
        系统中，该值正好是 `t2 - t1`。

os.execute([{command}])                                           *os.execute()*
        该函数等价于 C 函数 `system`。它把 {command} 交给操作系统的 shell
        执行。它返回一个状态码，该状态码依赖于系统。若 {command} 缺省，
        则在有 shell 可用时返回非零值，否则返回零。

os.exit([{code}])                                                    *os.exit()*
        调用 C 函数 `exit`，带一个可选的 {code}，以终止宿主程序。{code}
        的默认值为成功码。

os.getenv({varname})                                               *os.getenv()*
        返回进程环境变量 {varname} 的值，若该变量未定义则返回 `nil`。

os.remove({filename})                                              *os.remove()*
        删除给定名字的文件。要删除目录，该目录必须为空。若该函数失败，
        它返回 `nil`，外加一个描述该错误的字符串。

os.rename({oldname}, {newname})                                    *os.rename()*
        把名为 {oldname} 的文件改名为 {newname}。若该函数失败，它返回
        `nil`，外加一个描述该错误的字符串。

os.setlocale({locale} [, {category}])                           *os.setlocale()*
        设定程序的当前 locale。{locale} 是一个指定 locale 的字符串；
        {category} 是一个可选字符串，描述要更改哪个类别：`"all"`、
        `"collate"`、`"ctype"`、`"monetary"`、`"numeric"` 或 `"time"`；
        默认类别为 `"all"`。该函数返回新 locale 的名字，若请求无法满足
        则返回 `nil`。

os.time([{table}])                                                   *os.time()*
        不带参数调用时返回当前时间，或返回一个表示给定 table 所指定的日期
        与时间的时间。该 table 必须有 `year`、`month` 与 `day` 字段，且
        可以有 `hour`、`min`、`sec` 与 `isdst` 字段（关于这些字段的描述，
        见 `os.date` 函数 |os.date()|）。

        返回的值是一个数字，其含义取决于你的系统。在 POSIX、Windows 以及
        某些其它系统中，该数字计量自某个给定起始时间（“epoch”）以来的
        秒数。在其它系统中，其含义未被规定，`time` 返回的数字只能作为
        `date` 与 `difftime` 的参数使用。

os.tmpname()                                                      *os.tmpname()*
        返回一个含有可用于临时文件的文件名的字符串。该文件在使用之前必须
        被显式打开，在不再需要时必须被显式移除。

==============================================================================
5.9  Debug 库                                                  *lua-lib-debug*

本库向 Lua 程序提供 debug 接口的功能。使用本库时应当小心。此处提供的
函数应仅用于调试及类似任务，如性能分析。请抵制把它们当作常规编程工具的
诱惑：它们可能非常慢。此外，其中若干函数违反关于 Lua 代码的某些假定
（例如，函数局部的变量无法从外部访问，或 userdata 的元表无法被 Lua 代码
更改），因此可能危及原本安全的代码。

本库中所有函数都放在 `debug` table 内。所有作用于线程的函数都有一个可选的
第一个参数，即要作用的线程。默认值总是当前线程。

debug.debug()                                                    *debug.debug()*
        与用户进入交互模式，运行用户输入的每个字符串。使用简单命令与其它
        debug 设施，用户可以查看全局与局部变量、更改它们的值、求值表达式
        等等。只包含单词 `cont` 的一行会结束该函数，以便调用者继续其执行。

        注意，`debug.debug` 的命令并非词法上嵌套在任何函数之内，因此没有
        对局部变量的直接访问。

debug.getfenv(o)                                               *debug.getfenv()*
        返回对象 {o} 的环境。

debug.gethook([{thread}])                                      *debug.gethook()*
        返回该线程当前的 hook 设置，共三个值：当前 hook 函数、当前 hook
        掩码以及当前 hook 计数（如由 `debug.sethook` 函数所设置）。

debug.getinfo([{thread},] {function} [, {what}])               *debug.getinfo()*
        返回一个含有某函数信息的 table。你可以直接给出该函数，也可以把
        {function} 的值给成一个数字，它表示给定线程调用栈上第 {function}
        层正在运行的函数：第 0 层是当前函数（即 `getinfo` 自身）；第 1 层是
        调用 `getinfo` 的那个函数；依此类推。若 {function} 是一个大于活动
        函数数目的数字，则 `getinfo` 返回 `nil`。

        返回的 table 可以包含 `lua_getinfo` 返回的所有字段（见
        |lua_getinfo()|），而字符串 {what} 描述要填入哪些字段。{what} 的
        默认值是获取所有可用信息，除了有效行的 table。若存在，选项 `f`
        会添加一个名为 `func` 的字段，其值为该函数本身。若存在，选项 `L`
        会添加一个名为 `activelines` 的字段，其值为有效行的 table。

        例如，表达式 `debug.getinfo(1,"n").name` 返回当前函数的名称（若
        能找到合理的名称），而 `debug.getinfo(print)` 返回一个包含 `print`
        函数全部可用信息的 table。

debug.getlocal([{thread},] {level}, {local})                  *debug.getlocal()*
        该函数返回栈上第 {level} 层函数中索引为 {local} 的局部变量的名称与
        值。（第一个参数或局部变量的索引为 1，依此类推，直到最后一个活动
        的局部变量。）若不存在给定索引的局部变量，该函数返回 `nil`；以超出
        范围的 {level} 调用时会抛出错误。（你可以调用 `debug.getinfo`
        |debug.getinfo()| 来检查该层是否有效。）

        以 `(`（左圆括号）开头的变量名表示内部变量（循环控制变量、临时量
        以及 C 函数的局部变量）。

debug.getmetatable({object})                              *debug.getmetatable()*
        返回给定 {object} 的元表，若它没有元表则返回 `nil`。

debug.getregistry()                                        *debug.getregistry()*
        返回注册表 table（见 |lua-registry|）。

debug.getupvalue({func}, {up})                              *debug.getupvalue()*
        该函数返回函数 {func} 中索引为 {up} 的 upvalue 的名称与值。若不存在
        给定索引的 upvalue，该函数返回 `nil`。

debug.setfenv({object}, {table})                               *debug.setfenv()*
        把给定 {object} 的环境设为给定的 {table}。返回 {object}。

debug.sethook([{thread},] {hook}, {mask} [, {count}])          *debug.sethook()*
        把给定的函数设为 hook。字符串 {mask} 与数字 {count} 描述该 hook 将在
        何时被调用。字符串掩码可以含有下列字符，其含义如下：

         - `"c"` ：每次 Lua 调用一个函数时该 hook 被调用；
         - `"r"` ：每次 Lua 从函数返回时该 hook 被调用；
         - `"l"` ：每次 Lua 进入新的一行代码时该 hook 被调用。

        当 {count} 不为零时，每执行 {count} 条指令后该 hook 被调用一次。

        不带参数调用时，`debug.sethook` 关闭该 hook。

        当该 hook 被调用时，其第一个参数是一个字符串，描述触发此次调用的
        事件：`"call"`、`"return"`（或 `"tail return"`）、`"line"` 与
        `"count"`。对于 line 事件，该 hook 还会得到新的行号作为第二个参数。
        在 hook 内部，你可以用层 2 调用 `getinfo` 以获取关于正在运行的函数
        的更多信息（层 0 是 `getinfo` 函数，层 1 是 hook 函数），除非该事件
        是 `"tail return"`。在这种情形下，Lua 只是在模拟返回，调用 `getinfo`
        将返回无效的数据。

debug.setlocal([{thread},] {level}, {local}, {value})         *debug.setlocal()*
        该函数把值 {value} 赋给栈上第 {level} 层函数中索引为 {local} 的局部
        变量。若不存在给定索引的局部变量，该函数返回 `nil`；以超出范围的
        {level} 调用时会抛出错误。（你可以调用 `getinfo` 来检查该层是否
        有效。）否则，它返回该局部变量的名称。

debug.setmetatable({object}, {table})                     *debug.setmetatable()*
        把给定 {object} 的元表设为给定的 {table}（该 {table} 可以为 `nil`）。

debug.setupvalue({func}, {up}, {value})                     *debug.setupvalue()*
        该函数把值 {value} 赋给函数 {func} 中索引为 {up} 的 upvalue。若不存在
        给定索引的 upvalue，该函数返回 `nil`。否则，它返回该 upvalue 的
        名称。

debug.traceback([{thread},] [{message} [,{level}]])          *debug.traceback()*
        返回一个含有调用栈回溯的字符串。可选的 {message} 字符串被附加在回溯
        的开头。可选的 {level} 数字指明从哪一层开始回溯（默认为 1，即调用
        `traceback` 的那个函数）。

