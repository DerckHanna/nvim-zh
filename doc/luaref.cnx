lua_State                                                            *lua_State*
>c
    typedef struct lua_State lua_State;
<
        不透明的结构，保存一个 Lua 解释器的全部 state。Lua 库是完全可重入的：
        它没有全局变量。关于一个 state 的所有信息都保存在此结构中。

        指向该 state 的指针必须作为第一个参数传给库中的每个函数，
        `lua_newstate`（见 |lua_newstate()|）除外——它从头创建一个 Lua
        state。

lua_status                                                        *lua_status()*
>c
    int lua_status (lua_State *L);
<
        返回 thread `L` 的状态。

        状态可以是 0（普通 thread），也可以是错误码（该 thread 以错误结束执
        行时），或 `LUA_YIELD`（该 thread 已挂起）。

lua_toboolean                                                  *lua_toboolean()*
>c
    int lua_toboolean (lua_State *L, int index);
<
