  "notes": {
    "domain": "nvim-dap-ui",
    "excluded": "raw DAP data, user values, debugger output, internal Buffer names, dependency/layout error values and existing Buffer contents",
    "limitations": "existing Buffers are not scanned; shared nio.ui.select requires completed dapui setup, exactly six built-in non-hover IDs and expected formatter labels",
    "public_path": "fixed render/display projections and exact vim.notify title",
    "seam": "Canvas.new/write(highlight-scoped); util.apply_mapping(desc); util.format_value/error; util.select_win(scoped exact print); windows.open_float(title); guarded nio.ui.select; setup lifecycle; exact vim.notify title",
    "status": "implemented",
    "version_related": "Canvas.write recomputes matches from projected text; select_win is synchronous and render.new_canvas snapshots Canvas.new at module load",
    "writes": "fixed_display_strings_only"
  },
