  "notes": {
    "domain": "nvim-dap",
    "excluded": "DAP protocol data, logs, debugger output, raw variables/frames/threads, REPL command tokens/completions, existing Buffer contents, eager user-command descriptions, launch.json prompt text and internal quickfix/Buffer identities",
    "limitations": "existing REPL prompt callbacks are not reattached; DapNew/DapEval command descriptions stay English because re-registration cannot preserve command identity; launch.json promptString/pickString descriptions and options are user configuration data; duplicate quickfix locations fall back when raw breakpoint ownership is ambiguous",
    "public_path": "exact vim.notify title; structured dap.ui selectors; scoped REPL/new-buffer and vim.fn.input display hooks; breakpoint quickfix display projection; health.check; dap.ui.widgets builder/view layer; Session exception diagnostics, spawn and connect; deprecated utils/vscode notify_once",
    "seam": "vim.notify:title=DAP; dap.ui.pick_one(_sync); scoped REPL execute/append/open/toggle and no-session reply; session.set_exception_breakpoints and variable.tree_spec.compute_actions vim.fn.input; breakpoints.to_qf_list; health.check; synthetic thread root; dap.ui.widgets fixed messages via call-site-gated layer proxy; Session:_show_exception_info scoped vim.diagnostic.set; Session.spawn scoped vim.notify; Session.connect on_connect; dap.utils.to_dict and dap.ext.vscode.load_launchjs scoped vim.notify_once",
    "status": "implemented",
    "version_related": "REPL new_buf and help execution are pinned synchronous scopes; quickfix text is reprojected from raw breakpoint fields; direct input prompts are scoped to their owning public action; widget messages, exception diagnostics, spawn/connect failures and deprecated-API notifications are gated on the pinned source digests and on the real call site",
    "writes": "fixed_display_strings_only"
  },
