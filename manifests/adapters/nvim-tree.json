    "public_path": "default on_attach mapping descriptions; exact vim.notify title; api.fs.remove/trash/paste/marks.bulk.* prompts; api.tree.toggle_help; api.node.open.*; api.node.show_info_popup; renderer.hidden_display simple/all labels",
