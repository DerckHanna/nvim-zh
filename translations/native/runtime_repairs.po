# nvim-zh 运行时形式修复条目。
# 上游 po 抽取缺陷使下面 4 条 msgid 被截断（例如 “E5403: Chunk %i start %”）；
# 这里按固定上游 C 源码重建运行时 msgid，使其能与 Neovim 本体真正的 gettext 查询键匹配。
msgid ""
msgstr ""
"Project-Id-Version: nvim-zh native runtime repairs\n"
"PO-Revision-Date: 2026-11-17 20:38+0800\n"
"Last-Translator: nvim-zh maintainers\n"
"Language-Team: Simplified Chinese\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: zh_CN\n"
"Plural-Forms: nplurals=1; plural=0;\n"

#. upstream msgid: E5403: Chunk %i start %
#. evidence: src/nvim/ex_getln.c 该处用 PRINT_ERRMSG(_("E5403: Chunk %i start %" PRIdVARNUMBER " not in range [" PRIdVARNUMBER ", %i)"), ...)；上游 po 抽取时未展开 PRIdVARNUMBER，msgid 被截断成 “... start %”。
#: ../ex_getln.c:3011
#, c-format
msgid "E5403: Chunk %i start %<PRIdVARNUMBER> not in range [%<PRIdVARNUMBER>, %i)"
msgstr "E5403: 数据块 %i 的起始 %<PRIdVARNUMBER> 不在范围 [%<PRIdVARNUMBER>, %i) 内"

#. upstream msgid: E5405: Chunk %i start %
#. evidence: 源码为 PRINT_ERRMSG(_("E5405: Chunk %i start %" PRIdVARNUMBER " splits multibyte character"), ...)；上游 po msgid 在 “start %” 处被截断。
#: ../ex_getln.c:3016
#, c-format
msgid "E5405: Chunk %i start %<PRIdVARNUMBER> splits multibyte character"
msgstr "E5405: 数据块 %i 的起始 %<PRIdVARNUMBER> 分割了多字节字符"

#. upstream msgid: E5404: Chunk %i end %
#. evidence: 源码为 PRINT_ERRMSG(_("E5404: Chunk %i end %" PRIdVARNUMBER " not in range (" PRIdVARNUMBER ", %i]"), ...)；上游 po msgid 在 “end %” 处被截断。
#: ../ex_getln.c:3032
#, c-format
msgid "E5404: Chunk %i end %<PRIdVARNUMBER> not in range (%<PRIdVARNUMBER>, %i]"
msgstr "E5404: 数据块 %i 的结束 %<PRIdVARNUMBER> 不在范围 (%<PRIdVARNUMBER>, %i] 内"

#. upstream msgid: E5406: Chunk %i end %
#. evidence: 源码为 PRINT_ERRMSG(_("E5406: Chunk %i end %" PRIdVARNUMBER " splits multibyte character"), ...)；上游 po msgid 在 “end %” 处被截断。
#: ../ex_getln.c:3039
#, c-format
msgid "E5406: Chunk %i end %<PRIdVARNUMBER> splits multibyte character"
msgstr "E5406: 数据块 %i 的结束 %<PRIdVARNUMBER> 分割了多字节字符"

#. upstream msgid: E15: Invalid expression: %s
#. evidence: 固定 src/nvim/errors.h:37 定义 e_invexpr2 = N_("E15: Invalid expression: \"%s\"")，运行时 gettext 键带双引号；上游 po 抽取时丢失了 %s 外的双引号，导致已译条目永不命中。这里按运行时精确键补译。
#: ../errors.h:37
#, c-format
msgid "E15: Invalid expression: \"%s\""
msgstr "E15: 无效的表达式：\"%s\""

#. upstream msgid: E856: assert_fails() second argument must be a string or a list with one or two strings
#. evidence: 固定 src/nvim/testing.c 定义 e_assert_fails_second_arg = N_("E856: \"assert_fails()\" second argument must be a string or a list with one or two strings")，运行时键带双引号；上游 po 抽取丢失引号。
#: ../testing.c
msgid "E856: \"assert_fails()\" second argument must be a string or a list with one or two strings"
msgstr "E856: \"assert_fails()\" 的第二个参数必须是字符串，或包含一或两个字符串的列表"

#. upstream msgid: E1115: assert_fails() fourth argument must be a number
#. evidence: 固定 src/nvim/testing.c 定义 e_assert_fails_fourth_argument = N_("E1115: \"assert_fails()\" fourth argument must be a number")，运行时键带双引号；上游 po 抽取丢失引号。
#: ../testing.c
msgid "E1115: \"assert_fails()\" fourth argument must be a number"
msgstr "E1115: \"assert_fails()\" 的第四个参数必须是数字"

#. upstream msgid: E1116: assert_fails() fifth argument must be a string
#. evidence: 固定 src/nvim/testing.c 定义 e_assert_fails_fifth_argument = N_("E1116: \"assert_fails()\" fifth argument must be a string")，运行时键带双引号；上游 po 抽取丢失引号。
#: ../testing.c
msgid "E1116: \"assert_fails()\" fifth argument must be a string"
msgstr "E1116: \"assert_fails()\" 的第五个参数必须是字符串"
