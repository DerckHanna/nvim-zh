#: lua/aerial/actions.lua:6
msgctxt "action"
msgid "Show default keymaps"
msgstr "显示默认键映射"

#: lua/aerial/actions.lua:14
#: lua/aerial/nav_actions.lua:6
msgctxt "action"
msgid "Jump to the symbol under the cursor"
msgstr "跳转到光标下的符号"

#: lua/aerial/actions.lua:19
#: lua/aerial/nav_actions.lua:17
msgctxt "action"
msgid "Jump to the symbol in a vertical split"
msgstr "在垂直分屏中跳转到符号"

#: lua/aerial/actions.lua:26
#: lua/aerial/nav_actions.lua:32
msgctxt "action"
msgid "Jump to the symbol in a horizontal split"
msgstr "在水平分屏中跳转到符号"

#: lua/aerial/actions.lua:33
msgctxt "action"
msgid "Scroll to the symbol (stay in aerial buffer)"
msgstr "滚动到符号处（停留在 Aerial Buffer）"

#: lua/aerial/actions.lua:40
msgctxt "action"
msgid "Go down one line and scroll to that symbol"
msgstr "下移一行并滚动到该符号"

#: lua/aerial/actions.lua:50
msgctxt "action"
msgid "Go up one line and scroll to that symbol"
msgstr "上移一行并滚动到该符号"

#: lua/aerial/actions.lua:60
msgctxt "action"
msgid "Jump to the previous symbol"
msgstr "跳转到上一个符号"

