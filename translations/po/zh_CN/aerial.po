msgctxt "action"
msgid "Jump to the next symbol"
msgstr "跳转到下一个符号"

#: lua/aerial/actions.lua:70
msgctxt "action"
msgid "Jump up the tree, moving backwards in the file"
msgstr "在文件中向上跳转到上层树节点"

#: lua/aerial/actions.lua:75
msgctxt "action"
msgid "Jump up the tree, moving forwards in the file"
msgstr "在文件中向下跳转到上层树节点"

#: lua/aerial/actions.lua:80
msgctxt "action"
msgid "Close the aerial window"
msgstr "关闭 Aerial Window"

#: lua/aerial/actions.lua:91
msgctxt "action"
msgid "Toggle the symbol under the cursor open/closed"
msgstr "展开或折叠光标下的符号"

#: lua/aerial/actions.lua:96
msgctxt "action"
msgid "Recursively toggle the symbol under the cursor open/closed"
msgstr "递归展开或折叠光标下的符号"

#: lua/aerial/actions.lua:103
msgctxt "action"
msgid "Expand the symbol under the cursor"
msgstr "展开光标下的符号"

#: lua/aerial/actions.lua:108
msgctxt "action"
msgid "Recursively expand the symbol under the cursor"
msgstr "递归展开光标下的符号"

#: lua/aerial/actions.lua:115
msgctxt "action"
msgid "Collapse the symbol under the cursor"
msgstr "折叠光标下的符号"

#: lua/aerial/actions.lua:120
msgctxt "action"
msgid "Recursively collapse the symbol under the cursor"
msgstr "递归折叠光标下的符号"

#: lua/aerial/actions.lua:127
msgctxt "action"
msgid "Increase the fold level of the tree"
msgstr "增加树的折叠层级"

#: lua/aerial/actions.lua:134
msgctxt "action"
msgid "Decrease the fold level of the tree"
msgstr "减少树的折叠层级"

#: lua/aerial/actions.lua:141
msgctxt "action"
msgid "Expand all nodes in the tree"
msgstr "展开树中的所有节点"

#: lua/aerial/actions.lua:146
msgctxt "action"
msgid "Collapse all nodes in the tree"
msgstr "折叠树中的所有节点"

#: lua/aerial/actions.lua:151
msgctxt "action"
msgid "Sync code folding to the tree (useful if they get out of sync)"
msgstr "将代码折叠同步到树（不同步时可用）"

#: lua/aerial/nav_actions.lua:49
msgctxt "action"
msgid "Navigate to parent symbol"
msgstr "导航到父符号"

