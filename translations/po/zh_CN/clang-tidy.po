msgid "do not use 'compare' to test equality of strings; use the string equality operator instead"
msgstr "不要使用 'compare' 测试字符串是否相等；请改用字符串相等运算符"

#: clang-tools-extra/clang-tidy/readability/SuspiciousCallArgumentCheck.cpp:669
msgctxt "readability-suspicious-call-argument"
msgid "%0 argument '%1' (passed to '%2') looks like it might be swapped with the %3, '%4' (passed to '%5')"
msgstr "第 %0 个实参 '%1'（传递给 '%2'）看起来可能与第 %3 个实参 '%4'（传递给 '%5'）写反了"

#: clang-tools-extra/clang-tidy/readability/SuspiciousCallArgumentCheck.cpp:683
msgctxt "readability-suspicious-call-argument/note"
msgid "in the call to %0, declared here"
msgstr "在对在此处声明的 %0 的调用中"

#: clang-tools-extra/clang-tidy/readability/TrailingCommaCheck.cpp:167
msgctxt "readability-trailing-comma"
msgid "enum should have a trailing comma"
msgstr "枚举应当带有尾随逗号"

#: clang-tools-extra/clang-tidy/readability/TrailingCommaCheck.cpp:174
msgctxt "readability-trailing-comma"
msgid "enum should not have a trailing comma"
msgstr "枚举不应带有尾随逗号"

#: clang-tools-extra/clang-tidy/readability/TrailingCommaCheck.cpp:167
msgctxt "readability-trailing-comma"
msgid "initializer list should have a trailing comma"
msgstr "初始化列表应当带有尾随逗号"

#: clang-tools-extra/clang-tidy/readability/TrailingCommaCheck.cpp:174
msgctxt "readability-trailing-comma"
msgid "initializer list should not have a trailing comma"
msgstr "初始化列表不应带有尾随逗号"

#: clang-tools-extra/clang-tidy/readability/TrivialSwitchCheck.cpp:56
msgctxt "readability-trivial-switch"
msgid "switch could be better written as an if-else statement"
msgstr "此 switch 语句改写为 if-else 语句会更好"

#: clang-tools-extra/clang-tidy/readability/TrivialSwitchCheck.cpp:46
msgctxt "readability-trivial-switch"
msgid "switch statement without labels has no effect"
msgstr "不带标签的 switch 语句没有任何效果"

#: clang-tools-extra/clang-tidy/readability/TrivialSwitchCheck.cpp:50
msgctxt "readability-trivial-switch"
msgid "switch with default label only"
msgstr "switch 语句仅包含 default 标签"

#: clang-tools-extra/clang-tidy/readability/TrivialSwitchCheck.cpp:52
msgctxt "readability-trivial-switch"
msgid "switch with only one case; use an if statement"
msgstr "switch 语句仅有一个 case 分支；请改用 if 语句"

#: clang-tools-extra/clang-tidy/readability/UniqueptrDeleteReleaseCheck.cpp:62
msgctxt "readability-uniqueptr-delete-release"
msgid "prefer '= nullptr' to reset 'unique_ptr<>' objects"
msgstr "优先使用 '= nullptr' 重置 'unique_ptr<>' 对象"

#: clang-tools-extra/clang-tidy/readability/UniqueptrDeleteReleaseCheck.cpp:62
msgctxt "readability-uniqueptr-delete-release"
msgid "prefer 'reset()' to reset 'unique_ptr<>' objects"
msgstr "优先使用 'reset()' 重置 'unique_ptr<>' 对象"

#: clang-tools-extra/clang-tidy/readability/UppercaseLiteralSuffixCheck.cpp:213
msgctxt "readability-uppercase-literal-suffix"
msgid "floating point literal has suffix '%1', which is not uppercase"
msgstr "浮点字面量具有非大写后缀 '%1'"

#: clang-tools-extra/clang-tidy/readability/UppercaseLiteralSuffixCheck.cpp:213
msgctxt "readability-uppercase-literal-suffix"
msgid "integer literal has suffix '%1', which is not uppercase"
msgstr "整数字面量具有非大写后缀 '%1'"

#: clang-tools-extra/clang-tidy/readability/UseAnyOfAllOfCheck.cpp:105
msgctxt "readability-use-anyofallof"
msgid "replace loop by 'std::all_of()'"
msgstr "将循环替换为 'std::all_of()'"

#: clang-tools-extra/clang-tidy/readability/UseAnyOfAllOfCheck.cpp:105
msgctxt "readability-use-anyofallof"
msgid "replace loop by 'std::any_of()'"
msgstr "将循环替换为 'std::any_of()'"

#: clang-tools-extra/clang-tidy/readability/UseAnyOfAllOfCheck.cpp:105
msgctxt "readability-use-anyofallof"
msgid "replace loop by 'std::ranges::all_of()'"
msgstr "将循环替换为 'std::ranges::all_of()'"

#: clang-tools-extra/clang-tidy/readability/UseAnyOfAllOfCheck.cpp:105
msgctxt "readability-use-anyofallof"
msgid "replace loop by 'std::ranges::any_of()'"
msgstr "将循环替换为 'std::ranges::any_of()'"

#: clang-tools-extra/clang-tidy/readability/UseAnyOfAllOfCheck.cpp:117
msgctxt "readability-use-anyofallof/note"
msgid "reusing the temporary range directly in the replacement may be unsafe; consider materializing it in a local variable first"
msgstr "在替换代码中直接复用临时范围可能不安全；请考虑先将其具现化到局部变量中"

#: clang-tools-extra/clang-tidy/readability/UseAnyOfAllOfCheck.cpp:111
msgctxt "readability-use-anyofallof/note"
msgid "reusing the temporary range directly in the replacement may be unsafe; consider materializing it in a local variable first, or use 'std::ranges' algorithms which handle temporary ranges safely"
msgstr "在替换代码中直接复用临时范围可能不安全；请考虑先将其具现化到局部变量中，或使用能够安全处理临时范围的 'std::ranges' 算法"

#: clang-tools-extra/clang-tidy/readability/UseConcisePreprocessorDirectivesCheck.cpp:91
msgctxt "readability-use-concise-preprocessor-directives"
msgid "preprocessor condition can be written more concisely using '#%0'"
msgstr "可以使用 '#%0' 更简洁地编写预处理器条件"

#: clang-tools-extra/clang-tidy/readability/UseStdMinMaxCheck.cpp:223
msgctxt "readability-use-std-min-max"
msgid "use `%0` instead of `%1`"
msgstr "使用 `%0` 代替 `%1`"

#: clang-tools-extra/clang-tidy/fuchsia/TemporaryObjectsCheck.cpp:62
msgctxt "zircon-temporary-objects"
msgid "creating a temporary object of type %0 is prohibited"
msgstr "禁止创建类型为 %0 的临时对象"
