#: clang-tools-extra/clang-tidy/altera/IdDependentBackwardBranchCheck.cpp:140
msgctxt "altera-id-dependent-backward-branch/note"
msgid "assignment of ID-dependent field %0"
msgstr "对依赖 ID 的字段 %0 赋值"

#: clang-tools-extra/clang-tidy/altera/IdDependentBackwardBranchCheck.cpp:131
msgctxt "altera-id-dependent-backward-branch/note"
msgid "assignment of ID-dependent variable %0"
msgstr "对依赖 ID 的变量 %0 赋值"

#: clang-tools-extra/clang-tidy/altera/IdDependentBackwardBranchCheck.cpp:182
msgctxt "altera-id-dependent-backward-branch/note"
msgid "inferred assignment of ID-dependent member from ID-dependent member %0"
msgstr "从依赖 ID 的成员 %0 推断出对依赖 ID 的成员的赋值"

#: clang-tools-extra/clang-tidy/altera/IdDependentBackwardBranchCheck.cpp:182
msgctxt "altera-id-dependent-backward-branch/note"
msgid "inferred assignment of ID-dependent member from ID-dependent variable %0"
msgstr "从依赖 ID 的变量 %0 推断出对依赖 ID 的成员的赋值"

#: clang-tools-extra/clang-tidy/altera/IdDependentBackwardBranchCheck.cpp:151
msgctxt "altera-id-dependent-backward-branch/note"
msgid "inferred assignment of ID-dependent value from ID-dependent member %0"
msgstr "从依赖 ID 的成员 %0 推断出对依赖 ID 的值的赋值"

#: clang-tools-extra/clang-tidy/altera/IdDependentBackwardBranchCheck.cpp:151
msgctxt "altera-id-dependent-backward-branch/note"
msgid "inferred assignment of ID-dependent value from ID-dependent variable %0"
msgstr "从依赖 ID 的变量 %0 推断出对依赖 ID 的值的赋值"

#: clang-tools-extra/clang-tidy/altera/KernelNameRestrictionCheck.cpp:81
msgctxt "altera-kernel-name-restriction"
msgid "compiling '%0' may cause additional compilation errors due to the name of the kernel source file; consider renaming the included kernel source file"
msgstr "编译 '%0' 可能会由于内核源文件的名称而导致额外的编译错误；请考虑重命名所包含的内核源文件"

#: clang-tools-extra/clang-tidy/altera/KernelNameRestrictionCheck.cpp:94
msgctxt "altera-kernel-name-restriction"
msgid "including '%0' may cause additional compilation errors due to the name of the kernel source file; consider renaming the included kernel source file"
msgstr "包含 '%0' 可能会由于内核源文件的名称而导致额外的编译错误；请考虑重命名所包含的内核源文件"

#: clang-tools-extra/clang-tidy/altera/SingleWorkItemBarrierCheck.cpp:44
msgctxt "altera-single-work-item-barrier"
msgid "kernel function %0 does not call 'get_global_id' or 'get_local_id' and will be treated as a single work-item"
msgstr "内核函数 %0 未调用 'get_global_id' 或 'get_local_id'，将被视为单个工作项"

#: clang-tools-extra/clang-tidy/altera/SingleWorkItemBarrierCheck.cpp:67
msgctxt "altera-single-work-item-barrier"
msgid "kernel function %0 does not call an ID function and may be a viable single work-item, but will be forced to execute as an NDRange"
msgstr "内核函数 %0 未调用 ID 函数，可能是一个可行的单个工作项，但将被强制作为 NDRange 执行"

#: clang-tools-extra/clang-tidy/altera/SingleWorkItemBarrierCheck.cpp:48
msgctxt "altera-single-work-item-barrier/note"
msgid "barrier call is in a single work-item and may error out"
msgstr "屏障调用位于单个工作项中，可能会导致错误"

#: clang-tools-extra/clang-tidy/altera/SingleWorkItemBarrierCheck.cpp:71
msgctxt "altera-single-work-item-barrier/note"
msgid "barrier call will force NDRange execution; if single work-item semantics are desired a mem_fence may be more efficient"
msgstr "屏障调用将强制按 NDRange 执行；如果需要单个工作项语义，使用 mem_fence 可能更高效"

#: clang-tools-extra/clang-tidy/altera/StructPackAlignCheck.cpp:96
msgctxt "altera-struct-pack-align"
msgid "accessing fields in struct %0 is inefficient due to padding; only needs %1 bytes but is using %2 bytes"
msgstr "由于填充导致访问结构体 %0 中的字段效率低下；仅需 %1 字节但使用了 %2 字节"

#: clang-tools-extra/clang-tidy/altera/StructPackAlignCheck.cpp:125
msgctxt "altera-struct-pack-align"
msgid "accessing fields in struct %0 is inefficient due to poor alignment; currently aligned to %1 bytes, but recommended alignment is %2 bytes"
msgstr "由于对齐不佳导致访问结构体 %0 中的字段效率低下；当前按 %1 字节对齐，但建议按 %2 字节对齐"

#: clang-tools-extra/clang-tidy/altera/StructPackAlignCheck.cpp:130
msgctxt "altera-struct-pack-align/note"
msgid "use \"__attribute__((aligned(%0)))\" to align struct %1 to %0 bytes"
msgstr "使用 \"__attribute__((aligned(%0)))\" 将结构体 %1 按 %0 字节对齐"

#: clang-tools-extra/clang-tidy/altera/StructPackAlignCheck.cpp:102
msgctxt "altera-struct-pack-align/note"
msgid "use \"__attribute__((packed))\" to reduce the amount of padding applied to struct %0"
msgstr "使用 \"__attribute__((packed))\" 以减少应用于结构体 %0 的填充量"

#: clang-tools-extra/clang-tidy/altera/UnrollLoopsCheck.cpp:70
msgctxt "altera-unroll-loops"
msgid "full unrolling requested, but loop bounds are not known; to partially unroll this loop, use the '#pragma unroll <num>' directive"
msgstr "已请求完全展开，但循环边界未知；要部分展开此循环，请使用 '#pragma unroll <num>' 指令"

#: clang-tools-extra/clang-tidy/altera/UnrollLoopsCheck.cpp:44
msgctxt "altera-unroll-loops"
msgid "kernel performance could be improved by unrolling this loop with a '#pragma unroll' directive"
msgstr "使用 '#pragma unroll' 指令展开此循环可以提高内核性能"

#: clang-tools-extra/clang-tidy/altera/UnrollLoopsCheck.cpp:54
msgctxt "altera-unroll-loops"
msgid "loop likely has a large number of iterations and thus cannot be fully unrolled; to partially unroll this loop, use the '#pragma unroll <num>' directive"
msgstr "循环可能具有大量迭代，因此无法完全展开；要部分展开此循环，请使用 '#pragma unroll <num>' 指令"

#: clang-tools-extra/clang-tidy/altera/UnrollLoopsCheck.cpp:63
msgctxt "altera-unroll-loops/note"
msgid "full unrolling requested, but loop bounds may not be known; to partially unroll this loop, use the '#pragma unroll <num>' directive"
msgstr "已请求完全展开，但循环边界可能未知；要部分展开此循环，请使用 '#pragma unroll <num>' 指令"

