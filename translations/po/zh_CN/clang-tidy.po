#: clang/lib/StaticAnalyzer/Checkers/CStringSyntaxChecker.cpp:229
msgctxt "clang-analyzer-unix.cstring.BadSizeArg"
msgid "Potential buffer overflow. Replace with 'sizeof(%0) - strlen(%0) - 1' or use a safer 'strlcat' API"
msgstr "潜在的缓冲溢出。请替换为 'sizeof(%0) - strlen(%0) - 1' 或使用更安全的 'strlcat' API"

#: clang/lib/StaticAnalyzer/Checkers/CStringSyntaxChecker.cpp:229
