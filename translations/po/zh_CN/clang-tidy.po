#: clang-tools-extra/clang-tidy/abseil/CleanupCtadCheck.cpp:22
msgctxt "abseil-cleanup-ctad"
msgid "prefer absl::Cleanup's class template argument deduction pattern in C++17 and higher"
msgstr "在 C++17 及更高版本中，优先使用 absl::Cleanup 的类模板实参推导写法"

#: clang-tools-extra/clang-tidy/abseil/DurationAdditionCheck.cpp:66
msgctxt "abseil-duration-addition"
msgid "perform addition in the duration domain"
msgstr "在时间跨度（duration）域中执行加法"

#: clang-tools-extra/clang-tidy/abseil/DurationComparisonCheck.cpp:46
msgctxt "abseil-duration-comparison"
msgid "perform comparison in the duration domain"
msgstr "在时长域中执行比较"

#: clang-tools-extra/clang-tidy/abseil/DurationConversionCastCheck.cpp:71
msgctxt "abseil-duration-conversion-cast"
msgid "duration should be converted directly to a floating-point number rather than through a type cast"
msgstr "持续时间应当直接转换为浮点数，而不是通过类型转换"

#: clang-tools-extra/clang-tidy/abseil/DurationConversionCastCheck.cpp:56
msgctxt "abseil-duration-conversion-cast"
msgid "duration should be converted directly to an integer rather than through a type cast"
msgstr "持续时间应当直接转换为整数，而不是通过类型转换"

#: clang-tools-extra/clang-tidy/abseil/DurationDivisionCheck.cpp:38
msgctxt "abseil-duration-division"
msgid "operator/ on absl::Duration objects performs integer division; did you mean to use FDivDuration()?"
msgstr "在 absl::Duration 对象上使用 operator/ 会执行整数除法；您是否想使用 FDivDuration()？"

#: clang-tools-extra/clang-tidy/abseil/DurationFactoryFloatCheck.cpp:60
msgctxt "abseil-duration-factory-float"
msgid "use the integer version of absl::%0"
msgstr "请使用 absl::%0 的整数版本"

#: clang-tools-extra/clang-tidy/abseil/DurationFactoryScaleCheck.cpp:202
msgctxt "abseil-duration-factory-scale"
msgid "internal duration scaling can be removed"
msgstr "可以移除内部的时长缩放"

#: clang-tools-extra/clang-tidy/abseil/DurationFactoryScaleCheck.cpp:147
msgctxt "abseil-duration-factory-scale"
msgid "use ZeroDuration() for zero-length time intervals"
msgstr "对于零长度的时间间隔，请使用 ZeroDuration()"

#: clang-tools-extra/clang-tidy/abseil/DurationSubtractionCheck.cpp:49
msgctxt "abseil-duration-subtraction"
msgid "perform subtraction in the duration domain"
msgstr "在时间跨度（duration）域中执行减法"

#: clang-tools-extra/clang-tidy/abseil/DurationUnnecessaryConversionCheck.cpp:108
msgctxt "abseil-duration-unnecessary-conversion"
msgid "remove unnecessary absl::Duration conversions"
msgstr "移除不必要的 absl::Duration 转换"

#: clang-tools-extra/clang-tidy/abseil/FasterStrsplitDelimiterCheck.cpp:116
msgctxt "abseil-faster-strsplit-delimiter"
msgid "absl::MaxSplits() called with a string literal consisting of a single character; consider using the character overload"
msgstr "以仅含单个字符的字符串字面量调用了 absl::MaxSplits()；请考虑使用字符重载"

#: clang-tools-extra/clang-tidy/abseil/FasterStrsplitDelimiterCheck.cpp:116
msgctxt "abseil-faster-strsplit-delimiter"
msgid "absl::StrSplit() called with a string literal consisting of a single character; consider using the character overload"
msgstr "以仅含单个字符的字符串字面量调用了 absl::StrSplit()；请考虑使用字符重载"

#: clang-tools-extra/clang-tidy/abseil/NoInternalDependenciesCheck.cpp:41
msgctxt "abseil-no-internal-dependencies"
msgid "do not reference any 'internal' namespaces; those implementation details are reserved to Abseil"
msgstr "不要引用任何 'internal' 命名空间；这些实现细节仅供 Abseil 保留使用"

#: clang-tools-extra/clang-tidy/abseil/NoNamespaceCheck.cpp:27
msgctxt "abseil-no-namespace"
msgid "namespace 'absl' is reserved for implementation of the Abseil library and should not be opened in user code"
msgstr "命名空间 'absl' 保留用于 Abseil 库的实现，不应在用户代码中打开"

#: clang-tools-extra/clang-tidy/abseil/RedundantStrcatCallsCheck.cpp:131
msgctxt "abseil-redundant-strcat-calls"
msgid "multiple calls to 'absl::StrCat' can be flattened into a single call"
msgstr "对 'absl::StrCat' 的多次调用可以扁平化为单次调用"

#: clang-tools-extra/clang-tidy/abseil/StrCatAppendCheck.cpp:88
msgctxt "abseil-str-cat-append"
msgid "call 'absl::StrAppend' instead of 'absl::StrCat' when appending to a string to avoid a performance penalty"
msgstr "向字符串追加内容时，请调用 'absl::StrAppend' 而不是 'absl::StrCat'，以避免性能损耗"

#: clang-tools-extra/clang-tidy/abseil/StrCatAppendCheck.cpp:80
msgctxt "abseil-str-cat-append"
msgid "call to 'absl::StrCat' has no effect"
msgstr "对 'absl::StrCat' 的调用没有任何效果"

#: clang-tools-extra/clang-tidy/abseil/StringFindStartswithCheck.cpp:114
msgctxt "abseil-string-find-startswith"
msgid "use !absl::StartsWith instead of find() != 0"
msgstr "使用 !absl::StartsWith 代替 find() != 0"

#: clang-tools-extra/clang-tidy/abseil/StringFindStartswithCheck.cpp:114
msgctxt "abseil-string-find-startswith"
msgid "use !absl::StartsWith instead of find() == 0"
msgstr "使用 !absl::StartsWith 代替 find() == 0"

#: clang-tools-extra/clang-tidy/abseil/StringFindStartswithCheck.cpp:114
msgctxt "abseil-string-find-startswith"
msgid "use !absl::StartsWith instead of rfind() != 0"
msgstr "使用 !absl::StartsWith 代替 rfind() != 0"

#: clang-tools-extra/clang-tidy/abseil/StringFindStartswithCheck.cpp:114
msgctxt "abseil-string-find-startswith"
msgid "use !absl::StartsWith instead of rfind() == 0"
msgstr "使用 !absl::StartsWith 代替 rfind() == 0"

#: clang-tools-extra/clang-tidy/abseil/StringFindStartswithCheck.cpp:114
msgctxt "abseil-string-find-startswith"
msgid "use absl::StartsWith instead of find() != 0"
msgstr "使用 absl::StartsWith 代替 find() != 0"

#: clang-tools-extra/clang-tidy/abseil/StringFindStartswithCheck.cpp:114
msgctxt "abseil-string-find-startswith"
msgid "use absl::StartsWith instead of find() == 0"
msgstr "使用 absl::StartsWith 代替 find() == 0"

#: clang-tools-extra/clang-tidy/abseil/StringFindStartswithCheck.cpp:114
msgctxt "abseil-string-find-startswith"
msgid "use absl::StartsWith instead of rfind() != 0"
msgstr "使用 absl::StartsWith 代替 rfind() != 0"

#: clang-tools-extra/clang-tidy/abseil/StringFindStartswithCheck.cpp:114
msgctxt "abseil-string-find-startswith"
msgid "use absl::StartsWith instead of rfind() == 0"
msgstr "使用 absl::StartsWith 代替 rfind() == 0"

#: clang-tools-extra/clang-tidy/abseil/StringFindStrContainsCheck.cpp:65
msgctxt "abseil-string-find-str-contains"
msgid "use !absl::StrContains instead of find() == npos"
msgstr "用 !absl::StrContains 替代 find() == npos"

#: clang-tools-extra/clang-tidy/abseil/StringFindStrContainsCheck.cpp:73
msgctxt "abseil-string-find-str-contains"
msgid "use absl::StrContains instead of find() != npos"
msgstr "用 absl::StrContains 替代 find() != npos"

#: clang-tools-extra/clang-tidy/abseil/TimeComparisonCheck.cpp:47
msgctxt "abseil-time-comparison"
msgid "perform comparison in the time domain"
msgstr "请在时间域中执行比较"

#: clang-tools-extra/clang-tidy/abseil/TimeSubtractionCheck.cpp:89
msgctxt "abseil-time-subtraction"
msgid "perform subtraction in the time domain"
msgstr "请在时间域中执行减法"

#: clang-tools-extra/clang-tidy/abseil/UncheckedStatusOrAccessCheck.cpp:56
msgctxt "abseil-unchecked-statusor-access"
msgid "unchecked access to 'absl::StatusOr' value"
msgstr "未经检查地访问 'absl::StatusOr' 的值"

#: clang-tools-extra/clang-tidy/abseil/UpgradeDurationConversionsCheck.cpp:135
msgctxt "abseil-upgrade-duration-conversions"
msgid "implicit conversion to 'int64_t' is deprecated in this context; use an explicit cast instead"
msgstr "在此上下文中向 'int64_t' 的隐式转换已弃用；请改用显式类型转换"

#: clang-tools-extra/clang-tidy/altera/IdDependentBackwardBranchCheck.cpp:260
msgctxt "altera-id-dependent-backward-branch"
msgid "backward branch (do loop) is ID-dependent due to ID function call and may cause performance degradation"
msgstr "向后分支（do 循环）由于调用 ID 函数而依赖 ID，可能导致性能下降"

#: clang-tools-extra/clang-tidy/altera/IdDependentBackwardBranchCheck.cpp:276
msgctxt "altera-id-dependent-backward-branch"
msgid "backward branch (do loop) is ID-dependent due to member reference to %1 and may cause performance degradation"
msgstr "向后分支（do 循环）由于对 %1 的成员引用而依赖 ID，可能导致性能下降"

#: clang-tools-extra/clang-tidy/altera/IdDependentBackwardBranchCheck.cpp:270
msgctxt "altera-id-dependent-backward-branch"
msgid "backward branch (do loop) is ID-dependent due to variable reference to %1 and may cause performance degradation"
msgstr "向后分支（do 循环）由于对 %1 的变量引用而依赖 ID，可能导致性能下降"

#: clang-tools-extra/clang-tidy/altera/IdDependentBackwardBranchCheck.cpp:260
msgctxt "altera-id-dependent-backward-branch"
msgid "backward branch (for loop) is ID-dependent due to ID function call and may cause performance degradation"
msgstr "向后分支（for 循环）由于调用 ID 函数而依赖 ID，可能导致性能下降"

#: clang-tools-extra/clang-tidy/altera/IdDependentBackwardBranchCheck.cpp:276
