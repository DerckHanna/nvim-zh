msgctxt "diagnostic"
msgid "Missing ')' in macro parameter list"
msgstr "宏形参列表中缺少 ')'"

msgctxt "diagnostic"
msgid "Multiple default labels in one switch"
msgstr "同一个 switch 中有多个 default 标签"

