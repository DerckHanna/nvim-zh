msgstr "'#endif' 缺少对应的 '#if'"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:564
msgctxt "diagnostic"
msgid "'%0' file not found"
msgstr "找不到文件 '%0'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11275
msgctxt "diagnostic"
msgid "'break' statement not in loop or switch statement"
msgstr "'break' 语句在循环和 switch 语句之外"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11291
msgctxt "diagnostic"
msgid "'case' statement not in switch statement"
msgstr "'case' 语句在 switch 语句之外"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11273
msgctxt "diagnostic"
msgid "'continue' statement not in loop statement"
msgstr "'continue' 语句在循环之外"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11289
msgctxt "diagnostic"
msgid "'default' statement not in switch statement"
msgstr "'default' 语句在 switch 语句之外"

msgctxt "diagnostic"
msgid "'{file}' file not found"
msgstr "找不到文件 '{file}'"

msgctxt "diagnostic"
msgid "'{file}' file not found, did you mean '{suggestion}'?"
msgstr "找不到文件 '{file}'，是否想使用 '{suggestion}'？"

msgctxt "diagnostic"
msgid "'{name}' macro redefined"
msgstr "宏 '{name}' 被重复定义"

msgctxt "diagnostic"
msgid "A non-const lvalue reference to type {type} cannot bind to a temporary of type {from}"
msgstr "指向 {type} 的非 const 左值引用不能绑定到 {from} 类型的临时对象"

#: clang/include/clang/Basic/DiagnosticFrontendKinds.td:330
msgctxt "diagnostic"
msgid "AVX vector argument of type %1 without '%2' enabled changes the ABI"
msgstr "未启用 '%2' 时传递 %1 类型的 AVX 向量实参会改变 ABI"

#: clang/include/clang/Basic/DiagnosticFrontendKinds.td:330
msgctxt "diagnostic"
msgid "AVX vector argument of type {type} without '{target}' enabled changes the ABI"
msgstr "未启用 '{target}' 时传递 {type} 类型的 AVX 向量实参会改变 ABI"

#: clang/include/clang/Basic/DiagnosticFrontendKinds.td:330
msgctxt "diagnostic"
msgid "AVX vector return of type %1 without '%2' enabled changes the ABI"
msgstr "未启用 '%2' 时返回 %1 类型的 AVX 向量会改变 ABI"

#: clang/include/clang/Basic/DiagnosticFrontendKinds.td:330
msgctxt "diagnostic"
msgid "AVX vector return of type {type} without '{target}' enabled changes the ABI"
msgstr "未启用 '{target}' 时返回 {type} 类型的 AVX 向量会改变 ABI"

msgctxt "diagnostic"
msgid "Address of stack memory associated with local variable {name} returned"
msgstr "返回了局部变量 {name} 所在栈内存的地址"

msgctxt "diagnostic"
msgid "Array has incomplete element type {type}"
msgstr "数组元素的类型 {type} 是不完整类型"

msgctxt "diagnostic"
msgid "Array index {index} is past the end of the array (that has type {type})"
msgstr "下标 {index} 超出了 {type} 类型数组的末尾"

