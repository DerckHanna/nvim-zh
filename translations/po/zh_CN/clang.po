msgid "Implicit conversion from {from} to {to} is not allowed in C++11"
msgstr "从 {from} 到 {to} 的隐式转换在 C++11 中不允许"

msgctxt "diagnostic"
msgid "Implicit conversion loses integer precision: {from} to {to}"
msgstr "从 {from} 到 {to} 的隐式转换会损失整数精度"

msgctxt "diagnostic"
msgid "Implicit instantiation of undefined template {name}"
msgstr "隐式实例化了未定义的模板 {name}"

msgctxt "diagnostic"
msgid "In instantiation of function template specialization {name} requested here"
msgstr "这里请求实例化函数模板特化 {name}"

msgctxt "diagnostic"
msgid "In instantiation of member function {name} requested here"
msgstr "这里请求实例化成员函数 {name}"

msgctxt "diagnostic"
msgid "In instantiation of template class {name} requested here"
msgstr "这里请求实例化类模板 {name}"

msgctxt "diagnostic"
msgid "In instantiation of template type alias {name} requested here"
msgstr "这里请求实例化模板类型别名 {name}"

msgctxt "diagnostic"
msgid "Incompatible operand types ({left} and {right})"
msgstr "操作数类型不兼容（{left} 和 {right}）"

msgctxt "diagnostic"
msgid "Incomplete definition of type {type}"
msgstr "类型 {type} 的定义不完整"

msgctxt "diagnostic"
msgid "Indirection requires pointer operand ({type} invalid)"
msgstr "间接访问需要指针操作数（{type} 无效）"

msgctxt "diagnostic"
msgid "Initialization of incomplete type {type}"
msgstr "初始化了不完整类型 {type}"

msgctxt "diagnostic"
msgid "Initializer element is not a compile-time constant"
msgstr "初始化器的元素不是编译期常量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6864
msgctxt "diagnostic"
msgid "Insert an explicit cast to silence this issue"
msgstr "插入显式类型转换以消除这条诊断"

msgctxt "diagnostic"
msgid "Invalid application of 'sizeof' to an incomplete type {type}"
msgstr "无法对不完整类型 {type} 使用 'sizeof'"

