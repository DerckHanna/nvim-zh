msgctxt "diagnostic"
msgid "Cannot initialize return object of type {type} with an rvalue of type {from}"
msgstr "不能用 {from} 类型的右值初始化 {type} 类型的返回对象"

msgctxt "diagnostic"
msgid "Cannot jump from switch statement to this case label"
msgstr "无法从 switch 语句跳转到这个 case 标签"

