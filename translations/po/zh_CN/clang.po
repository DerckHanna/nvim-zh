msgctxt "clangd_legacy"
msgid "No matching function for call to {name}"
msgstr "找不到与调用匹配的函数 {name}"

msgctxt "clangd_legacy"
msgid "Variable has incomplete type {type}"
msgstr "变量的类型 {type} 是不完整类型"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:618
msgctxt "diagnostic"
msgid "#elif without #if"
msgstr "#elif 缺少对应的 #if"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:617
msgctxt "diagnostic"
msgid "#else without #if"
msgstr "#else 缺少对应的 #if"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:620
msgctxt "diagnostic"
msgid "#endif without #if"
msgstr "#endif 缺少对应的 #if"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:595
msgctxt "diagnostic"
msgid "#include nested too deeply"
msgstr "#include 嵌套过深"

msgctxt "diagnostic"
msgid "#include {0}"
msgstr "#include {0}"

