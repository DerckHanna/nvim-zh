msgctxt "diagnostic"
msgid "Cannot deduce return type from initializer list"
msgstr "无法从初始化列表推导返回类型"

msgctxt "diagnostic"
msgid "Cannot initialize a parameter of type {type} with an lvalue of type {from}"
msgstr "不能用 {from} 类型的左值初始化 {type} 类型的形参"

msgctxt "diagnostic"
msgid "Cannot initialize a parameter of type {type} with an rvalue of type {from}"
msgstr "不能用 {from} 类型的右值初始化 {type} 类型的形参"

msgctxt "diagnostic"
msgid "Cannot initialize a variable of type {type} with an lvalue of type {from}"
msgstr "不能用 {from} 类型的左值初始化 {type} 类型的变量"

msgctxt "diagnostic"
msgid "Cannot initialize a variable of type {type} with an rvalue of type {from}"
msgstr "不能用 {from} 类型的右值初始化 {type} 类型的变量"

