msgid "Invalid operands to binary expression ({left} and {right})"
msgstr "二元表达式的操作数类型无效（{left} 和 {right}）"

msgctxt "diagnostic"
msgid "Invalid preprocessing directive, did you mean '{name}'?"
msgstr "无效的预处理指令，是否想使用 '{name}'？"

msgctxt "diagnostic"
msgid "Jump bypasses variable initialization"
msgstr "跳转绕过了变量的初始化"

msgctxt "diagnostic"
msgid "Jump bypasses variable with a non-trivial destructor"
msgstr "跳转绕过了具有非平凡析构函数的变量"

