msgid "Array type {type} is not assignable"
msgstr "数组类型 {type} 不可赋值"

msgctxt "diagnostic"
msgid "Attempt to use a deleted function"
msgstr "尝试使用已删除的函数"

msgctxt "diagnostic"
msgid "Call to deleted function {name}"
msgstr "调用了已删除的函数 {name}"

msgctxt "diagnostic"
msgid "Call to implicitly-deleted copy constructor of {type}"
msgstr "调用了 {type} 已隐式删除的复制构造函数"

msgctxt "diagnostic"
msgid "Call to implicitly-deleted default constructor of {type}"
msgstr "调用了 {type} 已隐式删除的默认构造函数"

msgctxt "diagnostic"
msgid "Call to implicitly-deleted move constructor of {type}"
msgstr "调用了 {type} 已隐式删除的移动构造函数"

msgctxt "diagnostic"
msgid "Called object type {type} is not a function or function pointer"
msgstr "被调用对象的类型 {type} 不是函数或函数指针"

msgctxt "diagnostic"
msgid "Candidate constructor (the implicit copy constructor) not viable: requires 1 argument, but {provided} were provided"
msgstr "候选隐式拷贝构造函数不可用：需要 1 个实参，但提供了 {provided} 个"

msgctxt "diagnostic"
msgid "Candidate constructor (the implicit move constructor) not viable: requires 1 argument, but {provided} were provided"
msgstr "候选隐式移动构造函数不可用：需要 1 个实参，但提供了 {provided} 个"

msgctxt "diagnostic"
msgid "Candidate constructor not viable: requires 1 argument, but {provided} were provided"
msgstr "候选构造函数不可用：需要 1 个实参，但提供了 {provided} 个"

msgctxt "diagnostic"
msgid "Candidate function has been explicitly deleted"
msgstr "候选函数已被显式删除"

msgctxt "diagnostic"
msgid "Candidate function not viable: no known conversion from {from} to {to} for {argument} argument"
msgstr "候选函数不可用：第 {argument} 个实参无法从 {from} 转换为 {to}"

msgctxt "diagnostic"
msgid "Candidate function not viable: requires %d arguments, but %d was provided"
msgstr "候选函数不可用：需要 %d 个实参，但提供了 %d 个"

msgctxt "diagnostic"
msgid "Candidate function not viable: requires %d arguments, but %d were provided"
msgstr "候选函数不可用：需要 %d 个实参，但提供了 %d 个"

msgctxt "diagnostic"
msgid "Candidate function not viable: requires %d arguments, but no arguments were provided"
msgstr "候选函数不可用：需要 %d 个实参，但未提供实参"

msgctxt "diagnostic"
msgid "Candidate function not viable: requires single argument %s, but %d arguments were provided"
msgstr "候选函数不可用：需要一个实参 %s，但提供了 %d 个"

msgctxt "diagnostic"
msgid "Candidate function not viable: requires single argument {argument}, but no arguments were provided"
msgstr "候选函数不可用：需要一个实参 {argument}，但未提供实参"

msgctxt "diagnostic"
msgid "Candidate template ignored: constraints not satisfied [with {args}]"
msgstr "已忽略候选模板：不满足约束 [with {args}]"

msgctxt "diagnostic"
msgid "Candidate template ignored: could not match {expected} against {actual}"
msgstr "已忽略候选模板：{expected} 无法与 {actual} 匹配"

msgctxt "diagnostic"
msgid "Cannot assign to non-static data member within const member function {name}"
