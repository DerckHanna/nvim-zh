msgstr "预期用于 Objective-C getter 的选择器"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:358
msgctxt "diagnostic"
msgid "Expected selector for Objective-C method"
msgstr "期望 Objective-C 方法的选择器"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:575
msgctxt "diagnostic"
msgid "Expected selector for Objective-C setter"
msgstr "预期用于 Objective-C setter 的选择器"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:273
msgctxt "diagnostic"
msgid "Expected statement"
msgstr "此处需要语句"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1525
msgctxt "diagnostic"
msgid "Expected string in 'clause %0' - ignoring"
