msgstr "在 M-profile 架构上，缺少 %1 的目标不支持 %0 属性；请指定合适的 -march= 或 -mcpu="

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12467
msgctxt "diagnostic"
