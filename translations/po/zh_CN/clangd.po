#: clang/include/clang/Basic/DiagnosticSemaKinds.td:273
msgctxt "diagnostic"
msgid "Designator in initializer for indivisible sizeless type %1"
msgstr "用于不可分割的无大小类型 %1 初始化的指定初始化器"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:273
msgctxt "diagnostic"
