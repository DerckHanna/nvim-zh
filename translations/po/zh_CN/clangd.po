msgstr "期望为 'for'、'parallel'、'sections' 或 'taskgroup' 之一"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:939
msgctxt "diagnostic"
msgid "Only '*' can be exported from an inferred submodule"
msgstr "只能从推断的子模块中导出 '*'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1601
msgctxt "diagnostic"
msgid "Only 'device_type(any)' clause is allowed with indirect clause"
msgstr "与 indirect 子句一起只允许使用 'device_type(any)' 子句"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12474
msgctxt "diagnostic"
msgid "Only 'omp_in' or 'omp_out' variables are allowed in combiner expression"
msgstr "只允许在表达式中使用 'omp_in' 或 'omp_out' 变量（用于组合器）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12474
msgctxt "diagnostic"
msgid "Only 'omp_in' or 'omp_out' variables are allowed in initializer expression"
msgstr "只允许在表达式中使用 'omp_in' 或 'omp_out' 变量（用于初始化器）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12474
msgctxt "diagnostic"
msgid "Only 'omp_priv' or 'omp_orig' variables are allowed in combiner expression"
msgstr "只允许在表达式中使用 'omp_priv' 或 'omp_orig' 变量（用于组合器）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12474
msgctxt "diagnostic"
msgid "Only 'omp_priv' or 'omp_orig' variables are allowed in initializer expression"
msgstr "只允许在表达式中使用 'omp_priv' 或 'omp_orig' 变量（用于初始化器）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4276
msgctxt "diagnostic"
msgid "Only 'unavailable' and 'deprecated' are supported for Swift availability"
msgstr "Swift 可用性仅支持 'unavailable' 和 'deprecated'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1700
msgctxt "diagnostic"
msgid "Only a single match extension allowed per OpenMP context selector"
msgstr "每个 OpenMP 上下文选择器只允许一个匹配扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10207
msgctxt "diagnostic"
msgid "Only constructors take base initializers"
msgstr "只有构造函数才能使用基类初始化器"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2929
msgctxt "diagnostic"
msgid "Only enumeration types have underlying types"
msgstr "只有枚举类型才具有底层类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6305
msgctxt "diagnostic"
msgid "Only function and template parameters can be parameter packs"
msgstr "只有函数形参和模板形参才能是形参包"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:102
msgctxt "diagnostic"
msgid "Only functions can have deleted definitions"
msgstr "只有函数才能有弃置定义"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12790
msgctxt "diagnostic"
msgid "Only loop iteration variables are allowed in 'lastprivate' clause in 'omp %0' directives"
msgstr "'omp %0' 指令的 'lastprivate' 子句中只允许使用循环迭代变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12623
msgctxt "diagnostic"
msgid "Only loop iteration variables are allowed in 'linear' clause in distribute directives"
msgstr "distribute 指令中的 'linear' 子句只允许使用循环迭代变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12628
msgctxt "diagnostic"
msgid "Only one %0 clause can appear on a requires directive in a single translation unit"
msgstr "在单个翻译单元中的一条 requires 指令上只能出现一个 %0 子句"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1711
msgctxt "diagnostic"
msgid "Only one 'fr' selector allowed per preference-specification"
msgstr "每个 preference-specification 仅允许一个 'fr' 选择器"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11636
msgctxt "diagnostic"
msgid "Only one element declaration is allowed"
msgstr "只允许有一个元素声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12835
msgctxt "diagnostic"
msgid "Only one expression allowed in '%0' clause"
msgstr "'%0' 子句中只允许一个表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1105
msgctxt "diagnostic"
msgid "Only one parameter on 'main' declaration"
msgstr "'main' 声明上只有一个形参"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:99
msgctxt "diagnostic"
msgid "Only special member functions and comparison operators may be defaulted"
msgstr "只有特殊成员函数和比较运算符可以显式默认（defaulted）"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:99
msgctxt "diagnostic"
msgid "Only special member functions may be defaulted"
msgstr "只有特殊成员函数可以显式默认（defaulted）"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:923
msgctxt "diagnostic"
msgid "Only submodules and framework modules may be inferred with wildcard syntax"
msgstr "只有子模块和框架模块可以使用通配符语法进行推断"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8636
msgctxt "diagnostic"
msgid "Only the first dimension of an allocated array may have dynamic size"
msgstr "分配的数组只有第一维可以具有动态大小"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:974
msgctxt "diagnostic"
msgid "Only top-level modules can be re-exported as public"
msgstr "只有顶层模块才能作为 public 重新导出"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12478
msgctxt "diagnostic"
msgid "Only variable %0 is allowed in map clauses of this 'omp declare mapper' directive"
msgstr "此 'omp declare mapper' 指令的 map 子句中仅允许使用变量 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1239
msgctxt "diagnostic"
msgid "Only variables can be arguments to '#pragma unused'"
msgstr "只有变量才能作为 '#pragma unused' 的实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2870
msgctxt "diagnostic"
msgid "Only virtual member functions can be marked '%0'"
msgstr "只有虚成员函数才能标记为 '%0'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13942
msgctxt "diagnostic"
msgid "Only zero-length WebAssembly tables are currently supported"
msgstr "目前仅支持零长度的 WebAssembly 表"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14083
msgctxt "diagnostic"
msgid "OpenACC '%0' clause applies to 'device_type' '%1', which conflicts with previous '%2' clause"
msgstr "OpenACC '%0' 子句应用于 'device_type' '%1'，与之前的 '%2' 子句冲突"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14162
msgctxt "diagnostic"
msgid "OpenACC '%0' clause cannot appear on the same '%2' construct as a '%1' clause and a 'num_gangs' clause with more than one argument"
msgstr "OpenACC '%0' 子句不能与 '%1' 子句以及包含多个实参的 'num_gangs' 子句同时出现在同一个 '%2' 构造上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14162
msgctxt "diagnostic"
msgid "OpenACC '%0' clause cannot appear on the same '%2' construct as a '%1' clause inside a compute construct with a 'num_gangs' clause with more than one argument"
msgstr "OpenACC '%0' 子句不能与 '%1' 子句在带有包含多个实参的 'num_gangs' 子句的计算构造内同时出现在同一个 '%2' 构造上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14233
msgctxt "diagnostic"
msgid "OpenACC '%0' clause on a 'declare' directive is not allowed at global or namespace scope"
msgstr "不允许在全局作用域或命名空间作用域的 'declare' 指令上使用 OpenACC '%0' 子句"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14113
msgctxt "diagnostic"
msgid "OpenACC '%0' construct can only be applied to a 'for' loop"
msgstr "OpenACC '%0' 构造只能应用于 'for' 循环"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14178
msgctxt "diagnostic"
msgid "OpenACC '%0' construct must have a terminating condition"
msgstr "OpenACC '%0' 构造必须具有终止条件"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14183
msgctxt "diagnostic"
msgid "OpenACC '%0' construct must have at least one %1 clause"
msgstr "OpenACC '%0' 构造必须至少包含一个 %1 子句"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14175
msgctxt "diagnostic"
msgid "OpenACC '%0' construct must have initialization clause in canonical form ('var = init' or 'T var = init')"
msgstr "OpenACC '%0' 构造的初始化子句必须采用规范形式（'var = init' 或 'T var = init'）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14268
msgctxt "diagnostic"
msgid "OpenACC '%0' modifier not valid on '%1' clause"
msgstr "OpenACC '%0' 修饰符在 '%1' 子句上无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14180
msgctxt "diagnostic"
msgid "OpenACC '%0' variable must monotonically increase or decrease ('++', '--', or compound assignment)"
msgstr "OpenACC '%0' 变量必须单调递增或递减（'++'、'--' 或复合赋值）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13987
msgctxt "diagnostic"
msgid "OpenACC '%1' clause cannot appear more than once on a '%0' directive"
msgstr "OpenACC '%1' 子句不能在 '%0' 指令上出现多次"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13985
msgctxt "diagnostic"
msgid "OpenACC '%1' clause is not valid on '%0' directive"
msgstr "OpenACC '%1' 子句在 '%0' 指令上无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14090
msgctxt "diagnostic"
msgid "OpenACC '%1' clause may not appear on a '%2' construct with a '%3' clause"
msgstr "OpenACC '%1' 子句不能出现在带有 '%3' 子句的 '%2' 构造上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14090
msgctxt "diagnostic"
msgid "OpenACC '%1' clause may not appear on a '%2' construct with a '%3' clause with more than 1 argument"
msgstr "OpenACC '%1' 子句不能出现在带有包含超过 1 个实参的 '%3' 子句的 '%2' 构造上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14090
msgctxt "diagnostic"
msgid "OpenACC '%1' clause with more than 1 argument may not appear on a '%2' construct with a '%3' clause"
msgstr "带有超过 1 个实参的 OpenACC '%1' 子句不能出现在带有 '%3' 子句的 '%2' 构造上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14090
msgctxt "diagnostic"
msgid "OpenACC '%1' clause with more than 1 argument may not appear on a '%2' construct with a '%3' clause with more than 1 argument"
msgstr "带有超过 1 个实参的 OpenACC '%1' 子句不能出现在带有包含超过 1 个实参的 '%3' 子句的 '%2' 构造上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14123
msgctxt "diagnostic"
msgid "OpenACC '%3' construct cannot appear in intervening code of a '%1' with a '%2' clause"
msgstr "OpenACC '%3' 构造不能出现在带有 '%2' 子句的 '%1' 的中间代码中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14258
msgctxt "diagnostic"
msgid "OpenACC 'bind' clause on a declaration must bind to the same name as previous 'bind' clauses"
msgstr "声明上的 OpenACC 'bind' 子句必须绑定到与先前 'bind' 子句相同的名称"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14116
msgctxt "diagnostic"
msgid "OpenACC 'collapse' clause loop count must be a constant expression"
msgstr "OpenACC 'collapse' 子句的循环计数必须为常量表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14116
msgctxt "diagnostic"
msgid "OpenACC 'collapse' clause loop count must be a positive integer value, evaluated to %1"
msgstr "OpenACC 'collapse' 子句的循环计数必须为正整数值，实际求值为 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14272
msgctxt "diagnostic"
msgid "OpenACC 'device_type' clause on a '%0' construct only permits one architecture"
msgstr "'%0' 构造上的 OpenACC 'device_type' 子句仅允许一个架构"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14137
msgctxt "diagnostic"
msgid "OpenACC 'gang' clause may have at most one 'dim' argument"
msgstr "OpenACC 'gang' 子句最多只能有一个'dim' 实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14137
msgctxt "diagnostic"
msgid "OpenACC 'gang' clause may have at most one 'static' argument"
msgstr "OpenACC 'gang' 子句最多只能有一个'static' 实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14137
msgctxt "diagnostic"
msgid "OpenACC 'gang' clause may have at most one unnamed or 'num' argument"
msgstr "OpenACC 'gang' 子句最多只能有一个未命名或 'num' 实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14157
msgctxt "diagnostic"
msgid "OpenACC 'gang' clause with a 'dim' value greater than 1 cannot appear on the same '%1' construct as a 'gang' clause with a 'dim' value greater than 1"
msgstr "带有大于 1 的 'dim' 值的 OpenACC 'gang' 子句不能与带有大于 1 的 'dim' 值的 'gang' 子句出现在同一个 '%1' 构造上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14157
msgctxt "diagnostic"
msgid "OpenACC 'gang' clause with a 'dim' value greater than 1 cannot appear on the same '%1' construct as a 'reduction' clause"
msgstr "带有大于 1 的 'dim' 值的 OpenACC 'gang' 子句不能与'reduction' 子句出现在同一个 '%1' 构造上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14157
msgctxt "diagnostic"
msgid "OpenACC 'reduction' clause cannot appear on the same '%1' construct as a 'gang' clause with a 'dim' value greater than 1"
msgstr "OpenACC 'reduction' 子句不能与带有大于 1 的 'dim' 值的 'gang' 子句出现在同一个 '%1' 构造上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14157
msgctxt "diagnostic"
msgid "OpenACC 'reduction' clause cannot appear on the same '%1' construct as a 'reduction' clause"
msgstr "OpenACC 'reduction' 子句不能与'reduction' 子句出现在同一个 '%1' 构造上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14167
msgctxt "diagnostic"
msgid "OpenACC 'reduction' variable must have the same operator in all nested constructs (%0 vs %1)"
msgstr "OpenACC 'reduction' 变量在所有嵌套构造中必须具有相同的运算符（%0 与 %1）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14086
msgctxt "diagnostic"
msgid "OpenACC 'routine' construct must have at least one 'gang', 'seq', 'vector', or 'worker' clause that applies to each 'device_type'"
msgstr "OpenACC 'routine' 构造必须至少有一个适用于每个 'device_type' 的 'gang'、'seq'、'vector' 或 'worker' 子句"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14261
msgctxt "diagnostic"
msgid "OpenACC 'routine' directive with a name refers to a function with the same name as the function on the following line; this may be unintended"
msgstr "带名称的 OpenACC 'routine' 指令引用了与下一行函数同名的函数；这可能并非本意"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14119
msgctxt "diagnostic"
msgid "OpenACC 'tile' clause size expression must be an asterisk or a constant expression"
msgstr "OpenACC 'tile' 子句的大小表达式必须是星号或常量表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14119
msgctxt "diagnostic"
msgid "OpenACC 'tile' clause size expression must be positive integer value, evaluated to %1"
msgstr "OpenACC 'tile' 子句的大小表达式必须是正整数值，求值结果为 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14185
msgctxt "diagnostic"
msgid "OpenACC 'update' construct may not appear in place of the statement following a do statement"
msgstr "OpenACC 'update' 构造不能出现在紧跟 do 语句的语句位置上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14185
msgctxt "diagnostic"
msgid "OpenACC 'update' construct may not appear in place of the statement following a label statement"
msgstr "OpenACC 'update' 构造不能出现在紧跟标签语句的语句位置上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14185
msgctxt "diagnostic"
msgid "OpenACC 'update' construct may not appear in place of the statement following a switch statement"
msgstr "OpenACC 'update' 构造不能出现在紧跟 switch 语句的语句位置上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14185
msgctxt "diagnostic"
msgid "OpenACC 'update' construct may not appear in place of the statement following a while statement"
msgstr "OpenACC 'update' 构造不能出现在紧跟 while 语句的语句位置上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14185
msgctxt "diagnostic"
msgid "OpenACC 'update' construct may not appear in place of the statement following an if statement"
msgstr "OpenACC 'update' 构造不能出现在紧跟 if 语句的语句位置上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14073
msgctxt "diagnostic"
msgid "OpenACC clause '%0' may not appear on the same construct as a '%1' clause on a '%2' construct"
msgstr "在 '%2' 构造上，OpenACC 子句 '%0' 不能与 '%1' 子句出现在同一构造上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14070
msgctxt "diagnostic"
msgid "OpenACC clause '%0' may not follow a '%1' clause in a '%2' construct"
msgstr "在 '%2' 构造中，OpenACC 子句 '%0' 不能跟在 '%1' 子句之后"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14076
msgctxt "diagnostic"
msgid "OpenACC clause '%1' after 'device_type' clause on a '%0' construct conflicts with the '%2' clause before the first 'device_type'"
msgstr "OpenACC '%0' 构造中 'device_type' 子句之后的 '%1' 子句与第一个 'device_type' 之前的 '%2' 子句冲突"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14080
msgctxt "diagnostic"
msgid "OpenACC clause '%1' cannot combine with previous '%2' clause in the same 'device_type' region on a '%0' directive"
msgstr "在 '%0' 指令上的同一 'device_type' 区域中，OpenACC 子句 '%1' 不能与先前的 '%2' 子句组合使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14080
msgctxt "diagnostic"
msgid "OpenACC clause '%1' cannot combine with previous '%2' clause on a '%0' directive"
msgstr "在 '%0' 指令上，OpenACC 子句 '%1' 不能与先前的 '%2' 子句组合使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14007
msgctxt "diagnostic"
msgid "OpenACC clause '%1' requires expression of integer type (%3 invalid)"
msgstr "OpenACC 子句 '%1'需要整数类型的表达式（%3 无效）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14063
msgctxt "diagnostic"
msgid "OpenACC clause name '%0' is a deprecated clause name and is now an alias for '%1'"
msgstr "OpenACC 子句名 '%0' 是已弃用的子句名，现为 '%1' 的别名"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13982
msgctxt "diagnostic"
msgid "OpenACC construct '%0' cannot be used here; it can only be used in a statement context"
msgstr "此处不能使用 OpenACC 构造 '%0'；它只能用于语句上下文中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13978
msgctxt "diagnostic"
msgid "OpenACC construct 'routine' with implicit function not yet implemented, pragma ignored"
msgstr "带有隐式函数的 OpenACC 构造 'routine' 尚未实现，已忽略 pragma"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14003
msgctxt "diagnostic"
msgid "OpenACC construct 'self' has no effect when an 'if' clause evaluates to true"
msgstr "当 'if' 子句求值为 true 时，OpenACC 构造 'self' 无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14007
msgctxt "diagnostic"
msgid "OpenACC directive '%2' requires expression of integer type (%3 invalid)"
msgstr "OpenACC 指令 '%2'需要整数类型的表达式（%3 无效）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14010
msgctxt "diagnostic"
msgid "OpenACC integer expression has incomplete class type %0"
msgstr "OpenACC 整数表达式具有不完整的类类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14012
msgctxt "diagnostic"
msgid "OpenACC integer expression requires explicit conversion from %0 to %1"
msgstr "OpenACC 整数表达式需要从 %0 到 %1 的显式转换"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14248
msgctxt "diagnostic"
msgid "OpenACC routine name %0 does not name a function"
msgstr "OpenACC 例程名 %0 未指定函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14250
msgctxt "diagnostic"
msgid "OpenACC routine name %0 names a set of overloads"
msgstr "OpenACC 例程名 %0 指向一组重载函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14047
msgctxt "diagnostic"
msgid "OpenACC sub-array base is of incomplete type %0"
msgstr "OpenACC 子数组基址具有不完整类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14007
msgctxt "diagnostic"
msgid "OpenACC sub-array bound requires expression of integer type (%3 invalid)"
msgstr "OpenACC 子数组边界需要整数类型的表达式（%3 无效）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14045
msgctxt "diagnostic"
msgid "OpenACC sub-array cannot be of function type %0"
msgstr "OpenACC 子数组不能为函数类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12484
msgctxt "diagnostic"
msgid "OpenACC sub-array is not allowed here"
msgstr "此处不允许使用 OpenACC 子数组"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14056
msgctxt "diagnostic"
msgid "OpenACC sub-array length evaluated to a value (%1) that would be out of the range of the subscripted array size of %2"
msgstr "OpenACC 子数组长度的求值结果（%1）超出被下标访问数组大小 %2 的范围"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14053
msgctxt "diagnostic"
msgid "OpenACC sub-array length evaluated to negative value %1"
msgstr "OpenACC 子数组长度求值为负数 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14049
msgctxt "diagnostic"
msgid "OpenACC sub-array length is unspecified and cannot be inferred because the subscripted value is an array of unknown bound"
msgstr "OpenACC 子数组长度未指定且无法推断，因为带下标的值是未知边界的数组"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14049
msgctxt "diagnostic"
msgid "OpenACC sub-array length is unspecified and cannot be inferred because the subscripted value is not an array"
msgstr "OpenACC 子数组长度未指定且无法推断，因为带下标的值不是数组"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14056
msgctxt "diagnostic"
msgid "OpenACC sub-array lower bound evaluated to a value (%1) that would be out of the range of the subscripted array size of %2"
msgstr "OpenACC 子数组下界的求值结果（%1）超出被下标访问数组大小 %2 的范围"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14053
msgctxt "diagnostic"
msgid "OpenACC sub-array lower bound evaluated to negative value %1"
msgstr "OpenACC 子数组下界求值为负数 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14060
msgctxt "diagnostic"
msgid "OpenACC sub-array specified range [%0:%1] would be out of the range of the subscripted array size of %2"
msgstr "OpenACC 子数组指定的范围 [%0:%1] 超出了被下标索引的数组大小 %2 的范围"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14043
msgctxt "diagnostic"
msgid "OpenACC sub-array subscripted value is not an array or pointer"
msgstr "OpenACC 子数组下标操作的值不是数组或指针"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14036
msgctxt "diagnostic"
msgid "OpenACC variable in 'cache' directive is not a valid sub-array or array element"
msgstr "'cache' 指令中的 OpenACC 变量不是有效的子数组或数组元素"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14039
msgctxt "diagnostic"
msgid "OpenACC variable in 'cache' directive was not declared outside of the associated 'loop' directive; directive has no effect"
msgstr "'cache' 指令中的 OpenACC 变量未在关联的 'loop' 指令外部声明；该指令无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14028
msgctxt "diagnostic"
msgid "OpenACC variable in 'use_device' clause is not a valid variable name or array name"
msgstr "'use_device' 子句中的 OpenACC 变量不是有效的变量名或数组名"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14024
msgctxt "diagnostic"
msgid "OpenACC variable is not a valid variable name, sub-array, array element, member of a composite variable, or composite variable member"
msgstr "OpenACC 变量不是有效的变量名、子数组、数组元素、复合变量的成员或复合变量成员"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14024
msgctxt "diagnostic"
msgid "OpenACC variable is not a valid variable name, sub-array, array element, or composite variable member"
msgstr "OpenACC 变量不是有效的变量名、子数组、数组元素或复合变量成员"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14028
msgctxt "diagnostic"
msgid "OpenACC variable on 'declare' construct is not a valid variable name or array name"
msgstr "'declare' 构造上的 OpenACC 变量不是有效的变量名或数组名"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1457
msgctxt "diagnostic"
msgid "OpenCL extension %0 is core feature or supported optional core feature - ignoring"
msgstr "OpenCL 扩展 %0 是核心特性或受支持的可选核心特性 - 已忽略"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1453
msgctxt "diagnostic"
msgid "OpenCL extension %0 unknown or does not require pragma - ignoring"
msgstr "OpenCL 扩展 %0 未知或不需要 pragma——已忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12484
msgctxt "diagnostic"
msgid "OpenMP array section is not allowed here"
msgstr "此处不允许使用 OpenMP 数组切片"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12485
msgctxt "diagnostic"
msgid "OpenMP array shaping operation is not allowed here"
msgstr "此处不允许使用 OpenMP 数组塑形操作"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4109
msgctxt "diagnostic"
msgid "OpenMP captured regions are not yet supported in functions with ZA state"
msgstr "OpenMP 捕获区域尚不支持在具有 ZA 状态的函数中使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4109
msgctxt "diagnostic"
msgid "OpenMP captured regions are not yet supported in functions with ZT0 state"
msgstr "OpenMP 捕获区域尚不支持在具有 ZT0 状态的函数中使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4109
msgctxt "diagnostic"
msgid "OpenMP captured regions are not yet supported in streaming functions"
msgstr "OpenMP 捕获区域尚不支持在流式函数中使用"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1529
msgctxt "diagnostic"
msgid "OpenMP clause '%0' is only available as extension, use '-fopenmp-extensions'"
msgstr "OpenMP 子句 '%0' 仅作为扩展提供，请使用 '-fopenmp-extensions'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12373
msgctxt "diagnostic"
msgid "OpenMP constructs may not be nested inside a simd region"
msgstr "OpenMP 构造不能嵌套在 simd 区域内部"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12373
msgctxt "diagnostic"
msgid "OpenMP constructs may not be nested inside a simd region except for ordered simd, simd, scan, or atomic directive"
msgstr "OpenMP 构造不能嵌套在 simd 区域内部（ordered simd、simd、scan 或 atomic 指令除外）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12375
msgctxt "diagnostic"
msgid "OpenMP constructs may not be nested inside an atomic region"
msgstr "OpenMP 构造不能嵌套在 atomic 区域内"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12486
msgctxt "diagnostic"
msgid "OpenMP iterator is not allowed here"
msgstr "此处不允许使用 OpenMP 迭代器"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12335
msgctxt "diagnostic"
msgid "OpenMP loop iteration variable cannot have more than 64 bits size and will be narrowed"
msgstr "OpenMP 循环迭代变量的大小不能超过 64 位，将被窄化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12610
msgctxt "diagnostic"
msgid "OpenMP only allows an ordered construct with the simd clause nested in a simd construct"
msgstr "OpenMP 仅允许将带有 simd 子句的 ordered 构造嵌套在 simd 构造中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9737
msgctxt "diagnostic"
msgid "Operand argument to checked integer operation must be an integer type (%1 invalid)"
msgstr "受检整数运算的操作数实参必须是整数类型（%1 无效）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9737
msgctxt "diagnostic"
msgid "Operand argument to checked integer operation must be an integer type other than plain 'char', 'bool', bit-precise, or an enumeration (%1 invalid)"
msgstr "受检整数运算的操作数实参必须是除普通 'char'、'bool'、精确位宽整数或枚举之外的整数类型（%1 无效）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9737
msgctxt "diagnostic"
msgid "Operand argument to overflow builtin must be an integer type (%1 invalid)"
msgstr "溢出内建函数的操作数实参必须是整数类型（%1 无效）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9737
msgctxt "diagnostic"
msgid "Operand argument to overflow builtin must be an integer type other than plain 'char', 'bool', bit-precise, or an enumeration (%1 invalid)"
msgstr "溢出内建函数的操作数实参必须是除普通 'char'、'bool'、精确位宽整数或枚举之外的整数类型（%1 无效）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4560
msgctxt "diagnostic"
msgid "Operand of ? changes signedness: %0 to %1"
msgstr "? 的操作数改变了符号性：%0 到 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9937
msgctxt "diagnostic"
msgid "Operand of type %0 cannot be cast to a pointer type"
