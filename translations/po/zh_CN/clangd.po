msgstr "程序作用域 变量必须位于 %1 地址空间中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5198
msgctxt "diagnostic"
msgid "Promoted type %0 of K&R function parameter is not compatible with the parameter type %1 declared in a previous prototype"
