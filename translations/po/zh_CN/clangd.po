msgid "The message in this asm operand must be a string literal or an object with 'data()' and 'size()' member functions"
msgstr "消息（位于此内联汇编操作数中）必须是字符串字面量，或是具有 'data()' 和 'size()' 成员函数的对象"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1802
