msgstr "依赖的 using 声明解析为类型但缺少 'typename'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7745
msgctxt "diagnostic"
msgid "Dereference of pointer to incomplete type %0"
msgstr "对指向不完整类型 %0 的指针进行解引用"

