#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1562
msgctxt "diagnostic"
msgid "Setter cannot be specified for a readonly property"
msgstr "不能为只读属性指定 setter"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:931
msgctxt "diagnostic"
msgid "Setting buffer to a 'sizeof' expression; did you mean to transpose the last two arguments?"
msgstr "将缓冲设为 'sizeof' 表达式；您是否打算对调最后两个实参？"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1440
msgctxt "diagnostic"
msgid "Setting the floating point evaluation method to `source` on a target without SSE is not supported"
msgstr "不支持在没有 SSE 的目标上将浮点求值方法设置为 `source`"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1738
msgctxt "diagnostic"
msgid "Several methods with selector %0 of mismatched types are found for the @selector expression"
msgstr "为 @selector 表达式找到了多个类型不匹配且选择器为 %0 的方法"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7590
msgctxt "diagnostic"
msgid "Shift count >= width of type"
msgstr "移位位数大于或等于类型的位宽"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7588
msgctxt "diagnostic"
msgid "Shift count is negative"
msgstr "移位位数为负"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7586
msgctxt "diagnostic"
msgid "Shifting a negative signed value is undefined"
msgstr "对负有符号值进行移位是未定义行为"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:234
msgctxt "diagnostic"
msgid "Signed 'size_t' literal is out of range of possible 'size_t' values"
msgstr "有符号 'size_t' 字面量超出了可能的'size_t' 值的范围"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:234
msgctxt "diagnostic"
msgid "Signed 'size_t' literal is out of range of possible signed 'size_t' values"
msgstr "有符号 'size_t' 字面量超出了可能的有符号 'size_t' 值的范围"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13640
msgctxt "diagnostic"
msgid "Signed _BitInt must have a bit size of at least 1"
msgstr "有符号 _BitInt 的位宽必须至少为 1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13640
msgctxt "diagnostic"
msgid "Signed _BitInt must have a bit size of at least 2"
msgstr "有符号 _BitInt 的位宽必须至少为 2"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13642
msgctxt "diagnostic"
msgid "Signed _BitInt of bit sizes greater than %1 not supported"
msgstr "不支持位宽大于 %1 的有符号 _BitInt"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6895
msgctxt "diagnostic"
msgid "Signed bit-field %0 needs an extra bit to represent the largest positive enumerators of %1"
msgstr "有符号位域 %0 需要额外的一位来表示 %1 的最大正枚举值"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6909
msgctxt "diagnostic"
msgid "Signed bit-field %0 needs an extra bit to represent the largest positive enumerators of preferred type %1"
msgstr "有符号位域 %0 需要额外一位来表示首选类型 %1 的最大正枚举值"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7592
msgctxt "diagnostic"
msgid "Signed shift result (%0) requires %1 bits to represent, but %2 only has %3 bits"
msgstr "有符号移位结果 (%0) 需要 %1 位来表示，但 %2 只有 %3 位"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7595
msgctxt "diagnostic"
msgid "Signed shift result (%0) sets the sign bit of the shift expression's type (%1) and becomes negative"
msgstr "有符号移位结果 (%0) 设置了移位表达式类型 (%1) 的符号位并变为负值"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1024
msgctxt "diagnostic"
msgid "Signed value must have integer type; type here is %2"
msgstr "有符号值必须具有整型类型；此处的类型为 %2"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1024
msgctxt "diagnostic"
msgid "Signed value must have pointer or integer type; type here is %2"
msgstr "有符号值必须具有指针或整型类型；此处的类型为 %2"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1024
msgctxt "diagnostic"
msgid "Signed value must have pointer type; type here is %2"
msgstr "有符号值必须具有指针类型；此处的类型为 %2"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10885
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10889
msgctxt "diagnostic"
msgid "Signedness of format specifier '%0' is incompatible with '%1'"
msgstr "格式说明符 '%0' 的有符号性与 '%1' 不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1035
msgctxt "diagnostic"
msgid "Signing a null pointer will yield a non-null pointer"
msgstr "对空指针进行签名将产生非空指针"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12463
msgctxt "diagnostic"
msgid "Single declaration is expected after 'declare simd' directive"
msgstr "在 'declare simd' 指令之后期望单个声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12463
msgctxt "diagnostic"
msgid "Single declaration is expected after 'declare variant' directive"
msgstr "在 'declare variant' 指令之后期望单个声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13466
msgctxt "diagnostic"
msgid "Single subscript expressions are not allowed for matrix values"
msgstr "矩阵值不允许使用单个下标表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:918
msgctxt "diagnostic"
msgid "Size argument in %0 call appears to be size of the source; expected the size of the destination"
msgstr "%0 调用中的大小实参似乎是源的大小；期望的是目标的大小"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:924
msgctxt "diagnostic"
msgid "Size argument in %0 call is a comparison"
msgstr "%0 调用中的大小实参是一个比较表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:947
msgctxt "diagnostic"
msgid "Size argument in 'strncat' call appears to be size of the source"
msgstr "'strncat' 调用中的大小实参似乎是源字符串的大小"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13510
msgctxt "diagnostic"
msgid "Size of '__builtin_bit_cast' source type %0 does not match destination type %1 (%2 vs %3 bytes)"
msgstr "'__builtin_bit_cast' 源类型 %0 的大小与目标类型 %1 不匹配（%2 字节 vs %3 字节）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8855
msgctxt "diagnostic"
msgid "Size of array element of type %0 (%1 bytes) isn't a multiple of its alignment (%2 bytes)"
msgstr "类型为 %0 的数组元素大小（%1 字节）不是其对齐（%2 字节）的整数倍"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6743
msgctxt "diagnostic"
msgid "Size of array has non-integer type %0"
msgstr "数组大小具有非整数类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4796
msgctxt "diagnostic"
msgid "Size of field %1 (%2 bits) does not match the alignment of the first field in transparent union; transparent_union attribute ignored"
msgstr "字段 %1 的大小（%2 位）与透明联合体中第一个字段的对齐不匹配；已忽略 transparent_union 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4796
msgctxt "diagnostic"
msgid "Size of field %1 (%2 bits) does not match the size of the first field in transparent union; transparent_union attribute ignored"
msgstr "字段 %1 的大小（%2 位）与透明联合体中第一个字段的大小不匹配；已忽略 transparent_union 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10140
msgctxt "diagnostic"
msgid "Size of register '%0' does not match variable size"
msgstr "register '%0' 的大小与变量大小不匹配"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2023
msgctxt "diagnostic"
msgid "Sizeless type %1 is not allowed in exception specification"
msgstr "异常说明中不允许使用无大小类型 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7707
msgctxt "diagnostic"
msgid "Sizeof on array function parameter will return size of %0 instead of %1"
msgstr "对数组函数形参使用 sizeof 将返回 %0 的大小，而不是 %1 的大小"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7711
msgctxt "diagnostic"
msgid "Sizeof on pointer operation will return size of %0 instead of %1"
msgstr "对指针运算使用 sizeof 将返回 %0 的大小，而不是 %1 的大小"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:957
msgctxt "diagnostic"
msgid "Skipping '%0' because module declaration of '%1' lacks the 'framework' qualifier"
msgstr "正在跳过 '%0'，因为 '%1' 的模块声明缺少 'framework' 限定符"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:878
msgctxt "diagnostic"
msgid "Skipping stray token"
msgstr "跳过孤立记号"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:131
