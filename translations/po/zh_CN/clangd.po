msgstr "'prefer_type' 中预期为首选项说明"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:360
msgctxt "diagnostic"
msgid "Expected property name"
msgstr "需要属性名"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1279
msgctxt "diagnostic"
msgid "Expected push, pop or a string literal for the section name in '#pragma %0' - ignored"
