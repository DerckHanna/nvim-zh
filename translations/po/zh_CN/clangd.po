#: clang/include/clang/Basic/DiagnosticLexKinds.td:880
msgctxt "diagnostic"
msgid "Expected module name"
msgstr "期望模块名"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:847
msgctxt "diagnostic"
msgid "Expected name of accessor method"
msgstr "需要访问器方法的名称"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:93
msgctxt "diagnostic"
msgid "Expected namespace name"
msgstr "应为命名空间名称"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12793
msgctxt "diagnostic"
msgid "Expected non-const variable of type 'omp_interop_t'"
msgstr "预期为 'omp_interop_t' 类型的非 const 变量"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1306
msgctxt "diagnostic"
msgid "Expected non-wide string literal in '#pragma %0'"
msgstr "'#pragma %0' 中需要非宽字符串字面量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12521
msgctxt "diagnostic"
msgid "Expected one of %1 directive name modifier"
msgstr "期望 %1 之一作为指令名称修饰符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12521
msgctxt "diagnostic"
msgid "Expected one of %1 directive name modifiers"
msgstr "期望 %1 之一作为指令名称修饰符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12509
msgctxt "diagnostic"
msgid "Expected one of 'ref', val' or 'uval' modifiers"
msgstr "预期为 'ref'、val' 或 'uval' 修饰符之一"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1271
msgctxt "diagnostic"
msgid "Expected one of [bss|data|rodata|text|relro] section kind in '#pragma %0'"
msgstr "'#pragma %0' 中应为 [bss|data|rodata|text|relro] 节类型之一"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12671
msgctxt "diagnostic"
msgid "Expected one of the predefined allocators for the variables with the static storage: 'omp_default_mem_alloc', 'omp_large_cap_mem_alloc', 'omp_const_mem_alloc', 'omp_high_bw_mem_alloc', 'omp_low_lat_mem_alloc', 'omp_cgroup_mem_alloc', 'omp_pteam_mem_alloc' or 'omp_thread_mem_alloc'"
msgstr "对于具有静态存储期的变量，应为预定义分配器之一：'omp_default_mem_alloc'、'omp_large_cap_mem_alloc'、'omp_const_mem_alloc'、'omp_high_bw_mem_alloc'、'omp_low_lat_mem_alloc'、'omp_cgroup_mem_alloc'、'omp_pteam_mem_alloc' 或 'omp_thread_mem_alloc'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:430
msgctxt "diagnostic"
msgid "Expected parameter declarator"
msgstr "期望形参声明符"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:452
msgctxt "diagnostic"
msgid "Expected parentheses around type name in %0 expression"
msgstr "在 %0 表达式中的类型名周围期望圆括号"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1111
msgctxt "diagnostic"
msgid "Expected parenthesized parameter pack name in 'sizeof...' expression"
msgstr "'sizeof...' 表达式中期望带括号的形参包名称"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14067
msgctxt "diagnostic"
msgid "Expected pointer in '%0' clause, type is %1"
msgstr "在 '%0' 子句中应为指针，当前类型为 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12606
msgctxt "diagnostic"
msgid "Expected pointer or reference to pointer in 'use_device_ptr' clause"
msgstr "'use_device_ptr' 子句中预期为指针或指针的引用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9748
msgctxt "diagnostic"
msgid "Expected pointer to struct as %0 argument to %1, found %2"
msgstr "预期指向结构体的指针作为 %1 的 %0 实参，但实际为 %2"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12608
msgctxt "diagnostic"
