#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3766
msgctxt "diagnostic"
msgid "Derived class must specify the same code segment as its base classes"
msgstr "派生类必须指定与其基类相同的代码段"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13847
msgctxt "diagnostic"
