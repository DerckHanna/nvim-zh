msgctxt "diagnostic"
msgid "Expected umbrella, header, submodule, or module export"
msgstr "期望 umbrella、header、submodule 或模块 export"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:624
msgctxt "diagnostic"
msgid "Expected unqualified-id"
msgstr "此处需要非限定标识符"

