msgstr "等号后期望带引号的字符串"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12596
msgctxt "diagnostic"
msgid "Expected reference to one of the parameters of function %0"
msgstr "预期引用函数 %0 的某个形参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12596
msgctxt "diagnostic"
msgid "Expected reference to one of the parameters of function %0 or 'this'"
