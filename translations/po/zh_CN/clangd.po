msgctxt "diagnostic"
msgid "Expected reference type argument on 'adjust_args' clause with 'need_device_addr' modifier"
msgstr "在带有 'need_device_addr' 修饰符的 'adjust_args' 子句上期望引用类型实参"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:575
msgctxt "diagnostic"
