#: clang/include/clang/Basic/DiagnosticCommonKinds.td:300
msgctxt "diagnostic"
msgid "Pointer to subobject of predefined '%3' variable is not allowed in a template argument"
msgstr "模板实参中不允许使用指向 预定义的 '%3' 变量的子对象 的指针"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:300
msgctxt "diagnostic"
msgid "Pointer to subobject of string literal is not allowed in a template argument"
msgstr "模板实参中不允许使用指向 字符串字面量的子对象 的指针"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:300
msgctxt "diagnostic"
msgid "Pointer to subobject of temporary object is not allowed in a template argument"
msgstr "模板实参中不允许使用指向 临时对象的子对象 的指针"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:300
msgctxt "diagnostic"
msgid "Pointer to subobject of type_info object is not allowed in a template argument"
msgstr "模板实参中不允许使用指向 type_info 对象的子对象 的指针"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:300
msgctxt "diagnostic"
msgid "Pointer to temporary object is not allowed in a template argument"
msgstr "模板实参中不允许使用指向 临时对象 的指针"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11928
msgctxt "diagnostic"
msgid "Pointer to type %0 is invalid in OpenCL"
msgstr "指向类型 %0 的指针在 OpenCL 中无效"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:300
msgctxt "diagnostic"
msgid "Pointer to type_info object is not allowed in a template argument"
msgstr "模板实参中不允许使用指向 type_info 对象 的指针"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9990
msgctxt "diagnostic"
msgid "Pointer type mismatch"
msgstr "指针类型不匹配"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9990
msgctxt "diagnostic"
msgid "Pointer type mismatch (%0 and %1)"
msgstr "指针类型不匹配（%0 和 %1）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5806
msgctxt "diagnostic"
msgid "Pointer-to-member function type %0 can only be called on an lvalue"
msgstr "指向成员函数的指针类型 %0 只能在左值上调用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5806
msgctxt "diagnostic"
msgid "Pointer-to-member function type %0 can only be called on an rvalue"
msgstr "指向成员函数的指针类型 %0 只能在右值上调用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9993
msgctxt "diagnostic"
msgid "Pointer/integer type mismatch in conditional expression"
msgstr "条件表达式中指针/整数类型不匹配"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9993
msgctxt "diagnostic"
msgid "Pointer/integer type mismatch in conditional expression (%0 and %1)"
msgstr "条件表达式中指针/整数类型不匹配（%0 与 %1）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13759
msgctxt "diagnostic"
msgid "Pointers are unsupported in HLSL"
msgstr "HLSL 中不支持指针"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10197
msgctxt "diagnostic"
msgid "Pointers to functions are not allowed"
msgstr "不允许指向函数的指针"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8011
msgctxt "diagnostic"
msgid "Pointers to incompatible types"
msgstr "指向不兼容类型的指针"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:409
msgctxt "diagnostic"
msgid "Poisoning existing macro"
msgstr "正在将现有宏标记为禁用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10785
msgctxt "diagnostic"
msgid "Position arguments in format strings start counting at 1 (not 0)"
msgstr "格式字符串中的位置参数从 1 开始计数（而非 0）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10825
msgctxt "diagnostic"
msgid "Positional arguments are not supported by ISO C"
msgstr "ISO C 不支持位置参数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:124
msgctxt "diagnostic"
msgid "Possible misuse of comma operator here"
msgstr "此处可能误用了逗号运算符"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:583
msgctxt "diagnostic"
msgid "Postfix attributes are not allowed on Objective-C directives"
msgstr "Objective-C 指令上不允许使用后缀属性"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:585
msgctxt "diagnostic"
msgid "Postfix attributes are not allowed on Objective-C directives, place them in front of '@interface'"
msgstr "Objective-C 指令上不允许使用后缀属性，请将其放在 '@interface' 之前"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:585
msgctxt "diagnostic"
msgid "Postfix attributes are not allowed on Objective-C directives, place them in front of '@protocol'"
msgstr "Objective-C 指令上不允许使用后缀属性，请将其放在 '@protocol' 之前"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:715
msgctxt "diagnostic"
msgid "Pragma %0 requires a parenthesized string"
msgstr "pragma %0 需要一个带括号的字符串"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1360
msgctxt "diagnostic"
msgid "Pragma STDC FENV_ROUND is not supported"
msgstr "不支持编译指示 STDC FENV_ROUND"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1370
msgctxt "diagnostic"
msgid "Pragma comment requires parenthesized identifier and optional string"
msgstr "pragma comment 需要带圆括号的标识符和可选字符串"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1381
msgctxt "diagnostic"
msgid "Pragma detect_mismatch is malformed; it requires two comma-separated string literals"
msgstr "pragma detect_mismatch 格式错误；它需要两个以逗号分隔的字符串字面量"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:734
msgctxt "diagnostic"
msgid "Pragma diagnostic expected 'error', 'warning', 'ignored', 'fatal', 'push', or 'pop'"
msgstr "pragma diagnostic 期望为 'error'、'warning'、'ignored'、'fatal'、'push' 或 'pop'"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:741
msgctxt "diagnostic"
msgid "Pragma diagnostic expected option name (e.g. \"-Wundef\")"
msgstr "pragma diagnostic 应为选项名称（例如 \"-Wundef\"）"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:738
msgctxt "diagnostic"
msgid "Pragma diagnostic pop could not pop, no matching push"
msgstr "pragma diagnostic pop 无法弹出，没有匹配的 push"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:713
msgctxt "diagnostic"
msgid "Pragma error requires parenthesized string"
msgstr "pragma error 需要带括号的字符串"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1385
msgctxt "diagnostic"
msgid "Pragma float_control is malformed; use 'float_control({push|pop})' or 'float_control({precise|except}, {on|off} [,push])'"
msgstr "pragma float_control 格式错误；请使用 'float_control({push|pop})' 或 'float_control({precise|except}, {on|off} [,push])'"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:657
msgctxt "diagnostic"
msgid "Pragma include_alias expected '%0'"
msgstr "pragma include_alias 应为 '%0'"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:660
msgctxt "diagnostic"
msgid "Pragma include_alias expected include filename"
msgstr "pragma include_alias 期望包含文件名"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:713
msgctxt "diagnostic"
msgid "Pragma message requires parenthesized string"
msgstr "pragma message 需要带括号的字符串"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:717
msgctxt "diagnostic"
msgid "Pragma pop_macro could not pop '%0', no matching push_macro"
msgstr "pragma pop_macro 无法弹出 '%0'，没有匹配的 push_macro"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:713
msgctxt "diagnostic"
msgid "Pragma warning requires parenthesized string"
msgstr "pragma warning 需要带括号的字符串"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10816
msgctxt "diagnostic"
msgid "Precision used with '%1' conversion specifier, resulting in undefined behavior"
msgstr "精度与 '%1' 转换说明符一起使用，会导致未定义行为"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12775
msgctxt "diagnostic"
msgid "Predefined allocator cannot have traits specified"
msgstr "预定义分配器不能指定特性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:183
msgctxt "diagnostic"
msgid "Predefined identifier is only valid inside function"
msgstr "预定义标识符仅在函数内部有效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12797
msgctxt "diagnostic"
msgid "Prefer_list item must be a string literal or constant integral expression"
msgstr "prefer_list 项必须是字符串字面量或常量整型表达式"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:581
msgctxt "diagnostic"
msgid "Prefix attribute must be followed by an interface, protocol, or implementation"
msgstr "前缀属性后必须跟接口、协议或实现"

msgctxt "diagnostic"
msgid "Previous case defined here"
msgstr "此前的 case 定义在这里"

msgctxt "diagnostic"
msgid "Previous declaration is here"
msgstr "此前的声明在这里"

msgctxt "diagnostic"
msgid "Previous default label is here"
msgstr "此前的 default 标签在这里"

msgctxt "diagnostic"
msgid "Previous definition is here, with type {type}"
msgstr "此前的定义在这里，类型为 {type}"

msgctxt "diagnostic"
msgid "Previous implicit declaration is here"
msgstr "此前的隐式声明在这里"

msgctxt "diagnostic"
msgid "Previous statement is here"
msgstr "此前的语句在这里"

msgctxt "diagnostic"
msgid "Previous use is here"
msgstr "此前在这里使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1552
msgctxt "diagnostic"
msgid "Primary property declaration is implicitly strong while redeclaration in class extension is weak"
msgstr "主属性声明隐式为 strong，而类扩展中的重复声明为 weak"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13356
msgctxt "diagnostic"
msgid "Priority of default version cannot be overridden; ignoring priority"
msgstr "不能重写默认版本的优先级；已忽略优先级"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:433
#: clang/include/clang/Basic/DiagnosticCommonKinds.td:435
msgctxt "diagnostic"
msgid "Private API notes file for module '%0' should be named '%0_private.apinotes', not '%1'"
msgstr "模块 '%0' 的私有 API 注解文件应命名为 '%0_private.apinotes'，而不是 '%1'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:513
msgctxt "diagnostic"
msgid "Private field %0 is not used"
msgstr "私有字段 %0 未使用"

msgctxt "diagnostic"
msgid "Private field {name} is not used"
msgstr "私有字段 {name} 未使用"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1831
msgctxt "diagnostic"
msgid "Private module fragment cannot be exported"
msgstr "私有模块片段无法被导出"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12973
msgctxt "diagnostic"
msgid "Private module fragment declaration with no preceding module declaration"
msgstr "私有模块片段声明之前没有模块声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12977
msgctxt "diagnostic"
msgid "Private module fragment in module implementation unit"
msgstr "模块实现单元中出现了私有模块片段"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12975
msgctxt "diagnostic"
msgid "Private module fragment redefined"
msgstr "私有模块片段被重定义"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:949
msgctxt "diagnostic"
msgid "Private submodule '%0' in private module map, expected top-level module"
msgstr "私有模块映射中的私有子模块 '%0'，预期为顶层模块"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13663
msgctxt "diagnostic"
msgid "Probability argument to __builtin_expect_with_probability is outside the range [0.0, 1.0]"
msgstr "__builtin_expect_with_probability 的概率实参超出 [0.0, 1.0] 范围"

