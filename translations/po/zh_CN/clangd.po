#: clang/include/clang/Basic/DiagnosticParseKinds.td:21
msgctxt "diagnostic"
msgid "Expected 'volatile', 'inline', 'goto', or '('"
msgstr "期望 'volatile'、'inline'、'goto' 或 '('"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:280
msgctxt "diagnostic"
msgid "Expected 'while' in do/while loop"
msgstr "do/while 循环中缺少 'while'"

msgctxt "diagnostic"
msgid "Expected '{'"
msgstr "此处缺少 '{'"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:164
msgctxt "diagnostic"
msgid "Expected '{' after '\\%0' escape sequence"
msgstr "在 '\\%0' 转义序列之后应为 '{'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:653
msgctxt "diagnostic"
msgid "Expected '{' after base class list"
msgstr "基类列表后期望 '{'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:278
msgctxt "diagnostic"
msgid "Expected '{' in compound literal"
msgstr "在复合字面量中应为 '{'"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:935
msgctxt "diagnostic"
msgid "Expected '{' to start inferred submodule"
msgstr "预期以 '{' 开始推断子模块"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:881
msgctxt "diagnostic"
msgid "Expected '{' to start module '%0'"
msgstr "需要 '{' 来开始模块 '%0'"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:882
msgctxt "diagnostic"
msgid "Expected '}'"
msgstr "此处缺少 '}'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1897
msgctxt "diagnostic"
msgid "Expected HLSL Semantic identifier"
msgstr "期望 HLSL 语义标识符"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1483
msgctxt "diagnostic"
msgid "Expected OpenACC directive"
msgstr "预期为 OpenACC 指令"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11577
msgctxt "diagnostic"
msgid "Expected a 'float', 'double' or '__float128' for the first argument"
msgstr "第一个实参期望为 'float'、'double' 或 '__float128'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9750
msgctxt "diagnostic"
msgid "Expected a callable expression as %0 argument to %1, found %2"
msgstr "期望可调用表达式作为 %1 的 %0 实参，但找到 %2"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1208
msgctxt "diagnostic"
msgid "Expected a class method selector with single argument, e.g., 'colorWithCGColor:'"
msgstr "期望带有单个实参的类方法选择器，例如 'colorWithCGColor:'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:690
msgctxt "diagnostic"
msgid "Expected a class name after '~' to name a destructor"
msgstr "期望在 '~' 之后有类名以命名析构函数"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:945
msgctxt "diagnostic"
msgid "Expected a feature name"
msgstr "期望特性名称"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:607
msgctxt "diagnostic"
msgid "Expected a field designator, such as '.field = 4'"
msgstr "期望字段指示符，例如 '.field = 4'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:997
msgctxt "diagnostic"
msgid "Expected a foldable binary operator in fold expression"
msgstr "在折叠表达式中期望一个可折叠的二元运算符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1264
msgctxt "diagnostic"
msgid "Expected a for, while, or do-while loop to follow '%0'"
msgstr "期望在 '%0' 之后跟随 for、while 或 do-while 循环"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:967
msgctxt "diagnostic"
msgid "Expected a header attribute name ('size' or 'mtime')"
msgstr "需要头文件属性名 ('size' 或 'mtime')"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:888
msgctxt "diagnostic"
msgid "Expected a header name after '%0'"
msgstr "'%0' 之后期望头文件名"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12440
msgctxt "diagnostic"
msgid "Expected a memory order clause"
msgstr "应为内存序子句"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:914
msgctxt "diagnostic"
msgid "Expected a message describing the conflict with '%0'"
msgstr "期望一条描述与 '%0' 冲突的消息"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:889
msgctxt "diagnostic"
msgid "Expected a module map file name"
msgstr "期望模块映射文件名"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:1005
msgctxt "diagnostic"
msgid "Expected a module name in '__building_module' expression"
msgstr "'__building_module' 表达式中需要模块名"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:902
msgctxt "diagnostic"
msgid "Expected a module name or '*'"
msgstr "预期为模块名或 '*'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1224
msgctxt "diagnostic"
msgid "Expected a platform name here"
msgstr "此处需要平台名称"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1200
msgctxt "diagnostic"
msgid "Expected a platform name, e.g., 'macos'"
msgstr "期望平台名称，例如 'macos'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:599
msgctxt "diagnostic"
msgid "Expected a property name in @synthesize"
msgstr "@synthesize 中期望属性名"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:974
#: clang/include/clang/Basic/DiagnosticParseKinds.td:976
msgctxt "diagnostic"
msgid "Expected a qualified name after 'typename'"
msgstr "'typename' 后需要限定名称"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12598
msgctxt "diagnostic"
msgid "Expected a reference to a parameter specified in a 'uniform' clause"
msgstr "需要引用在 'uniform' 子句中指定的形参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12600
msgctxt "diagnostic"
msgid "Expected a reference to an integer-typed parameter"
msgstr "应为对整数类型形参的引用"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1206
msgctxt "diagnostic"
msgid "Expected a related Objective-C class name, e.g., 'NSColor'"
msgstr "应为相关的 Objective-C 类名，例如 'NSColor'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1282
msgctxt "diagnostic"
msgid "Expected a stack label or a string literal for the section name in '#pragma %0' - ignored"
msgstr "'#pragma %0' 中的节名期望栈标签或字符串字面量 - 已忽略"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1275
msgctxt "diagnostic"
msgid "Expected a string literal for the section name in '#pragma %0' - ignored"
msgstr "'#pragma %0' 中的节名称应为字符串字面量——已忽略"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:226
msgctxt "diagnostic"
msgid "Expected a type"
msgstr "此处需要类型"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1193
msgctxt "diagnostic"
msgid "Expected a version of the form 'major[.minor[.subminor]]'"
msgstr "应为 'major[.minor[.subminor]]' 形式的版本号"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12165
msgctxt "diagnostic"
msgid "Expected access to data field"
msgstr "期望访问数据字段"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1328
msgctxt "diagnostic"
msgid "Expected action or ')' in '#pragma %0' - ignored"
msgstr "'#pragma %0' 中需要操作或 ')' - 已忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12150
msgctxt "diagnostic"
msgid "Expected addressable lvalue expression, array element or array section"
msgstr "预期为可寻址左值表达式、数组元素或数组切片"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12150
msgctxt "diagnostic"
msgid "Expected addressable lvalue expression, array element or array section of non 'omp_depend_t' type"
msgstr "预期为非 'omp_depend_t' 类型的可寻址左值表达式、数组元素或数组切片"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12150
msgctxt "diagnostic"
msgid "Expected addressable lvalue expression, array element, array section or array shaping expression"
msgstr "预期为可寻址左值表达式、数组元素、数组切片或数组整形表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12150
msgctxt "diagnostic"
msgid "Expected addressable lvalue expression, array element, array section or array shaping expression of non 'omp_depend_t' type"
msgstr "预期为非 'omp_depend_t' 类型的可寻址左值表达式、数组元素、数组切片或数组整形表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12763
msgctxt "diagnostic"
msgid "Expected addressable lvalue in '%0' clause"
msgstr "'%0' 子句中需要可寻址左值"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12617
msgctxt "diagnostic"
msgid "Expected addressable reduction item for the task-based directives"
msgstr "基于任务的指令期望可寻址的归约项"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12682
msgctxt "diagnostic"
msgid "Expected an 'allocator' clause inside of the target region; provide an 'allocator' clause or use 'requires' directive with the 'dynamic_allocators' clause"
msgstr "target 区域内预期有 'allocator' 子句；请提供 'allocator' 子句或配合 'dynamic_allocators' 子句使用 'requires' 指令"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:550
msgctxt "diagnostic"
msgid "Expected an Objective-C directive after '@'"
msgstr "'@' 后应为 Objective-C 指令"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1719
msgctxt "diagnostic"
msgid "Expected an OpenMP 'directive' or 'sequence' attribute argument"
msgstr "需要 OpenMP 'directive' 或 'sequence' 属性实参"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1519
msgctxt "diagnostic"
msgid "Expected an OpenMP directive"
msgstr "期望一个 OpenMP 指令"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12685
msgctxt "diagnostic"
msgid "Expected an allocator expression inside of the target region; provide an allocator expression or use 'requires' directive with the 'dynamic_allocators' clause"
msgstr "期望在目标区域内部有一个分配器表达式；请提供一个分配器表达式，或使用带有 'dynamic_allocators' 子句的 'requires' 指令"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1404
msgctxt "diagnostic"
msgid "Expected an attribute after '('"
msgstr "'(' 后预期为属性"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:946
msgctxt "diagnostic"
msgid "Expected an attribute name"
msgstr "需要属性名"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1412
msgctxt "diagnostic"
msgid "Expected an attribute that is specified using the GNU, C++11 or '__declspec' syntax"
msgstr "期望使用 GNU、C++11 或 '__declspec' 语法指定的属性"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1202
msgctxt "diagnostic"
msgid "Expected an environment name, e.g., 'compute'"
msgstr "期望一个环境名称，例如 'compute'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:981
msgctxt "diagnostic"
msgid "Expected an identifier or template-id after '::'"
msgstr "'::' 后需要标识符或模板标识符"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1423
msgctxt "diagnostic"
msgid "Expected an identifier that corresponds to an attribute subject matcher sub-rule; '%0' matcher "
msgstr "期望与属性主体匹配器子规则对应的标识符；'%0' 匹配器"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1423
msgctxt "diagnostic"
msgid "Expected an identifier that corresponds to an attribute subject matcher sub-rule; '%0' matcher does not support sub-rules"
msgstr "期望与属性主体匹配器子规则对应的标识符；'%0' 匹配器不支持子规则"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1423
msgctxt "diagnostic"
msgid "Expected an identifier that corresponds to an attribute subject matcher sub-rule; '%0' matcher supports the following sub-rules: %2"
msgstr "期望与属性主体匹配器子规则对应的标识符；'%0' 匹配器支持以下子规则：%2"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1419
msgctxt "diagnostic"
msgid "Expected an identifier that corresponds to an attribute subject rule"
msgstr "应为对应特性主体规则的标识符"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1289
msgctxt "diagnostic"
msgid "Expected an integer argument in '#pragma %0'"
msgstr "'#pragma %0' 中应为整数实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12699
msgctxt "diagnostic"
msgid "Expected an integer or a pointer type of the outer loop counter '%0' for non-rectangular nests"
msgstr "对于非矩形嵌套，外层循环计数器 '%0' 应为整数或指针类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12539
msgctxt "diagnostic"
msgid "Expected at least one %0 clause for '#pragma omp %1'"
msgstr "'#pragma omp %1' 期望至少一个 %0 子句"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1591
msgctxt "diagnostic"
msgid "Expected at least one 'enter', 'link' or 'indirect' clause"
msgstr "预期至少有一个 'enter'、'link' 或 'indirect' 子句"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1591
msgctxt "diagnostic"
msgid "Expected at least one 'enter', 'link', 'indirect' or 'local' clause"
msgstr "预期至少有一个 'enter'、'link'、'indirect' 或 'local' 子句"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12602
msgctxt "diagnostic"
msgid "Expected at least one 'to' clause or 'from' clause specified to '#pragma omp target update'"
msgstr "'#pragma omp target update' 至少需要指定一个 'to' 子句或 'from' 子句"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1591
msgctxt "diagnostic"
msgid "Expected at least one 'to' or 'link' clause"
msgstr "预期至少有一个 'to' 或 'link' 子句"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1591
msgctxt "diagnostic"
msgid "Expected at least one 'to', 'link' or 'indirect' clause"
msgstr "预期至少有一个 'to'、'link' 或 'indirect' 子句"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1606
msgctxt "diagnostic"
msgid "Expected at least one clause on '#pragma omp %0' directive"
msgstr "'#pragma omp %0' 指令上至少需要一个子句"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1417
msgctxt "diagnostic"
msgid "Expected attribute subject set specifier 'apply_to'"
msgstr "期望属性主体集说明符 'apply_to'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1121
msgctxt "diagnostic"
msgid "Expected body of lambda expression"
msgstr "lambda 表达式缺少函数体"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:952
msgctxt "diagnostic"
msgid "Expected canonical name for private module '%0'"
msgstr "期望私有模块 '%0' 的规范名称"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:676
msgctxt "diagnostic"
msgid "Expected catch"
msgstr "此处需要 catch"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:651
msgctxt "diagnostic"
msgid "Expected class member or base class name"
msgstr "此处需要类成员或基类的名称"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:445
msgctxt "diagnostic"
msgid "Expected class name"
msgstr "此处需要类名"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1484
msgctxt "diagnostic"
msgid "Expected clause-list or newline in OpenACC directive"
msgstr "在 OpenACC 指令中需要子句列表或换行符"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:605
msgctxt "diagnostic"
msgid "Expected comma in macro parameter list"
msgstr "宏形参列表中缺少逗号"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:938
msgctxt "diagnostic"
msgid "Expected concept name with optional arguments"
msgstr "需要带有可选实参的 concept 名称"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:910
msgctxt "diagnostic"
msgid "Expected configuration macro name after ','"
msgstr "',' 后应为配置宏名称"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12773
msgctxt "diagnostic"
msgid "Expected constant sized array of 'omp_alloctrait_t' elements, not %0"
msgstr "应为常量大小的 'omp_alloctrait_t' 元素数组，而不是 %0"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1610
msgctxt "diagnostic"
msgid "Expected declarator on 'omp declare mapper' directive"
msgstr "期望 'omp declare mapper' 指令上带有声明符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12652
msgctxt "diagnostic"
msgid "Expected depobj expression"
msgstr "期望 depobj 表达式"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:731
msgctxt "diagnostic"
msgid "Expected end of directive in pragma"
msgstr "pragma 中应为指令结束"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:623
msgctxt "diagnostic"
msgid "Expected end of line in preprocessor expression"
msgstr "预处理表达式中期望行尾"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:931
msgctxt "diagnostic"
msgid "Expected excluded module name"
msgstr "期望被排除的模块名称"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:225
msgctxt "diagnostic"
msgid "Expected expression"
msgstr "此处需要表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12152
msgctxt "diagnostic"
msgid "Expected expression containing only member accesses and/or array sections based on named variables"
msgstr "期望表达式仅包含基于命名变量的成员访问和/或数组切片"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12767
msgctxt "diagnostic"
msgid "Expected expression with a pointer to a complete type as a base of an array shaping operation"
msgstr "需要一个指向完整类型的指针的表达式作为数组塑形操作的基址"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:227
msgctxt "diagnostic"
msgid "Expected external declaration"
msgstr "此处需要外部声明"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:904
msgctxt "diagnostic"
msgid "Expected framework name as a string"
msgstr "期望字符串形式的框架名称"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:249
msgctxt "diagnostic"
msgid "Expected function body after function declarator"
msgstr "函数声明符后缺少函数体"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14266
msgctxt "diagnostic"
msgid "Expected function or lambda declaration for 'routine' construct"
msgstr "'routine' 构造期望函数或 lambda 声明"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:624
msgctxt "diagnostic"
msgid "Expected identifier"
msgstr "此处需要标识符"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:1040
#: clang/include/clang/Basic/DiagnosticLexKinds.td:760
msgctxt "diagnostic"
msgid "Expected identifier after '.' in module name"
msgstr "预期为模块名中 '.' 之后的标识符"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1259
msgctxt "diagnostic"
msgid "Expected identifier in '#pragma %0' - ignored"
msgstr "'#pragma %0' 中期望标识符 - 已忽略"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:603
msgctxt "diagnostic"
msgid "Expected identifier in macro parameter list"
msgstr "宏形参列表中需要标识符"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1535
msgctxt "diagnostic"
msgid "Expected identifier or one of the following operators: '+', '-', '*', '&', '|', '^', '&&', or '||'"
msgstr "期望标识符或以下运算符之一：'+'、'-'、'*'、'&'、'|'、'^'、'&&' 或 '||'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1631
msgctxt "diagnostic"
msgid "Expected identifier or string literal describing a context property; property skipped"
msgstr "预期为描述上下文属性的标识符或字符串字面量；已跳过该属性"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1631
msgctxt "diagnostic"
msgid "Expected identifier or string literal describing a context property; selector skipped"
msgstr "预期为描述上下文属性的标识符或字符串字面量；已跳过该选择器"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1631
msgctxt "diagnostic"
msgid "Expected identifier or string literal describing a context property; set skipped"
msgstr "预期为描述上下文属性的标识符或字符串字面量；已跳过该集合"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1631
msgctxt "diagnostic"
msgid "Expected identifier or string literal describing a context selector; property skipped"
msgstr "预期为描述上下文选择器的标识符或字符串字面量；已跳过该属性"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1631
msgctxt "diagnostic"
msgid "Expected identifier or string literal describing a context selector; selector skipped"
msgstr "预期为描述上下文选择器的标识符或字符串字面量；已跳过该选择器"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1631
msgctxt "diagnostic"
msgid "Expected identifier or string literal describing a context selector; set skipped"
msgstr "预期为描述上下文选择器的标识符或字符串字面量；已跳过该集合"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1631
msgctxt "diagnostic"
msgid "Expected identifier or string literal describing a context set; property skipped"
msgstr "预期为描述上下文集合的标识符或字符串字面量；已跳过该属性"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1631
msgctxt "diagnostic"
msgid "Expected identifier or string literal describing a context set; selector skipped"
msgstr "预期为描述上下文集合的标识符或字符串字面量；已跳过该选择器"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1631
msgctxt "diagnostic"
msgid "Expected identifier or string literal describing a context set; set skipped"
msgstr "预期为描述上下文集合的标识符或字符串字面量；已跳过该集合"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1496
msgctxt "diagnostic"
msgid "Expected identifier or string literal in OpenACC 'bind' clause"
msgstr "在 OpenACC 'bind' 子句中期望标识符或字符串字面量"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1533
msgctxt "diagnostic"
msgid "Expected identifier specifying the name of the 'omp critical' directive"
msgstr "期望指定 'omp critical' 指令名称的标识符"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1406
msgctxt "diagnostic"
msgid "Expected identifier that represents an attribute name"
msgstr "期望表示属性名称的标识符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11518
msgctxt "diagnostic"
msgid "Expected initializer"
msgstr "需要初始化器"

