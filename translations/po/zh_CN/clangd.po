#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6642
msgctxt "diagnostic"
msgid "Implicit declaration introduced by elaborated type conflicts with a non-struct type of the same name"
msgstr "详述类型引入的隐式声明与同名的非结构体类型冲突"

