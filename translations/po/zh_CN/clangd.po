msgctxt "diagnostic"
msgid "@try statement without a @catch and @finally clause"
msgstr "@try 语句缺少 @catch 和 @finally 子句"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9105
msgctxt "diagnostic"
msgid "A 'decltype' specifier cannot be used in a declarative nested name specifier"
msgstr "不能在声明性嵌套名称说明符中使用'decltype' 说明符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6434
msgctxt "diagnostic"
msgid "A block declaration without a prototype is deprecated "
msgstr "不带原型的块声明已弃用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6434
msgctxt "diagnostic"
msgid "A block declaration without a prototype is deprecated in all versions of C"
msgstr "不带原型的块声明在所有 C 版本中已弃用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3676
msgctxt "diagnostic"
msgid "A boxed expression literal can only be used at file scope if constant"
msgstr "装箱表达式字面量只有在为常量时才能在文件作用域中使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3676
msgctxt "diagnostic"
msgid "A boxed expression literal can only be used at file scope if its contents are all also constant literals"
msgstr "装箱表达式字面量只有在其内容也全部是常量字面量时才能在文件作用域中使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3676
msgctxt "diagnostic"
msgid "A boxed expression literal can only be used at file scope if its contents are all also constant literals and its keys are string literals"
msgstr "装箱表达式字面量只有在其内容也全部是常量字面量且其键为字符串字面量时才能在文件作用域中使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3176
msgctxt "diagnostic"
msgid "A concept definition cannot refer to itself"
msgstr "概念（concept）定义不能引用自身"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9102
msgctxt "diagnostic"
msgid "A declarative nested name specifier cannot name an alias template"
msgstr "声明性嵌套名称说明符不能命名别名模板"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3676
msgctxt "diagnostic"
msgid "A dictionary literal can only be used at file scope if constant"
msgstr "字典字面量只有在为常量时才能在文件作用域中使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3676
msgctxt "diagnostic"
msgid "A dictionary literal can only be used at file scope if its contents are all also constant literals"
msgstr "字典字面量只有在其内容也全部是常量字面量时才能在文件作用域中使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3676
msgctxt "diagnostic"
msgid "A dictionary literal can only be used at file scope if its contents are all also constant literals and its keys are string literals"
msgstr "字典字面量只有在其内容也全部是常量字面量且其键为字符串字面量时才能在文件作用域中使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12128
msgctxt "diagnostic"
msgid "A firstprivate variable with incomplete type %0"
msgstr "firstprivate 变量具有不完整类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1941
msgctxt "diagnostic"
msgid "A friend declaration that befriends a template must contain exactly one type-specifier"
msgstr "声明模板为友元的友元声明必须恰好包含一个类型说明符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6434
msgctxt "diagnostic"
msgid "A function declaration without a prototype is deprecated "
msgstr "不带原型的函数声明已弃用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6434
msgctxt "diagnostic"
msgid "A function declaration without a prototype is deprecated in all versions of C"
msgstr "不带原型的函数声明在所有 C 版本中已弃用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6437
msgctxt "diagnostic"
msgid "A function declaration without a prototype is deprecated in all versions of C and is not supported in C23"
msgstr "没有原型的函数声明在所有 C 版本中均已弃用，且在 C23 中不受支持"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6437
msgctxt "diagnostic"
msgid "A function declaration without a prototype is deprecated in all versions of C and is treated as a zero-parameter prototype in C23, conflicting with a previous declaration"
msgstr "没有原型的函数声明在所有 C 版本中均已弃用，且在 C23 中被视为零形参原型，与先前的声明冲突"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6437
msgctxt "diagnostic"
msgid "A function declaration without a prototype is deprecated in all versions of C and is treated as a zero-parameter prototype in C23, conflicting with a previous definition"
msgstr "没有原型的函数声明在所有 C 版本中均已弃用，且在 C23 中被视为零形参原型，与先前的定义冲突"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6437
msgctxt "diagnostic"
msgid "A function declaration without a prototype is deprecated in all versions of C and is treated as a zero-parameter prototype in C23, conflicting with a subsequent declaration"
msgstr "没有原型的函数声明在所有 C 版本中均已弃用，且在 C23 中被视为零形参原型，与后续的声明冲突"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6437
msgctxt "diagnostic"
msgid "A function declaration without a prototype is deprecated in all versions of C and is treated as a zero-parameter prototype in C23, conflicting with a subsequent definition"
msgstr "没有原型的函数声明在所有 C 版本中均已弃用，且在 C23 中被视为零形参原型，与后续的定义冲突"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6437
msgctxt "diagnostic"
msgid "A function definition without a prototype is deprecated in all versions of C and is not supported in C23"
msgstr "没有原型的函数定义在所有 C 版本中均已弃用，且在 C23 中不受支持"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6437
msgctxt "diagnostic"
msgid "A function definition without a prototype is deprecated in all versions of C and is treated as a zero-parameter prototype in C23, conflicting with a previous declaration"
msgstr "没有原型的函数定义在所有 C 版本中均已弃用，且在 C23 中被视为零形参原型，与先前的声明冲突"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6437
msgctxt "diagnostic"
msgid "A function definition without a prototype is deprecated in all versions of C and is treated as a zero-parameter prototype in C23, conflicting with a previous definition"
msgstr "没有原型的函数定义在所有 C 版本中均已弃用，且在 C23 中被视为零形参原型，与先前的定义冲突"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6437
msgctxt "diagnostic"
msgid "A function definition without a prototype is deprecated in all versions of C and is treated as a zero-parameter prototype in C23, conflicting with a subsequent declaration"
msgstr "没有原型的函数定义在所有 C 版本中均已弃用，且在 C23 中被视为零形参原型，与后续的声明冲突"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6437
msgctxt "diagnostic"
msgid "A function definition without a prototype is deprecated in all versions of C and is treated as a zero-parameter prototype in C23, conflicting with a subsequent definition"
msgstr "没有原型的函数定义在所有 C 版本中均已弃用，且在 C23 中被视为零形参原型，与后续的定义冲突"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9066
msgctxt "diagnostic"
msgid "A function type is not allowed here"
msgstr "此处不允许使用函数类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8380
msgctxt "diagnostic"
msgid "A getter method is needed to perform a compound assignment on a property"
msgstr "对属性执行复合赋值需要 getter 方法"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8947
msgctxt "diagnostic"
msgid "A lambda expression cannot appear in this context"
msgstr "lambda 表达式不能出现在此上下文中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8945
msgctxt "diagnostic"
msgid "A lambda expression may not appear inside of a constant expression"
msgstr "lambda 表达式不能出现在常量表达式内部"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9007
msgctxt "diagnostic"
msgid "A lambda parameter cannot shadow an explicitly captured entity"
msgstr "lambda 形参不能遮蔽显式捕获的实体"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8249
msgctxt "diagnostic"
msgid "A lambda with an explicit object parameter cannot be mutable"
msgstr "带有显式对象形参的 lambda 不能是 mutable"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12130
msgctxt "diagnostic"
msgid "A lastprivate variable with incomplete type %0"
msgstr "lastprivate 变量具有不完整类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12270
msgctxt "diagnostic"
msgid "A linear variable with incomplete type %0"
msgstr "线性变量具有不完整类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8996
msgctxt "diagnostic"
msgid "A member of a lambda should not be explicitly instantiated"
msgstr "不应显式实例化 lambda 的成员"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8996
msgctxt "diagnostic"
msgid "A member of a lambda should not be explicitly specialized"
msgstr "不应显式特化 lambda 的成员"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8961
msgctxt "diagnostic"
msgid "A member of a lambda should not be the target of a friend declaration"
msgstr "lambda 的成员不应作为友元声明的目标"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:976
msgctxt "diagnostic"
msgid "A module can only be re-exported as another top-level module"
msgstr "模块只能重新导出为另一个顶层模块"

msgctxt "diagnostic"
msgid "A non-const lvalue reference to type {type} cannot bind to a temporary of type {from}"
msgstr "指向 {type} 的非 const 左值引用不能绑定到 {from} 类型的临时对象"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5597
msgctxt "diagnostic"
msgid "A non-type template parameter cannot have type %0"
msgstr "非类型模板形参不能具有类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5599
msgctxt "diagnostic"
msgid "A non-type template parameter cannot have type %0 before C++20"
msgstr "在 C++20 之前，非类型模板形参不能具有类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3364
msgctxt "diagnostic"
msgid "A non-vector or non-vectorizable scalar type is an invalid argument to attribute %1"
msgstr "非向量或不可向量化的标量类型是属性 %1 的无效实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3676
msgctxt "diagnostic"
msgid "A numeric literal literal can only be used at file scope if constant"
msgstr "数值字面量字面量只有在为常量时才能在文件作用域中使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3676
msgctxt "diagnostic"
msgid "A numeric literal literal can only be used at file scope if its contents are all also constant literals"
msgstr "数值字面量字面量只有在其内容也全部是常量字面量时才能在文件作用域中使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3676
msgctxt "diagnostic"
msgid "A numeric literal literal can only be used at file scope if its contents are all also constant literals and its keys are string literals"
msgstr "数值字面量字面量只有在其内容也全部是常量字面量且其键为字符串字面量时才能在文件作用域中使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9105
msgctxt "diagnostic"
msgid "A pack indexing specifier cannot be used in a declarative nested name specifier"
msgstr "不能在声明性嵌套名称说明符中使用包索引 说明符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12301
msgctxt "diagnostic"
msgid "A parameter cannot appear in more than one %1 clause"
msgstr "形参不能在多个 %1 子句中重复出现"

