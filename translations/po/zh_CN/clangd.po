msgstr "消息（位于此内联汇编操作数中）必须具有 'data()' 成员函数，且其返回值可转换为 'std::size_t'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1795
msgctxt "diagnostic"
msgid "The message in this asm operand must have a 'size()' member function returning an object convertible to 'const char *'"
msgstr "消息（位于此内联汇编操作数中）必须具有 'size()' 成员函数，且其返回值可转换为 'const char *'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1795
msgctxt "diagnostic"
msgid "The message in this asm operand must have a 'size()' member function returning an object convertible to 'std::size_t'"
msgstr "消息（位于此内联汇编操作数中）必须具有 'size()' 成员函数，且其返回值可转换为 'std::size_t'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1798
msgctxt "diagnostic"
msgid "The message in this static assertion is not a constant expression"
msgstr "消息（位于此静态断言中）不是常量表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1789
msgctxt "diagnostic"
msgid "The message object in this asm operand is missing 'data()' and 'size()' member functions"
msgstr "消息对象（位于此内联汇编操作数中）缺少 'data()' 和 'size()' 成员函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1789
msgctxt "diagnostic"
msgid "The message object in this asm operand is missing a 'data()' member function"
msgstr "消息对象（位于此内联汇编操作数中）缺少 'data()' 成员函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1789
msgctxt "diagnostic"
msgid "The message object in this asm operand is missing a 'size()' member function"
msgstr "消息对象（位于此内联汇编操作数中）缺少 'size()' 成员函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1789
msgctxt "diagnostic"
msgid "The message object in this static assertion is missing 'data()' and 'size()' member functions"
msgstr "消息对象（位于此静态断言中）缺少 'data()' 和 'size()' 成员函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1789
msgctxt "diagnostic"
msgid "The message object in this static assertion is missing a 'data()' member function"
msgstr "消息对象（位于此静态断言中）缺少 'data()' 成员函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1789
msgctxt "diagnostic"
msgid "The message object in this static assertion is missing a 'size()' member function"
msgstr "消息对象（位于此静态断言中）缺少 'size()' 成员函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12553
msgctxt "diagnostic"
msgid "The name of the construct must be specified in presence of 'hint' clause"
msgstr "存在 'hint' 子句时必须指定构造的名称"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1885
msgctxt "diagnostic"
msgid "The number of preprocessor source tokens (%0) exceeds this token limit (%1)"
msgstr "预处理器源记号数量（%0）超出了此记号限制（%1）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10556
msgctxt "diagnostic"
msgid "The parameter for an explicitly-defaulted copy assignment operator may not be volatile"
msgstr "显式默认化的拷贝赋值运算符的形参不能为 volatile"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10566
msgctxt "diagnostic"
msgid "The parameter for an explicitly-defaulted copy assignment operator must be an lvalue reference type"
msgstr "显式默认化的拷贝赋值运算符的形参必须是左值引用类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10556
msgctxt "diagnostic"
msgid "The parameter for an explicitly-defaulted copy constructor may not be volatile"
msgstr "显式默认化的拷贝构造函数的形参不能为 volatile"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10556
msgctxt "diagnostic"
msgid "The parameter for an explicitly-defaulted default constructor may not be volatile"
msgstr "显式默认化的默认构造函数的形参不能为 volatile"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10556
msgctxt "diagnostic"
msgid "The parameter for an explicitly-defaulted destructor may not be volatile"
msgstr "显式默认化的析构函数的形参不能为 volatile"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10559
msgctxt "diagnostic"
msgid "The parameter for an explicitly-defaulted move assignment operator may not be const"
msgstr "显式默认化的移动赋值运算符的形参不能为 const"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10556
msgctxt "diagnostic"
msgid "The parameter for an explicitly-defaulted move assignment operator may not be volatile"
msgstr "显式默认化的移动赋值运算符的形参不能为 volatile"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10559
msgctxt "diagnostic"
msgid "The parameter for an explicitly-defaulted move constructor may not be const"
msgstr "显式默认化的移动构造函数的形参不能为 const"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10556
msgctxt "diagnostic"
msgid "The parameter for an explicitly-defaulted move constructor may not be volatile"
msgstr "显式默认化的移动构造函数的形参不能为 volatile"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10562
msgctxt "diagnostic"
msgid "The parameter for this explicitly-defaulted copy assignment operator is const, but a member or base requires it to be non-const"
msgstr "此显式默认化的拷贝赋值运算符的形参为 const，但某个成员或基类要求其为非 const"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10562
msgctxt "diagnostic"
msgid "The parameter for this explicitly-defaulted copy constructor is const, but a member or base requires it to be non-const"
msgstr "此显式默认化的拷贝构造函数的形参为 const，但某个成员或基类要求其为非 const"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12545
msgctxt "diagnostic"
msgid "The parameter of the 'ordered' clause must be greater than or equal to the parameter of the 'collapse' clause"
msgstr "'ordered' 子句的参数必须大于或等于 'collapse' 子句的参数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13474
msgctxt "diagnostic"
msgid "The pointee of the 2nd argument must match the element type of the 1st argument (%0 != %1)"
msgstr "第 2 个实参所指向的类型必须与第 1 个实参的元素类型匹配（%0 != %1）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10711
msgctxt "diagnostic"
msgid "The pointer decremented by %0 refers before the beginning of the array"
msgstr "递减 %0 后的指针指向了数组起始位置之前"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10714
msgctxt "diagnostic"
msgid "The pointer incremented by %0 refers past the end of the array (that has type %1)"
msgstr "递增 %0 后的指针指向了数组末尾之后（该数组的类型为 %1）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10723
msgctxt "diagnostic"
msgid "The pointer incremented by %0 refers past the last possible element for an array in %1-bit address space containing %2-bit (%3-byte) elements (max possible %4 element)"
msgstr "递增 %0 后的指针越过了 %1 位地址空间中包含 %2 位（%3 字节）元素的数组的最大可能末尾元素（最多可能有 %4 个元素）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10723
msgctxt "diagnostic"
msgid "The pointer incremented by %0 refers past the last possible element for an array in %1-bit address space containing %2-bit (%3-byte) elements (max possible %4 elements)"
msgstr "递增 %0 后的指针越过了 %1 位地址空间中包含 %2 位（%3 字节）元素的数组的最大可能末尾元素（最多可能有 %4 个元素）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12691
msgctxt "diagnostic"
msgid "The referenced item is not found in any private clause on the same directive"
msgstr "在同一条指令的任何 private 子句中均未找到所引用的项"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7291
msgctxt "diagnostic"
msgid "The result of a delegate init call must be immediately returned or assigned to 'self'"
msgstr "委托 init 调用的结果必须立即返回或赋值给 'self'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3834
msgctxt "diagnostic"
msgid "The result of checking whether a value is aligned to 1 byte is a no-op"
msgstr "检查值是否按 1 字节对齐的结果是空操作（no-op）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3834
msgctxt "diagnostic"
msgid "The result of checking whether a value is aligned to 1 byte is always true"
msgstr "检查值是否按 1 字节对齐的结果总是为 true"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4572
msgctxt "diagnostic"
msgid "The resulting value is always non-negative after implicit conversion"
msgstr "隐式转换后的结果值始终为非负"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11663
msgctxt "diagnostic"
msgid "The semantics of this intrinsic changed with GCC version 4.4 - the newer semantics are provided here"
msgstr "此内建函数的语义在 GCC 4.4 版本中已更改——此处提供的是较新的语义"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12388
msgctxt "diagnostic"
msgid "The statement for '#pragma omp %0' must be a compound statement"
msgstr "'#pragma omp %0' 的语句必须是复合语句"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12418
msgctxt "diagnostic"
msgid "The statement for 'atomic capture' must be a compound statement of form '{v = x; x binop= expr;}', '{x binop= expr; v = x;}', '{v = x; x = x binop expr;}', '{v = x; x = expr binop x;}', '{x = x binop expr; v = x;}', '{x = expr binop x; v = x;}' or '{v = x; x = expr;}', '{v = x; x++;}', '{v = x; ++x;}', '{++x; v = x;}', '{x++; v = x;}', '{v = x; x--;}', '{v = x; --x;}', '{--x; v = x;}', '{x--; v = x;}' where x is an lvalue expression with scalar type"
msgstr "'atomic capture' 的语句必须是形式为 '{v = x; x binop= expr;}'、'{x binop= expr; v = x;}'、'{v = x; x = x binop expr;}'、'{v = x; x = expr binop x;}'、'{x = x binop expr; v = x;}'、'{x = expr binop x; v = x;}' 或 '{v = x; x = expr;}'、'{v = x; x++;}'、'{v = x; ++x;}'、'{++x; v = x;}'、'{x++; v = x;}'、'{v = x; x--;}'、'{v = x; --x;}'、'{--x; v = x;}'、'{x--; v = x;}' 的复合语句，其中 x 是标量类型的左值表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12415
msgctxt "diagnostic"
msgid "The statement for 'atomic capture' must be an expression statement of form 'v = ++x;', 'v = --x;', 'v = x++;', 'v = x--;', 'v = x binop= expr;', 'v = x = x binop expr' or 'v = x = expr binop x', where x and v are both lvalue expressions with scalar type"
msgstr "'atomic capture' 的语句必须是形如 'v = ++x;'、'v = --x;'、'v = x++;'、'v = x--;'、'v = x binop= expr;'、'v = x = x binop expr' 或 'v = x = expr binop x' 的表达式语句，其中 x 和 v 都是具有标量类型的左值表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12430
msgctxt "diagnostic"
msgid "The statement for 'atomic compare capture' must be a compound statement of form '{v = x; cond-up-stmt}', ''{cond-up-stmt v = x;}', '{if(x == e) {x = d;} else {v = x;}}', '{r = x == e; if(r) {x = d;}}', or '{r = x == e; if(r) {x = d;} else {v = x;}}', where 'cond-update-stmt' can have one of the following forms: 'if(expr ordop x) {x = expr;}', 'if(x ordop expr) {x = expr;}', 'if(x == e) {x = d;}', or 'if(e == x) {x = d;}' where 'x', 'r', and 'v' are lvalue expressions with scalar type, 'expr', 'e', and 'd' are expressions with scalar type, and 'ordop' is one of '<' or '>'"
msgstr "'atomic compare capture' 的语句必须是形如 '{v = x; cond-up-stmt}'、''{cond-up-stmt v = x;}'、'{if(x == e) {x = d;} else {v = x;}}'、'{r = x == e; if(r) {x = d;}}' 或 '{r = x == e; if(r) {x = d;} else {v = x;}}' 的复合语句，其中 'cond-update-stmt' 可以具有以下形式之一：'if(expr ordop x) {x = expr;}'、'if(x ordop expr) {x = expr;}'、'if(x == e) {x = d;}' 或 'if(e == x) {x = d;}'，其中 'x'、'r' 和 'v' 是具有标量类型的左值表达式，'expr'、'e' 和 'd' 是具有标量类型的表达式，而 'ordop' 是 '<' 或 '>' 之一"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12425
msgctxt "diagnostic"
msgid "The statement for 'atomic compare' must be a compound statement of form '{x = expr ordop x ? expr : x;}', '{x = x ordop expr? expr : x;}', '{x = x == e ? d : x;}', '{x = e == x ? d : x;}', or 'if(expr ordop x) {x = expr;}', 'if(x ordop expr) {x = expr;}', 'if(x == e) {x = d;}', 'if(e == x) {x = d;}' where 'x' is an lvalue expression with scalar type, 'expr', 'e', and 'd' are expressions with scalar type, and 'ordop' is one of '<' or '>'"
msgstr "'atomic compare' 的语句必须是如下形式的复合语句：'{x = expr ordop x ? expr : x;}'、'{x = x ordop expr? expr : x;}'、'{x = x == e ? d : x;}'、'{x = e == x ? d : x;}'，或 'if(expr ordop x) {x = expr;}'、'if(x ordop expr) {x = expr;}'、'if(x == e) {x = d;}'、'if(e == x) {x = d;}'，其中 'x' 为标量类型的左值表达式，'expr'、'e' 和 'd' 为标量类型的表达式，'ordop' 为 '<' 或 '>'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12397
msgctxt "diagnostic"
msgid "The statement for 'atomic read' must be an expression statement of form 'v = x;', where v and x are both lvalue expressions with scalar type"
msgstr "'atomic read' 的语句必须是形如 'v = x;' 的表达式语句，其中 v 和 x 都是标量类型的左值表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12405
msgctxt "diagnostic"
msgid "The statement for 'atomic update' must be an expression statement of form '++x;', '--x;', 'x++;', 'x--;', 'x binop= expr;', 'x = x binop expr' or 'x = expr binop x', where x is an lvalue expression with scalar type"
msgstr "'atomic update' 的语句必须是形式为 '++x;'、'--x;'、'x++;'、'x--;'、'x binop= expr;'、'x = x binop expr' 或 'x = expr binop x' 的表达式语句，其中 x 是具有标量类型的左值表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12402
msgctxt "diagnostic"
msgid "The statement for 'atomic write' must be an expression statement of form 'x = expr;', where x is a lvalue expression with scalar type"
msgstr "'atomic write' 的语句必须是形式为 'x = expr;' 的表达式语句，其中 x 是标量类型的左值表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12408
msgctxt "diagnostic"
msgid "The statement for 'atomic' must be an expression statement of form '++x;', '--x;', 'x++;', 'x--;', 'x binop= expr;', 'x = x binop expr' or 'x = expr binop x', where x is an lvalue expression with scalar type"
msgstr "'atomic' 的语句必须是形如 '++x;'、'--x;'、'x++;'、'x--;'、'x binop= expr;'、'x = x binop expr' 或 'x = expr binop x' 的表达式语句，其中 x 是标量类型的左值表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1789
msgctxt "diagnostic"
msgid "The string object in this asm operand is missing 'data()' and 'size()' member functions"
msgstr "字符串对象（位于此内联汇编操作数中）缺少 'data()' 和 'size()' 成员函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1789
msgctxt "diagnostic"
msgid "The string object in this asm operand is missing a 'data()' member function"
msgstr "字符串对象（位于此内联汇编操作数中）缺少 'data()' 成员函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1789
msgctxt "diagnostic"
msgid "The string object in this asm operand is missing a 'size()' member function"
msgstr "字符串对象（位于此内联汇编操作数中）缺少 'size()' 成员函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1789
msgctxt "diagnostic"
msgid "The string object in this static assertion is missing 'data()' and 'size()' member functions"
msgstr "字符串对象（位于此静态断言中）缺少 'data()' 和 'size()' 成员函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1789
msgctxt "diagnostic"
msgid "The string object in this static assertion is missing a 'data()' member function"
msgstr "字符串对象（位于此静态断言中）缺少 'data()' 成员函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1789
msgctxt "diagnostic"
msgid "The string object in this static assertion is missing a 'size()' member function"
msgstr "字符串对象（位于此静态断言中）缺少 'size()' 成员函数"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1889
msgctxt "diagnostic"
msgid "The total number of preprocessor source tokens (%0) exceeds the token limit (%1)"
msgstr "预处理器源码词法单元总数（%0）超出了词法单元限制（%1）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13916
msgctxt "diagnostic"
msgid "The two-parameter std::span construction is unsafe as it can introduce mismatch between buffer size and the bound information"
msgstr "双参数 std::span 构造是不安全的，因为它可能引入缓冲大小与边界信息之间的不匹配"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3648
msgctxt "diagnostic"
msgid "The type %0 is already explicitly ownership-qualified"
msgstr "类型 %0 已经具有显式的所有权限定"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11644
msgctxt "diagnostic"
msgid "The type %0 is not a pointer to a fast-enumerable object"
msgstr "类型 %0 不是指向支持快速枚举对象的指针"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9053
msgctxt "diagnostic"
msgid "The type of object expression (%0) does not match the type being destroyed (%1) in pseudo-destructor expression"
msgstr "伪析构函数表达式中对象表达式的类型（%0）与被销毁的类型（%1）不匹配"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9053
msgctxt "diagnostic"
msgid "The type of object expression does not match the type being destroyed in pseudo-destructor expression"
msgstr "伪析构函数表达式中对象表达式的类型与被销毁的类型不匹配"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10553
msgctxt "diagnostic"
msgid "The type of the explicit object parameter of an explicitly-defaulted copy assignment operator should be reference to %1"
msgstr "显式默认化的拷贝赋值运算符的显式对象形参类型应为到 %1 的引用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10553
msgctxt "diagnostic"
msgid "The type of the explicit object parameter of an explicitly-defaulted move assignment operator should be reference to %1"
msgstr "显式默认化的移动赋值运算符的显式对象形参类型应为到 %1 的引用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5655
msgctxt "diagnostic"
msgid "The type of variable template specialization %0 declared with deduced type %1 depends on itself"
msgstr "使用推导类型 %1 声明的变量模板特化 %0 的类型依赖于其自身"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12722
msgctxt "diagnostic"
msgid "The user condition in the OpenMP context selector needs to be constant; %0 is not"
msgstr "OpenMP 上下文选择器中的用户条件必须为常量；%0 不是常量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12515
msgctxt "diagnostic"
msgid "The value of 'simdlen' parameter must be less than or equal to the value of the 'safelen' parameter"
msgstr "'simdlen' 参数的值必须小于或等于 'safelen' 参数的值"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:944
msgctxt "diagnostic"
msgid "The value of the size argument in 'strncat' is too large, might lead to a buffer overflow"
msgstr "'strncat' 中大小实参的值过大，可能会导致缓冲溢出"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:949
msgctxt "diagnostic"
msgid "The value of the size argument to 'strncat' is wrong"
msgstr "传递给 'strncat' 的大小实参值有误"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4081
msgctxt "diagnostic"
msgid "The vecreturn attribute can only be used on a POD (plain old data) class or structure (i.e. no virtual functions)"
msgstr "vecreturn 属性只能用于 POD (普通旧数据) 类或结构体 (即没有虚函数)"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4079
msgctxt "diagnostic"
