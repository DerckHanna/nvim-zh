msgstr "为了与 GCC 兼容，允许混合使用 'target_clones' 说明符机制；请使用逗号分隔的字符串字面量序列，或包含逗号分隔版本列表的单个字符串字面量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11608
msgctxt "diagnostic"
msgid "Mixing declarations and code is a C99 extension"
msgstr "混合声明与代码是 C99 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11611
msgctxt "diagnostic"
msgid "Mixing declarations and code is incompatible with standards before C99"
msgstr "混用声明和代码与 C99 之前的标准不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:303
msgctxt "diagnostic"
msgid "Mixture of designated and non-designated initializers in the same initializer list is a C99 extension"
msgstr "在同一初始化器列表中混用指派初始化器和非指派初始化器是 C99 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4851
msgctxt "diagnostic"
msgid "Mode %0 is not supported for enumeration types"
msgstr "枚举类型不支持模式 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4838
msgctxt "diagnostic"
msgid "Mode attribute only supported for integer and floating-point types"
msgstr "mode 属性仅支持整数和浮点类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12583
msgctxt "diagnostic"
msgid "Modifier '%0' cannot be used along with modifier '%1'"
msgstr "修饰符 '%0' 不能与修饰符 '%1' 一起使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12587
msgctxt "diagnostic"
msgid "Modifier '%0' cannot be used along with modifier '%1' in dyn_groupprivate"
msgstr "在 dyn_groupprivate 中，修饰符 '%0' 不能与修饰符 '%1' 一起使用"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:455
msgctxt "diagnostic"
msgid "Modifier '%0' is currently not supported on a GPU for the '%1' clause; modifier ignored"
msgstr "GPU 上当前不支持 '%1' 子句的修饰符 '%0'；已忽略修饰符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:604
msgctxt "diagnostic"
msgid "Modifying constructor parameter %0 that shadows a field of %1"
msgstr "正在修改遮蔽了 %1 字段的构造函数形参 %0"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:1010
msgctxt "diagnostic"
msgid "Module %0 does not depend on a module exporting '%1'"
msgstr "模块 %0 不依赖于导出 '%1' 的模块"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:1014
msgctxt "diagnostic"
msgid "Module %0 does not depend on a module exporting '%1', which is part of module %2, although its private module does"
msgstr "模块 %0 不依赖于导出 '%1'（其属于模块 %2）的模块，尽管其私有模块依赖"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:1012
msgctxt "diagnostic"
msgid "Module %0 does not directly depend on a module exporting '%1', which is part of indirectly-used module %2"
msgstr "模块 %0 不直接依赖于导出 '%1' 的模块，该符号是间接使用的模块 %2 的一部分"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:971
msgctxt "diagnostic"
msgid "Module '%0' already re-exported as '%1'"
msgstr "模块 '%0' 已重新导出为 '%1'"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:1022
msgctxt "diagnostic"
msgid "Module '%0' conflicts with already-imported module '%1': %2"
msgstr "模块 '%0' 与已导入的模块 '%1' 冲突：%2"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:110
msgctxt "diagnostic"
msgid "Module '%0' is incompatible with feature '%2'"
msgstr "模块 '%0' 与特性 '%2' 不兼容"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:107
msgctxt "diagnostic"
msgid "Module '%0' is needed but has not been provided, and implicit use of module files is disabled"
msgstr "需要模块 '%0' 但未提供，且已禁用模块文件的隐式使用"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:104
msgctxt "diagnostic"
msgid "Module '%0' not found"
msgstr "找不到模块 '%0'"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:110
msgctxt "diagnostic"
msgid "Module '%0' requires feature '%2'"
msgstr "模块 '%0' 需要特性 '%2'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1812
msgctxt "diagnostic"
msgid "Module declaration can only appear at the top level"
msgstr "module 声明只能出现在顶层"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:1048
msgctxt "diagnostic"
msgid "Module declaration must not come from an #include directive"
msgstr "模块声明不能来自 #include 指令"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12945
msgctxt "diagnostic"
msgid "Module declaration must occur at the start of the translation unit"
msgstr "模块声明必须出现在翻译单元的开头"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:1050
msgctxt "diagnostic"
msgid "Module directive lines are not allowed on lines controlled by preprocessor conditionals"
msgstr "模块指令行不允许出现在受预处理器条件控制的行上"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1842
msgctxt "diagnostic"
msgid "Module imports cannot be in the global module fragment"
msgstr "模块导入不能位于全局模块片段中"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1842
msgctxt "diagnostic"
msgid "Module imports cannot be in the private module fragment"
msgstr "模块导入不能位于私有模块片段中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12882
msgctxt "diagnostic"
msgid "Module name '%0' specified on command line does not match name of module"
msgstr "命令行中指定的模块名 '%0' 与模块名称不匹配"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:1038
msgctxt "diagnostic"
msgid "Module name component %1 cannot be a object-like macro"
msgstr "模块名称组件 %1 不能是对象式宏"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12967
msgctxt "diagnostic"
msgid "Module partition implementations cannot be exported"
msgstr "模块分区实现无法导出"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1842
msgctxt "diagnostic"
msgid "Module partition imports cannot be in the global module fragment"
msgstr "模块分区导入不能位于全局模块片段中"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1842
msgctxt "diagnostic"
msgid "Module partition imports cannot be in the private module fragment"
msgstr "模块分区导入不能位于私有模块片段中"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1840
msgctxt "diagnostic"
msgid "Module partition imports must be within a module purview"
msgstr "模块分区导入必须在模块管辖范围内"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1836
msgctxt "diagnostic"
msgid "Module partitions are only supported for C++20 onwards"
msgstr "模块分区仅从 C++20 开始受支持"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10740
msgctxt "diagnostic"
msgid "More '%%' conversions than data arguments"
msgstr "'%%' 转换说明符多于数据实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10742
msgctxt "diagnostic"
msgid "More specifiers in format string than expected"
msgstr "格式字符串中的说明符比预期的多"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1697
msgctxt "diagnostic"
msgid "More than one 'device_type' clause is specified"
msgstr "指定了多个 'device_type' 子句"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14128
msgctxt "diagnostic"
msgid "More than one for-loop in a loop associated with OpenACC '%0' construct with a '%1' clause"
msgstr "带有 '%1' 子句的 OpenACC '%0' 构造所关联的循环中包含多个 for 循环"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10153
msgctxt "diagnostic"
msgid "More than one input constraint matches the same output '%0'"
msgstr "多个输入约束匹配同一个输出 '%0'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10572
msgctxt "diagnostic"
msgid "Move assignment operator cannot be 'constexpr' in a class with virtual base class"
msgstr "在具有虚基类的类中，移动赋值运算符不能为 'constexpr'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10572
msgctxt "diagnostic"
msgid "Move constructor cannot be 'constexpr' in a class with virtual base class"
msgstr "在具有虚基类的类中，移动构造函数不能为 'constexpr'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7690
msgctxt "diagnostic"
msgid "Moving a local object in a return statement prevents copy elision"
msgstr "在 return 语句中移动局部对象会阻止复制消除"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7693
msgctxt "diagnostic"
msgid "Moving a temporary object prevents copy elision"
msgstr "移动临时对象会阻止复制消除"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1210
msgctxt "diagnostic"
msgid "Ms_struct may not produce Microsoft-compatible layouts for classes with base classes or virtual functions"
msgstr "ms_struct 对于具有基类或虚函数的类可能不会生成与 Microsoft 兼容的布局"

#: clang/include/clang/Basic/DiagnosticASTKinds.td:1031
msgctxt "diagnostic"
msgid "Ms_struct may not produce Microsoft-compatible layouts with fundamental data types with sizes that aren't a power of two"
msgstr "对于大小不是 2 的幂的基本数据类型，ms_struct 可能无法生成与 Microsoft 兼容的布局"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:124
#: clang/include/clang/Basic/DiagnosticLexKinds.td:126
msgctxt "diagnostic"
msgid "Multi-character character constant"
msgstr "多字符的字符常量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13962
msgctxt "diagnostic"
msgid "Multi-dimensional arrays of WebAssembly references are not allowed"
msgstr "不允许 WebAssembly 引用的多维数组"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:50
msgctxt "diagnostic"
msgid "Multi-line // comment"
msgstr "多行 // 注释"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3586
msgctxt "diagnostic"
msgid "Multiple '%0' attributes specified"
msgstr "指定了多个 '%0' 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3563
msgctxt "diagnostic"
msgid "Multiple 'callback' attributes specified"
msgstr "指定了多个 'callback' 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13329
msgctxt "diagnostic"
msgid "Multiple 'cpu_specific' functions cannot specify the same CPU: %0"
msgstr "多个 'cpu_specific' 函数不能指定相同的 CPU：%0"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1508
msgctxt "diagnostic"
msgid "Multiple 'linear modifier' found in linear clause"
msgstr "linear 子句中发现多个 'linear modifier'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14255
msgctxt "diagnostic"
msgid "Multiple 'routine' directives with 'bind' clauses are not permitted to refer to the same function"
msgstr "不允许多个带有 'bind' 子句的 'routine' 指令指向同一个函数"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1508
msgctxt "diagnostic"
msgid "Multiple 'step size' found in linear clause"
msgstr "linear 子句中发现多个 'step size'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11970
msgctxt "diagnostic"
msgid "Multiple access qualifiers"
msgstr "多个访问限定符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3625
msgctxt "diagnostic"
msgid "Multiple address spaces specified for type"
msgstr "为类型指定了多个地址空间"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12167
msgctxt "diagnostic"
msgid "Multiple array elements associated with the same variable are not allowed in map clauses of the same construct"
msgstr "同一构造的 map 子句中不允许存在与同一变量关联的多个数组元素"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:986
msgctxt "diagnostic"
msgid "Multiple candidates for header '%0' found; directory '%1' chosen, ignoring others including '%2'"
msgstr "找到头文件 '%0' 的多个候选；已选择目录 '%1'，忽略包括 '%2' 在内的其他目录"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14017
msgctxt "diagnostic"
msgid "Multiple conversions from expression type %0 to an integral type"
msgstr "从表达式类型 %0 到整型存在多个转换"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11356
msgctxt "diagnostic"
msgid "Multiple conversions from switch condition type %0 to an integral or enumeration type"
msgstr "从 switch 条件类型 %0 到整数或枚举类型存在多个转换"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1511
msgctxt "diagnostic"
msgid "Multiple declarations of method %0 found and ignored"
msgstr "找到方法 %0 的多个声明并已忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11354
msgctxt "diagnostic"
msgid "Multiple default labels in one switch"
msgstr "同一个 switch 中有多个 default 标签"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1135
msgctxt "diagnostic"
msgid "Multiple ellipses in pack capture"
msgstr "包捕获中存在多个省略号"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8439
msgctxt "diagnostic"
msgid "Multiple garbage collection attributes specified for type"
msgstr "为类型指定了多个垃圾回收属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3627
msgctxt "diagnostic"
msgid "Multiple identical address spaces specified for type"
msgstr "为类型指定了多个相同的地址空间"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10214
msgctxt "diagnostic"
msgid "Multiple initializations given for base %0"
msgstr "为基类 %0 提供了多次初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10210
msgctxt "diagnostic"
msgid "Multiple initializations given for non-static member %0"
msgstr "为非静态成员 %0 指定了多次初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1498
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1500
msgctxt "diagnostic"
msgid "Multiple methods named %0 found"
msgstr "找到多个名为 %0 的方法"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7385
msgctxt "diagnostic"
msgid "Multiple methods named %0 found with mismatched result, parameter type or attributes"
msgstr "找到多个名为 %0 的方法，其返回类型、形参类型或属性不匹配"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7798
msgctxt "diagnostic"
msgid "Multiple overloads of %0 instantiate to the same signature %1"
msgstr "%0 的多个重载实例化为相同的签名 %1"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1137
msgctxt "diagnostic"
msgid "Multiple packs in structured binding declaration"
msgstr "结构化绑定声明中存在多个包"

#: clang/include/clang/Basic/Diagnostic.td:201
msgctxt "diagnostic"
msgid "Multiple return statements in constexpr function is a C++14 extension"
msgstr "constexpr 函数中的多个 return 语句是 C++14 扩展"

#: clang/include/clang/Basic/Diagnostic.td:209
msgctxt "diagnostic"
msgid "Multiple return statements in constexpr function is incompatible with C++ standards before C++14"
msgstr "constexpr 函数中的多个 return 语句与 C++14 之前的 C++ 标准不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8725
msgctxt "diagnostic"
msgid "Multiple suitable %0 functions for %1; no 'operator delete' function will be invoked if initialization throws an exception"
msgstr "存在多个适用于 %1 的 %0 函数；如果初始化抛出异常，将不会调用任何 'operator delete' 函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8723
msgctxt "diagnostic"
msgid "Multiple suitable %0 functions in %1"
msgstr "%1 中存在多个合适的 %0 函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2610
msgctxt "diagnostic"
msgid "Multiple unsequenced modifications to %0"
msgstr "对 %0 进行了多次无序修改"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13623
msgctxt "diagnostic"
msgid "Multiple vtable pointer authentication policies on %0"
msgstr "%0 上存在多个虚表指针认证策略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13309
msgctxt "diagnostic"
msgid "Multiversioned function declaration has a different calling convention"
msgstr "多版本函数声明具有不同的调用约定"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13309
msgctxt "diagnostic"
msgid "Multiversioned function declaration has a different constexpr specification"
msgstr "多版本函数声明具有不同的constexpr 说明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13309
msgctxt "diagnostic"
msgid "Multiversioned function declaration has a different inline specification"
msgstr "多版本函数声明具有不同的inline 说明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13309
msgctxt "diagnostic"
msgid "Multiversioned function declaration has a different language linkage"
msgstr "多版本函数声明具有不同的语言链接"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13309
msgctxt "diagnostic"
msgid "Multiversioned function declaration has a different linkage"
msgstr "多版本函数声明具有不同的链接"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13309
msgctxt "diagnostic"
msgid "Multiversioned function declaration has a different return type"
msgstr "多版本函数声明具有不同的返回类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13302
msgctxt "diagnostic"
msgid "Multiversioned function must have a prototype"
msgstr "多版本函数必须具有原型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13300
msgctxt "diagnostic"
msgid "Multiversioned function redeclarations require identical target attributes"
msgstr "多版本函数重新声明需要相同的目标属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13325
msgctxt "diagnostic"
msgid "Multiversioning attributes cannot be combined"
msgstr "多版本属性不能组合使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7362
msgctxt "diagnostic"
msgid "Must explicitly describe intended ownership of an object array parameter"
msgstr "必须显式描述对象数组形参的预期所有权"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7954
msgctxt "diagnostic"
msgid "Must explicitly qualify name of member function when taking its address"
msgstr "获取成员函数的地址时必须显式限定其名称"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1231
msgctxt "diagnostic"
msgid "Must handle potential future platforms with '*'"
msgstr "必须使用 '*' 处理潜在的未来平台"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:762
msgctxt "diagnostic"
msgid "Must specify '-fmodule-name=%0' to enter submodule of this module"
msgstr "必须指定 '-fmodule-name=%0' 才能进入此模块的子模块"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:762
msgctxt "diagnostic"
msgid "Must specify '-fmodule-name=%0' to enter submodule of this module (current module is %3)"
msgstr "必须指定 '-fmodule-name=%0' 才能进入此模块的子模块（当前模块为 %3）"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:762
msgctxt "diagnostic"
msgid "Must specify '-fmodule-name=%0' to enter this module"
msgstr "必须指定 '-fmodule-name=%0' 才能进入此模块"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:762
msgctxt "diagnostic"
msgid "Must specify '-fmodule-name=%0' to enter this module (current module is %3)"
msgstr "必须指定 '-fmodule-name=%0' 才能进入此模块（当前模块为 %3）"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:191
msgctxt "diagnostic"
msgid "Must use '%1' tag to refer to type %0"
msgstr "必须使用 '%1' 标签来引用类型 %0"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:191
msgctxt "diagnostic"
msgid "Must use '%1' tag to refer to type %0 in this scope"
msgstr "在此作用域中必须使用 '%1' 标签来引用类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1904
msgctxt "diagnostic"
msgid "Must use a qualified name when declaring a constructor as a friend"
msgstr "将构造函数声明为友元时必须使用限定名称"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1904
msgctxt "diagnostic"
msgid "Must use a qualified name when declaring a conversion operator as a friend"
msgstr "将转换运算符声明为友元时必须使用限定名称"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1904
msgctxt "diagnostic"
msgid "Must use a qualified name when declaring a deduction guide as a friend"
msgstr "将推导指引声明为友元时必须使用限定名称"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1904
msgctxt "diagnostic"
msgid "Must use a qualified name when declaring a destructor as a friend"
msgstr "将析构函数声明为友元时必须使用限定名称"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1059
msgctxt "diagnostic"
msgid "Name defined in alias declaration must be an identifier"
msgstr "别名声明中定义的名称必须是标识符"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1872
msgctxt "diagnostic"
msgid "Name defined in concept definition must be an identifier"
msgstr "概念定义中定义的名称必须是标识符"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:221
msgctxt "diagnostic"
msgid "Named 'break' is only supported in C2y"
msgstr "仅在 C2y 中支持具名 'break'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:221
msgctxt "diagnostic"
msgid "Named 'continue' is only supported in C2y"
msgstr "仅在 C2y 中支持具名 'continue'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6873
msgctxt "diagnostic"
msgid "Named bit-field %0 has zero width"
msgstr "具名位域 %0 的宽度为零"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:152
msgctxt "diagnostic"
msgid "Named escape sequences are a C++23 extension"
msgstr "命名转义序列是 C++23 扩展"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:152
msgctxt "diagnostic"
msgid "Named escape sequences are a C2y extension"
msgstr "命名转义序列是 C2y 扩展"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:152
msgctxt "diagnostic"
msgid "Named escape sequences are a Clang extension"
msgstr "命名转义序列是 Clang 扩展"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:155
msgctxt "diagnostic"
