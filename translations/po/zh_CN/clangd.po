msgid "The message in this asm operand must have a 'data()' member function returning an object convertible to 'const char *'"
msgstr "消息（位于此内联汇编操作数中）必须具有 'data()' 成员函数，且其返回值可转换为 'const char *'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1795
