#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10424
msgctxt "diagnostic"
msgid "Destroying %2 must have at least one parameters"
msgstr "销毁型（destroying）%2 必须至少有 1 个形参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10424
msgctxt "diagnostic"
msgid "Destroying %2 must have at least three parameter"
msgstr "销毁型（destroying）%2 必须至少有 3 个形参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10424
msgctxt "diagnostic"
msgid "Destroying %2 must have at least three parameters"
msgstr "销毁型（destroying）%2 必须至少有 3 个形参"

