msgstr "迭代器类型应为整型或指针类型，而不是 %0"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1706
msgctxt "diagnostic"
msgid "Expected interop type: 'target' and/or 'targetsync'"
msgstr "期望 interop 类型：'target' 和/或 'targetsync'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12577
msgctxt "diagnostic"
msgid "Expected iterator specification as depend modifier"
msgstr "需要迭代器规范作为 depend 修饰符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12579
msgctxt "diagnostic"
msgid "Expected iterator specification as map modifier"
msgstr "期望迭代器说明作为 map 修饰符"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:904
msgctxt "diagnostic"
msgid "Expected library name as a string"
msgstr "期望字符串形式的库名称"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12756
msgctxt "diagnostic"
msgid "Expected list item of scalar type in 'lastprivate' clause with 'conditional' modifier"
msgstr "带有 'conditional' 修饰符的 'lastprivate' 子句中期望标量类型的列表项"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12695
msgctxt "diagnostic"
msgid "Expected loop invariant expression"
msgstr "应为循环不变表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12697
msgctxt "diagnostic"
msgid "Expected loop invariant expression or '<invariant1> * %0 + <invariant2>' kind of expression"
msgstr "期望循环不变量表达式或 '<invariant1> * %0 + <invariant2>' 形式的表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12563
msgctxt "diagnostic"
msgid "Expected loop iteration variable"
msgstr "期望 循环迭代变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12650
msgctxt "diagnostic"
msgid "Expected lvalue expression"
msgstr "预期为左值表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12650
msgctxt "diagnostic"
msgid "Expected lvalue expression of 'omp_depend_t' type, not %1"
msgstr "预期为 'omp_depend_t' 类型的左值表达式，而不是 %1"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:235
msgctxt "diagnostic"
msgid "Expected member name or ';' after declaration specifiers"
msgstr "声明说明符后需要成员名称或 ';'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:617
msgctxt "diagnostic"
msgid "Expected member name or ';' after declaration specifiers; %0 is a keyword in Objective-C++"
msgstr "在声明说明符后需要成员名或 ';'；%0 是 Objective-C++ 中的关键字"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:266
msgctxt "diagnostic"
msgid "Expected method body"
msgstr "应为方法体"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8307
msgctxt "diagnostic"
msgid "Expected method to read array element not found on object of type %0"
msgstr "在类型为 %0 的对象上未找到用于读取数组元素的预期方法"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8307
msgctxt "diagnostic"
msgid "Expected method to read dictionary element not found on object of type %0"
msgstr "在类型为 %0 的对象上未找到用于读取字典元素的预期方法"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8307
msgctxt "diagnostic"
msgid "Expected method to write array element not found on object of type %0"
msgstr "在类型为 %0 的对象上未找到用于写入数组元素的预期方法"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8307
msgctxt "diagnostic"
msgid "Expected method to write dictionary element not found on object of type %0"
msgstr "在类型为 %0 的对象上未找到用于写入字典元素的预期方法"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1746
msgctxt "diagnostic"
msgid "Expected modifier in '%0' clause"
msgstr "'%0' 子句中缺少修饰符"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:879
msgctxt "diagnostic"
msgid "Expected module declaration"
msgstr "应为模块声明"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:937
msgctxt "diagnostic"
msgid "Expected module exclusion with 'exclude'"
msgstr "预期使用 'exclude' 排除模块"

