msgid "'delete[]' applied to a pointer that was allocated with 'new'; did you mean 'delete'?"
msgstr "'delete[]' 被应用于由 'new' 分配的指针；您是指 'delete' 吗？"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8716
msgctxt "diagnostic"
msgid "'delete[]' applied to a pointer that was allocated with 'new'; did you mean 'delete[]'?"
msgstr "'delete[]' 被应用于由 'new' 分配的指针；您是指 'delete[]' 吗？"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8716
msgctxt "diagnostic"
msgid "'delete[]' applied to a pointer that was allocated with 'new[]'; did you mean 'delete'?"
msgstr "'delete[]' 被应用于由 'new[]' 分配的指针；您是指 'delete' 吗？"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8716
msgctxt "diagnostic"
msgid "'delete[]' applied to a pointer that was allocated with 'new[]'; did you mean 'delete[]'?"
msgstr "'delete[]' 被应用于由 'new[]' 分配的指针；您是指 'delete[]' 吗？"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1740
msgctxt "diagnostic"
msgid "'depend' clause for 'ordered' is deprecated; use 'doacross' instead"
msgstr "用于 'ordered' 的 'depend' 子句已弃用；请改用 'doacross'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12806
msgctxt "diagnostic"
msgid "'depend' clause requires the 'targetsync' interop type"
msgstr "'depend' 子句需要 'targetsync' 互操作类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6379
msgctxt "diagnostic"
msgid "'deprecated' attribute on anonymous namespace ignored"
msgstr "忽略匿名命名空间上的 'deprecated' 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12706
msgctxt "diagnostic"
msgid "'device_type(%0)' does not match previously specified 'device_type(%1)' for the same declaration"
msgstr "'device_type(%0)' 与先前为同一声明指定的 'device_type(%1)' 不匹配"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12288
msgctxt "diagnostic"
msgid "'device_type(nohost)' is not yet supported with 'local' clause; treating as 'device_type(any)'"
msgstr "'device_type(nohost)' 尚不支持与 'local' 子句一起使用；将其视为 'device_type(any)'"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:271
msgctxt "diagnostic"
msgid "'diagnose_if' is a clang extension"
msgstr "'diagnose_if' 是 clang 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3987
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3990
msgctxt "diagnostic"
msgid "'dllexport' attribute ignored on explicit instantiation definition"
msgstr "显式实例化定义上的 'dllexport' 属性已被忽略"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:269
msgctxt "diagnostic"
msgid "'enable_if' is a clang extension"
msgstr "'enable_if' 是 clang 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2206
msgctxt "diagnostic"
msgid "'explicit' can only appear on non-static member functions"
msgstr "'explicit' 只能出现在非静态成员函数上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2210
msgctxt "diagnostic"
msgid "'explicit' can only be applied to a constructor or conversion function"
msgstr "'explicit' 只能应用于构造函数或转换函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2208
msgctxt "diagnostic"
msgid "'explicit' can only be specified inside the class definition"
msgstr "'explicit' 只能在类定义内部指定"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:941
msgctxt "diagnostic"
msgid "'explicit' is not permitted on top-level modules"
msgstr "顶层模块上不允许使用 'explicit'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6763
msgctxt "diagnostic"
msgid "'extern' variable has an initializer"
msgstr "'extern' 变量带有初始化器"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14239
msgctxt "diagnostic"
msgid "'extern' variable may not be referenced by '%0' clause on an OpenACC 'declare' directive"
msgstr "'extern' 变量不能被 OpenACC 'declare' 指令上的 '%0' 子句引用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12759
msgctxt "diagnostic"
msgid "'flush' directive with memory order clause '%0' cannot have the list"
msgstr "带有内存序子句 '%0' 的 'flush' 指令不能包含列表"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1866
msgctxt "diagnostic"
msgid "'for co_await' belongs to CoroutineTS instead of C++20, which is deprecated"
msgstr "'for co_await' 属于 CoroutineTS 而非 C++20，已被弃用"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:458
msgctxt "diagnostic"
msgid "'for template' is invalid; use 'template for' instead"
msgstr "'for template' 无效；请改用 'template for'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1922
msgctxt "diagnostic"
msgid "'friend' must appear first in a non-function declaration"
msgstr "'friend' 在非函数声明中必须出现在最前面"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:487
msgctxt "diagnostic"
msgid "'friend' used outside of class"
msgstr "在类外部使用了 'friend'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4071
msgctxt "diagnostic"
msgid "'gnu_inline' attribute requires function to be marked 'inline', attribute ignored"
msgstr "'gnu_inline' 属性要求函数标记为 'inline'，属性已被忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4075
msgctxt "diagnostic"
msgid "'gnu_inline' attribute without 'extern' in C++ treated as externally available, this changed in Clang 10"
msgstr "C++ 中不带 'extern' 的 'gnu_inline' 属性被视为外部可用，此行为在 Clang 10 中已变更"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3951
msgctxt "diagnostic"
msgid "'hybrid_patchable' is ignored on functions without external linkage"
msgstr "在没有外部链接的函数上忽略 'hybrid_patchable'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:735
msgctxt "diagnostic"
msgid "'if' initialization statements are a C++17 extension"
msgstr "'if' 初始化语句是 C++17 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:570
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:572
msgctxt "diagnostic"
msgid "'inline' can only appear on functions"
msgstr "'inline' 只能出现在函数上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:570
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:572
msgctxt "diagnostic"
msgid "'inline' can only appear on functions and non-local variables"
msgstr "'inline' 只能出现在函数和非局部变量上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12664
msgctxt "diagnostic"
msgid "'inscan' modifier can be used only in 'omp for', 'omp simd', 'omp for simd', 'omp parallel for', or 'omp parallel for simd' directive"
msgstr "'inscan' 修饰符只能在 'omp for'、'omp simd'、'omp for simd'、'omp parallel for' 或 'omp parallel for simd' 指令中使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6540
msgctxt "diagnostic"
msgid "'internal_linkage' attribute on a non-static local variable is ignored"
msgstr "非静态局部变量上的 'internal_linkage' 属性已被忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3583
msgctxt "diagnostic"
msgid "'lifetime_capture_by' argument references itself"
msgstr "'lifetime_capture_by' 实参引用了其自身"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3576
msgctxt "diagnostic"
msgid "'lifetime_capture_by' argument references unavailable implicit 'this'"
msgstr "'lifetime_capture_by' 实参引用了不可用的隐式 'this'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3580
msgctxt "diagnostic"
msgid "'lifetime_capture_by' attribute argument %0 is not a known function parameter; must be a function parameter, 'this', 'global' or 'unknown'"
msgstr "'lifetime_capture_by' 属性实参 %0 不是已知的函数形参；必须是函数形参、'this'、'global' 或 'unknown'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3574
msgctxt "diagnostic"
msgid "'lifetime_capture_by' attribute specifies no capturing entity"
msgstr "'lifetime_capture_by' 属性未指定捕获实体"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3588
msgctxt "diagnostic"
msgid "'lifetime_capture_by(%0)' is deprecated; use '%1' instead"
msgstr "'lifetime_capture_by(%0)' 已弃用；请改用 '%1'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3578
msgctxt "diagnostic"
msgid "'lifetime_capture_by_this' attribute requires an implicit object parameter"
msgstr "'lifetime_capture_by_this' 属性需要隐式对象形参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10905
msgctxt "diagnostic"
msgid "'lifetimebound' attribute cannot be applied to a constructor"
msgstr "'lifetimebound' 属性不能应用于构造函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10905
msgctxt "diagnostic"
msgid "'lifetimebound' attribute cannot be applied to a destructor"
msgstr "'lifetimebound' 属性不能应用于析构函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10908
msgctxt "diagnostic"
msgid "'lifetimebound' attribute cannot be applied to a parameter of a function that returns void; did you mean 'lifetime_capture_by(X)'"
msgstr "'lifetimebound' 属性不能应用于返回 void 的函数的形参；您是指 'lifetime_capture_by(X)' 吗"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10911
msgctxt "diagnostic"
msgid "'lifetimebound' attribute cannot be applied to an implicit object parameter of a function that returns void; did you mean 'lifetime_capture_by(X)'"
msgstr "'lifetimebound' 属性不能应用于返回 void 的函数的隐式对象形参；是否意指 'lifetime_capture_by(X)'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10901
msgctxt "diagnostic"
msgid "'lifetimebound' attribute cannot be applied; explicit object member function has no implicit object parameter"
msgstr "无法应用 'lifetimebound' 属性；显式对象成员函数没有隐式对象形参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10901
msgctxt "diagnostic"
msgid "'lifetimebound' attribute cannot be applied; non-member function has no implicit object parameter"
msgstr "无法应用 'lifetimebound' 属性；非成员函数没有隐式对象形参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10901
msgctxt "diagnostic"
msgid "'lifetimebound' attribute cannot be applied; static member function has no implicit object parameter"
msgstr "无法应用 'lifetimebound' 属性；静态成员函数没有隐式对象形参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11090
msgctxt "diagnostic"
msgid "'lifetimebound' attribute has no effect on parameter of type %0. The attribute only applies to reference types, pointer types, and non-owner record types"
msgstr "'lifetimebound' 属性对类型 %0 的形参无效。该属性仅适用于引用类型、指针类型和非所有权记录类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11080
msgctxt "diagnostic"
msgid "'lifetimebound' attribute on this definition is not visible to callers before the definition; add it to the declaration instead"
msgstr "此定义上的 'lifetimebound' 特性在定义之前对调用方不可见；请改将其添加到声明中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11085
msgctxt "diagnostic"
msgid "'lifetimebound' attribute on this definition is not visible to callers in other translation units; add it to the declaration instead"
msgstr "此定义上的 'lifetimebound' 属性对其他翻译单元中的调用方不可见；请改为将其添加到声明中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12581
msgctxt "diagnostic"
msgid "'linear' clause cannot be specified along with 'ordered' clause with a parameter"
msgstr "'linear' 子句不能与带参数的 'ordered' 子句一起指定"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12285
msgctxt "diagnostic"
msgid "'local' clause is incompatible with 'device_type(host)'; local variables exist only on the device"
msgstr "'local' 子句与 'device_type(host)' 不兼容；局部变量仅存在于设备上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:342
msgctxt "diagnostic"
msgid "'long %1' is invalid"
msgstr "'long %1' 无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:342
msgctxt "diagnostic"
msgid "'long long %1' is invalid"
msgstr "'long long %1' 无效"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:220
msgctxt "diagnostic"
msgid "'long long' is a C++11 extension"
msgstr "'long long' 是 C++11 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11946
msgctxt "diagnostic"
msgid "'long long' is a reserved data type in OpenCL C"
msgstr "'long long' 是 OpenCL C 中的保留数据类型"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:217
msgctxt "diagnostic"
msgid "'long long' is an extension when C99 mode is not enabled"
msgstr "未启用 C99 模式时，'long long' 是扩展特性"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:223
msgctxt "diagnostic"
msgid "'long long' is incompatible with C++98"
msgstr "'long long' 与 C++98 不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13321
msgctxt "diagnostic"
msgid "'main' cannot be a multiversioned function"
msgstr "'main' 不能是多版本函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1086
msgctxt "diagnostic"
msgid "'main' is not allowed to be declared _Noreturn"
msgstr "不允许将 'main' 声明为 _Noreturn"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1089
msgctxt "diagnostic"
msgid "'main' is not allowed to be declared consteval"
msgstr "不允许将 'main' 声明为 consteval"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1089
msgctxt "diagnostic"
msgid "'main' is not allowed to be declared constexpr"
msgstr "不允许将 'main' 声明为 constexpr"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1083
msgctxt "diagnostic"
msgid "'main' is not allowed to be declared inline"
msgstr "不允许将 'main' 声明为 inline"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1082
msgctxt "diagnostic"
msgid "'main' is not allowed to be declared static"
msgstr "不允许将 'main' 声明为 static"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1084
msgctxt "diagnostic"
msgid "'main' is not allowed to be declared variadic"
msgstr "不允许将 'main' 声明为可变参数函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1091
msgctxt "diagnostic"
msgid "'main' is not allowed to be deleted"
msgstr "不允许删除 'main'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1096
msgctxt "diagnostic"
msgid "'main' must return 'int'"
msgstr "'main' 必须返回 'int'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1093
msgctxt "diagnostic"
msgid "'main' never has module linkage"
msgstr "'main' 永不具有模块链接"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1118
msgctxt "diagnostic"
msgid "'main' should not be 'extern \"C\"'"
msgstr "'main' 不应为 'extern \"C\"'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1080
msgctxt "diagnostic"
msgid "'main' should not be declared static"
msgstr "'main' 不应声明为 static"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9986
msgctxt "diagnostic"
msgid "'make_signed' is only compatible with non-_BitInt(1) integers and enum types, but was given %2"
msgstr "'make_signed' 仅与非 _BitInt(1) 整数和枚举类型兼容，但传入了 %2"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9986
msgctxt "diagnostic"
msgid "'make_signed' is only compatible with non-_BitInt(1) integers and enum types, but was given %2 whose underlying type is %4"
msgstr "'make_signed' 仅与非 _BitInt(1) 整数和枚举类型兼容，但传入了 %2（其底层类型为 %4）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9986
msgctxt "diagnostic"
msgid "'make_signed' is only compatible with non-bool integers and enum types, but was given %2"
msgstr "'make_signed' 仅与非 bool 整数和枚举类型兼容，但传入了 %2"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9986
msgctxt "diagnostic"
msgid "'make_signed' is only compatible with non-bool integers and enum types, but was given %2 whose underlying type is %4"
msgstr "'make_signed' 仅与非 bool 整数和枚举类型兼容，但传入了 %2（其底层类型为 %4）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9986
msgctxt "diagnostic"
msgid "'make_unsigned' is only compatible with non-_BitInt(1) integers and enum types, but was given %2"
msgstr "'make_unsigned' 仅与非 _BitInt(1) 整数和枚举类型兼容，但传入了 %2"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9986
msgctxt "diagnostic"
msgid "'make_unsigned' is only compatible with non-_BitInt(1) integers and enum types, but was given %2 whose underlying type is %4"
msgstr "'make_unsigned' 仅与非 _BitInt(1) 整数和枚举类型兼容，但传入了 %2（其底层类型为 %4）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9986
msgctxt "diagnostic"
msgid "'make_unsigned' is only compatible with non-bool integers and enum types, but was given %2"
msgstr "'make_unsigned' 仅与非 bool 整数和枚举类型兼容，但传入了 %2"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9986
msgctxt "diagnostic"
msgid "'make_unsigned' is only compatible with non-bool integers and enum types, but was given %2 whose underlying type is %4"
msgstr "'make_unsigned' 仅与非 bool 整数和枚举类型兼容，但传入了 %2（其底层类型为 %4）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4894
msgctxt "diagnostic"
msgid "'malloc' argument %0 must take a pointer type as its first argument"
msgstr "'malloc' 实参 %0 必须接受指针类型作为其第一个参数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4892
msgctxt "diagnostic"
msgid "'malloc' argument %1 is not a function"
msgstr "%1 'malloc' 实参不是函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4892
msgctxt "diagnostic"
msgid "'malloc' argument %1 is not a single function"
msgstr "%1 'malloc' 实参不是单个函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4896
msgctxt "diagnostic"
msgid "'malloc' argument '%0' refers to non-pointer type %1 of %2"
msgstr "'malloc' 实参 '%0' 引用了 %2 的非指针类型 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4892
msgctxt "diagnostic"
msgid "'malloc' argument for deallocator is not a function"
msgstr "用于释放器的 'malloc' 实参不是函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4892
msgctxt "diagnostic"
msgid "'malloc' argument for deallocator is not a single function"
msgstr "用于释放器的 'malloc' 实参不是单个函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12013
msgctxt "diagnostic"
msgid "'mig_server_routine' attribute only applies to routines that return a kern_return_t"
msgstr "'mig_server_routine' 属性仅适用于返回 kern_return_t 的例程"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13521
msgctxt "diagnostic"
msgid "'modular_format' attribute requires 'format' attribute"
msgstr "'modular_format' 属性需要 'format' 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12877
msgctxt "diagnostic"
msgid "'module' declaration found while building header unit"
msgstr "在构建头文件单元时发现 'module' 声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12875
msgctxt "diagnostic"
msgid "'module' declaration found while building module from module map"
msgstr "从模块映射构建模块时发现 'module' 声明"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1828
msgctxt "diagnostic"
msgid "'module;' introducing a global module fragment can appear only at the start of the translation unit"
msgstr "引入全局模块片段的 'module;' 只能出现在翻译单元的开头"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:384
msgctxt "diagnostic"
msgid "'musttail' attribute for this call is impossible because calls outside the current linkage unit cannot be tail called on MIPS"
msgstr "此调用无法使用 'musttail' 属性，因为在 MIPS 上无法对当前链接单元之外的调用进行尾调用"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:378
msgctxt "diagnostic"
msgid "'musttail' attribute for this call is impossible because external calls cannot be tail called on PPC"
msgstr "此调用无法使用 'musttail' 属性，因为在 PPC 上不能对外部调用进行尾调用"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:378
msgctxt "diagnostic"
msgid "'musttail' attribute for this call is impossible because indirect calls cannot be tail called on PPC"
msgstr "此调用无法使用 'musttail' 属性，因为在 PPC 上不能对间接调用进行尾调用"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:378
msgctxt "diagnostic"
msgid "'musttail' attribute for this call is impossible because long calls cannot be tail called on PPC"
msgstr "此调用无法使用 'musttail' 属性，因为在 PPC 上不能对长调用进行尾调用"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:384
msgctxt "diagnostic"
msgid "'musttail' attribute for this call is impossible because the MIPS16 ABI does not support tail calls"
msgstr "此调用无法使用 'musttail' 属性，因为MIPS16 ABI 不支持尾调用"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:389
msgctxt "diagnostic"
msgid "'musttail' attribute is not supported on AIX"
msgstr "AIX 不支持 'musttail' 属性"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:391
msgctxt "diagnostic"
msgid "'musttail' in a noexcept function requires a noexcept callee"
msgstr "noexcept 函数中的 'musttail' 要求被调用方也是 noexcept"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2193
msgctxt "diagnostic"
msgid "'mutable' and 'const' cannot be mixed"
msgstr "'mutable' 和 'const' 不能混用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2194
msgctxt "diagnostic"
msgid "'mutable' can only be applied to member variables"
msgstr "'mutable' 只能应用于成员变量"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1129
msgctxt "diagnostic"
msgid "'mutable' cannot appear multiple times in a lambda declarator"
msgstr "'mutable' 不能在 lambda 声明符中多次出现"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2188
msgctxt "diagnostic"
msgid "'mutable' cannot be applied to functions"
msgstr "'mutable' 不能应用于函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2189
msgctxt "diagnostic"
msgid "'mutable' cannot be applied to references"
msgstr "'mutable' 不能应用于引用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2190
msgctxt "diagnostic"
msgid "'mutable' on a reference type is a Microsoft extension"
msgstr "在引用类型上使用 'mutable' 是 Microsoft 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12569
msgctxt "diagnostic"
msgid "'mutexinoutset' modifier not allowed in 'depend' clause on 'taskwait' directive"
msgstr "'taskwait' 指令的 'depend' 子句中不允许使用 'mutexinoutset' 修饰符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7350
msgctxt "diagnostic"
msgid "'new' cannot allocate an array of %0 with no explicit ownership"
msgstr "'new' 无法分配未显式指定所有权的 %0 数组"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:251
msgctxt "diagnostic"
msgid "'new' cannot allocate object of variably modified type %0"
msgstr "'new' 无法分配可变修改类型 %0 的对象"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8667
msgctxt "diagnostic"
msgid "'new' cannot allocate objects of type %0 in address space '%1'"
msgstr "'new' 无法在地址空间 '%1' 中分配类型为 %0 的对象"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8644
msgctxt "diagnostic"
msgid "'new' expression with placement arguments refers to non-placement 'operator delete'"
msgstr "带有 placement 实参的 'new' 表达式引用了非 placement 的 'operator delete'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3870
msgctxt "diagnostic"
msgid "'nocf_check' attribute ignored; use -fcf-protection to enable the attribute"
msgstr "已忽略 'nocf_check' 属性；请使用 -fcf-protection 启用该属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13391
msgctxt "diagnostic"
msgid "'noderef' can only be used on an array or pointer type"
msgstr "'noderef' 只能用于数组或指针类型"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:940
msgctxt "diagnostic"
msgid "'noexcept' can only be used in a compound requirement (with '{' '}' around the expression)"
msgstr "'noexcept' 只能用于复合要求（表达式周围带有 '{' '}'）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12585
msgctxt "diagnostic"
msgid "'nonmonotonic' modifier can only be specified with 'dynamic' or 'guided' schedule kind"
msgstr "'nonmonotonic' 修饰符只能与 'dynamic' 或 'guided' 调度种类一起指定"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4853
msgctxt "diagnostic"
msgid "'nonnull' attribute applied to function with no pointer arguments"
msgstr "'nonnull' 属性应用于没有指针形参的函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4856
msgctxt "diagnostic"
msgid "'nonnull' attribute when used on parameters takes no arguments"
msgstr "用于形参时，'nonnull' 属性不接受任何实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3858
msgctxt "diagnostic"
msgid "'nothrow' attribute conflicts with exception specification; attribute ignored"
msgstr "'nothrow' 属性与异常说明冲突；该属性已被忽略"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:780
msgctxt "diagnostic"
msgid "'nullptr' is a C23 extension"
msgstr "'nullptr' 是 C23 扩展"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:778
msgctxt "diagnostic"
msgid "'nullptr' is incompatible with C++98"
msgstr "'nullptr' 与 C++98 不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5034
msgctxt "diagnostic"
msgid "'objc_bridge(id)' is only allowed on structs and typedefs of void pointers"
msgstr "'objc_bridge(id)' 仅允许用于结构体和 void 指针的 typedef"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1352
msgctxt "diagnostic"
msgid "'objc_class_stub' attribute cannot be specified on a class that does not have the 'objc_subclassing_restricted' attribute"
msgstr "不能在没有 'objc_subclassing_restricted' 属性的类上指定 'objc_class_stub' 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5025
msgctxt "diagnostic"
msgid "'objc_designated_initializer' attribute only applies to init methods of interface or class extension declarations"
msgstr "'objc_designated_initializer' 属性仅适用于接口或类扩展声明的 init 方法"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1393
msgctxt "diagnostic"
msgid "'objc_direct' attribute cannot be applied to methods declared in an Objective-C protocol"
msgstr "'objc_direct' 属性不能应用于 Objective-C 协议中声明的方法"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1393
msgctxt "diagnostic"
msgid "'objc_direct' attribute cannot be applied to properties declared in an Objective-C protocol"
msgstr "'objc_direct' 属性不能应用于 Objective-C 协议中声明的属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5127
msgctxt "diagnostic"
msgid "'objc_externally_retained' can only be applied to local variables of retainable type"
msgstr "'objc_externally_retained' 只能应用于可持有类型的局部变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5127
msgctxt "diagnostic"
msgid "'objc_externally_retained' can only be applied to local variables with strong ownership"
msgstr "'objc_externally_retained' 只能应用于具有强所有权的局部变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3930
msgctxt "diagnostic"
msgid "'objc_independent_class' attribute may be put on Objective-C object pointer type only; attribute is ignored"
msgstr "'objc_independent_class' 属性只能用于 Objective-C 对象指针类型；属性已被忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3926
msgctxt "diagnostic"
msgid "'objc_independent_class' attribute may be put on a typedef only; attribute is ignored"
msgstr "'objc_independent_class' 属性只能置于 typedef 上；该属性已被忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7555
msgctxt "diagnostic"
msgid "'offsetof' on non-POD type %0"
msgstr "对非 POD 类型 %0 使用 'offsetof'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7557
msgctxt "diagnostic"
msgid "'offsetof' on non-standard-layout type %0"
msgstr "对非标准布局类型 %0 使用 'offsetof'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12390
msgctxt "diagnostic"
msgid "'omp section' directive must be closely nested to a sections region"
msgstr "'omp section' 指令必须紧密嵌套在 sections 区域中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12390
msgctxt "diagnostic"
msgid "'omp section' directive must be closely nested to a sections region, not a %1 region"
msgstr "'omp section' 指令必须紧密嵌套在 sections 区域中，而不是 %1 区域中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12743
msgctxt "diagnostic"
msgid "'omp_interop_t' must be defined when 'append_args' clause is used; include <omp.h>"
msgstr "使用 'append_args' 子句时必须定义 'omp_interop_t'；请包含 <omp.h>"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1742
msgctxt "diagnostic"
msgid "'ompx_attribute' clause only allows 'amdgpu_flat_work_group_size', 'amdgpu_waves_per_eu', and 'launch_bounds'; %0 is ignored"
msgstr "'ompx_attribute' 子句仅允许 'amdgpu_flat_work_group_size'、'amdgpu_waves_per_eu' 和 'launch_bounds'；已忽略 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12833
msgctxt "diagnostic"
msgid "'ompx_bare' clauses requires explicit grid size via 'num_teams' and 'thread_limit' clauses"
msgstr "'ompx_bare' 子句需要通过 'num_teams' 和 'thread_limit' 子句显式指定网格大小"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13092
msgctxt "diagnostic"
msgid "'operator new' provided by %0 is not usable with the function signature of %1"
msgstr "%0 提供的 'operator new' 不能用于 %1 的函数签名"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12592
msgctxt "diagnostic"
msgid "'ordered' clause with a parameter cannot be specified in '#pragma omp %0' directive"
msgstr "不能在 '#pragma omp %0' 指令中指定带参数的 'ordered' 子句"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12527
msgctxt "diagnostic"
msgid "'ordered' directive with '%0' clause cannot be closely nested inside ordered region without specified parameter"
msgstr "带有 '%0' 子句的 'ordered' 指令不能紧密嵌套在未指定参数的 ordered 区域内"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12525
msgctxt "diagnostic"
msgid "'ordered' directive with 'threads' clause cannot be closely nested inside ordered region with specified parameter"
msgstr "带有 'threads' 子句的 'ordered' 指令不能紧邻嵌套在指定了形参的 ordered 区域内"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12525
msgctxt "diagnostic"
msgid "'ordered' directive without any clauses cannot be closely nested inside ordered region with specified parameter"
msgstr "不带任何子句的 'ordered' 指令不能紧邻嵌套在指定了形参的 ordered 区域内"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4932
msgctxt "diagnostic"
msgid "'overloadable' function %0 must have a prototype"
msgstr "'overloadable' 函数 %0 必须具有原型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3540
msgctxt "diagnostic"
msgid "'ownership_returns' attribute index does not match; here it is %0"
msgstr "'ownership_returns' 属性索引不匹配；此处为 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3540
msgctxt "diagnostic"
msgid "'ownership_returns' attribute index does not match; here it is omitted"
msgstr "'ownership_returns' 属性索引不匹配；此处为省略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3538
msgctxt "diagnostic"
msgid "'ownership_returns' attribute only applies to functions that return a pointer"
msgstr "'ownership_returns' 特性仅适用于返回指针的函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3544
msgctxt "diagnostic"
msgid "'ownership_takes' attribute class does not match; here it is '%0'"
msgstr "'ownership_takes' 属性类不匹配；此处为 '%0'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4792
msgctxt "diagnostic"
msgid "'packed' attribute was ignored on bit-fields with single-byte alignment in older versions of GCC and Clang"
msgstr "在旧版本的 GCC 和 Clang 中，单字节对齐位域上的 'packed' 属性会被忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:802
msgctxt "diagnostic"
msgid "'pure' attribute on function returning 'void'; attribute ignored"
msgstr "返回 'void' 的函数上带有 'pure' 属性；该属性已被忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12619
msgctxt "diagnostic"
msgid "'reduction' clause cannot be used with 'nogroup' clause"
msgstr "'reduction' 子句不能与 'nogroup' 子句一起使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11285
msgctxt "diagnostic"
msgid "'reduction' clause not allowed with '#pragma omp loop bind(teams)'"
msgstr "'#pragma omp loop bind(teams)' 不允许使用 'reduction' 子句"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12770
msgctxt "diagnostic"
msgid "'reduction' clause with 'task' modifier allowed only on non-simd parallel or worksharing constructs"
msgstr "带有 'task' 修饰符的 'reduction' 子句仅允许用于非 simd 的并行或工作共享构造"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:355
msgctxt "diagnostic"
msgid "'register' storage class specifier is deprecated and incompatible with C++17"
msgstr "'register' 存储类说明符已弃用，且与 C++17 不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8447
msgctxt "diagnostic"
msgid "'register' storage specifier on @catch parameter will be ignored"
msgstr "@catch 形参上的 'register' 存储说明符将被忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4898
msgctxt "diagnostic"
msgid "'regparm' is not valid on this platform"
msgstr "'regparm' 在此平台上无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4900
msgctxt "diagnostic"
msgid "'regparm' parameter must be between 0 and %0 inclusive"
msgstr "'regparm' 形参必须介于 0 和 %0 之间（含边界）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8507
msgctxt "diagnostic"
msgid "'reinterpret_cast' from class %0 from its base at non-zero offset %1 behaves differently from 'static_cast'"
msgstr "从类 %0 来自其非零偏移基类 %1 时，'reinterpret_cast' 的行为与 'static_cast' 不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8507
msgctxt "diagnostic"
msgid "'reinterpret_cast' from class %0 from its virtual base %1 behaves differently from 'static_cast'"
msgstr "从类 %0 来自其虚基类 %1 时，'reinterpret_cast' 的行为与 'static_cast' 不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8507
msgctxt "diagnostic"
msgid "'reinterpret_cast' from class %0 to its base at non-zero offset %1 behaves differently from 'static_cast'"
msgstr "从类 %0 转换到其非零偏移基类 %1 时，'reinterpret_cast' 的行为与 'static_cast' 不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8507
msgctxt "diagnostic"
msgid "'reinterpret_cast' from class %0 to its virtual base %1 behaves differently from 'static_cast'"
msgstr "从类 %0 转换到其虚基类 %1 时，'reinterpret_cast' 的行为与 'static_cast' 不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8507
msgctxt "diagnostic"
msgid "'reinterpret_cast' to class %0 from its base at non-zero offset %1 behaves differently from 'static_cast'"
msgstr "从非零偏移基类 %1 转换到类 %0 时，'reinterpret_cast' 的行为与 'static_cast' 不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8507
msgctxt "diagnostic"
msgid "'reinterpret_cast' to class %0 from its virtual base %1 behaves differently from 'static_cast'"
msgstr "从虚基类 %1 转换到类 %0 时，'reinterpret_cast' 的行为与 'static_cast' 不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8507
msgctxt "diagnostic"
msgid "'reinterpret_cast' to class %0 to its base at non-zero offset %1 behaves differently from 'static_cast'"
msgstr "到类 %0 转换到其非零偏移基类 %1 时，'reinterpret_cast' 的行为与 'static_cast' 不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8507
msgctxt "diagnostic"
msgid "'reinterpret_cast' to class %0 to its virtual base %1 behaves differently from 'static_cast'"
msgstr "到类 %0 转换到其虚基类 %1 时，'reinterpret_cast' 的行为与 'static_cast' 不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10078
msgctxt "diagnostic"
msgid "'require_constant_initialization' attribute added after initialization of variable"
msgstr "在变量初始化之后添加了 'require_constant_initialization' 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7916
msgctxt "diagnostic"
msgid "'restrict' qualifier on an array of pointers is a C23 extension"
msgstr "指针数组上的 'restrict' 限定符是 C23 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7913
msgctxt "diagnostic"
msgid "'restrict' qualifier on an array of pointers is incompatible with C standards before C23"
msgstr "指针数组上的 'restrict' 限定符与 C23 之前的 C 标准不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:820
msgctxt "diagnostic"
msgid "'return' will never be executed"
msgstr "'return' 永远不会被执行"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1088
msgctxt "diagnostic"
msgid "'sealed' keyword is a Microsoft extension"
msgstr "'sealed' 关键字是 Microsoft 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3949
msgctxt "diagnostic"
msgid "'selectany' can only be applied to data items with external linkage"
msgstr "'selectany' 只能应用于具有外部链接的数据项"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4868
msgctxt "diagnostic"
msgid "'sentinel' attribute only supported for variadic blocks"
msgstr "'sentinel' 属性仅支持可变参数 block"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4868
msgctxt "diagnostic"
msgid "'sentinel' attribute only supported for variadic functions"
msgstr "'sentinel' 属性仅支持可变参数函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4865
msgctxt "diagnostic"
msgid "'sentinel' attribute requires named arguments"
msgstr "'sentinel' 属性需要具名实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4874
msgctxt "diagnostic"
msgid "'sentinel' parameter 1 less than zero"
msgstr "'sentinel' 形参 1 小于零"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4876
msgctxt "diagnostic"
msgid "'sentinel' parameter 2 not 0 or 1"
msgstr "'sentinel' 参数 2 不是 0 或 1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:342
msgctxt "diagnostic"
msgid "'short %1' is invalid"
msgstr "'short %1' 无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:939
msgctxt "diagnostic"
msgid "'size' argument to bzero is '0'"
msgstr "bzero 的 'size' 实参为 '0'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:931
msgctxt "diagnostic"
msgid "'size' argument to memset is '0'; did you mean to transpose the last two arguments?"
msgstr "memset 的 'size' 实参为 '0'；您是否打算对调最后两个实参？"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:234
msgctxt "diagnostic"
msgid "'size_t' literal is out of range of possible 'size_t' values"
msgstr "'size_t' 字面量超出了可能的'size_t' 值的范围"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:234
msgctxt "diagnostic"
msgid "'size_t' literal is out of range of possible signed 'size_t' values"
msgstr "'size_t' 字面量超出了可能的有符号 'size_t' 值的范围"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:226
msgctxt "diagnostic"
msgid "'size_t' suffix for literals is a C++23 extension"
msgstr "字面量的 'size_t' 后缀是 C++23 扩展"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:232
msgctxt "diagnostic"
msgid "'size_t' suffix for literals is a C++23 feature"
msgstr "字面量的 'size_t' 后缀是 C++23 特性"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:229
msgctxt "diagnostic"
msgid "'size_t' suffix for literals is incompatible with C++ standards before C++23"
msgstr "字面量的 'size_t' 后缀与 C++23 之前的 C++ 标准不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7181
msgctxt "diagnostic"
msgid "'sized_by' argument cannot refer to a union member"
msgstr "'sized_by' 实参不能引用联合体成员"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7177
msgctxt "diagnostic"
msgid "'sized_by' argument must be a simple declaration reference"
msgstr "'sized_by' 实参必须是简单的声明引用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7185
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7223
msgctxt "diagnostic"
msgid "'sized_by' cannot be applied to a pointer with pointee of unknown size because %1 is a function type"
msgstr "'sized_by' 不能应用于被指向对象大小未知的指针，因为 %1 是函数类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7185
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7223
msgctxt "diagnostic"
msgid "'sized_by' cannot be applied to a pointer with pointee of unknown size because %1 is a sizeless type"
msgstr "'sized_by' 不能应用于被指向对象大小未知的指针，因为 %1 是无大小类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7185
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7223
msgctxt "diagnostic"
msgid "'sized_by' cannot be applied to a pointer with pointee of unknown size because %1 is a struct type with a flexible array member"
msgstr "'sized_by' 不能应用于被指向对象大小未知的指针，因为 %1 是带有柔性数组成员的结构体类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7185
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7223
msgctxt "diagnostic"
msgid "'sized_by' cannot be applied to a pointer with pointee of unknown size because %1 is a struct type with a flexible array member. This will be an error in a future compiler version"
msgstr "'sized_by' 不能应用于被指向对象大小未知的指针，因为 %1 是带有柔性数组成员的结构体类型。这在未来的编译器版本中将成为错误"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7185
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7223
msgctxt "diagnostic"
msgid "'sized_by' cannot be applied to a pointer with pointee of unknown size because %1 is an incomplete type"
msgstr "'sized_by' 不能应用于被指向对象大小未知的指针，因为 %1 是不完整类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7179
msgctxt "diagnostic"
msgid "'sized_by' cannot be applied to a union member"
msgstr "'sized_by' 不能应用于联合体成员"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7185
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7223
msgctxt "diagnostic"
msgid "'sized_by' cannot be applied to an array with element of unknown size because %1 is a function type"
msgstr "'sized_by' 不能应用于元素大小未知的数组，因为 %1 是函数类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7185
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7223
msgctxt "diagnostic"
msgid "'sized_by' cannot be applied to an array with element of unknown size because %1 is a sizeless type"
msgstr "'sized_by' 不能应用于元素大小未知的数组，因为 %1 是无大小类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7185
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7223
msgctxt "diagnostic"
msgid "'sized_by' cannot be applied to an array with element of unknown size because %1 is a struct type with a flexible array member"
msgstr "'sized_by' 不能应用于元素大小未知的数组，因为 %1 是带有柔性数组成员的结构体类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7185
