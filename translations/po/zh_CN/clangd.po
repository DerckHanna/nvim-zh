msgctxt "diagnostic"
msgid "A parameter list without types is only allowed in a function definition"
msgstr "不带类型的形参列表仅允许出现在函数定义中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3276
msgctxt "diagnostic"
msgid "A parameter pack may not be accessed at an out of bounds index"
msgstr "不能以越界索引访问形参包"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12126
msgctxt "diagnostic"
msgid "A private variable with incomplete type %0"
msgstr "私有变量具有不完整类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13881
msgctxt "diagnostic"
msgid "A randomized struct can only be initialized with a designated initializer"
msgstr "随机化结构体只能使用指派初始化器进行初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12132
msgctxt "diagnostic"
msgid "A reduction list item with incomplete type %0"
msgstr "归约列表项具有不完整类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3364
msgctxt "diagnostic"
msgid "A reference type is an invalid argument to attribute %1"
msgstr "引用类型是属性 %1 的无效实参"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:932
msgctxt "diagnostic"
msgid "A requires expression cannot have an explicit object parameter"
msgstr "requires 表达式不能具有显式对象形参"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:928
msgctxt "diagnostic"
msgid "A requires expression must contain at least one requirement"
msgstr "requires 表达式必须至少包含一条约束要求"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:900
msgctxt "diagnostic"
msgid "A space is required between a right angle bracket and an equals sign (use '> =')"
msgstr "右尖括号和等号之间需要一个空格 (请使用 '> =')"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:898
msgctxt "diagnostic"
msgid "A space is required between consecutive right angle brackets (use '> >')"
msgstr "连续的右尖括号之间需要空格（请使用 '> >'）"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1189
msgctxt "diagnostic"
msgid "A static lambda cannot have any captures"
msgstr "static lambda 不能有任何捕获"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:909
msgctxt "diagnostic"
msgid "A static_assert declaration cannot be a template"
msgstr "static_assert 声明不能是模板"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:947
msgctxt "diagnostic"
msgid "A template argument list is expected after a name prefixed by the template keyword"
msgstr "以 template 关键字为前缀的名称后期望模板实参列表"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:911
msgctxt "diagnostic"
msgid "A template declaration can only  a single entity"
msgstr "模板声明只能单个实体"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:911
msgctxt "diagnostic"
msgid "A template declaration can only declare a single entity"
msgstr "模板声明只能声明单个实体"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:911
msgctxt "diagnostic"
msgid "A template declaration can only instantiate a single entity"
msgstr "模板声明只能实例化单个实体"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10375
msgctxt "diagnostic"
msgid "A type named %0 is hidden by a declaration in a different namespace"
msgstr "名为 %0 的类型被不同命名空间中的声明隐藏"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11678
msgctxt "diagnostic"
msgid "A type specifier is required for all declarations"
msgstr "所有声明都需要类型说明符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5569
msgctxt "diagnostic"
msgid "A typedef cannot be a template"
msgstr "typedef 不能是模板"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12301
msgctxt "diagnostic"
msgid "A variable cannot appear in more than one %1 clause"
msgstr "变量不能在多个 %1 子句中重复出现"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:342
msgctxt "diagnostic"
msgid "ABI '%0' is not supported for '%1'"
msgstr "'%1' 不支持 ABI '%0'"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:341
msgctxt "diagnostic"
msgid "ABI '%0' is not supported on CPU '%1'"
msgstr "CPU '%1' 不支持 ABI '%0'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12102
msgctxt "diagnostic"
msgid "API notes replacement type %0 has a different size from original type %1"
msgstr "API 注解替换类型 %0 的大小与原始类型 %1 不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7388
msgctxt "diagnostic"
msgid "ARC __autoreleasing lifetime qualifier on return type is ignored"
msgstr "返回类型上的 ARC __autoreleasing 生命周期限定符被忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7388
msgctxt "diagnostic"
msgid "ARC __strong lifetime qualifier on return type is ignored"
msgstr "返回类型上的 ARC __strong 生命周期限定符被忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7388
msgctxt "diagnostic"
msgid "ARC __unsafe_unretained lifetime qualifier on return type is ignored"
msgstr "返回类型上的 ARC __unsafe_unretained 生命周期限定符被忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7388
msgctxt "diagnostic"
msgid "ARC __weak lifetime qualifier on return type is ignored"
msgstr "返回类型上的 ARC __weak 生命周期限定符被忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7289
msgctxt "diagnostic"
msgid "ARC forbids explicit message send of %0"
msgstr "ARC 禁止显式发送消息 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7156
msgctxt "diagnostic"
msgid "ARC forbids flexible array members with retainable object type"
msgstr "ARC 禁止具有可保留对象类型的柔性数组成员"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7306
msgctxt "diagnostic"
msgid "ARC forbids implementation of %1"
msgstr "ARC 禁止实现 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7306
msgctxt "diagnostic"
msgid "ARC forbids synthesis of %1"
msgstr "ARC 禁止合成 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7301
msgctxt "diagnostic"
msgid "ARC forbids synthesizing a property of an Objective-C object with unspecified ownership or storage attribute"
msgstr "ARC 禁止为未指定所有权或存储属性的 Objective-C 对象合成属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7304
msgctxt "diagnostic"
msgid "ARC forbids use of %0 in a @selector"
msgstr "ARC 禁止在 @selector 中使用 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7388
msgctxt "diagnostic"
msgid "ARC unused lifetime qualifier on return type is ignored"
msgstr "返回类型上的 ARC unused 生命周期限定符被忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:431
msgctxt "diagnostic"
msgid "AVR 'interrupt' attribute only applies to functions that have a 'void' return type"
msgstr "AVR 'interrupt' 属性仅适用于返回类型为 'void'的函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:431
msgctxt "diagnostic"
msgid "AVR 'interrupt' attribute only applies to functions that have no parameters"
msgstr "AVR 'interrupt' 属性仅适用于没有形参的函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:431
msgctxt "diagnostic"
msgid "AVR 'signal' attribute only applies to functions that have a 'void' return type"
msgstr "AVR 'signal' 属性仅适用于返回类型为 'void'的函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:431
msgctxt "diagnostic"
msgid "AVR 'signal' attribute only applies to functions that have no parameters"
msgstr "AVR 'signal' 属性仅适用于没有形参的函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:100
msgctxt "diagnostic"
msgid "Absolute value function %0 given an argument of type %1 but has parameter of type %2 which may cause truncation of value"
msgstr "绝对值函数 %0 接收了类型为 %1 的实参，但其形参类型为 %2，这可能导致值截断"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2895
msgctxt "diagnostic"
msgid "Abstract class is marked 'final'"
msgstr "抽象类被标记为 'final'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2895
msgctxt "diagnostic"
msgid "Abstract class is marked 'sealed'"
msgstr "抽象类被标记为 'sealed'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:746
msgctxt "diagnostic"
msgid "Access declarations are deprecated; use using declarations instead"
msgstr "访问声明已弃用；请改用 using 声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11967
msgctxt "diagnostic"
msgid "Access qualifier %0 cannot be used for %1 "
msgstr "访问限定符 %0 不能用于 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11967
msgctxt "diagnostic"
msgid "Access qualifier %0 cannot be used for %1 prior to OpenCL C version 2.0 or in version 3.0 and without __opencl_c_read_write_images feature"
msgstr "在 OpenCL C 2.0 之前的版本中，或在没有 __opencl_c_read_write_images 特性的 3.0 版本中，访问限定符 %0 不能用于 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11965
msgctxt "diagnostic"
msgid "Access qualifier can only be used for pipe and image type"
msgstr "访问限定符只能用于 pipe 和 image 类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3752
msgctxt "diagnostic"
msgid "Access specifier can only have annotation attributes"
msgstr "访问说明符只能具有注解属性"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1902
msgctxt "diagnostic"
msgid "Access specifiers are a clang HLSL extension"
msgstr "访问说明符是 clang HLSL 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7514
msgctxt "diagnostic"
msgid "Accessing a member of an atomic structure or union is undefined behavior"
msgstr "访问原子结构体或联合体的成员是未定义行为"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10357
msgctxt "diagnostic"
msgid "Accessing inaccessible direct base %0 of %1 is a Microsoft extension"
msgstr "访问 %1 的不可访问直接基类 %0 是 Microsoft 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4427
msgctxt "diagnostic"
msgid "Acquiring %0 '%1' requires negative capability '%2'"
msgstr "获取 %0 '%1' 需要负向能力 '%2'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4367
msgctxt "diagnostic"
msgid "Acquiring %0 '%1' that is already held"
