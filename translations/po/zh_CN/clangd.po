#: clang/include/clang/Basic/DiagnosticSemaKinds.td:898
msgctxt "diagnostic"
msgid "Destination for this %1 call is a pointer to dynamic class %3; vtable pointer will be copied"
msgstr "此 %1 调用的目标是指向动态类 %3的指针；虚表指针将被拷贝"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:898
msgctxt "diagnostic"
msgid "Destination for this %1 call is a pointer to dynamic class %3; vtable pointer will be moved"
msgstr "此 %1 调用的目标是指向动态类 %3的指针；虚表指针将被移动"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:898
msgctxt "diagnostic"
msgid "Destination for this %1 call is a pointer to dynamic class %3; vtable pointer will be overwritten"
msgstr "此 %1 调用的目标是指向动态类 %3的指针；虚表指针将被覆写"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7410
