msgctxt "diagnostic"
msgid "Expected valid context selector in %0"
msgstr "在 %0 中需要有效的上下文选择器"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:621
msgctxt "diagnostic"
msgid "Expected value in expression"
msgstr "表达式中需要值"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12143
msgctxt "diagnostic"
msgid "Expected variable name"
msgstr "预期变量名"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12531
msgctxt "diagnostic"
msgid "Expected variable name as a base of the array section"
msgstr "预期变量名作为数组切片的基址"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12531
msgctxt "diagnostic"
msgid "Expected variable name as a base of the array subscript"
msgstr "预期变量名作为数组下标的基址"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1119
msgctxt "diagnostic"
msgid "Expected variable name or 'this' in lambda capture list"
msgstr "lambda 捕获列表中需要变量名或 'this'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12143
msgctxt "diagnostic"
msgid "Expected variable name or data member of current class"
msgstr "预期变量名或当前类的数据成员"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12148
msgctxt "diagnostic"
msgid "Expected variable name, array element or array section"
msgstr "预期为变量名、数组元素或数组切片"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12148
msgctxt "diagnostic"
msgid "Expected variable name, data member of current class, array element or array section"
msgstr "预期为变量名、当前类的数据成员、数组元素或数组切片"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12765
msgctxt "diagnostic"
msgid "Expected variable of the '%0' type"
msgstr "预期为 '%0' 类型的变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12765
msgctxt "diagnostic"
msgid "Expected variable of the '%0' type, not %2"
msgstr "预期为 '%0' 类型的变量，而不是 %2"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12145
msgctxt "diagnostic"
msgid "Expected variable of type '%1'"
msgstr "期望类型为 '%1' 的变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12793
msgctxt "diagnostic"
msgid "Expected variable of type 'omp_interop_t'"
msgstr "预期为 'omp_interop_t' 类型的变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12145
msgctxt "diagnostic"
msgid "Expected variable or static data member of type '%1'"
msgstr "期望类型为 '%1' 的变量或静态数据成员"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12145
msgctxt "diagnostic"
msgid "Expected variable, static data member, or non-static data member of current class of type '%1'"
msgstr "期望类型为 '%1' 的变量、静态数据成员或当前类的非静态数据成员"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4379
msgctxt "diagnostic"
msgid "Expecting %0 '%1' to be held at start of each loop"
msgstr "期望在每次循环开始时持有 %0 '%1'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4379
msgctxt "diagnostic"
msgid "Expecting %0 '%1' to be held at start of each loop with equal reentrancy depth"
msgstr "期望在每次循环开始时持有 %0 '%1'（且具有相同的重入深度）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4372
msgctxt "diagnostic"
msgid "Expecting %0 '%1' to be held at the end of function"
msgstr "预期在函数末尾持有 %0 '%1'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13648
msgctxt "diagnostic"
msgid "Expecting a pointer argument to the generic address space"
msgstr "期望一个指向通用地址空间的指针实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11715
msgctxt "diagnostic"
msgid "Explicit call to +initialize results in duplicate call to +initialize"
msgstr "显式调用 +initialize 会导致重复调用 +initialize"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11718
msgctxt "diagnostic"
msgid "Explicit call to [super initialize] should only be in implementation of +initialize"
msgstr "对 [super initialize] 的显式调用只应出现在 +initialize 的实现中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9014
msgctxt "diagnostic"
msgid "Explicit capture of 'this' with a capture default of '=' is a C++20 extension"
msgstr "在默认捕获为 '=' 时显式捕获 'this' 是 C++20 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9011
msgctxt "diagnostic"
msgid "Explicit capture of 'this' with a capture default of '=' is incompatible with C++ standards before C++20"
msgstr "在默认捕获为 '=' 时显式捕获 'this' 与 C++20 之前的 C++ 标准不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2401
msgctxt "diagnostic"
msgid "Explicit constructor calls are a Microsoft extension"
msgstr "显式构造函数调用是 Microsoft 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10534
msgctxt "diagnostic"
msgid "Explicit conversion functions are a C++11 extension"
msgstr "显式转换函数是 C++11 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10536
msgctxt "diagnostic"
msgid "Explicit conversion functions are incompatible with C++98"
msgstr "显式转换函数与 C++98 不兼容"

#: clang/include/clang/Basic/DiagnosticASTKinds.td:416
msgctxt "diagnostic"
msgid "Explicit initialization of field %1 will not be enforced in C++20 and later because %2 has a user-declared constructor, making the type no longer an aggregate"
msgstr "在 C++20 及更高版本中将不再强制要求显式初始化字段 %1，因为 %2 具有用户声明的构造函数，使该类型不再是聚合体"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6159
msgctxt "diagnostic"
msgid "Explicit instantiation cannot be 'constexpr'"
msgstr "显式实例化不能为 'constexpr'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6154
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6156
msgctxt "diagnostic"
msgid "Explicit instantiation cannot be 'inline'"
msgstr "显式实例化不能为 'inline'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6133
msgctxt "diagnostic"
msgid "Explicit instantiation cannot have a storage class"
msgstr "显式实例化不能有存储类"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6178
msgctxt "diagnostic"
msgid "Explicit instantiation declaration (with 'extern') follows explicit instantiation definition (without 'extern')"
msgstr "显式实例化声明（带 'extern'）跟在显式实例化定义（不带 'extern'）之后"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6135
msgctxt "diagnostic"
msgid "Explicit instantiation declaration of %0 with internal linkage"
msgstr "对具有内部链接的 %0 进行显式实例化声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6129
msgctxt "diagnostic"
msgid "Explicit instantiation declaration requires a name"
msgstr "显式实例化声明需要一个名称"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3984
msgctxt "diagnostic"
