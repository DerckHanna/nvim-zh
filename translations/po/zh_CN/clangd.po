msgstr "指派初始化器是 C++20 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:255
msgctxt "diagnostic"
msgid "Designated initializers are a C99 feature"
msgstr "指派初始化器是 C99 特性"

