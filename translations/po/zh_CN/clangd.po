msgctxt "diagnostic"
msgid "Existing instance variable %1 for strong property %0 may not be __weak"
msgstr "strong 属性 %0 的已有实例变量 %1 不能是 __weak"

msgctxt "diagnostic"
msgid "Expanded from here"
msgstr "从这里展开"

msgctxt "diagnostic"
msgid "Expanded from macro '{name}'"
msgstr "由宏 '{name}' 展开"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:867
msgctxt "diagnostic"
msgid "Expansion of date or time macro is not reproducible"
msgstr "日期或时间宏的展开不可重现"

