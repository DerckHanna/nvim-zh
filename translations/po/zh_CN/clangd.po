#: clang/include/clang/Basic/DiagnosticCommonKinds.td:55
msgctxt "diagnostic"
msgid "Expected string literal for optional message in 'availability' attribute"
msgstr "预期用于 'availability' 属性可选消息的字符串字面量"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:55
msgctxt "diagnostic"
msgid "Expected string literal for source container name in 'external_source_symbol' attribute"
msgstr "预期用于 'external_source_symbol' 属性中源容器名称 的字符串字面量"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:55
msgctxt "diagnostic"
msgid "Expected string literal in %1"
msgstr "预期在 %1 中使用的字符串字面量"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1261
msgctxt "diagnostic"
msgid "Expected string literal in '#pragma %0' - ignoring"
msgstr "'#pragma %0' 中期望字符串字面量 - 已忽略"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:356
msgctxt "diagnostic"
msgid "Expected string literal in 'asm'"
msgstr "'asm' 中预期为字符串字面量"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1525
msgctxt "diagnostic"
msgid "Expected string literal in 'clause %0' - ignoring"
msgstr "在 'clause %0' 中期望字符串字面量 - 已忽略"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:356
msgctxt "diagnostic"
