msgstr "无效的正则表达式 '{pattern}'：{reason}"

msgctxt "clangd_config"
msgid "Latency of clang-tidy check '{check}' is not known. It will only run if ClangTidy.FastCheckFilter is Loose or None"
msgstr "未知 clang-tidy 检查 '{check}' 的延迟。仅当 ClangTidy.FastCheckFilter 为 Loose 或 None 时才会运行"

msgctxt "clangd_config"
msgid "Remote index may not be specified by untrusted configuration. Copy this into user config to use it."
msgstr "不受信任的配置不能指定远程索引。请复制到用户配置中以启用"

msgctxt "clangd_config"
msgid "Unknown {kind} key '{key}' ignored"
msgstr "已忽略未知的 {kind} 键 '{key}'"

msgctxt "clangd_config"
msgid "clang-tidy check '{check}' is slow. It will only run if ClangTidy.FastCheckFilter is None"
msgstr "clang-tidy 检查 '{check}' 运行较慢。仅当 ClangTidy.FastCheckFilter 为 None 时才会运行"

msgctxt "clangd_config"
msgid "clang-tidy check '{check}' was not found"
msgstr "未找到 clang-tidy 检查 '{check}'"

msgctxt "clangd_config"
msgid "{key} should be a boolean"
msgstr "{key} 应为布尔值"

msgctxt "clangd_config"
msgid "{key} should be scalar"
msgstr "{key} 应为标量值"

msgctxt "clangd_config"
msgid "{key} should be scalar or list of scalars"
msgstr "{key} 应为标量值或标量列表"

msgctxt "clangd_config"
msgid "{path} must be an absolute path, because this fragment is not associated with any directory."
msgstr "{path} 必须是绝对路径，因为该配置片段没有关联任何目录"
