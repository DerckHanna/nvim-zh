msgctxt "diagnostic"
msgid "'#pragma omp declare variant' cannot be applied to the function that was defined already; the original function might be used"
msgstr "'#pragma omp declare variant' 不能应用于已定义的函数；可能会使用原函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12731
msgctxt "diagnostic"
msgid "'#pragma omp declare variant' does not support consteval function"
msgstr "'#pragma omp declare variant' 不支持consteval 函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12731
msgctxt "diagnostic"
msgid "'#pragma omp declare variant' does not support constexpr functions"
msgstr "'#pragma omp declare variant' 不支持constexpr 函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12731
msgctxt "diagnostic"
msgid "'#pragma omp declare variant' does not support constructors"
msgstr "'#pragma omp declare variant' 不支持构造函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12731
msgctxt "diagnostic"
msgid "'#pragma omp declare variant' does not support deduced return types"
msgstr "'#pragma omp declare variant' 不支持推导返回类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12731
msgctxt "diagnostic"
msgid "'#pragma omp declare variant' does not support defaulted functions"
msgstr "'#pragma omp declare variant' 不支持默认化函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12731
msgctxt "diagnostic"
msgid "'#pragma omp declare variant' does not support deleted functions"
msgstr "'#pragma omp declare variant' 不支持已删除函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12731
msgctxt "diagnostic"
msgid "'#pragma omp declare variant' does not support destructors"
msgstr "'#pragma omp declare variant' 不支持析构函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12731
msgctxt "diagnostic"
msgid "'#pragma omp declare variant' does not support function templates"
msgstr "'#pragma omp declare variant' 不支持函数模板"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12731
msgctxt "diagnostic"
msgid "'#pragma omp declare variant' does not support virtual functions"
msgstr "'#pragma omp declare variant' 不支持虚函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12716
msgctxt "diagnostic"
msgid "'#pragma omp declare variant' is not compatible with any target-specific attributes"
msgstr "'#pragma omp declare variant' 与任何特定于目标的属性都不兼容"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1568
msgctxt "diagnostic"
msgid "'#pragma omp end assumes' with no matching '#pragma omp begin assumes'"
msgstr "'#pragma omp end assumes' 没有匹配的 '#pragma omp begin assumes'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1565
msgctxt "diagnostic"
msgid "'#pragma omp end declare variant' with no matching '#pragma omp begin declare variant'"
msgstr "'#pragma omp end declare variant' 缺少匹配的 '#pragma omp begin declare variant'"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:720
msgctxt "diagnostic"
msgid "'#pragma pop_macro' expected a non-empty string"
msgstr "'#pragma pop_macro' 预期一个非空字符串"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:720
msgctxt "diagnostic"
msgid "'#pragma push_macro' expected a non-empty string"
msgstr "'#pragma push_macro' 预期一个非空字符串"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:1108
msgctxt "diagnostic"
msgid "'#pragma unsafe_buffer_usage' was not ended"
msgstr "'#pragma unsafe_buffer_usage' 未结束"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:58
msgctxt "diagnostic"
msgid "'$' in identifier"
msgstr "标识符中包含 '$'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10856
msgctxt "diagnostic"
msgid "'%%n' specifier not supported on this platform"
msgstr "此平台不支持 '%%n' 说明符"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:375
msgctxt "diagnostic"
msgid "'%0' ABI is not supported with FPU"
msgstr "FPU 不支持 '%0' ABI"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12549
msgctxt "diagnostic"
msgid "'%0' and '%1' clause are mutually exclusive and may not appear on the same directive"
msgstr "'%0' 和 '%1' 子句互斥，不能出现在同一条指令上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14140
msgctxt "diagnostic"
msgid "'%0' argument on '%1' clause is not permitted on a '%3' construct"
msgstr "在'%3' 构造上，不允许在 '%1' 子句中使用 '%0' 实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14140
msgctxt "diagnostic"
msgid "'%0' argument on '%1' clause is not permitted on a '%3' construct associated with a '%5' compute construct"
msgstr "在'%3' 构造（关联到 '%5' 计算构造）上，不允许在 '%1' 子句中使用 '%0' 实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14140
msgctxt "diagnostic"
msgid "'%0' argument on '%1' clause is not permitted on an orphaned '%3' construct"
msgstr "在孤立的 '%3' 构造上，不允许在 '%1' 子句中使用 '%0' 实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14140
msgctxt "diagnostic"
msgid "'%0' argument on '%1' clause is not permitted on an orphaned '%3' construct associated with a '%5' compute construct"
msgstr "在孤立的 '%3' 构造（关联到 '%5' 计算构造）上，不允许在 '%1' 子句中使用 '%0' 实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14147
msgctxt "diagnostic"
msgid "'%0' argument to '%1' clause not allowed on a '%2' construct associated with a '%4' construct that has a '%5' clause"
msgstr "不允许在具有 '%5' 子句的 '%2' 构造（关联到 '%4' 构造）上为 '%1' 子句使用 '%0' 实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14147
msgctxt "diagnostic"
msgid "'%0' argument to '%1' clause not allowed on a '%2' construct that has a '%5' clause"
msgstr "不允许在具有 '%5' 子句的 '%2' 构造上为 '%1' 子句使用 '%0' 实参"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:990
msgctxt "diagnostic"
msgid "'%0' as a module map name is deprecated, rename it to module.modulemap"
msgstr "将 '%0' 用作模块映射名称已弃用，请将其重命名为 module.modulemap"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:990
msgctxt "diagnostic"
msgid "'%0' as a module map name is deprecated, rename it to module.modulemap in the 'Modules' directory of the framework"
msgstr "将 '%0' 用作模块映射名称已弃用，请将其重命名为框架 'Modules' 目录中的 module.modulemap"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:990
msgctxt "diagnostic"
msgid "'%0' as a module map name is deprecated, rename it to module.private.modulemap"
msgstr "将 '%0' 用作模块映射名称已弃用，请将其重命名为 module.private.modulemap"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:990
msgctxt "diagnostic"
msgid "'%0' as a module map name is deprecated, rename it to module.private.modulemap in the 'Modules' directory of the framework"
msgstr "将 '%0' 用作模块映射名称已弃用，请将其重命名为框架 'Modules' 目录中的 module.private.modulemap"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3963
msgctxt "diagnostic"
msgid "'%0' attribute cannot be specified on a definition"
msgstr "不能在定义上指定 '%0' 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11936
msgctxt "diagnostic"
msgid "'%0' attribute is deprecated and may be removed in a future version of Clang"
msgstr "'%0' 属性已弃用，并可能在未来版本的 Clang 中移除"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:905
msgctxt "diagnostic"
msgid "'%0' call operates on objects of type %1 while the size is based on a different type %2"
msgstr "'%0' 调用操作于类型 %1 的对象，而大小基于不同的类型 %2"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:345
msgctxt "diagnostic"
msgid "'%0' can only be used if the target supports the mfhc1 and mthc1 instructions"
msgstr "仅当目标支持 mfhc1 和 mthc1 指令时才能使用 '%0'"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:344
msgctxt "diagnostic"
msgid "'%0' can only be used with the '%1' ABI"
msgstr "'%0' 只能与 '%1' ABI 一起使用"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:493
msgctxt "diagnostic"
msgid "'%0' cannot be a part of nested name specifier; did you mean ':'?"
msgstr "'%0' 不能作为嵌套名称说明符的一部分；您是指 ':' 吗？"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11669
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:341
msgctxt "diagnostic"
msgid "'%0' cannot be signed or unsigned"
msgstr "'%0' 不能带有 signed 或 unsigned 限定"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13018
msgctxt "diagnostic"
msgid "'%0' cannot be used in an unevaluated context"
msgstr "'%0' 不能用于未求值上下文"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13020
msgctxt "diagnostic"
msgid "'%0' cannot be used in the handler of a try block"
msgstr "'%0' 不能在 try 块的处理程序中使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13022
msgctxt "diagnostic"
msgid "'%0' cannot be used outside a function"
msgstr "'%0' 不能在函数外部使用"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:563
msgctxt "diagnostic"
msgid "'%0' casts have no effect when not using ARC"
msgstr "未使用 ARC 时，'%0' 转换无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14151
msgctxt "diagnostic"
msgid "'%0' clause not allowed on a 'kernels loop' construct that has a '%1' clause with a 'num' argument"
msgstr "在具有带 'num'实参的 '%1' 子句的 'kernels loop' 构造上不允许使用 '%0' 子句"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14151
msgctxt "diagnostic"
msgid "'%0' clause not allowed on a 'kernels loop' construct that has a '%1' clause with an argument"
