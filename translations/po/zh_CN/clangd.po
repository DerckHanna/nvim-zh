#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3943
msgctxt "diagnostic"
msgid "Passing union across security boundary via return value may leak information"
msgstr "通过返回值跨安全边界传递联合体可能会泄漏信息"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4435
msgctxt "diagnostic"
msgid "Passing variable %1 by reference requires holding %0 '%2'"
msgstr "按引用传递变量 %1 需要持有 %0 '%2'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4435
msgctxt "diagnostic"
msgid "Passing variable %1 by reference requires holding %0 '%2' exclusively"
msgstr "按引用传递变量 %1 需要独占持有 %0 '%2'"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:801
#: clang/include/clang/Basic/DiagnosticLexKinds.td:803
msgctxt "diagnostic"
msgid "Pasting formed '%0', an invalid preprocessing token"
msgstr "拼接生成了无效的预处理记号 '%0'"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:63
msgctxt "diagnostic"
msgid "Pasting two '/' tokens into a '//' comment is a Microsoft extension"
msgstr "将两个 '/' 记号拼接为 '//' 注释是 Microsoft 扩展"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:1025
msgctxt "diagnostic"
msgid "Path refers outside of the module directory; such paths in implicitly discovered module maps are deprecated"
msgstr "路径指向模块目录之外；在隐式发现的模块映射中使用此类路径已弃用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1667
msgctxt "diagnostic"
msgid "PerformSelector may cause a leak because its selector is unknown"
msgstr "由于选择器未知，performSelector 可能导致内存泄漏"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1665
msgctxt "diagnostic"
msgid "PerformSelector names a selector which retains the object"
msgstr "performSelector 指定了一个会保留该对象的选择器"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7565
msgctxt "diagnostic"
msgid "Performing pointer arithmetic on a null pointer has undefined behavior"
msgstr "对空指针执行指针算术运算具有未定义行为"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7565
msgctxt "diagnostic"
msgid "Performing pointer arithmetic on a null pointer has undefined behavior if the offset is nonzero"
msgstr "当偏移量非零时，对空指针执行指针算术运算具有未定义行为"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7571
msgctxt "diagnostic"
msgid "Performing pointer subtraction with a null pointer has undefined behavior"
msgstr "对空指针执行指针减法属于未定义行为"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7571
msgctxt "diagnostic"
msgid "Performing pointer subtraction with a null pointer may have undefined behavior"
msgstr "对空指针执行指针减法可能属于未定义行为"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12815
msgctxt "diagnostic"
msgid "Permutation index must be at least 1 and at most %0"
msgstr "置换索引必须至少为 1 且至多为 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2062
msgctxt "diagnostic"
msgid "Personality routine in declaration does not match previous declaration"
msgstr "声明中的个性例程与先前的声明不匹配"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11910
msgctxt "diagnostic"
msgid "Pipes packet types cannot be of reference type"
msgstr "管道数据包类型不能为引用类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7523
msgctxt "diagnostic"
msgid "Placeholder variables are a C++2c extension"
msgstr "占位符变量是 C++2c 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7525
msgctxt "diagnostic"
msgid "Placeholder variables are incompatible with C++ standards before C++2c"
msgstr "占位符变量与 C++2c 之前的 C++ 标准不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8617
msgctxt "diagnostic"
msgid "Placement new expression with a const-qualified argument of type %0 is not allowed"
msgstr "不允许带有类型为 %0 的 const 限定实参的 placement new 表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:323
msgctxt "diagnostic"
msgid "Plain '_Complex' requires a type specifier; assuming '_Complex double'"
msgstr "单独的 '_Complex' 需要类型说明符；假定为 '_Complex double'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11853
msgctxt "diagnostic"
msgid "Pointer arguments to kernel functions must reside in '__global', '__constant' or '__local' address space"
msgstr "内核函数的指针实参必须位于 '__global'、'__constant' 或 '__local' 地址空间中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9964
msgctxt "diagnostic"
msgid "Pointer cannot be cast to type %0"
msgstr "指针无法强制转换为类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12173
msgctxt "diagnostic"
msgid "Pointer cannot be mapped along with a section derived from itself"
msgstr "指针不能与从其自身派生的区段一起映射"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11156
msgctxt "diagnostic"
msgid "Pointer comparison always evaluates to 'std::strong_ordering::equal'"
msgstr "指针比较始终求值为'std::strong_ordering::equal'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11156
msgctxt "diagnostic"
msgid "Pointer comparison always evaluates to a constant"
msgstr "指针比较始终求值为常量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11156
msgctxt "diagnostic"
msgid "Pointer comparison always evaluates to false"
msgstr "指针比较始终求值为false"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11156
msgctxt "diagnostic"
msgid "Pointer comparison always evaluates to true"
msgstr "指针比较始终求值为true"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8022
msgctxt "diagnostic"
msgid "Pointer comparisons before C11 need to be between two complete or two incomplete types; %0 is complete and %1 is complete"
msgstr "C11 之前的指针比较必须在两个完整类型或两个不完整类型之间进行；%0 是完整类型，而 %1 是完整类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8022
msgctxt "diagnostic"
msgid "Pointer comparisons before C11 need to be between two complete or two incomplete types; %0 is complete and %1 is incomplete"
msgstr "C11 之前的指针比较必须在两个完整类型或两个不完整类型之间进行；%0 是完整类型，而 %1 是不完整类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8022
msgctxt "diagnostic"
msgid "Pointer comparisons before C11 need to be between two complete or two incomplete types; %0 is incomplete and %1 is complete"
msgstr "C11 之前的指针比较必须在两个完整类型或两个不完整类型之间进行；%0 是不完整类型，而 %1 是完整类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8022
msgctxt "diagnostic"
msgid "Pointer comparisons before C11 need to be between two complete or two incomplete types; %0 is incomplete and %1 is incomplete"
msgstr "C11 之前的指针比较必须在两个完整类型或两个不完整类型之间进行；%0 是不完整类型，而 %1 是不完整类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13170
msgctxt "diagnostic"
msgid "Pointer is missing a nullability type specifier (_Nonnull, _Nullable, or _Null_unspecified)"
msgstr "指针缺少可空性类型说明符（_Nonnull、_Nullable 或 _Null_unspecified）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13934
msgctxt "diagnostic"
msgid "Pointer to WebAssembly reference type is not allowed"
msgstr "不允许指向 WebAssembly 引用类型的指针"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6737
msgctxt "diagnostic"
msgid "Pointer to function type %0 may not be 'restrict' qualified"
msgstr "指向函数类型 %0 的指针不能具有 'restrict' 限定"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8229
msgctxt "diagnostic"
msgid "Pointer to function type %2 cannot have '%3' qualifier"
msgstr "指向函数类型 %2 的指针不能带有 '%3' 限定符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8229
msgctxt "diagnostic"
msgid "Pointer to function type cannot have '%3' qualifier"
msgstr "指向函数类型的指针不能带有 '%3' 限定符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2020
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2026
msgctxt "diagnostic"
msgid "Pointer to incomplete type %1 is not allowed in exception specification"
msgstr "异常说明中不允许使用指向不完整类型 %1 的指针"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7360
msgctxt "diagnostic"
msgid "Pointer to non-const type %0 with no explicit ownership"
