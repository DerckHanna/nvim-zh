msgctxt "diagnostic"
msgid "Destroying %2 must have at least two parameter"
msgstr "销毁型（destroying）%2 必须至少有 2 个形参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10424
msgctxt "diagnostic"
msgid "Destroying %2 must have at least two parameters"
msgstr "销毁型（destroying）%2 必须至少有 2 个形参"

