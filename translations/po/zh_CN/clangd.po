msgctxt "diagnostic"
msgid "Block pointer to function type cannot have '%3' qualifier"
msgstr "指向函数类型的块指针不能带有 '%3' 限定符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7501
msgctxt "diagnostic"
msgid "Block pointer to non-function type is invalid"
msgstr "指向非函数类型的 block 指针无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2579
msgctxt "diagnostic"
msgid "Block pointer variable %0 is null when captured by block"
msgstr "block 指针变量 %0 在被 block 捕获时为空"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2579
msgctxt "diagnostic"
msgid "Block pointer variable %0 is uninitialized when captured by block"
msgstr "block 指针变量 %0 在被 block 捕获时未初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11926
msgctxt "diagnostic"
msgid "Block type cannot be used as expression in ternary expression in OpenCL"
msgstr "在 OpenCL 中，block 类型不能用作三元表达式中的表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12022
msgctxt "diagnostic"
msgid "Block with '%1' attribute must not access ObjC methods or properties"
msgstr "带有 '%1' 属性的block不得访问 ObjC 方法或属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12022
msgctxt "diagnostic"
msgid "Block with '%1' attribute must not allocate or deallocate memory"
msgstr "带有 '%1' 属性的block不得分配或释放内存"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12034
msgctxt "diagnostic"
msgid "Block with '%1' attribute must not call non-'%1' block '%3'"
msgstr "带有 '%1' 属性的块不得调用非 '%1' 块 '%3'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12034
msgctxt "diagnostic"
msgid "Block with '%1' attribute must not call non-'%1' constructor '%3'"
msgstr "带有 '%1' 属性的块不得调用非 '%1' 构造函数 '%3'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12034
msgctxt "diagnostic"
msgid "Block with '%1' attribute must not call non-'%1' destructor '%3'"
msgstr "带有 '%1' 属性的块不得调用非 '%1' 析构函数 '%3'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12046
msgctxt "diagnostic"
msgid "Block with '%1' attribute must not call non-'%1' expression"
msgstr "带有 '%1' 属性的block不得调用非 '%1' 表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12034
msgctxt "diagnostic"
msgid "Block with '%1' attribute must not call non-'%1' function '%3'"
msgstr "带有 '%1' 属性的块不得调用非 '%1' 函数 '%3'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12034
msgctxt "diagnostic"
msgid "Block with '%1' attribute must not call non-'%1' lambda '%3'"
msgstr "带有 '%1' 属性的块不得调用非 '%1' lambda '%3'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12022
msgctxt "diagnostic"
msgid "Block with '%1' attribute must not have static local variables"
msgstr "带有 '%1' 属性的block不得包含静态局部变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12022
msgctxt "diagnostic"
msgid "Block with '%1' attribute must not throw or catch exceptions"
msgstr "带有 '%1' 属性的block不得抛出或捕获异常"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12022
msgctxt "diagnostic"
msgid "Block with '%1' attribute must not use thread-local variables"
msgstr "带有 '%1' 属性的block不得使用线程局部变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12058
msgctxt "diagnostic"
msgid "Block with '%1' attribute should be declared noexcept"
msgstr "具有 '%1' 属性的block 应声明为 noexcept"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11241
msgctxt "diagnostic"
msgid "Blocks support disabled - compile with -fblocks or for OpenCL C 2.0 or OpenCL C 3.0 with __opencl_c_device_enqueue feature"
msgstr "blocks 支持已禁用 - 请使用 -fblocks 编译，或针对带有 __opencl_c_device_enqueue 特性的 OpenCL C 2.0 或 OpenCL C 3.0 进行编译"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11241
msgctxt "diagnostic"
msgid "Blocks support disabled - compile with -fblocks or pick a deployment target that supports them"
msgstr "blocks 支持已禁用 - 请使用 -fblocks 编译，或选择支持它的部署目标"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11996
msgctxt "diagnostic"
msgid "Blocks used in enqueue_kernel call are expected to have parameters of type 'local void*'"
msgstr "enqueue_kernel 调用中使用的块期望具有 'local void*' 类型的形参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11998
msgctxt "diagnostic"
msgid "Blocks with parameters are not accepted in this prototype of enqueue_kernel call"
msgstr "此 enqueue_kernel 调用原型不接受带形参的 block"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13334
msgctxt "diagnostic"
msgid "Body of cpu_dispatch function will be ignored"
msgstr "cpu_dispatch 函数的函数体将被忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1110
msgctxt "diagnostic"
msgid "Bool literal returned from 'main'"
msgstr "从 'main' 返回了 bool 字面量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3673
msgctxt "diagnostic"
msgid "Boolean literal must be prefixed by '@' in a collection"
msgstr "集合中的布尔字面量必须以 '@' 作为前缀"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:318
msgctxt "diagnostic"
msgid "Brace elision for designated initializer is a C99 extension"
msgstr "指派初始化式的花括号省略是 C99 扩展"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1713
msgctxt "diagnostic"
msgid "Brace-grouped 'prefer_type' argument requires OpenMP version 6.0 or later"
msgstr "花括号分组的 'prefer_type' 实参需要 OpenMP 6.0 或更高版本"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6805
msgctxt "diagnostic"
msgid "Braces around initializer"
msgstr "初始化器周围使用了花括号"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6805
msgctxt "diagnostic"
msgid "Braces around scalar initializer"
msgstr "标量初始化器周围使用了花括号"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:698
msgctxt "diagnostic"
msgid "Bracket nesting level exceeded maximum of %0"
msgstr "括号嵌套层数超过最大值 %0"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:628
msgctxt "diagnostic"
msgid "Brackets are not allowed here; to declare an array, place the brackets after the identifier"
msgstr "此处不允许使用方括号；要声明数组，请将方括号放在标识符之后"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:628
msgctxt "diagnostic"
msgid "Brackets are not allowed here; to declare an array, place the brackets after the name"
msgstr "此处不允许使用方括号；要声明数组，请将方括号放在名称之后"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:119
msgctxt "diagnostic"
msgid "Build a shadowed submodule '%0'"
msgstr "构建被遮蔽的子模块 '%0'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5504
msgctxt "diagnostic"
msgid "Built-in subscript operator for type %0 expects exactly one argument"
msgstr "类型 %0 的内置下标运算符仅接受一个参数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6397
msgctxt "diagnostic"
msgid "Builtin %0 is deprecated"
msgstr "内建函数 %0 已弃用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6391
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6394
msgctxt "diagnostic"
msgid "Builtin %0 is deprecated; use %1 instead"
msgstr "内置函数 %0 已弃用；请改用 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13695
msgctxt "diagnostic"
msgid "Builtin %0 resource coordinate dimension mismatch: expected %1, found %2"
msgstr "内建 %0 资源坐标维度不匹配：预期为 %1，实际为 %2"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3406
msgctxt "diagnostic"
msgid "Builtin call is not valid when calling from a function without active ZA state"
msgstr "从没有活动 ZA 状态的函数调用时，该内建调用无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3409
msgctxt "diagnostic"
msgid "Builtin call is not valid when calling from a function without active ZT0 state"
msgstr "从没有活动 ZT0 状态的函数调用时，该内建调用无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3404
msgctxt "diagnostic"
msgid "Builtin can only be called from a %0 function"
msgstr "该内建函数只能从 %0 函数中调用"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:641
msgctxt "diagnostic"
msgid "Builtin feature check macro requires a parenthesized identifier"
msgstr "内建特性检查宏需要一个带括号的标识符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9635
msgctxt "diagnostic"
msgid "Builtin functions must be directly called"
msgstr "必须直接调用内建函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11588
msgctxt "diagnostic"
msgid "Builtin is not supported on this target"
msgstr "此目标不支持该内建函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14341
msgctxt "diagnostic"
msgid "Builtin requires a global or generic pointer"
msgstr "内建函数需要全局指针或通用指针"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13675
msgctxt "diagnostic"
msgid "Builtin requires at least one of the following extensions: %1"
msgstr "内建函数需要以下扩展中的至少一个：%1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13646
msgctxt "diagnostic"
msgid "Builtin requires spirv target"
msgstr "内建函数需要 spirv 目标"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13646
msgctxt "diagnostic"
msgid "Builtin requires spirv32 or spirv64 target"
msgstr "内建函数需要 spirv32 或 spirv64 目标"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13675
msgctxt "diagnostic"
msgid "Builtin requires: %1"
msgstr "内建函数需要：%1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9000
msgctxt "diagnostic"
msgid "By value capture of '*this' is incompatible with C++ standards before C++17"
msgstr "按值捕获 '*this' 与 C++17 之前的 C++ 标准不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1958
msgctxt "diagnostic"
msgid "By-copy capture of value of abstract type %0"
msgstr "按值复制捕获抽象类型 %0 的值"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1960
msgctxt "diagnostic"
msgid "By-copy capture of variable %0 with incomplete type %2"
msgstr "按值捕获具有不完整类型 %2 的变量 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1960
msgctxt "diagnostic"
msgid "By-copy capture of variable %0 with sizeless type %2"
msgstr "按值捕获具有无大小类型 %2 的变量 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5145
msgctxt "diagnostic"
msgid "C does not support default arguments"
msgstr "C 不支持默认实参"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:831
msgctxt "diagnostic"
msgid "C requires #line number to be less than %0, allowed as extension"
msgstr "C 要求 #line 行号小于 %0，作为扩展予以允许"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:433
msgctxt "diagnostic"
msgid "C requires a comma prior to the ellipsis in a variadic function type"
msgstr "C 语言要求在可变参数函数类型的省略号之前有逗号"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:806
#: clang/include/clang/Basic/DiagnosticLexKinds.td:808
msgctxt "diagnostic"
msgid "C++ operator %0 (aka %1) used as a macro name"
msgstr "将 C++ 运算符 %0（即 %1）用作宏名称"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:828
msgctxt "diagnostic"
msgid "C++11 only allows consecutive left square brackets when introducing an attribute"
msgstr "C++11 仅允许在引入属性时使用连续的左方括号"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2079
msgctxt "diagnostic"
msgid "C++98 requires an accessible copy constructor for class %2 when binding a reference to a temporary; was private"
msgstr "将引用绑定到临时对象时，C++98 要求类 %2 具有可访问的拷贝构造函数；当前为私有"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2079
msgctxt "diagnostic"
msgid "C++98 requires an accessible copy constructor for class %2 when binding a reference to a temporary; was protected"
msgstr "将引用绑定到临时对象时，C++98 要求类 %2 具有可访问的拷贝构造函数；当前为受保护"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8536
msgctxt "diagnostic"
msgid "C-style cast from %1 to %2 casts away qualifiers"
msgstr "从 %1 到 %2 的 C 风格强制类型转换丢弃了限定符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8571
msgctxt "diagnostic"
msgid "C-style cast from %1 to %2 changes address space of nested pointers"
msgstr "从 %1 到 %2 的 C 风格类型转换 更改了嵌套指针的地址空间"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8539
msgctxt "diagnostic"
msgid "C-style cast from %1 to %2 converts between mismatching address spaces"
msgstr "从 %1 到 %2 的 C 风格转换 在不匹配的地址空间之间进行了转换"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8522
msgctxt "diagnostic"
msgid "C-style cast from %1 to %2 is not allowed"
msgstr "不允许从 %1 到 %2 进行 C 风格强制类型转换"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5453
msgctxt "diagnostic"
msgid "C-style cast from %1 to %2 uses deleted function"
msgstr "从 %1 到 %2 的 C 风格强制转换使用了已删除的函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5453
msgctxt "diagnostic"
msgid "C-style cast from %1 to %2 uses deleted function: %4"
msgstr "从 %1 到 %2 的 C 风格强制转换使用了已删除的函数：%4"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8525
msgctxt "diagnostic"
msgid "C-style cast from %1 to %2, which are not related by inheritance, is not allowed"
msgstr "不允许从 %1 到 %2 进行 C 风格强制类型转换，两者之间没有继承关系"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8533
msgctxt "diagnostic"
msgid "C-style cast from bit-field lvalue to reference type %2"
msgstr "使用 C 风格强制转换将位域左值转换为引用类型 %2 无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8530
msgctxt "diagnostic"
msgid "C-style cast from rvalue to reference type %2"
msgstr "从右值向引用类型 %2 执行 C 风格类型转换"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8565
msgctxt "diagnostic"
msgid "C-style cast from scalar %1 to vector %2 of different size"
msgstr "从标量 %1 到不同大小的向量 %2 的 C 风格类型转换"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8562
msgctxt "diagnostic"
msgid "C-style cast from vector %1 to scalar %2 of different size"
msgstr "从向量 %1 到不同大小的标量 %2 的 C 风格转换 无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8568
msgctxt "diagnostic"
msgid "C-style cast from vector %1 to vector %2 of different size"
msgstr "不能使用 C 风格强制转换将向量 %1 转换为不同大小的向量 %2"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8549
msgctxt "diagnostic"
msgid "C-style cast to %2, which is not a reference, pointer-to-object, or pointer-to-data-member"
msgstr "C 风格强制类型转换 的目标类型 %2 不是引用、指向对象的指针或指向数据成员的指针"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9930
msgctxt "diagnostic"
msgid "C99 forbids casting nonscalar type %0 to the same type"
msgstr "C99 禁止将非标量类型 %0 强制转换为相同类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9926
msgctxt "diagnostic"
msgid "C99 forbids conditional expressions with only one void side"
msgstr "C99 禁止仅一侧为 void 的条件表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5036
msgctxt "diagnostic"
msgid "CF object of type %0 is bridged to %1, which is not an Objective-C class"
msgstr "类型为 %0 的 CF 对象被桥接到 %1，而后者不是 Objective-C 类"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11256
msgctxt "diagnostic"
msgid "CFString literal is not a string constant"
msgstr "CFString 字面量不是字符串常量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13331
msgctxt "diagnostic"
msgid "CPU list contains duplicate entries; attribute ignored"
msgstr "CPU 列表包含重复项；属性已忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9810
msgctxt "diagnostic"
msgid "CUDA device code does not support va_arg"
msgstr "CUDA 设备代码不支持 va_arg"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9807
msgctxt "diagnostic"
msgid "CUDA device code does not support variadic functions"
msgstr "CUDA 设备代码不支持可变参数函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9825
msgctxt "diagnostic"
msgid "CUDA does not support global %0 for __device__ functions"
msgstr "CUDA 不支持用于 __device__ 函数的全局 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9812
msgctxt "diagnostic"
msgid "CUDA older than 10.0 does not support .alias"
msgstr "10.0 之前的 CUDA 版本不支持 .alias"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9779
msgctxt "diagnostic"
msgid "CUDA special function '%0' must have pointer return type"
msgstr "CUDA 特殊函数 '%0' 必须具有指针返回类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9777
msgctxt "diagnostic"
msgid "CUDA special function '%0' must have scalar return type"
msgstr "CUDA 特殊函数 '%0' 必须具有标量返回类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5218
msgctxt "diagnostic"
msgid "Call to %0 is ambiguous"
msgstr "对 %0 的调用存在二义性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10464
msgctxt "diagnostic"
msgid "Call to '__builtin_operator_delete' selects non-usual allocation function"
msgstr "对 '__builtin_operator_delete' 的调用选择了非常规分配函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10464
msgctxt "diagnostic"
msgid "Call to '__builtin_operator_delete' selects non-usual deallocation function"
msgstr "对 '__builtin_operator_delete' 的调用选择了非常规释放函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10464
msgctxt "diagnostic"
msgid "Call to '__builtin_operator_new' selects non-usual allocation function"
msgstr "对 '__builtin_operator_new' 的调用选择了非常规分配函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10464
msgctxt "diagnostic"
msgid "Call to '__builtin_operator_new' selects non-usual deallocation function"
msgstr "对 '__builtin_operator_new' 的调用选择了非常规释放函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:149
msgctxt "diagnostic"
msgid "Call to 'data()' cannot be narrowed from type %2 to %3"
msgstr "对 'data()' 的调用不能从类型 %2 窄化为 %3"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:149
msgctxt "diagnostic"
msgid "Call to 'data()' evaluates to %2, which cannot be narrowed to type %3"
msgstr "对 'data()' 的调用的求值结果为 %2，不能窄化为类型 %3"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:147
msgctxt "diagnostic"
msgid "Call to 'data()' is not a constant expression"
msgstr "对 'data()' 的调用不是常量表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:149
msgctxt "diagnostic"
msgid "Call to 'size()' cannot be narrowed from type %2 to %3"
msgstr "对 'size()' 的调用不能从类型 %2 窄化为 %3"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:149
msgctxt "diagnostic"
msgid "Call to 'size()' evaluates to %2, which cannot be narrowed to type %3"
msgstr "对 'size()' 的调用的求值结果为 %2，不能窄化为类型 %3"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:147
msgctxt "diagnostic"
msgid "Call to 'size()' is not a constant expression"
msgstr "对 'size()' 的调用不是常量表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4094
msgctxt "diagnostic"
msgid "Call to a function that shares state other than 'za' from a function that has live 'za' state requires a spill/fill of ZA, which is not yet implemented"
msgstr "从具有活跃 'za' 状态的函数调用共享非 'za' 状态的函数需要对 ZA 进行溢出/填充（spill/fill），该功能尚未实现"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4090
msgctxt "diagnostic"
msgid "Call to a shared ZA function requires the caller to have ZA state"
msgstr "调用共享 ZA 函数要求调用方具有 ZA 状态"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4092
msgctxt "diagnostic"
msgid "Call to a shared ZT0 function requires the caller to have ZT0 state"
msgstr "调用共享 ZT0 函数要求调用方具有 ZT0 状态"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4088
msgctxt "diagnostic"
msgid "Call to a streaming function requires 'sme'"
msgstr "调用流式函数需要 'sme'"

