msgstr "' %1' 无效"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:510
msgctxt "diagnostic"
msgid "'##' cannot appear at end of __VA_OPT__ argument"
msgstr "'##' 不能出现在 __VA_OPT__ 实参末尾"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:785
msgctxt "diagnostic"
msgid "'##' cannot appear at end of macro expansion"
msgstr "'##' 不能出现在宏展开的末尾"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:507
msgctxt "diagnostic"
msgid "'##' cannot appear at start of __VA_OPT__ argument"
msgstr "'##' 不能出现在 __VA_OPT__ 实参的开头"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:783
msgctxt "diagnostic"
msgid "'##' cannot appear at start of macro expansion"
msgstr "'##' 不能出现在宏展开的开头"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:609
msgctxt "diagnostic"
msgid "'#' is not followed by a macro parameter"
msgstr "'#' 后面未跟随宏形参"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:609
msgctxt "diagnostic"
msgid "'#@' is not followed by a macro parameter"
msgstr "'#@' 后面未跟随宏形参"

msgctxt "diagnostic"
msgid "'#endif' without '#if'"
msgstr "'#endif' 缺少对应的 '#if'"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:1059
msgctxt "diagnostic"
msgid "'#include <filename>' attaches the declarations to the named module '%0', which is not usually intended; consider moving that directive before the module declaration"
msgstr "'#include <filename>' 会将声明附加到命名模块 '%0'，这通常并非本意；请考虑将该指令移到模块声明之前"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1226
msgctxt "diagnostic"
msgid "'#pragma %0' can only appear at file scope"
msgstr "'#pragma %0' 只能出现在文件作用域"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1351
msgctxt "diagnostic"
msgid "'#pragma %0' can only appear at file scope or at the start of a compound statement"
msgstr "'#pragma %0' 只能出现在文件作用域或复合语句的开头"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1366
msgctxt "diagnostic"
msgid "'#pragma %0' is not supported on this target - ignored"
msgstr "此目标不支持 '#pragma %0' - 已忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1208
msgctxt "diagnostic"
msgid "'#pragma STDC FENV_ACCESS ON' is illegal when precise is disabled"
msgstr "当禁用了 precise 时，'#pragma STDC FENV_ACCESS ON' 非法"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1230
msgctxt "diagnostic"
msgid "'#pragma alloc_text' is applicable only to functions"
msgstr "'#pragma alloc_text' 仅适用于函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1228
msgctxt "diagnostic"
msgid "'#pragma alloc_text' is applicable only to functions with C linkage"
msgstr "'#pragma alloc_text' 仅适用于具有 C 链接的函数"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:864
msgctxt "diagnostic"
msgid "'#pragma clang arc_cf_code_audited' was not ended within this file"
msgstr "'#pragma clang arc_cf_code_audited' 未在此文件内结束"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:1088
msgctxt "diagnostic"
msgid "'#pragma clang assume_nonnull' was not ended within this file"
msgstr "'#pragma clang assume_nonnull' 未在本文件内结束"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1274
msgctxt "diagnostic"
msgid "'#pragma clang attribute %1.pop' with no matching '#pragma clang attribute %1.push'"
msgstr "'#pragma clang attribute %1.pop' 没有匹配的 '#pragma clang attribute %1.push'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1274
msgctxt "diagnostic"
msgid "'#pragma clang attribute %1.pop' with no matching '#pragma clang attribute push'"
msgstr "'#pragma clang attribute %1.pop' 没有匹配的 '#pragma clang attribute push'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1274
msgctxt "diagnostic"
msgid "'#pragma clang attribute pop' with no matching '#pragma clang attribute %1.push'"
msgstr "'#pragma clang attribute pop' 没有匹配的 '#pragma clang attribute %1.push'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1274
msgctxt "diagnostic"
msgid "'#pragma clang attribute pop' with no matching '#pragma clang attribute push'"
msgstr "'#pragma clang attribute pop' 没有匹配的 '#pragma clang attribute push'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1286
msgctxt "diagnostic"
msgid "'#pragma clang attribute' attribute with no matching '#pragma clang attribute push'"
msgstr "'#pragma clang attribute' 属性没有匹配的 '#pragma clang attribute push'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7579
msgctxt "diagnostic"
msgid "'#pragma clang fp eval_method' cannot be used with '#pragma clang fp reassociate'"
msgstr "'#pragma clang fp eval_method' 不能与'#pragma clang fp reassociate' 一起使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7579
msgctxt "diagnostic"
msgid "'#pragma clang fp eval_method' cannot be used with '#pragma clang fp reciprocal'"
msgstr "'#pragma clang fp eval_method' 不能与'#pragma clang fp reciprocal' 一起使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7579
msgctxt "diagnostic"
msgid "'#pragma clang fp eval_method' cannot be used with option 'fapprox-func'"
msgstr "'#pragma clang fp eval_method' 不能与选项 'fapprox-func' 一起使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7579
msgctxt "diagnostic"
msgid "'#pragma clang fp eval_method' cannot be used with option 'ffp-eval-method'"
msgstr "'#pragma clang fp eval_method' 不能与选项 'ffp-eval-method' 一起使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7579
msgctxt "diagnostic"
msgid "'#pragma clang fp eval_method' cannot be used with option 'freciprocal'"
msgstr "'#pragma clang fp eval_method' 不能与选项 'freciprocal' 一起使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7579
msgctxt "diagnostic"
msgid "'#pragma clang fp eval_method' cannot be used with option 'mreassociate'"
msgstr "'#pragma clang fp eval_method' 不能与选项 'mreassociate' 一起使用"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1374
msgctxt "diagnostic"
msgid "'#pragma comment %0' ignored"
msgstr "已忽略 '#pragma comment %0'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1376
msgctxt "diagnostic"
msgid "'#pragma comment %0' ignored: it can be specified only once per translation unit"
msgstr "已忽略 '#pragma comment %0'：每个翻译单元只能指定一次"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1199
msgctxt "diagnostic"
msgid "'#pragma float_control push/pop' can only appear at file or namespace scope or within a language linkage specification"
msgstr "'#pragma float_control push/pop' 只能出现在文件或命名空间作用域，或者语言链接说明内"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1204
msgctxt "diagnostic"
msgid "'#pragma float_control(except, on)' is illegal when precise is disabled"
msgstr "当禁用 precise 时，'#pragma float_control(except, on)' 非法"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1206
msgctxt "diagnostic"
msgid "'#pragma float_control(precise, off)' is illegal when except is enabled"
msgstr "启用 except 时，'#pragma float_control(precise, off)' 非法"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1202
msgctxt "diagnostic"
msgid "'#pragma float_control(precise, off)' is illegal when fenv_access is enabled"
msgstr "启用 fenv_access 时，'#pragma float_control(precise, off)' 非法"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1346
msgctxt "diagnostic"
msgid "'#pragma init_seg' is only supported when targeting a Microsoft environment"
msgstr "仅当目标为 Microsoft 环境时才支持 '#pragma init_seg'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1531
msgctxt "diagnostic"
msgid "'#pragma omp %0' cannot be an immediate substatement"
msgstr "'#pragma omp %0' 不能作为直接子语句"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12638
msgctxt "diagnostic"
msgid "'#pragma omp %0' directive must appear only in file scope"
msgstr "'#pragma omp %0' 指令只能出现在文件作用域中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12120
msgctxt "diagnostic"
msgid "'#pragma omp %0' must appear in the scope of the %1 variable declaration"
msgstr "'#pragma omp %0' 必须出现在 %1 变量声明的作用域中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12122
msgctxt "diagnostic"
msgid "'#pragma omp %0' must precede all references to variable %1"
msgstr "'#pragma omp %0' 必须位于对变量 %1 的所有引用之前"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1531
msgctxt "diagnostic"
msgid "'#pragma omp %0' with '%2' clause cannot be an immediate substatement"
msgstr "带有 '%2' 子句的 '#pragma omp %0' 不能作为直接子语句"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12465
msgctxt "diagnostic"
msgid "'#pragma omp declare simd' can only be applied to functions"
msgstr "'#pragma omp declare simd' 只能应用于函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12465
msgctxt "diagnostic"
msgid "'#pragma omp declare variant' can only be applied to functions"
msgstr "'#pragma omp declare variant' 只能应用于函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12725
msgctxt "diagnostic"
msgid "'#pragma omp declare variant' cannot be applied for function after first usage; the original function might be used"
msgstr "'#pragma omp declare variant' 不能在函数首次使用后应用；可能会使用原函数"

