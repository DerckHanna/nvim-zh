msgctxt "diagnostic"
msgid "Friend specialization cannot have a trailing requires clause unless it declares a function template"
msgstr "友元特化不能具有尾随 requires 子句，除非它声明的是函数模板"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1908
msgctxt "diagnostic"
msgid "Friend type templates must use an elaborated type"
msgstr "友元类型模板必须使用详述类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1883
msgctxt "diagnostic"
msgid "Friends can only be classes or functions"
msgstr "友元只能是类或函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1890
msgctxt "diagnostic"
msgid "Friends cannot be members of the declaring class"
msgstr "友元不能是声明类的成员"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4281
msgctxt "diagnostic"
msgid "Fuchsia API Level prohibits specifying a minor or sub-minor version"
msgstr "Fuchsia API 级别禁止指定次版本号或子次版本号"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13602
msgctxt "diagnostic"
msgid "Function %0 cannot be used in device code because it is declared with the %1 attribute"
msgstr "函数 %0 不能在设备代码中使用，因为它声明了 %1 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11443
msgctxt "diagnostic"
msgid "Function %0 declared 'noreturn' should not return"
msgstr "声明为 'noreturn' 的函数 %0 不应返回"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13896
msgctxt "diagnostic"
msgid "Function %0 is unsafe"
msgstr "函数 %0 不安全"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2855
msgctxt "diagnostic"
msgid "Function %0 with deduced return type cannot be used before it is defined"
msgstr "返回类型需要推导的函数 %0 必须先定义才能使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11829
msgctxt "diagnostic"
msgid "Function %0 with unknown type must be given a function type"
msgstr "未知类型的函数 %0 必须被赋予一个函数类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:806
msgctxt "diagnostic"
msgid "Function %1 could be declared with attribute 'noreturn'"
msgstr "函数 %1 可以声明为带有 'noreturn' 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6522
msgctxt "diagnostic"
msgid "Function %1 has internal linkage but is not defined"
msgstr "函数 %1 具有内部链接但未定义"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:503
msgctxt "diagnostic"
msgid "Function %1 is not needed and will not be emitted"
msgstr "不需要函数 %1，因此不会生成"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6525
msgctxt "diagnostic"
msgid "Function %1 is used but not defined in this translation unit, and cannot be defined in any other translation unit because its type does not have linkage"
msgstr "函数 %1 在此翻译单元中被使用但未定义，且由于其类型没有链接性而无法在任何其他翻译单元中定义"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11912
msgctxt "diagnostic"
msgid "Function cannot be called 'main'"
msgstr "函数不能命名为 'main'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:919
msgctxt "diagnostic"
msgid "Function cannot be defined in an explicit instantiation; if this declaration is meant to be a class definition, remove the 'template' keyword"
msgstr "不能在显式实例化中定义函数；如果此声明意在作为类定义，请移除 'template' 关键字"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:919
msgctxt "diagnostic"
msgid "Function cannot be defined in an explicit instantiation; if this declaration is meant to be a function definition, remove the 'template' keyword"
msgstr "不能在显式实例化中定义函数；如果此声明意在作为函数定义，请移除 'template' 关键字"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:919
msgctxt "diagnostic"
msgid "Function cannot be defined in an explicit instantiation; if this declaration is meant to be a variable definition, remove the 'template' keyword"
msgstr "不能在显式实例化中定义函数；如果此声明意在作为变量定义，请移除 'template' 关键字"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7105
msgctxt "diagnostic"
msgid "Function cannot return array type %1"
msgstr "函数不能返回数组类型 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7105
msgctxt "diagnostic"
msgid "Function cannot return function type %1"
msgstr "函数不能返回函数类型 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7102
msgctxt "diagnostic"
msgid "Function cannot return qualified void type %0"
msgstr "函数不能返回带有限定符的 void 类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13294
msgctxt "diagnostic"
msgid "Function declaration cannot become a multiversioned function after first usage"
msgstr "函数声明在首次使用后不能成为多版本函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6715
msgctxt "diagnostic"
msgid "Function declaration cannot have variably modified type"
msgstr "函数声明不能具有可变修饰类型"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1541
msgctxt "diagnostic"
msgid "Function declaration is expected after 'declare simd' directive"
msgstr "'declare simd' 指令后应为函数声明"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1541
msgctxt "diagnostic"
msgid "Function declaration is expected after 'declare variant' directive"
msgstr "'declare variant' 指令后应为函数声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13289
msgctxt "diagnostic"
msgid "Function declaration is missing 'cpu_specific' or 'cpu_dispatch' attribute in a multiversioned function"
msgstr "多版本函数中的函数声明缺少 'cpu_specific' 或 'cpu_dispatch' 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13289
msgctxt "diagnostic"
msgid "Function declaration is missing 'target' attribute in a multiversioned function"
msgstr "多版本函数中的函数声明缺少 'target' 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13289
msgctxt "diagnostic"
msgid "Function declaration is missing 'target_version' attribute in a multiversioned function"
msgstr "多版本函数中的函数声明缺少 'target_version' 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4086
msgctxt "diagnostic"
msgid "Function declared %0 was previously declared %1, which has different SME function attributes"
msgstr "声明为 %0 的函数先前被声明为 %1，两者具有不同的 SME 函数属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4136
msgctxt "diagnostic"
msgid "Function declared '%0' here was previously declared '%2'"
msgstr "此处声明为 '%0' 的函数此前声明为 '%2'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4136
msgctxt "diagnostic"
msgid "Function declared '%0' here was previously declared without calling convention"
msgstr "此处声明为 '%0' 的函数此前声明时未指定调用约定"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11456
msgctxt "diagnostic"
msgid "Function declared '[[carries_dependency]]' after its first declaration"
msgstr "函数在首次声明之后才声明为 '[[carries_dependency]]'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11446
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11450
msgctxt "diagnostic"
msgid "Function declared 'noreturn' should not return"
msgstr "声明为 'noreturn' 的函数不应该返回"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7948
msgctxt "diagnostic"
msgid "Function declared in block scope cannot have 'static' storage class"
msgstr "在块作用域中声明的函数不能具有 'static' 存储类"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4159
msgctxt "diagnostic"
msgid "Function declared with %0 attribute was previously declared without the %0 attribute"
msgstr "声明时带有 %0 属性的函数先前声明时没有 %0 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4156
msgctxt "diagnostic"
msgid "Function declared with regparm(%0) attribute was previously declared with the regparm(%1) attribute"
msgstr "使用 regparm(%0) 属性声明的函数先前声明时带有 regparm(%1) 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4156
msgctxt "diagnostic"
msgid "Function declared with regparm(%0) attribute was previously declared without the regparm attribute"
msgstr "使用 regparm(%0) 属性声明的函数先前声明时没有 regparm 属性"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:237
msgctxt "diagnostic"
msgid "Function definition declared 'typedef'"
msgstr "函数定义被声明为 'typedef'"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:632
msgctxt "diagnostic"
msgid "Function definition does not declare parameters"
msgstr "函数定义未声明形参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9942
msgctxt "diagnostic"
msgid "Function definition inside an Objective-C container is deprecated"
msgstr "Objective-C 容器内的函数定义已弃用"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:518
msgctxt "diagnostic"
msgid "Function definition is not allowed here"
msgstr "此处不允许定义函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2231
msgctxt "diagnostic"
msgid "Function definition with pure-specifier is a Microsoft extension"
msgstr "带有纯说明符的函数定义是 Microsoft 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3551
msgctxt "diagnostic"
msgid "Function does not return %0"
msgstr "函数不返回 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4103
msgctxt "diagnostic"
msgid "Function executed in streaming-SVE mode requires 'sme'"
msgstr "在 streaming-SVE 模式下执行的函数需要 'sme'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13891
msgctxt "diagnostic"
msgid "Function introduces unsafe buffer manipulation"
msgstr "函数引入了不安全的缓冲操作"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13297
msgctxt "diagnostic"
msgid "Function multiversioning doesn't support architecture '%1'"
msgstr "函数多版本控制不支持架构 '%1'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13297
msgctxt "diagnostic"
msgid "Function multiversioning doesn't support feature '%1'"
msgstr "函数多版本控制不支持特性 '%1'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13323
msgctxt "diagnostic"
msgid "Function multiversioning is not supported on the current target"
msgstr "当前目标不支持函数多版本化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12295
msgctxt "diagnostic"
msgid "Function name is not allowed in '%0' clause"
msgstr "'%0' 子句中不允许出现函数名"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3043
msgctxt "diagnostic"
msgid "Function parameter cannot be <ERROR>"
msgstr "函数形参 不能为 <ERROR>"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3043
msgctxt "diagnostic"
msgid "Function parameter cannot be consteval"
msgstr "函数形参 不能为 consteval"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3043
msgctxt "diagnostic"
msgid "Function parameter cannot be constexpr"
msgstr "函数形参 不能为 constexpr"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3043
msgctxt "diagnostic"
msgid "Function parameter cannot be constinit"
msgstr "函数形参 不能为 constinit"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13407
msgctxt "diagnostic"
msgid "Function pointer argument to '__builtin_is_within_lifetime' is not allowed"
msgstr "不允许向 '__builtin_is_within_lifetime' 传递函数指针实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13401
msgctxt "diagnostic"
msgid "Function pointer argument to '__builtin_launder' is not allowed"
msgstr "不允许将函数指针实参传递给 '__builtin_launder'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10706
msgctxt "diagnostic"
msgid "Function previously declared with an explicit exception specification redeclared with an explicit exception specification"
msgstr "先前声明为具有显式异常说明的函数被重新声明为具有显式异常说明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10706
msgctxt "diagnostic"
msgid "Function previously declared with an explicit exception specification redeclared with an implicit exception specification"
msgstr "先前声明为具有显式异常说明的函数被重新声明为具有隐式异常说明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10706
msgctxt "diagnostic"
msgid "Function previously declared with an implicit exception specification redeclared with an explicit exception specification"
msgstr "先前声明为具有隐式异常说明的函数被重新声明为具有显式异常说明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10706
msgctxt "diagnostic"
msgid "Function previously declared with an implicit exception specification redeclared with an implicit exception specification"
msgstr "先前声明为具有隐式异常说明的函数被重新声明为具有隐式异常说明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1155
msgctxt "diagnostic"
msgid "Function return value cannot have __fp16 type; did you forget * ?"
msgstr "函数返回值不能为 __fp16 类型；是否忘记了 * ？"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13113
msgctxt "diagnostic"
msgid "Function returns a type %0 marked with [[clang::coro_return_type]] but is neither a coroutine nor a coroutine wrapper; non-coroutines should be marked with [[clang::coro_wrapper]] to allow returning coroutine return type"
msgstr "函数返回了带有 [[clang::coro_return_type]] 标记的类型 %0，但该函数既不是协程也不是协程包装器；非协程应标记为 [[clang::coro_wrapper]] 以允许返回协程返回类型"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:431
msgctxt "diagnostic"
msgid "Function scope depth exceeded maximum of %0"
msgstr "函数作用域深度超过最大值 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11858
msgctxt "diagnostic"
msgid "Function scope variable cannot be declared in %1 address space"
msgstr "函数作用域变量不能在 %1 地址空间中声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14252
msgctxt "diagnostic"
msgid "Function static variables are not permitted in functions to which an OpenACC 'routine' directive applies"
msgstr "在应用了 OpenACC 'routine' 指令的函数中不允许使用函数静态变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2779
msgctxt "diagnostic"
msgid "Function template %1 requires template arguments; argument deduction only allowed for class templates or alias templates"
msgstr "函数模板 %1 需要模板实参；仅类模板或别名模板允许实参推导"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5969
msgctxt "diagnostic"
msgid "Function template partial specialization is not allowed"
msgstr "不允许函数模板偏特化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5963
msgctxt "diagnostic"
msgid "Function template specialization %0 ambiguously refers to more than one function template; explicitly specify additional template arguments to identify a particular function template"
msgstr "函数模板特化 %0 有歧义地引用了多个函数模板；请显式指定额外的模板实参以标识特定的函数模板"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5963
msgctxt "diagnostic"
msgid "Function template specialization %0 ambiguously refers to more than one function template; explicitly specify template arguments to identify a particular function template"
msgstr "函数模板特化 %0 有歧义地引用了多个函数模板；请显式指定模板实参以标识特定的函数模板"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5850
msgctxt "diagnostic"
msgid "Function template specialization of %1 must occur at global scope"
msgstr "%1 的函数模板特化必须在全局作用域中进行"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5837
msgctxt "diagnostic"
msgid "Function template specialization of %1 not in a namespace enclosing %2"
msgstr "%1 的函数模板特化不在包含 %2 的命名空间中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5843
msgctxt "diagnostic"
msgid "Function template specialization of %1 not in a namespace enclosing %2 is a Microsoft extension"
msgstr "不在包含 %2 的命名空间中的 %1 函数模板特化是 Microsoft 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5837
msgctxt "diagnostic"
msgid "Function template specialization of %1 not in class %2 or an enclosing namespace"
msgstr "%1 的函数模板特化不在类 %2 或其外围命名空间中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5843
msgctxt "diagnostic"
msgid "Function template specialization of %1 not in class %2 or an enclosing namespace is a Microsoft extension"
msgstr "不在类 %2 或包含它的命名空间中的 %1 函数模板特化是 Microsoft 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13537
msgctxt "diagnostic"
msgid "Function template with 'sycl_kernel' attribute must have a 'void' return type"
msgstr "带有 'sycl_kernel' 属性的函数模板必须具有 'void' 返回类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13534
msgctxt "diagnostic"
msgid "Function template with 'sycl_kernel' attribute must have a single parameter"
msgstr "带有 'sycl_kernel' 属性的函数模板必须只有一个形参"

#: clang/include/clang/Basic/Diagnostic.td:201
msgctxt "diagnostic"
msgid "Function try block in constexpr constructor is a C++20 extension"
msgstr "constexpr 构造函数中的函数 try 块是 C++20 扩展"

#: clang/include/clang/Basic/Diagnostic.td:209
msgctxt "diagnostic"
msgid "Function try block in constexpr constructor is incompatible with C++ standards before C++20"
msgstr "constexpr 构造函数中的函数 try 块与 C++20 之前的 C++ 标准不兼容"

#: clang/include/clang/Basic/Diagnostic.td:201
msgctxt "diagnostic"
msgid "Function try block in constexpr function is a C++20 extension"
msgstr "constexpr 函数中的函数 try 块是 C++20 扩展"

#: clang/include/clang/Basic/Diagnostic.td:209
msgctxt "diagnostic"
msgid "Function try block in constexpr function is incompatible with C++ standards before C++20"
msgstr "constexpr 函数中的函数 try 块与 C++20 之前的 C++ 标准不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3634
msgctxt "diagnostic"
msgid "Function type may not be qualified with an address space"
msgstr "函数类型不能使用地址空间限定符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3630
msgctxt "diagnostic"
msgid "Function type with %0 attribute must have C linkage"
msgstr "带有 %0 属性的函数类型必须具有 C 链接"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4105
msgctxt "diagnostic"
msgid "Function using ZA state requires 'sme'"
msgstr "使用 ZA 状态的函数需要 'sme'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4107
msgctxt "diagnostic"
msgid "Function using ZT0 state requires 'sme2'"
msgstr "使用 ZT0 状态的函数需要 'sme2'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12736
msgctxt "diagnostic"
msgid "Function with '#pragma omp declare variant' has a different calling convention"
msgstr "带有 '#pragma omp declare variant' 的函数具有不同的调用约定"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12736
msgctxt "diagnostic"
msgid "Function with '#pragma omp declare variant' has a different constexpr specification"
msgstr "带有 '#pragma omp declare variant' 的函数具有不同的constexpr 说明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12736
msgctxt "diagnostic"
msgid "Function with '#pragma omp declare variant' has a different inline specification"
msgstr "带有 '#pragma omp declare variant' 的函数具有不同的inline 说明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12736
msgctxt "diagnostic"
msgid "Function with '#pragma omp declare variant' has a different linkage"
msgstr "带有 '#pragma omp declare variant' 的函数具有不同的链接"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12736
msgctxt "diagnostic"
msgid "Function with '#pragma omp declare variant' has a different return type"
msgstr "带有 '#pragma omp declare variant' 的函数具有不同的返回类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12736
msgctxt "diagnostic"
msgid "Function with '#pragma omp declare variant' has a different storage class"
msgstr "带有 '#pragma omp declare variant' 的函数具有不同的存储类"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12740
msgctxt "diagnostic"
msgid "Function with '#pragma omp declare variant' must have a prototype when 'append_args' is used"
msgstr "使用 'append_args' 时，带有 '#pragma omp declare variant' 的函数必须具有函数原型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12022
msgctxt "diagnostic"
msgid "Function with '%1' attribute must not access ObjC methods or properties"
msgstr "带有 '%1' 属性的函数不得访问 ObjC 方法或属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12022
msgctxt "diagnostic"
msgid "Function with '%1' attribute must not allocate or deallocate memory"
msgstr "带有 '%1' 属性的函数不得分配或释放内存"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12034
msgctxt "diagnostic"
msgid "Function with '%1' attribute must not call non-'%1' block '%3'"
msgstr "带有 '%1' 属性的函数不得调用非 '%1' 块 '%3'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12034
msgctxt "diagnostic"
msgid "Function with '%1' attribute must not call non-'%1' constructor '%3'"
msgstr "带有 '%1' 属性的函数不得调用非 '%1' 构造函数 '%3'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12034
msgctxt "diagnostic"
msgid "Function with '%1' attribute must not call non-'%1' destructor '%3'"
msgstr "带有 '%1' 属性的函数不得调用非 '%1' 析构函数 '%3'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12046
msgctxt "diagnostic"
msgid "Function with '%1' attribute must not call non-'%1' expression"
msgstr "带有 '%1' 属性的函数不得调用非 '%1' 表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12034
msgctxt "diagnostic"
msgid "Function with '%1' attribute must not call non-'%1' function '%3'"
msgstr "带有 '%1' 属性的函数不得调用非 '%1' 函数 '%3'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12034
msgctxt "diagnostic"
msgid "Function with '%1' attribute must not call non-'%1' lambda '%3'"
msgstr "带有 '%1' 属性的函数不得调用非 '%1' lambda '%3'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12022
msgctxt "diagnostic"
msgid "Function with '%1' attribute must not have static local variables"
msgstr "带有 '%1' 属性的函数不得包含静态局部变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12022
msgctxt "diagnostic"
msgid "Function with '%1' attribute must not throw or catch exceptions"
msgstr "带有 '%1' 属性的函数不得抛出或捕获异常"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12022
msgctxt "diagnostic"
msgid "Function with '%1' attribute must not use thread-local variables"
msgstr "带有 '%1' 属性的函数不得使用线程局部变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12058
msgctxt "diagnostic"
msgid "Function with '%1' attribute should be declared noexcept"
msgstr "具有 '%1' 属性的函数 应声明为 noexcept"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12708
msgctxt "diagnostic"
msgid "Function with 'device_type(%0)' is not available on device"
msgstr "带有 'device_type(%0)' 的函数在设备端不可用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12708
msgctxt "diagnostic"
msgid "Function with 'device_type(%0)' is not available on host"
msgstr "带有 'device_type(%0)' 的函数在主机端不可用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:413
msgctxt "diagnostic"
msgid "Function with attribute 'no_caller_saved_registers' should only call a function with attribute 'no_caller_saved_registers' or be compiled with '-mgeneral-regs-only'"
msgstr "带有属性 'no_caller_saved_registers' 的函数应仅调用带有属性 'no_caller_saved_registers' 的函数，或者使用 '-mgeneral-regs-only' 进行编译"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2863
msgctxt "diagnostic"
msgid "Function with deduced return type cannot be virtual"
msgstr "带有推导返回类型的函数不能为虚函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2747
msgctxt "diagnostic"
msgid "Function with deduced return type must be the only declaration in its group"
msgstr "具有推导返回类型的函数必须是其声明组中的唯一声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4149
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4151
msgctxt "diagnostic"
msgid "Function with no prototype cannot use the %0 calling convention"
msgstr "无原型的函数不能使用 %0 调用约定"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2728
msgctxt "diagnostic"
msgid "Function with trailing return type must specify return type 'auto', not %0"
msgstr "带有尾置返回类型的函数必须指定返回类型 'auto'，而不是 %0"

msgctxt "diagnostic"
msgid "Function {name} exceeds recommended size/complexity thresholds"
msgstr "函数 {name} 超过建议的长度或复杂度上限"

msgctxt "diagnostic"
msgid "Function {name} with deduced return type cannot be used before it is defined"
msgstr "返回类型需要推导的函数 {name} 必须先定义才能使用"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:634
msgctxt "diagnostic"
msgid "Function-like macro %0 is not defined"
msgstr "未定义类函数宏 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8277
msgctxt "diagnostic"
msgid "Function-style cast to a builtin type can only take one argument"
msgstr "向内建类型的函数风格强制转换只能接受一个实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8536
msgctxt "diagnostic"
msgid "Functional-style cast from %1 to %2 casts away qualifiers"
msgstr "从 %1 到 %2 的函数式强制类型转换丢弃了限定符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8539
msgctxt "diagnostic"
msgid "Functional-style cast from %1 to %2 converts between mismatching address spaces"
msgstr "从 %1 到 %2 的 函数式转换 在不匹配的地址空间之间进行了转换"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8522
msgctxt "diagnostic"
msgid "Functional-style cast from %1 to %2 is not allowed"
msgstr "不允许从 %1 到 %2 进行 函数式强制类型转换"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5453
msgctxt "diagnostic"
msgid "Functional-style cast from %1 to %2 uses deleted function"
msgstr "从 %1 到 %2 的函数风格强制转换使用了已删除的函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5453
msgctxt "diagnostic"
msgid "Functional-style cast from %1 to %2 uses deleted function: %4"
msgstr "从 %1 到 %2 的函数风格强制转换使用了已删除的函数：%4"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8525
msgctxt "diagnostic"
msgid "Functional-style cast from %1 to %2, which are not related by inheritance, is not allowed"
msgstr "不允许从 %1 到 %2 进行 函数式强制类型转换，两者之间没有继承关系"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8533
msgctxt "diagnostic"
msgid "Functional-style cast from bit-field lvalue to reference type %2"
msgstr "使用函数风格强制转换将位域左值转换为引用类型 %2 无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8530
msgctxt "diagnostic"
msgid "Functional-style cast from rvalue to reference type %2"
msgstr "从右值向引用类型 %2 执行 函数风格类型转换"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2736
msgctxt "diagnostic"
msgid "Functional-style cast to %0 has incompatible initializer of type %1"
msgstr "到 %0 的函数式强制类型转换具有不兼容的 %1 类型初始化式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8549
msgctxt "diagnostic"
msgid "Functional-style cast to %2, which is not a reference, pointer-to-object, or pointer-to-data-member"
msgstr "函数式强制类型转换 的目标类型 %2 不是引用、指向对象的指针或指向数据成员的指针"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10308
msgctxt "diagnostic"
msgid "Functions cannot be declared in an anonymous struct"
msgstr "不能在匿名 struct 中声明函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10308
msgctxt "diagnostic"
msgid "Functions cannot be declared in an anonymous union"
msgstr "不能在匿名 union 中声明函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3632
msgctxt "diagnostic"
msgid "Functions may not be declared with 'cmse_nonsecure_call' attribute"
msgstr "函数不能使用 'cmse_nonsecure_call' 属性声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5206
msgctxt "diagnostic"
msgid "Functions that differ only in their return type cannot be overloaded"
msgstr "仅在返回类型上不同的函数不能重载"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:251
msgctxt "diagnostic"
msgid "GCC does not allow %0 attribute in this position on a function definition"
msgstr "GCC 不允许在函数定义的此位置使用 %0 属性"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:254
msgctxt "diagnostic"
msgid "GCC does not allow an attribute in this position on a function declaration"
msgstr "GCC 不允许属性出现在函数声明的此位置"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4906
msgctxt "diagnostic"
msgid "GCC does not allow the %0 attribute to be written on a type"
msgstr "GCC 不允许将 %0 属性写在类型上"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4878
msgctxt "diagnostic"
msgid "GCC does not allow the 'cleanup' attribute argument to be anything other than a simple identifier"
msgstr "GCC 不允许 'cleanup' 属性实参为简单标识符以外的任何内容"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:257
msgctxt "diagnostic"
msgid "GCC does not allow variable declarations in for loop initializers before C99"
msgstr "GCC 在 C99 之前不允许在 for 循环初始化器中声明变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4909
msgctxt "diagnostic"
msgid "GCC requires a function with the %0 attribute to be variadic"
msgstr "GCC 要求带有 %0 属性的函数是可变参数的"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11680
msgctxt "diagnostic"
msgid "GNU decimal type extension not supported"
msgstr "不支持 GNU 十进制类型扩展"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:819
msgctxt "diagnostic"
msgid "GNU line marker directive interprets number as decimal, not octal"
msgstr "GNU 行标记指令将数字解释为十进制，而非八进制"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:821
msgctxt "diagnostic"
msgid "GNU line marker directive requires a simple digit sequence"
msgstr "GNU 行标记指令需要简单的数字序列"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8882
msgctxt "diagnostic"
msgid "GNU vector conditional operand cannot be a throw expression"
msgstr "GNU 向量条件运算的操作数不能为 throw 表达式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8882
msgctxt "diagnostic"
msgid "GNU vector conditional operand cannot be void"
msgstr "GNU 向量条件运算的操作数不能为 void"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:33
msgctxt "diagnostic"
msgid "GNU-style inline assembly is disabled"
msgstr "GNU 风格内联汇编已禁用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13874
msgctxt "diagnostic"
msgid "GatherCmpAlpha operations on the Vulkan target are not supported; only GatherCmp and GatherCmpRed are allowed"
msgstr "Vulkan 目标不支持 gatherCmpAlpha 操作；仅允许 GatherCmp 和 GatherCmpRed"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13874
msgctxt "diagnostic"
msgid "GatherCmpBlue operations on the Vulkan target are not supported; only GatherCmp and GatherCmpRed are allowed"
msgstr "Vulkan 目标不支持 gatherCmpBlue 操作；仅允许 GatherCmp 和 GatherCmpRed"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13874
msgctxt "diagnostic"
msgid "GatherCmpGreen operations on the Vulkan target are not supported; only GatherCmp and GatherCmpRed are allowed"
msgstr "Vulkan 目标不支持 gatherCmpGreen 操作；仅允许 GatherCmp 和 GatherCmpRed"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13874
msgctxt "diagnostic"
msgid "GatherCmpRed operations on the Vulkan target are not supported; only GatherCmp and GatherCmpRed are allowed"
msgstr "Vulkan 目标不支持 gatherCmpRed 操作；仅允许 GatherCmp 和 GatherCmpRed"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:390
msgctxt "diagnostic"
msgid "Generalized initializer lists are a C++11 extension"
msgstr "广义初始化列表是 C++11 扩展"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:393
msgctxt "diagnostic"
msgid "Generalized initializer lists are incompatible with C++98"
msgstr "广义初始化器列表与 C++98 不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8993
msgctxt "diagnostic"
msgid "Generic lambdas are incompatible with C++11"
msgstr "泛型 lambda 与 C++11 不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1614
msgctxt "diagnostic"
msgid "Getter name mismatch between property redeclaration (%1) and its original declaration (%0)"
msgstr "属性重复声明的 getter 名称 (%1) 与其原始声明 (%0) 不匹配"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1831
msgctxt "diagnostic"
msgid "Global module fragment cannot be exported"
msgstr "全局模块片段无法被导出"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11902
msgctxt "diagnostic"
msgid "Global sampler requires a const or constant address space qualifier"
msgstr "全局采样器需要 const 或 constant 地址空间限定符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7352
msgctxt "diagnostic"
msgid "Global variables cannot have __autoreleasing ownership"
msgstr "全局变量不能具有 __autoreleasing 所有权"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12185
msgctxt "diagnostic"
msgid "Groupprivate variable with incomplete type %0"
msgstr "groupprivate 变量具有不完整类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9872
msgctxt "diagnostic"
msgid "HIP does not support OpenMP target directives; directive has been ignored"
msgstr "HIP 不支持 OpenMP 目标指令；指令已被忽略"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13699
msgctxt "diagnostic"
msgid "HLSL does not support constructors or destructors"
msgstr "HLSL 不支持构造函数或析构函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13761
msgctxt "diagnostic"
msgid "HLSL resource needs to have [[hlsl::resource_class()]] attribute"
msgstr "HLSL 资源需要具有 [[hlsl::resource_class()]] 属性"

#: clang/include/clang/Basic/DiagnosticCommentKinds.td:28
msgctxt "diagnostic"
msgid "HTML end tag '%0' is forbidden"
msgstr "禁止使用 HTML 结束标签 '%0'"

#: clang/include/clang/Basic/DiagnosticCommentKinds.td:32
msgctxt "diagnostic"
msgid "HTML end tag does not match any start tag"
msgstr "HTML 结束标签与任何起始标签都不匹配"

#: clang/include/clang/Basic/DiagnosticCommentKinds.td:36
msgctxt "diagnostic"
msgid "HTML start tag '%0' closed by '%1'"
msgstr "HTML 起始标签 '%0' 由 '%1' 闭合"

#: clang/include/clang/Basic/DiagnosticCommentKinds.td:19
msgctxt "diagnostic"
msgid "HTML start tag prematurely ended, expected attribute name or '>'"
msgstr "HTML 开始标签过早结束，预期为属性名或 '>'"

#: clang/include/clang/Basic/DiagnosticCommentKinds.td:43
msgctxt "diagnostic"
msgid "HTML tag '%0' requires an end tag"
msgstr "HTML 标签 '%0' 需要结束标签"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:206
msgctxt "diagnostic"
msgid "Half precision constant requires cl_khr_fp16"
msgstr "半精度常量需要 cl_khr_fp16"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:354
msgctxt "diagnostic"
msgid "Hardware TLS register is not supported for the %0 sub-architecture"
msgstr "%0 子架构不支持硬件 TLS register"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:895
msgctxt "diagnostic"
msgid "Header '%0' is owned by multiple modules"
msgstr "头文件 '%0' 归属于多个模块"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:1029
msgctxt "diagnostic"
msgid "Header '%0' may be a symlink to '%1' owned by module '%2'; symlinks to modular headers are deprecated, replace with a textual forwarding header"
msgstr "头文件 '%0' 可能是指向模块 '%2' 所属 '%1' 的符号链接；指向模块化头文件的符号链接已弃用，请替换为文本转发头文件"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:112
msgctxt "diagnostic"
msgid "Header '%1' not found"
msgstr "未找到头文件 '%1'"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:963
msgctxt "diagnostic"
msgid "Header attribute '%0' specified multiple times"
msgstr "多次指定了头文件特性 '%0'"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:1056
msgctxt "diagnostic"
msgid "Header file %0 (aka '%1') cannot be imported because it is not known to be a header unit"
msgstr "头文件 %0（即 '%1'）无法导入，因为未知其是否为头文件单元"

msgctxt "diagnostic"
msgid "Header {header} is not used directly"
msgstr "头文件 {header} 未被直接使用"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:285
msgctxt "diagnostic"
msgid "Hex escape sequence out of range"
msgstr "十六进制转义序列超出范围"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:252
msgctxt "diagnostic"
msgid "Hexadecimal floating constant requires a significand"
msgstr "十六进制浮点常量需要有效数字"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:252
msgctxt "diagnostic"
msgid "Hexadecimal floating constant requires an exponent"
msgstr "十六进制浮点常量需要指数"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:255
msgctxt "diagnostic"
msgid "Hexadecimal floating constants are a C99 feature"
msgstr "十六进制浮点常量是 C99 特性"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:252
msgctxt "diagnostic"
msgid "Hexadecimal floating literal requires a significand"
msgstr "十六进制浮点字面量需要有效数字"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:252
msgctxt "diagnostic"
msgid "Hexadecimal floating literal requires an exponent"
msgstr "十六进制浮点字面量需要指数"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:257
msgctxt "diagnostic"
msgid "Hexadecimal floating literals are a C++17 feature"
msgstr "十六进制浮点字面量是 C++17 特性"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:259
msgctxt "diagnostic"
msgid "Hexadecimal floating literals are incompatible with C++ standards before C++17"
msgstr "十六进制浮点字面量与 C++17 之前的 C++ 标准不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4569
msgctxt "diagnostic"
msgid "Higher order bits are zeroes after implicit conversion"
msgstr "隐式转换后高位为零"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4924
msgctxt "diagnostic"
msgid "IBOutletCollection properties should be copy/strong and not assign"
msgstr "IBOutletCollection 属性应为 copy/strong，而不是 assign"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:284
msgctxt "diagnostic"
msgid "ISO C does not allow an attribute list to appear here"
msgstr "ISO C 不允许属性列表出现在此处"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7978
msgctxt "diagnostic"
msgid "ISO C does not allow indirection on operand of type %0"
msgstr "ISO C 不允许对类型为 %0 的操作数进行间接寻址"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8372
msgctxt "diagnostic"
msgid "ISO C does not support '~' for complex conjugation of %0"
msgstr "ISO C 不支持对 %0 使用 '~' 进行复共轭运算"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6674
msgctxt "diagnostic"
msgid "ISO C forbids forward references to 'enum' types"
msgstr "ISO C 禁止对 'enum' 类型的向前引用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7952
msgctxt "diagnostic"
msgid "ISO C forbids taking the address of an expression of type 'void'"
msgstr "ISO C 禁止获取 'void' 类型表达式的地址"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:562
msgctxt "diagnostic"
msgid "ISO C requires a named parameter before '...'"
msgstr "ISO C 要求在 '...' 之前有一个具名形参"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:40
msgctxt "diagnostic"
msgid "ISO C requires a translation unit to contain at least one declaration"
msgstr "ISO C 要求翻译单元至少包含一个声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2444
msgctxt "diagnostic"
msgid "ISO C++ considers this destructor name lookup to be ambiguous"
msgstr "ISO C++ 认为此析构函数名称查找具有歧义"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8543
msgctxt "diagnostic"
msgid "ISO C++ does not allow  from %1 to %2 because it casts away qualifiers, even though the source and destination types are unrelated"
msgstr "ISO C++ 不允许从 %1 到 %2 进行 ，因为它移除了限定符，即使源类型和目标类型不相关"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:823
msgctxt "diagnostic"
msgid "ISO C++ does not allow %0 to appear here"
msgstr "ISO C++ 不允许%0出现在此处"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8543
msgctxt "diagnostic"
msgid "ISO C++ does not allow C-style cast from %1 to %2 because it casts away qualifiers, even though the source and destination types are unrelated"
msgstr "ISO C++ 不允许从 %1 到 %2 进行 C 风格强制类型转换，因为它移除了限定符，即使源类型和目标类型不相关"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:823
msgctxt "diagnostic"
msgid "ISO C++ does not allow an attribute list to appear here"
msgstr "ISO C++ 不允许属性列表出现在此处"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8543
msgctxt "diagnostic"
msgid "ISO C++ does not allow const_cast from %1 to %2 because it casts away qualifiers, even though the source and destination types are unrelated"
msgstr "ISO C++ 不允许从 %1 到 %2 进行 const_cast，因为它移除了限定符，即使源类型和目标类型不相关"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8543
msgctxt "diagnostic"
msgid "ISO C++ does not allow dynamic_cast from %1 to %2 because it casts away qualifiers, even though the source and destination types are unrelated"
msgstr "ISO C++ 不允许从 %1 到 %2 进行 dynamic_cast，因为它移除了限定符，即使源类型和目标类型不相关"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8543
msgctxt "diagnostic"
msgid "ISO C++ does not allow functional-style cast from %1 to %2 because it casts away qualifiers, even though the source and destination types are unrelated"
msgstr "ISO C++ 不允许从 %1 到 %2 进行 函数式强制类型转换，因为它移除了限定符，即使源类型和目标类型不相关"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8543
msgctxt "diagnostic"
msgid "ISO C++ does not allow reinterpret_cast from %1 to %2 because it casts away qualifiers, even though the source and destination types are unrelated"
msgstr "ISO C++ 不允许从 %1 到 %2 进行 reinterpret_cast，因为它移除了限定符，即使源类型和目标类型不相关"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8543
msgctxt "diagnostic"
msgid "ISO C++ does not allow static_cast from %1 to %2 because it casts away qualifiers, even though the source and destination types are unrelated"
msgstr "ISO C++ 不允许从 %1 到 %2 进行 static_cast，因为它移除了限定符，即使源类型和目标类型不相关"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1874
msgctxt "diagnostic"
msgid "ISO C++ does not permit the 'bool' keyword after 'concept'"
msgstr "ISO C++ 不允许在 'concept' 之后使用 'bool' 关键字"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:463
msgctxt "diagnostic"
msgid "ISO C++ forbids attributes before the compound statement of an expansion statement"
msgstr "ISO C++ 禁止在展开语句的复合语句之前放置属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6676
msgctxt "diagnostic"
msgid "ISO C++ forbids forward references to 'enum' types"
msgstr "ISO C++ 禁止前向引用 'enum' 类型"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:143
msgctxt "diagnostic"
msgid "ISO C++ only allows ':' in member enumeration declaration to introduce a fixed underlying type, not an anonymous bit-field"
msgstr "ISO C++ 仅允许在成员枚举声明中使用 ':' 来引入固定底层类型，而不能用于匿名位域"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6529
msgctxt "diagnostic"
msgid "ISO C++ requires a definition in this translation unit for function %1 because its type does not have linkage"
msgstr "ISO C++ 要求在此翻译单元中为函数 %1 提供定义，因为其类型没有链接"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6529
msgctxt "diagnostic"
msgid "ISO C++ requires a definition in this translation unit for variable %1 because its type does not have linkage"
msgstr "ISO C++ 要求在此翻译单元中为变量 %1 提供定义，因为其类型没有链接"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:312
msgctxt "diagnostic"
msgid "ISO C++ requires field designators to be specified in declaration order; field %1 will be initialized after field %0"
msgstr "ISO C++ 要求按声明顺序指定字段指定符；字段 %1 将在字段 %0 之后初始化"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:460
msgctxt "diagnostic"
msgid "ISO C++ requires the body of an expansion statement to be a compound statement"
msgstr "ISO C++ 要求展开语句的主体必须是复合语句"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2438
msgctxt "diagnostic"
msgid "ISO C++ requires the name after '::~' to be found in the same scope as the name before '::~'"
msgstr "ISO C++ 要求在 '::~' 之前名称所在的同一作用域中找到 '::~' 之后的名称"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2178
msgctxt "diagnostic"
msgid "ISO C++ specifies that qualified reference to %0 is a constructor name rather than a template name in this context, despite preceding 'template' keyword"
msgstr "ISO C++ 规定，在此上下文中对 %0 的限定引用是构造函数名而非模板名，即使前面有 'template' 关键字"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2178
msgctxt "diagnostic"
msgid "ISO C++ specifies that qualified reference to %0 is a constructor name rather than a template name in this context, despite preceding 'typename' keyword"
msgstr "ISO C++ 规定，在此上下文中对 %0 的限定引用是构造函数名而非模板名，即使前面有 'typename' 关键字"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2178
msgctxt "diagnostic"
msgid "ISO C++ specifies that qualified reference to %0 is a constructor name rather than a type in this context, despite preceding 'template' keyword"
msgstr "ISO C++ 规定，在此上下文中对 %0 的限定引用是构造函数名而非类型，即使前面有 'template' 关键字"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2178
msgctxt "diagnostic"
msgid "ISO C++ specifies that qualified reference to %0 is a constructor name rather than a type in this context, despite preceding 'typename' keyword"
msgstr "ISO C++ 规定，在此上下文中对 %0 的限定引用是构造函数名而非类型，即使前面有 'typename' 关键字"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2701
msgctxt "diagnostic"
msgid "ISO C++ standards before C++17 do not allow new expression for type %0 to use list-initialization"
msgstr "C++17 之前的 ISO C++ 标准不允许类型为 %0 的 new 表达式使用列表初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:749
msgctxt "diagnostic"
msgid "ISO C++11 does not allow access declarations; use using declarations instead"
msgstr "ISO C++11 不允许访问声明；请改用 using 声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7935
msgctxt "diagnostic"
msgid "ISO C++11 does not allow conversion from string literal to %0"
msgstr "ISO C++11 不允许从字符串字面量转换为 %0"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:716
msgctxt "diagnostic"
msgid "ISO C++11 requires a parenthesized pack declaration to have a name"
msgstr "ISO C++11 要求带括号的包声明必须具有名称"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:358
msgctxt "diagnostic"
msgid "ISO C++17 does not allow 'register' storage class specifier"
msgstr "ISO C++17 不允许 'register' 存储类说明符"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:525
msgctxt "diagnostic"
msgid "ISO C++17 does not allow a structured binding group to be empty"
msgstr "ISO C++17 不允许结构化绑定组为空"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:666
msgctxt "diagnostic"
msgid "ISO C++17 does not allow dynamic exception specifications"
msgstr "ISO C++17 不允许动态异常规范"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8744
msgctxt "diagnostic"
msgid "ISO C++17 does not allow incrementing expression of type bool"
msgstr "ISO C++17 不允许对 bool 类型的表达式进行递增"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5469
msgctxt "diagnostic"
msgid "ISO C++20 considers use of overloaded operator '%0' (with operand types %1 and %2) to be ambiguous despite there being a unique best viable function"
msgstr "ISO C++20 认为重载运算符 '%0'（操作数类型为 %1 和 %2）的使用存在歧义，尽管存在唯一最佳可行函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5469
msgctxt "diagnostic"
msgid "ISO C++20 considers use of overloaded operator '%0' (with operand types %1 and %2) to be ambiguous despite there being a unique best viable function with non-reversed arguments"
msgstr "ISO C++20 认为重载运算符 '%0'（操作数类型为 %1 和 %2）的使用存在歧义，尽管使用非反转实参时存在唯一最佳可行函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5496
msgctxt "diagnostic"
msgid "ISO C++20 requires return type of selected 'operator==' function for rewritten '%1' comparison to be 'bool', not %0"
msgstr "ISO C++20 要求用于重写 '%1' 比较的所选 'operator==' 函数的返回类型必须为 'bool'，而不是 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7733
msgctxt "diagnostic"
msgid "ISO C90 does not allow subscripting non-lvalue array"
msgstr "ISO C90 不允许对非左值数组进行下标操作"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:373
msgctxt "diagnostic"
msgid "ISO C99 requires whitespace after the macro name"
msgstr "ISO C99 要求宏名后有空白字符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2424
msgctxt "diagnostic"
msgid "Identifier %0 after '~' in destructor name does not name a type"
msgstr "析构函数名中 '~' 后的标识符 %0 未命名任何类型"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:447
msgctxt "diagnostic"
msgid "Identifier %0 conflicts with a C++ keyword"
msgstr "标识符 %0 与 C++ 关键字冲突"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2429
msgctxt "diagnostic"
msgid "Identifier %0 in object destruction expression does not name a type"
msgstr "对象析构表达式中的标识符 %0 未命名一个类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2426
msgctxt "diagnostic"
msgid "Identifier %0 in object destruction expression does not name the type %1 of the object being destroyed"
msgstr "对象析构表达式中的标识符 %0 未命名正被析构对象的类型 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:523
msgctxt "diagnostic"
msgid "Identifier %0 is reserved because <ERROR>"
msgstr "标识符 %0 是保留的，因为<ERROR>"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:523
msgctxt "diagnostic"
msgid "Identifier %0 is reserved because it contains '__'"
msgstr "标识符 %0 是保留的，因为它包含 '__'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:523
msgctxt "diagnostic"
msgid "Identifier %0 is reserved because it starts with '_' and has C language linkage"
msgstr "标识符 %0 是保留的，因为它以 '_' 开头且具有 C 语言链接"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:523
msgctxt "diagnostic"
msgid "Identifier %0 is reserved because it starts with '_' at global scope"
msgstr "标识符 %0 是保留的，因为它在全局作用域中以 '_' 开头"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:523
msgctxt "diagnostic"
msgid "Identifier %0 is reserved because it starts with '_' followed by a capital letter"
msgstr "标识符 %0 是保留的，因为它以 '_' 后跟大写字母开头"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:523
msgctxt "diagnostic"
msgid "Identifier %0 is reserved because it starts with '__'"
msgstr "标识符 %0 是保留的，因为它以 '__' 开头"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:532
msgctxt "diagnostic"
msgid "Identifier %0 preceded by whitespace in a literal operator declaration is deprecated"
msgstr "在字面量运算符声明中，标识符 %0 前带有空白符已弃用"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:309
msgctxt "diagnostic"
msgid "Identifier after literal will be treated as a reserved user-defined literal suffix in C++11"
msgstr "字面量后的标识符在 C++11 中将被视为保留的用户定义字面量后缀"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:306
msgctxt "diagnostic"
msgid "Identifier after literal will be treated as a user-defined literal suffix in C++11"
msgstr "字面量后的标识符在 C++11 中将被视为用户定义字面量后缀"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:145
msgctxt "diagnostic"
msgid "Identifier contains Unicode character <U+%0> that is invisible in some environments"
msgstr "标识符包含在某些环境中不可见的 Unicode 字符 <U+%0>"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:885
msgctxt "diagnostic"
msgid "Identifier followed by '<' indicates a class template specialization but %0 <unused>"
msgstr "后跟 '<' 的标识符表示类模板特化，但 %0 <unused>"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:885
msgctxt "diagnostic"
msgid "Identifier followed by '<' indicates a class template specialization but %0 does not refer to a template"
msgstr "后跟 '<' 的标识符表示类模板特化，但 %0 未引用模板"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:885
msgctxt "diagnostic"
msgid "Identifier followed by '<' indicates a class template specialization but %0 refers to a concept"
msgstr "后跟 '<' 的标识符表示类模板特化，但 %0 引用了概念"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:885
msgctxt "diagnostic"
msgid "Identifier followed by '<' indicates a class template specialization but %0 refers to a function template"
msgstr "后跟 '<' 的标识符表示类模板特化，但 %0 引用了函数模板"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:885
msgctxt "diagnostic"
msgid "Identifier followed by '<' indicates a class template specialization but %0 refers to a variable template"
msgstr "后跟 '<' 的标识符表示类模板特化，但 %0 引用了变量模板"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:738
msgctxt "diagnostic"
msgid "If initialization statements are incompatible with C++ standards before C++17"
msgstr "if 初始化语句与 C++17 之前的 C++ 标准不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11368
msgctxt "diagnostic"
msgid "If statement has empty body"
msgstr "if 语句体为空"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6936
msgctxt "diagnostic"
msgid "If you see this diagnostic, a Clang developer has made a mistake"
msgstr "如果您看到此诊断信息，说明 Clang 开发者犯了一个错误"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9804
msgctxt "diagnostic"
msgid "Ignored 'inline' attribute on kernel function %0"
msgstr "已忽略内核函数 %0 上的 'inline' 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10158
msgctxt "diagnostic"
msgid "Ignored asm label '%0' on automatic variable"
msgstr "已忽略自动变量上的 asm 标签 '%0'"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:43
msgctxt "diagnostic"
msgid "Ignored trigraph would end block comment"
msgstr "被忽略的三字母词将会结束块注释"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4322
msgctxt "diagnostic"
msgid "Ignoring %0 attribute because its argument is invalid"
msgstr "已忽略 %0 属性，因为其实参无效"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:966
msgctxt "diagnostic"
msgid "Ignoring 'inline' keyword on explicit template instantiation"
msgstr "忽略显式模板实例化上的 'inline' 关键字"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:966
msgctxt "diagnostic"
msgid "Ignoring 'static' keyword on explicit template instantiation"
msgstr "忽略显式模板实例化上的 'static' 关键字"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4172
msgctxt "diagnostic"
msgid "Ignoring __declspec(allocator) because the function return type %0 is not a pointer or reference type"
msgstr "忽略 __declspec(allocator)，因为函数返回类型 %0 不是指针或引用类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4270
msgctxt "diagnostic"
msgid "Ignoring availability attribute on '+load' method"
msgstr "忽略 '+load' 方法上的可用性属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4270
msgctxt "diagnostic"
msgid "Ignoring availability attribute with constructor attribute"
msgstr "忽略带有 constructor 属性的可用性属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4270
msgctxt "diagnostic"
msgid "Ignoring availability attribute with destructor attribute"
msgstr "忽略带有 destructor 属性的可用性属性"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:444
msgctxt "diagnostic"
msgid "Ignoring redefinition of Objective-C qualifier macro"
msgstr "正在忽略 Objective-C 限定符宏的重定义"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10015
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10030
msgctxt "diagnostic"
msgid "Ignoring return value of function declared with %0 attribute"
msgstr "忽略了带有 %0 属性的函数的返回值"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10030
msgctxt "diagnostic"
msgid "Ignoring return value of function declared with %0 attribute: %2"
msgstr "忽略了带有 %0 属性的函数的返回值：%2"

msgctxt "diagnostic"
msgid "Ignoring return value of function declared with {attribute} attribute"
msgstr "忽略了带有 {attribute} 属性的函数的返回值"

msgctxt "diagnostic"
msgid "Ignoring return value of function declared with {attribute} attribute: {message}"
msgstr "忽略了带有 {attribute} 属性的函数的返回值：{message}"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10018
msgctxt "diagnostic"
msgid "Ignoring return value of type %2 declared with %1 attribute"
msgstr "忽略了使用 %1 属性声明的类型为 %2 的返回值"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10018
msgctxt "diagnostic"
msgid "Ignoring return value of type %2 declared with %1 attribute: %4"
msgstr "忽略了使用 %1 属性声明的类型为 %2 的返回值：%4"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10021
msgctxt "diagnostic"
msgid "Ignoring temporary created by a constructor declared with %0 attribute"
msgstr "正在忽略由声明了 %0 属性的构造函数创建的临时对象"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10021
msgctxt "diagnostic"
msgid "Ignoring temporary created by a constructor declared with %0 attribute: %2"
msgstr "正在忽略由声明了 %0 属性的构造函数创建的临时对象：%2"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10018
msgctxt "diagnostic"
msgid "Ignoring temporary of type %2 declared with %1 attribute"
msgstr "忽略了使用 %1 属性声明的类型为 %2 的临时对象"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10018
msgctxt "diagnostic"
msgid "Ignoring temporary of type %2 declared with %1 attribute: %4"
msgstr "忽略了使用 %1 属性声明的类型为 %2 的临时对象：%4"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:173
msgctxt "diagnostic"
msgid "Ignoring the 'branch-protection' attribute because the '%0' architecture does not support it"
msgstr "正在忽略 'branch-protection' 属性，因为 '%0' 架构不支持它"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1608
msgctxt "diagnostic"
msgid "Illegal OpenMP user-defined mapper identifier"
msgstr "非法的 OpenMP 用户定义映射器标识符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12001
msgctxt "diagnostic"
msgid "Illegal call to %0, expected %1 argument type"
msgstr "对 %0 的调用非法，期望实参类型为 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11990
msgctxt "diagnostic"
msgid "Illegal call to enqueue_kernel, incorrect argument types"
msgstr "对 enqueue_kernel 的非法调用，实参类型不正确"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11994
msgctxt "diagnostic"
msgid "Illegal call to enqueue_kernel, parameter needs to be specified as integer type"
msgstr "对 enqueue_kernel 的非法调用，参数需要指定为整数类型"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:343
#: clang/include/clang/Basic/DiagnosticLexKinds.td:345
msgctxt "diagnostic"
msgid "Illegal character encoding in character literal"
msgstr "字符字面量中的字符编码非法"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:338
#: clang/include/clang/Basic/DiagnosticLexKinds.td:340
msgctxt "diagnostic"
msgid "Illegal character encoding in string literal"
msgstr "字符串字面量中存在非法字符编码"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9853
msgctxt "diagnostic"
msgid "Illegal device builtin surface reference class template %1 declared here"
msgstr "此处声明了非法的设备内置表面引用类模板 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9862
msgctxt "diagnostic"
msgid "Illegal device builtin surface reference type %1 declared here"
msgstr "此处声明了非法的设备内建 surface 引用类型 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9853
msgctxt "diagnostic"
msgid "Illegal device builtin texture reference class template %1 declared here"
msgstr "此处声明了非法的设备内置纹理引用类模板 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9862
msgctxt "diagnostic"
msgid "Illegal device builtin texture reference type %1 declared here"
msgstr "此处声明了非法的设备内建 texture 引用类型 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6832
msgctxt "diagnostic"
msgid "Illegal initializer (only variables can be initialized)"
msgstr "非法的初始化器（只有变量可以被初始化）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6834
msgctxt "diagnostic"
msgid "Illegal initializer type %0"
msgstr "非法的初始化器类型 %0"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:570
msgctxt "diagnostic"
msgid "Illegal interface qualifier"
msgstr "非法的接口限定符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8335
msgctxt "diagnostic"
msgid "Illegal operation on Objective-C container subscripting"
msgstr "对 Objective-C 容器下标操作执行了非法运算"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8443
msgctxt "diagnostic"
msgid "Illegal qualifiers on @catch parameter"
msgstr "@catch 形参上存在非法限定符"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1630
msgctxt "diagnostic"
msgid "Illegal redeclaration of 'readwrite' property in class extension %0 (perhaps you intended this to be a 'readwrite' redeclaration of a 'readonly' public property?)"
msgstr "类扩展 %0 中 'readwrite' 属性的重复声明非法（您是否打算将其作为 'readonly' 公有属性的 'readwrite' 重复声明？）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1624
msgctxt "diagnostic"
msgid "Illegal redeclaration of property in class extension %0 (attribute must be 'readwrite', while its primary must be 'readonly')"
msgstr "在类扩展 %0 中非法重声明属性（属性必须为 'readwrite'，而其主声明必须为 'readonly'）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13812
msgctxt "diagnostic"
msgid "Illegal scalar extension cast on argument %0 to inout paramemter"
msgstr "对传递给 inout 形参的实参 %0 进行非法的标量扩展强制转换"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13812
msgctxt "diagnostic"
msgid "Illegal scalar extension cast on argument %0 to out paramemter"
msgstr "对传递给 out 形参的实参 %0 进行非法的标量扩展强制转换"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7939
msgctxt "diagnostic"
msgid "Illegal storage class on file-scoped variable"
msgstr "文件作用域变量上的存储类非法"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7947
msgctxt "diagnostic"
msgid "Illegal storage class on function"
msgstr "函数上的存储类非法"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3652
msgctxt "diagnostic"
msgid "Illegal type %0 used in a boxed expression"
msgstr "装箱表达式中使用了非法类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3619
msgctxt "diagnostic"
msgid "Illegal vector component name %0"
msgstr "非法的向量分量名 %0"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:568
msgctxt "diagnostic"
msgid "Illegal visibility specification"
msgstr "非法的可见性说明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:328
msgctxt "diagnostic"
msgid "Imaginary constants are a C2y extension"
msgstr "虚数常量是 C2y 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:330
msgctxt "diagnostic"
msgid "Imaginary constants are a GNU extension"
msgstr "虚数常量是 GNU 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:325
msgctxt "diagnostic"
msgid "Imaginary constants are incompatible with C standards before C2y"
msgstr "虚数常量与 C2y 之前的 C 标准不兼容"

