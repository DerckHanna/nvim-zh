msgctxt "diagnostic"
msgid "Expansion of predefined identifier '%0' to a string literal is a Microsoft extension"
msgstr "将预定义标识符 '%0' 展开为字符串字面量是 Microsoft 扩展"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:426
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2949
msgctxt "diagnostic"
msgid "Expansion statement declaration must declare a variable"
msgstr "展开语句声明必须声明一个变量"

