msgctxt "diagnostic"
msgid "%2 tokens introducing attribute are separated by whitespace"
msgstr "用于引入属性的 %2 记号之间被空白分隔"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:76
msgctxt "diagnostic"
msgid "%2 tokens introducing statement expression appear in different macro expansion contexts"
msgstr "用于引入语句表达式的 %2 记号出现在不同的宏展开上下文中"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:81
msgctxt "diagnostic"
msgid "%2 tokens introducing statement expression are separated by whitespace"
msgstr "用于引入语句表达式的 %2 记号之间被空白分隔"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:76
msgctxt "diagnostic"
msgid "%2 tokens terminating attribute appear in different macro expansion contexts"
msgstr "用于结束属性的 %2 记号出现在不同的宏展开上下文中"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:81
msgctxt "diagnostic"
msgid "%2 tokens terminating attribute are separated by whitespace"
msgstr "用于结束属性的 %2 记号之间被空白分隔"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:76
msgctxt "diagnostic"
msgid "%2 tokens terminating statement expression appear in different macro expansion contexts"
msgstr "用于结束语句表达式的 %2 记号出现在不同的宏展开上下文中"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:81
msgctxt "diagnostic"
msgid "%2 tokens terminating statement expression are separated by whitespace"
msgstr "用于结束语句表达式的 %2 记号之间被空白分隔"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10442
msgctxt "diagnostic"
msgid "%3 parameter of %2 must have type %4"
msgstr " %2 的第 %3 个形参必须具有类型 %4"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10442
msgctxt "diagnostic"
msgid "%3 parameter of destroying %2 must have type %4"
msgstr "销毁 %2 的第 %3 个形参必须具有类型 %4"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10442
msgctxt "diagnostic"
msgid "%3 parameter of type aware %2 must have type %4"
msgstr "类型感知 %2 的第 %3 个形参必须具有类型 %4"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10442
msgctxt "diagnostic"
msgid "%3 parameter of type aware destroying %2 must have type %4"
msgstr "类型感知销毁 %2 的第 %3 个形参必须具有类型 %4"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:342
msgctxt "diagnostic"
