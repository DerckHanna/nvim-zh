#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4014
msgctxt "diagnostic"
msgid "Propagating dll attribute to already instantiated base class template without dll attribute is not supported"
msgstr "不支持将 dll 属性传播到没有 dll 属性的已实例化基类模板"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4014
msgctxt "diagnostic"
msgid "Propagating dll attribute to explicitly specialized base class template without dll attribute is not supported"
msgstr "不支持将 dll 属性传播到没有 dll 属性的显式特化基类模板"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1700
msgctxt "diagnostic"
msgid "Property %0 attempting to use instance variable %1 declared in super class %2"
msgstr "属性 %0 试图使用在父类 %2 中声明的实例变量 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8337
msgctxt "diagnostic"
msgid "Property %0 cannot be found in forward class object %1"
msgstr "在前向声明类对象 %1 中找不到属性 %0"

#: clang/include/clang/Basic/DiagnosticASTKinds.td:575
#: clang/include/clang/Basic/DiagnosticASTKinds.td:578
msgctxt "diagnostic"
msgid "Property %0 declared with incompatible types in different translation units (%1 vs. %2)"
msgstr "属性 %0 在不同翻译单元中声明了不兼容的类型（%1 与 %2）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11785
msgctxt "diagnostic"
msgid "Property %0 found on object of type %1; did you mean to access it with the \".\" operator?"
msgstr "在类型为 %1 的对象上找到了属性 %0；你是否想使用 \".\" 运算符访问它？"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3796
msgctxt "diagnostic"
msgid "Property %0 has a variably modified type"
msgstr "属性 %0 具有可变修饰类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11778
msgctxt "diagnostic"
msgid "Property %0 is a class property; did you mean to access it with class '%1'?"
msgstr "属性 %0 是类属性；您是要通过类 '%1' 访问它吗？"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1710
msgctxt "diagnostic"
msgid "Property %0 is already implemented"
msgstr "属性 %0 已实现"

#: clang/include/clang/Basic/DiagnosticASTKinds.td:582
#: clang/include/clang/Basic/DiagnosticASTKinds.td:585
msgctxt "diagnostic"
msgid "Property %0 is implemented with @dynamic in one translation but @dynamic in another translation unit"
msgstr "属性 %0 在一个翻译单元中使用 @dynamic 实现，而在另一个翻译单元中使用 @dynamic 实现"

#: clang/include/clang/Basic/DiagnosticASTKinds.td:582
#: clang/include/clang/Basic/DiagnosticASTKinds.td:585
msgctxt "diagnostic"
msgid "Property %0 is implemented with @dynamic in one translation but @synthesize in another translation unit"
msgstr "属性 %0 在一个翻译单元中使用 @dynamic 实现，而在另一个翻译单元中使用 @synthesize 实现"

#: clang/include/clang/Basic/DiagnosticASTKinds.td:582
#: clang/include/clang/Basic/DiagnosticASTKinds.td:585
msgctxt "diagnostic"
msgid "Property %0 is implemented with @synthesize in one translation but @dynamic in another translation unit"
msgstr "属性 %0 在一个翻译单元中使用 @synthesize 实现，而在另一个翻译单元中使用 @dynamic 实现"

#: clang/include/clang/Basic/DiagnosticASTKinds.td:582
#: clang/include/clang/Basic/DiagnosticASTKinds.td:585
msgctxt "diagnostic"
msgid "Property %0 is implemented with @synthesize in one translation but @synthesize in another translation unit"
msgstr "属性 %0 在一个翻译单元中使用 @synthesize 实现，而在另一个翻译单元中使用 @synthesize 实现"

#: clang/include/clang/Basic/DiagnosticASTKinds.td:591
#: clang/include/clang/Basic/DiagnosticASTKinds.td:594
msgctxt "diagnostic"
msgid "Property %0 is synthesized to different ivars in different translation units (%1 vs. %2)"
msgstr "属性 %0 在不同的翻译单元中合成为不同的实例变量（%1 与 %2）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8301
msgctxt "diagnostic"
msgid "Property %0 not found on object of type %1"
msgstr "在类型 %1 的对象上找不到属性 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11776
msgctxt "diagnostic"
msgid "Property %0 not found on object of type %1; did you mean %2?"
msgstr "在类型为 %1 的对象上找不到属性 %0；您是否指的是 %2？"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11780
msgctxt "diagnostic"
msgid "Property %0 not found on object of type %1; did you mean to access instance variable %2?"
msgstr "在类型为 %1 的对象上找不到属性 %0；您是否想访问实例变量 %2？"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11782
msgctxt "diagnostic"
msgid "Property %0 not found on object of type %1; did you mean to access property %2?"
msgstr "在类型为 %1 的对象上未找到属性 %0；你是否想访问属性 %2？"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8339
msgctxt "diagnostic"
msgid "Property %0 refers to an incomplete Objective-C class %1 (with no @interface available)"
msgstr "属性 %0 引用了不完整的 Objective-C 类 %1（没有可用的 @interface）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8480
msgctxt "diagnostic"
msgid "Property %0 requires method %1 to be defined - use @dynamic or provide a method implementation in this category"
msgstr "属性 %0 要求定义方法 %1 - 请使用 @dynamic 或在此分类中提供方法实现"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8475
msgctxt "diagnostic"
msgid "Property %0 requires method %1 to be defined - use @synthesize, @dynamic or provide a method implementation in this class implementation"
msgstr "属性 %0 需要定义方法 %1 —— 请使用 @synthesize、@dynamic 或在此类实现中提供方法实现"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8386
msgctxt "diagnostic"
msgid "Property access cannot be qualified with %1"
msgstr "属性访问不能用 %1 限定"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6374
msgctxt "diagnostic"
msgid "Property access is using %0 method which is deprecated"
msgstr "属性访问正在使用的 %0 方法已弃用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6400
msgctxt "diagnostic"
msgid "Property access is using %0 method which is unavailable"
msgstr "属性访问正在使用的 %0 方法不可用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10009
msgctxt "diagnostic"
msgid "Property access result unused - getters should not be used for side effects"
msgstr "属性访问结果未使用 - getter 不应用于产生副作用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1549
msgctxt "diagnostic"
msgid "Property attribute in class extension does not match the primary class"
msgstr "类扩展中的属性特性与主类不匹配"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1523
msgctxt "diagnostic"
msgid "Property attributes '%0' and '%1' are mutually exclusive"
msgstr "属性特性 '%0' 和 '%1' 互斥"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1635
msgctxt "diagnostic"
msgid "Property cannot have array or function type %0"
msgstr "属性不能具有数组或函数类型 %0"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:851
msgctxt "diagnostic"
msgid "Property declaration cannot have a default member initializer"
msgstr "属性声明不能带有默认成员初始化器"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1396
msgctxt "diagnostic"
msgid "Property declaration conflicts with previous declaration of method %3"
msgstr "属性声明与先前的方法 %3 声明冲突"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1396
msgctxt "diagnostic"
msgid "Property declaration conflicts with previous declaration of property %3"
msgstr "属性声明与先前的属性 %3 声明冲突"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1396
msgctxt "diagnostic"
msgid "Property declaration conflicts with previous direct declaration of method %3"
msgstr "属性声明与先前的直接方法 %3 声明冲突"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1396
msgctxt "diagnostic"
msgid "Property declaration conflicts with previous direct declaration of property %3"
msgstr "属性声明与先前的直接属性 %3 声明冲突"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:845
msgctxt "diagnostic"
msgid "Property declaration specifies '%0' accessor twice"
msgstr "属性声明两次指定了 '%0' 访问器"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1611
msgctxt "diagnostic"
msgid "Property declared as returning non-retained objects; getter returning retained objects"
msgstr "属性声明为返回非保留对象；getter 返回了保留对象"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1641
msgctxt "diagnostic"
msgid "Property declared in category %0 cannot be implemented in class implementation"
msgstr "在分类 %0 中声明的属性不能在类实现中实现"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:835
msgctxt "diagnostic"
msgid "Property does not specify a getter or a putter"
msgstr "属性未指定 getter 或 putter"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1574
