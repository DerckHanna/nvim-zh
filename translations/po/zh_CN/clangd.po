#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13843
msgctxt "diagnostic"
msgid "Value must be in the range [%0, %1]"
msgstr "值必须在范围 [%0, %1] 内"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1194
msgctxt "diagnostic"
msgid "Value of #pragma pack(show) == %0"
msgstr "#pragma pack(show) 的值 == %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9069
msgctxt "diagnostic"
msgid "Value of type %0 is not contextually convertible to 'bool'"
msgstr "类型为 %0 的值不能按上下文转换为 'bool'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:135
msgctxt "diagnostic"
msgid "Value of type %0 is not implicitly convertible to %1"
msgstr "类型 %0 的值不能隐式转换为 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7234
msgctxt "diagnostic"
msgid "Value returned by '__builtin_counted_by_ref' cannot be assigned to a variable"
msgstr "'__builtin_counted_by_ref' 返回的值不能赋值给变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7234
msgctxt "diagnostic"
msgid "Value returned by '__builtin_counted_by_ref' cannot be passed into a function"
msgstr "'__builtin_counted_by_ref' 返回的值不能传入函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7234
msgctxt "diagnostic"
msgid "Value returned by '__builtin_counted_by_ref' cannot be returned from a function"
msgstr "'__builtin_counted_by_ref' 返回的值不能从函数返回"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7237
msgctxt "diagnostic"
msgid "Value returned by '__builtin_counted_by_ref' cannot be used in a binary expression"
msgstr "'__builtin_counted_by_ref' 返回的值不能用于二元表达式中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7237
msgctxt "diagnostic"
msgid "Value returned by '__builtin_counted_by_ref' cannot be used in an array subscript expression"
msgstr "'__builtin_counted_by_ref' 返回的值不能用于数组下标表达式中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10163
msgctxt "diagnostic"
msgid "Value size does not match register size specified by the constraint and modifier"
msgstr "值的大小与约束和修饰符指定的 register 大小不匹配"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1444
msgctxt "diagnostic"
msgid "Value-dependent expression passed as an argument to debug command"
msgstr "将值待决的表达式作为实参传递给了调试命令"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10775
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10779
msgctxt "diagnostic"
msgid "Values of type '%0' should not be used as format arguments; add an explicit cast to %1 instead"
msgstr "不应将类型为 '%0' 的值用作格式实参；请改为添加向 %1 的显式类型转换"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:930
msgctxt "diagnostic"
msgid "Varargs not allowed in requires expression"
msgstr "requires 表达式中不允许使用可变参数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6758
msgctxt "diagnostic"
msgid "Variable %0 cannot be declared both 'extern' and with the 'loader_uninitialized' attribute"
msgstr "变量 %0 不能同时声明为 'extern' 并带有 'loader_uninitialized' 属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8935
msgctxt "diagnostic"
msgid "Variable %0 cannot be implicitly captured in a lambda with no capture-default specified"
msgstr "在未指定默认捕获符的 lambda 中不能隐式捕获变量 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12124
msgctxt "diagnostic"
msgid "Variable %0 cannot be threadprivate because it is a global named register variable"
msgstr "变量 %0 不能为 threadprivate，因为它是全局命名 register 变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12124
msgctxt "diagnostic"
msgid "Variable %0 cannot be threadprivate because it is thread-local"
msgstr "变量 %0 不能为 threadprivate，因为它是线程局部变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is captured uninitialized whenever %3 is called"
msgstr "每当调用 %3 时，变量 %0 均在未初始化的情况下被捕获"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is captured uninitialized whenever '%3' condition is false"
msgstr "每当'%3' 条件为 false时，变量 %0 均在未初始化的情况下被捕获"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is captured uninitialized whenever '%3' condition is true"
msgstr "每当'%3' 条件为 true时，变量 %0 均在未初始化的情况下被捕获"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is captured uninitialized whenever '%3' loop condition is true"
msgstr "每当'%3' 循环条件为 true时，变量 %0 均在未初始化的情况下被捕获"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is captured uninitialized whenever '%3' loop exits because its condition is false"
msgstr "每当因条件为 false 而退出 '%3' 循环时，变量 %0 均在未初始化的情况下被捕获"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is captured uninitialized whenever '%3' loop is entered"
msgstr "每当进入 '%3' 循环时，变量 %0 均在未初始化的情况下被捕获"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is captured uninitialized whenever its declaration is reached"
msgstr "每当到达其声明处时，变量 %0 均在未初始化的情况下被捕获"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is captured uninitialized whenever switch %3 is taken"
msgstr "每当进入 switch %3 分支时，变量 %0 均在未初始化的情况下被捕获"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:83
msgctxt "diagnostic"
msgid "Variable %0 is decremented both in the loop header and in the loop body"
msgstr "变量 %0 在循环头和循环体中均被自减"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:83
msgctxt "diagnostic"
msgid "Variable %0 is incremented both in the loop header and in the loop body"
msgstr "变量 %0 在循环头和循环体中均被自增"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2560
msgctxt "diagnostic"
msgid "Variable %0 is uninitialized when captured by block"
msgstr "变量 %0 在被 block 捕获时尚未初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2606
msgctxt "diagnostic"
msgid "Variable %0 is uninitialized when passed as a const pointer argument here"
msgstr "变量 %0 在此处作为 const 指针实参传递时未初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2602
msgctxt "diagnostic"
msgid "Variable %0 is uninitialized when passed as a const reference argument here"
msgstr "变量 %0 在此处作为 const 引用实参传递时尚未初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2560
msgctxt "diagnostic"
msgid "Variable %0 is uninitialized when used here"
msgstr "在此处使用的变量 %0 尚未初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2553
msgctxt "diagnostic"
msgid "Variable %0 is uninitialized when used within its own initialization"
msgstr "变量 %0 在自身初始化过程中被使用，此时它尚未初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is used uninitialized whenever %3 is called"
msgstr "每当调用 %3 时，变量 %0 均在未初始化的情况下被使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is used uninitialized whenever '%3' condition is false"
msgstr "每当'%3' 条件为 false时，变量 %0 均在未初始化的情况下被使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is used uninitialized whenever '%3' condition is true"
msgstr "每当'%3' 条件为 true时，变量 %0 均在未初始化的情况下被使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is used uninitialized whenever '%3' loop condition is true"
msgstr "每当'%3' 循环条件为 true时，变量 %0 均在未初始化的情况下被使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is used uninitialized whenever '%3' loop exits because its condition is false"
msgstr "每当因条件为 false 而退出 '%3' 循环时，变量 %0 均在未初始化的情况下被使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is used uninitialized whenever '%3' loop is entered"
msgstr "每当进入 '%3' 循环时，变量 %0 均在未初始化的情况下被使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is used uninitialized whenever its declaration is reached"
msgstr "每当到达其声明处时，变量 %0 均在未初始化的情况下被使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2563
msgctxt "diagnostic"
msgid "Variable %0 is used uninitialized whenever switch %3 is taken"
msgstr "每当进入 switch %3 分支时，变量 %0 均在未初始化的情况下被使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2572
msgctxt "diagnostic"
msgid "Variable %0 may be uninitialized when captured by block"
msgstr "变量 %0 在被 block 捕获时可能未初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2572
msgctxt "diagnostic"
msgid "Variable %0 may be uninitialized when used here"
msgstr "变量 %0 在此处使用时可能未初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12183
msgctxt "diagnostic"
msgid "Variable %0 must have explicitly specified data sharing attributes"
msgstr "变量 %0 必须显式指定数据共享属性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12189
msgctxt "diagnostic"
msgid "Variable %0 must have explicitly specified data sharing attributes, data mapping attributes, or in an is_device_ptr clause"
msgstr "变量 %0 必须显式指定数据共享属性、数据映射属性，或位于 is_device_ptr 子句中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:447
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:449
msgctxt "diagnostic"
msgid "Variable %0 set but not used"
msgstr "变量 %0 已赋值但未使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8932
msgctxt "diagnostic"
msgid "Variable %0 with flexible array member cannot be captured in a lambda expression"
msgstr "带有柔性数组成员的变量 %0 不能在 lambda 表达式中捕获"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12187
msgctxt "diagnostic"
msgid "Variable %0 with initializer cannot appear in groupprivate directive"
msgstr "带有初始化器的变量 %0 不能出现在 groupprivate 指令中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2732
msgctxt "diagnostic"
msgid "Variable %0 with type %1 has incompatible initializer of type %2"
msgstr "类型为 %1 的变量 %0 具有不兼容的 %2 类型初始化器"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11827
msgctxt "diagnostic"
msgid "Variable %0 with unknown type cannot be given a function type"
msgstr "不能为未知类型的变量 %0 指定函数类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2652
msgctxt "diagnostic"
msgid "Variable %1 declared with deduced type %2 cannot appear in its own initializer"
msgstr "以推导类型 %2 声明的变量 %1 不能出现在其自身的初始化器中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6522
msgctxt "diagnostic"
msgid "Variable %1 has internal linkage but is not defined"
msgstr "变量 %1 具有内部链接但未定义"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:503
msgctxt "diagnostic"
msgid "Variable %1 is not needed and will not be emitted"
msgstr "不需要变量 %1，因此不会生成"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6525
msgctxt "diagnostic"
msgid "Variable %1 is used but not defined in this translation unit, and cannot be defined in any other translation unit because its type does not have linkage"
msgstr "变量 %1 在此翻译单元中被使用但未定义，且由于其类型没有链接性而无法在任何其他翻译单元中定义"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:79
msgctxt "diagnostic"
msgid "Variable %1 used in loop condition not modified in loop body"
msgstr "循环条件中使用的变量 %1 未在循环体中修改"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12533
msgctxt "diagnostic"
msgid "Variable already marked as mapped in current construct"
msgstr "变量在当前构造中已标记为已映射"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14242
msgctxt "diagnostic"
msgid "Variable appearing in '%0' clause of OpenACC 'declare' directive must be in the same scope as the directive"
msgstr "出现在 OpenACC 'declare' 指令 '%0' 子句中的变量必须与该指令处于同一作用域"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12352
msgctxt "diagnostic"
msgid "Variable can appear only once in OpenMP '%0' clause"
msgstr "变量在 OpenMP '%0' 子句中只能出现一次"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12354
msgctxt "diagnostic"
msgid "Variable can appear only once in OpenMP 'target update' construct"
msgstr "变量在 OpenMP 'target update' 构造中只能出现一次"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:919
msgctxt "diagnostic"
msgid "Variable cannot be defined in an explicit instantiation; if this declaration is meant to be a class definition, remove the 'template' keyword"
msgstr "不能在显式实例化中定义变量；如果此声明意在作为类定义，请移除 'template' 关键字"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:919
msgctxt "diagnostic"
msgid "Variable cannot be defined in an explicit instantiation; if this declaration is meant to be a function definition, remove the 'template' keyword"
msgstr "不能在显式实例化中定义变量；如果此声明意在作为函数定义，请移除 'template' 关键字"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:919
msgctxt "diagnostic"
msgid "Variable cannot be defined in an explicit instantiation; if this declaration is meant to be a variable definition, remove the 'template' keyword"
msgstr "不能在显式实例化中定义变量；如果此声明意在作为变量定义，请移除 'template' 关键字"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12704
msgctxt "diagnostic"
msgid "Variable captured in declare target region must appear in a to clause"
msgstr "在 declare target 区域中捕获的变量必须出现在 to 子句中"

#: clang/include/clang/Basic/Diagnostic.td:201
msgctxt "diagnostic"
msgid "Variable declaration in a constexpr constructor is a C++14 extension"
msgstr "constexpr 构造函数中的变量声明是 C++14 扩展"

#: clang/include/clang/Basic/Diagnostic.td:209
msgctxt "diagnostic"
msgid "Variable declaration in a constexpr constructor is incompatible with C++ standards before C++14"
msgstr "constexpr 构造函数中的变量声明与 C++14 之前的 C++ 标准不兼容"

#: clang/include/clang/Basic/Diagnostic.td:201
msgctxt "diagnostic"
msgid "Variable declaration in a constexpr function is a C++14 extension"
msgstr "constexpr 函数中的变量声明是 C++14 扩展"

#: clang/include/clang/Basic/Diagnostic.td:209
msgctxt "diagnostic"
msgid "Variable declaration in a constexpr function is incompatible with C++ standards before C++14"
msgstr "constexpr 函数中的变量声明与 C++14 之前的 C++ 标准不兼容"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:638
msgctxt "diagnostic"
msgid "Variable declaration in condition cannot have a parenthesized initializer"
msgstr "条件中的变量声明不能带有括号初始化器"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:636
msgctxt "diagnostic"
msgid "Variable declaration in condition must have an initializer"
msgstr "条件中的变量声明必须有初始化器"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:99
msgctxt "diagnostic"
msgid "Variable declaration in for loop is a C99-specific feature"
msgstr "for 循环中的变量声明是 C99 特有特性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7333
msgctxt "diagnostic"
msgid "Variable declared with 'objc_externally_retained' cannot be modified in ARC"
msgstr "在 ARC 中不能修改用 'objc_externally_retained' 声明的变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:10067
msgctxt "diagnostic"
msgid "Variable does not have a constant initializer"
msgstr "变量没有常量初始化式"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:7871
msgctxt "diagnostic"
msgid "Variable has incomplete type %0"
msgstr "变量的类型 %0 是不完整类型"

msgctxt "diagnostic"
msgid "Variable has incomplete type {type}"
msgstr "变量的类型 {type} 是不完整类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11917
msgctxt "diagnostic"
msgid "Variable in constant address space must be initialized"
msgstr "constant 地址空间中的变量必须被初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6090
msgctxt "diagnostic"
msgid "Variable instantiated with function type %1"
msgstr "变量被实例化为函数类型 %1"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9558
msgctxt "diagnostic"
msgid "Variable is not assignable (missing __block type specifier)"
msgstr "变量不可赋值（缺少 __block 类型说明符）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:226
msgctxt "diagnostic"
msgid "Variable length array cannot be formed during template argument deduction"
msgstr "模板实参推导期间不能形成变长数组"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:234
msgctxt "diagnostic"
msgid "Variable length array declaration cannot have 'extern' linkage"
msgstr "变长数组声明不能具有 'extern' 链接"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:232
msgctxt "diagnostic"
msgid "Variable length array declaration cannot have 'static' storage duration"
msgstr "变长数组声明不能具有 'static' 存储期"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:230
msgctxt "diagnostic"
msgid "Variable length array declaration not allowed at file scope"
msgstr "文件作用域中不允许变长数组声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:236
msgctxt "diagnostic"
msgid "Variable length array folded to constant array as an extension"
msgstr "作为扩展，变长数组已折叠为常量数组"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:228
msgctxt "diagnostic"
msgid "Variable length array must be bound in function definition"
msgstr "变长数组必须在函数定义中指定边界"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:224
msgctxt "diagnostic"
msgid "Variable length array used"
msgstr "使用了变长数组"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:210
msgctxt "diagnostic"
msgid "Variable length arrays are a C99 feature"
msgstr "变长数组是 C99 特性"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:239
msgctxt "diagnostic"
msgid "Variable length arrays are not supported for the current target"
msgstr "当前目标不支持变长数组"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:239
msgctxt "diagnostic"
msgid "Variable length arrays are not supported in '%1'"
msgstr "在 '%1' 中不支持变长数组"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11867
msgctxt "diagnostic"
msgid "Variable length arrays are not supported in OpenCL"
msgstr "OpenCL 中不支持变长数组"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12828
msgctxt "diagnostic"
msgid "Variable length arrays are not supported in OpenMP tasking regions with 'untied' clause"
msgstr "带有 'untied' 子句的 OpenMP 任务区域不支持变长数组"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:214
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:217
msgctxt "diagnostic"
msgid "Variable length arrays in C++ are a Clang extension"
msgstr "C++ 中的变长数组是 Clang 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:219
#: clang/include/clang/Basic/DiagnosticSemaKinds.td:222
msgctxt "diagnostic"
msgid "Variable length arrays in C++ are a Clang extension; did you mean to use 'static_assert'?"
msgstr "C++ 中的变长数组是 Clang 扩展；是否打算使用 'static_assert'？"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:241
msgctxt "diagnostic"
msgid "Variable length arrays in a coroutine are not supported"
msgstr "协程中不支持变长数组"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12317
msgctxt "diagnostic"
msgid "Variable must be of integer or pointer type"
msgstr "变量必须是整型或指针类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12317
msgctxt "diagnostic"
msgid "Variable must be of integer or random access iterator type"
msgstr "变量必须是整型或随机访问迭代器类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1114
msgctxt "diagnostic"
msgid "Variable named 'main' with external linkage has undefined behavior"
msgstr "具有外部链接且名为 'main' 的变量具有未定义行为"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14275
msgctxt "diagnostic"
msgid "Variable of array type %0 referenced in OpenACC '%1' clause does not have constant bounds; initialization will happen after decay to pointer"
msgstr "OpenACC '%1' 子句中引用的数组类型 %0 变量没有常量边界；将在退化为指针后进行初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3103
msgctxt "diagnostic"
msgid "Variable of non-literal type %1 cannot be defined in a constexpr constructor before C++23"
msgstr "在 C++23 之前，不能在 constexpr 构造函数中定义非字面量类型 %1 的变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3103
msgctxt "diagnostic"
msgid "Variable of non-literal type %1 cannot be defined in a constexpr function before C++23"
msgstr "在 C++23 之前，不能在 constexpr 函数中定义非字面量类型 %1 的变量"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12511
msgctxt "diagnostic"
msgid "Variable of non-reference type %0 can be used only with 'val' modifier, but used with '%1'"
msgstr "非引用类型 %0 的变量只能与 'val' 修饰符一起使用，但此处使用了 '%1'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14280
msgctxt "diagnostic"
msgid "Variable of type %0 referenced in OpenACC '%1' clause does not have a copy constructor; reference has no effect"
msgstr "OpenACC '%1' 子句中引用的类型为 %0 的变量没有拷贝构造函数；该引用无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14280
msgctxt "diagnostic"
msgid "Variable of type %0 referenced in OpenACC '%1' clause does not have a default constructor; reference has no effect"
msgstr "OpenACC '%1' 子句中引用的类型为 %0 的变量没有默认构造函数；该引用无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14280
msgctxt "diagnostic"
msgid "Variable of type %0 referenced in OpenACC '%1' clause does not have a destructor; reference has no effect"
msgstr "OpenACC '%1' 子句中引用的类型为 %0 的变量没有析构函数；该引用无效"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14287
msgctxt "diagnostic"
msgid "Variable of type %0 referenced in OpenACC 'reduction' clause does not have a valid operation available"
msgstr "OpenACC 'reduction' 子句中引用的类型为 %0 的变量没有可用的有效操作"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2118
msgctxt "diagnostic"
msgid "Variable of type %1 has private destructor"
msgstr "类型为 %1 的变量具有私有的析构函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2118
msgctxt "diagnostic"
msgid "Variable of type %1 has protected destructor"
msgstr "类型为 %1 的变量具有受保护的析构函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14236
msgctxt "diagnostic"
msgid "Variable referenced by 'link' clause not in global or namespace scope must be marked 'extern'"
msgstr "由 'link' 子句引用且不在全局或命名空间作用域中的变量必须标记为 'extern'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:14245
msgctxt "diagnostic"
msgid "Variable referenced in '%0' clause of OpenACC 'declare' directive was already referenced"
msgstr "OpenACC 'declare' 指令的 '%0' 子句中引用的变量已被引用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2652
msgctxt "diagnostic"
msgid "Variable template %1 declared with deduced type %2 cannot appear in its own initializer"
msgstr "以推导类型 %2 声明的变量模板 %1 不能出现在其自身的初始化器中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2779
msgctxt "diagnostic"
msgid "Variable template %1 requires template arguments; argument deduction only allowed for class templates or alias templates"
msgstr "变量模板 %1 需要模板实参；仅类模板或别名模板允许实参推导"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2652
msgctxt "diagnostic"
msgid "Variable template explicit specialization %1 declared with deduced type %2 cannot appear in its own initializer"
msgstr "以推导类型 %2 声明的变量模板显式特化 %1 不能出现在其自身的初始化器中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5950
msgctxt "diagnostic"
msgid "Variable template partial specialization %0 cannot be redefined"
msgstr "变量模板偏特化 %0 不能被重定义"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2652
msgctxt "diagnostic"
msgid "Variable template partial specialization %1 declared with deduced type %2 cannot appear in its own initializer"
msgstr "以推导类型 %2 声明的变量模板偏特化 %1 不能出现在其自身的初始化器中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5932
msgctxt "diagnostic"
msgid "Variable template partial specialization contains a template parameter that cannot be deduced; this partial specialization will never be used"
msgstr "变量模板偏特化包含无法推导的模板形参；此偏特化将永远不会被使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5932
msgctxt "diagnostic"
msgid "Variable template partial specialization contains template parameters that cannot be deduced; this partial specialization will never be used"
msgstr "变量模板偏特化包含无法推导的模板形参；此偏特化将永远不会被使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5923
msgctxt "diagnostic"
msgid "Variable template partial specialization does not specialize any template argument; to declare the primary template, remove the template argument list"
msgstr "变量模板偏特化未特化任何模板实参；要声明主模板，请移除模板实参列表"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5923
msgctxt "diagnostic"
msgid "Variable template partial specialization does not specialize any template argument; to define the primary template, remove the template argument list"
msgstr "变量模板偏特化未特化任何模板实参；要定义主模板，请移除模板实参列表"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5927
msgctxt "diagnostic"
msgid "Variable template partial specialization is not more specialized than the primary template"
msgstr "变量模板偏特化并不比主模板更特化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5850
msgctxt "diagnostic"
msgid "Variable template partial specialization of %1 must occur at global scope"
msgstr "%1 的变量模板偏特化必须在全局作用域中进行"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5837
msgctxt "diagnostic"
msgid "Variable template partial specialization of %1 not in a namespace enclosing %2"
msgstr "%1 的变量模板偏特化不在包含 %2 的命名空间中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5843
msgctxt "diagnostic"
msgid "Variable template partial specialization of %1 not in a namespace enclosing %2 is a Microsoft extension"
msgstr "不在包含 %2 的命名空间中的 %1 变量模板偏特化是 Microsoft 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5837
msgctxt "diagnostic"
msgid "Variable template partial specialization of %1 not in class %2 or an enclosing namespace"
msgstr "%1 的变量模板偏特化不在类 %2 或其外围命名空间中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5843
msgctxt "diagnostic"
msgid "Variable template partial specialization of %1 not in class %2 or an enclosing namespace is a Microsoft extension"
msgstr "不在类 %2 或包含它的命名空间中的 %1 变量模板偏特化是 Microsoft 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5850
msgctxt "diagnostic"
msgid "Variable template specialization of %1 must occur at global scope"
msgstr "%1 的变量模板特化必须在全局作用域中进行"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5837
msgctxt "diagnostic"
msgid "Variable template specialization of %1 not in a namespace enclosing %2"
msgstr "%1 的变量模板特化不在包含 %2 的命名空间中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5843
msgctxt "diagnostic"
msgid "Variable template specialization of %1 not in a namespace enclosing %2 is a Microsoft extension"
msgstr "不在包含 %2 的命名空间中的 %1 变量模板特化是 Microsoft 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5837
msgctxt "diagnostic"
msgid "Variable template specialization of %1 not in class %2 or an enclosing namespace"
msgstr "%1 的变量模板特化不在类 %2 或其外围命名空间中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:5843
msgctxt "diagnostic"
msgid "Variable template specialization of %1 not in class %2 or an enclosing namespace is a Microsoft extension"
msgstr "不在类 %2 或包含它的命名空间中的 %1 变量模板特化是 Microsoft 扩展"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:957
msgctxt "diagnostic"
msgid "Variable template template parameter is a C++2c extension"
msgstr "变量模板模板形参是 C++2c 扩展"

#: clang/include/clang/Basic/Diagnostic.td:201
msgctxt "diagnostic"
msgid "Variable templates are a C++14 extension"
msgstr "变量模板是 C++14 扩展"

#: clang/include/clang/Basic/Diagnostic.td:209
msgctxt "diagnostic"
msgid "Variable templates are incompatible with C++ standards before C++14"
msgstr "变量模板与 C++14 之前的 C++ 标准不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1950
msgctxt "diagnostic"
msgid "Variable type %1 is an abstract class"
msgstr "变量类型 %1 是抽象类"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6750
msgctxt "diagnostic"
msgid "Variable with 'loader_uninitialized' attribute cannot have an initializer"
msgstr "带有 'loader_uninitialized' 属性的变量不能有初始化器"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6753
msgctxt "diagnostic"
msgid "Variable with 'loader_uninitialized' attribute must have a trivial default constructor"
msgstr "带有 'loader_uninitialized' 属性的变量必须具有平凡默认构造函数"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13655
msgctxt "diagnostic"
msgid "Variable with 'vk::constant_id' attribute must be a const int/float/enum/bool and be initialized with a literal"
msgstr "带有 'vk::constant_id' 属性的变量必须是 const int/float/enum/bool 且必须用字面量初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12303
msgctxt "diagnostic"
msgid "Variable with local storage in initial value of threadprivate variable"
msgstr "threadprivate 变量的初始值中包含具有局部存储期的变量"

msgctxt "diagnostic"
msgid "Variable {name} is not initialized"
msgstr "变量 {name} 未初始化"

msgctxt "diagnostic"
msgid "Variable {name} is uninitialized when used here"
msgstr "在此处使用的变量 {name} 尚未初始化"

msgctxt "diagnostic"
msgid "Variable {name} is uninitialized when used within its own initialization"
msgstr "变量 {name} 在自身初始化过程中被使用，此时它尚未初始化"

msgctxt "diagnostic"
msgid "Variable {name} set but not used"
msgstr "变量 {name} 已赋值但未使用"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6767
msgctxt "diagnostic"
msgid "Variable-sized object may not be initialized"
msgstr "可变大小的对象不能被初始化"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:79
msgctxt "diagnostic"
msgid "Variables %1 and %2 used in loop condition not modified in loop body"
msgstr "循环条件中使用的变量 %1 和 %2 未在循环体中修改"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:79
msgctxt "diagnostic"
msgid "Variables %1, %2, %3, and %4 used in loop condition not modified in loop body"
msgstr "循环条件中使用的变量 %1、%2、%3 和 %4 未在循环体中修改"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:79
msgctxt "diagnostic"
msgid "Variables %1, %2, and %3 used in loop condition not modified in loop body"
msgstr "循环条件中使用的变量 %1、%2 和 %3 未在循环体中修改"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11863
msgctxt "diagnostic"
msgid "Variables in function scope cannot be declared static"
msgstr "函数作用域中的变量不能声明为 static"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11860
msgctxt "diagnostic"
msgid "Variables in the %0 address space can only be declared in the outermost scope of a kernel function"
msgstr "%0 地址空间中的变量只能在核函数的最外层作用域中声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:79
msgctxt "diagnostic"
msgid "Variables used in loop condition not modified in loop body"
msgstr "循环条件中使用的变量 未在循环体中修改"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:247
msgctxt "diagnostic"
msgid "Variably modified type %0 cannot be used as a template argument"
msgstr "可变修改类型 %0 不能用作模板实参"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6710
msgctxt "diagnostic"
msgid "Variably modified type declaration cannot have 'extern' linkage"
msgstr "可变修饰类型声明不能具有 'extern' 链接"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:6708
msgctxt "diagnostic"
msgid "Variably modified type declaration not allowed at file scope"
msgstr "文件作用域中不允许可变修饰类型声明"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3095
msgctxt "diagnostic"
msgid "Variably-modified type %0 cannot be used in a constexpr constructor"
msgstr "可变修改类型 %0 不能用于 constexpr 构造函数中"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3095
msgctxt "diagnostic"
msgid "Variably-modified type %0 cannot be used in a constexpr function"
msgstr "可变修改类型 %0 不能用于 constexpr 函数中"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1026
msgctxt "diagnostic"
msgid "Variadic 'friend' declarations are a C++2c extension"
msgstr "可变参数 'friend' 声明是 C++2c 扩展"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1028
msgctxt "diagnostic"
msgid "Variadic 'friend' declarations are incompatible with C++ standards before C++2c"
msgstr "可变参数的 'friend' 声明与 C++2c 之前的 C++ 标准不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:4154
msgctxt "diagnostic"
msgid "Variadic function cannot use %0 calling convention"
msgstr "可变参数函数不能使用 %0 调用约定"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:514
msgctxt "diagnostic"
msgid "Variadic macros are a C99 feature"
msgstr "可变参数宏是 C99 特性"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:548
msgctxt "diagnostic"
msgid "Variadic macros are a Clang extension in OpenCL"
msgstr "可变参数宏在 OpenCL 中是 Clang 扩展"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:516
msgctxt "diagnostic"
msgid "Variadic macros are incompatible with C++98"
msgstr "可变参数宏与 C++98 不兼容"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:94
msgctxt "diagnostic"
msgid "Variadic templates are a C++11 extension"
msgstr "可变参数模板是 C++11 扩展"

#: clang/include/clang/Basic/DiagnosticCommonKinds.td:96
msgctxt "diagnostic"
msgid "Variadic templates are incompatible with C++98"
msgstr "可变参数模板与 C++98 不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12750
msgctxt "diagnostic"
msgid "Variant function in '#pragma omp declare variant' is itself marked as '#pragma omp declare variant'"
msgstr "'#pragma omp declare variant' 中的变体函数自身也被标记为 '#pragma omp declare variant'"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12748
msgctxt "diagnostic"
msgid "Variant in '#pragma omp declare variant' is the same as the base function"
msgstr "'#pragma omp declare variant' 中的变体与基函数相同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12745
msgctxt "diagnostic"
msgid "Variant in '#pragma omp declare variant' with type %0 is incompatible with type %1"
msgstr "'#pragma omp declare variant' 中类型为 %0 的变体与类型 %1 不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12745
msgctxt "diagnostic"
msgid "Variant in '#pragma omp declare variant' with type %0 is incompatible with type %1 with appended arguments"
msgstr "'#pragma omp declare variant' 中类型为 %0 的变体与类型 %1（带附加实参） 不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3617
msgctxt "diagnostic"
msgid "Vector component access exceeds type %0"
msgstr "向量分量访问超出了类型 %0"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11856
msgctxt "diagnostic"
msgid "Vector component access has invalid length %0; supported lengths are: 1,2,3,4,8,16"
msgstr "向量分量访问的长度 %0 无效；支持的长度为：1,2,3,4,8,16"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:12005
msgctxt "diagnostic"
msgid "Vector component name '%0' is a feature from OpenCL version 3.0 onwards"
msgstr "向量分量名称 '%0' 是 OpenCL 3.0 及更高版本的功能"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8877
msgctxt "diagnostic"
msgid "Vector condition type %0 and result type %1 do not have elements of the same size"
msgstr "向量条件类型 %0 和结果类型 %1 的元素大小不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8874
msgctxt "diagnostic"
msgid "Vector condition type %0 and result type %1 do not have the same number of elements"
msgstr "向量条件类型 %0 与结果类型 %1 的元素数量不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:11549
msgctxt "diagnostic"
msgid "Vector initializers are not compatible with NEON intrinsics in big endian mode"
msgstr "向量初始化式在大端模式下与 NEON 内建指令不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:9554
msgctxt "diagnostic"
msgid "Vector is not assignable (contains duplicate components)"
msgstr "向量不可赋值（包含重复的分量）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3596
msgctxt "diagnostic"
msgid "Vector must have non-negative size"
msgstr "向量的大小必须为非负值"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3614
msgctxt "diagnostic"
msgid "Vector operands do not have the same elements sizes (%0 and %1)"
msgstr "向量操作数不具有相同的元素大小（%0 和 %1）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3612
msgctxt "diagnostic"
msgid "Vector operands do not have the same number of elements (%0 and %1)"
msgstr "向量操作数的元素个数不同（%0 和 %1）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8888
msgctxt "diagnostic"
msgid "Vector operands to the vector conditional must be the same type (%0 and %1)}"
msgstr "向量条件运算符的向量操作数必须是相同类型（%0 和 %1）"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:8888
msgctxt "diagnostic"
msgid "Vector operands to the vector conditional must be the same type }"
msgstr "向量条件运算符的向量操作数必须是相同类型"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3594
msgctxt "diagnostic"
msgid "Vector size not an integral multiple of component size"
msgstr "向量大小不是分量大小的整数倍"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1760
msgctxt "diagnostic"
msgid "Vectorize_width loop hint malformed; use vectorize_width(X, fixed) or vectorize_width(X, scalable) where X is an integer, or vectorize_width('fixed' or 'scalable')"
msgstr "vectorize_width 循环提示格式错误；请使用 vectorize_width(X, fixed) 或 vectorize_width(X, scalable)（其中 X 为整数），或使用 vectorize_width('fixed' 或 'scalable')"

#: clang/include/clang/Basic/DiagnosticLexKinds.td:91
msgctxt "diagnostic"
msgid "Version control conflict marker in file"
msgstr "文件中存在版本控制冲突标记"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1233
msgctxt "diagnostic"
msgid "Version for '%0' already specified"
msgstr "已为 '%0' 指定版本"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13347
msgctxt "diagnostic"
msgid "Version list contains duplicate entries"
msgstr "版本列表包含重复项"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13350
msgctxt "diagnostic"
msgid "Version list contains entries that don't impact code generation"
msgstr "版本列表包含不影响代码生成的条目"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1198
msgctxt "diagnostic"
msgid "Version number must have non-zero major, minor, or sub-minor version"
msgstr "版本号必须具有非零的主版本号、次版本号或子次版本号"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:13353
msgctxt "diagnostic"
msgid "Version priority '%0' is outside the allowed range [1-255]; ignoring priority"
msgstr "版本优先级 '%0' 超出允许范围 [1-255]；忽略优先级"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3076
msgctxt "diagnostic"
msgid "Virtual constexpr functions are incompatible with C++ standards before C++20"
msgstr "虚 constexpr 函数与 C++20 之前的 C++ 标准不兼容"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2333
msgctxt "diagnostic"
msgid "Virtual function %0 has a different return type (%1) than the function it overrides (which has return type %2)"
msgstr "虚函数 %0 的返回类型（%1）与其覆写的函数（其返回类型为 %2）不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2333
msgctxt "diagnostic"
msgid "Virtual function %0 has a different return type than the function it overrides"
msgstr "虚函数 %0 的返回类型与其覆写的函数不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2339
msgctxt "diagnostic"
msgid "Virtual function %0 has different attributes (%1) than the function it overrides (which has %2)"
msgstr "虚函数 %0 的属性（%1）与它覆写的函数（具有 %2）不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2339
msgctxt "diagnostic"
msgid "Virtual function %0 has different attributes than the function it overrides"
msgstr "虚函数 %0 的属性与它覆写的函数不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2343
msgctxt "diagnostic"
msgid "Virtual function %0 has different calling convention attributes (%1) than the function it overrides (which has calling convention %2)"
msgstr "虚函数 %0 的调用约定属性（%1）与它覆写的函数（调用约定为 %2）不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:2343
msgctxt "diagnostic"
msgid "Virtual function %0 has different calling convention attributes than the function it overrides"
msgstr "虚函数 %0 的调用约定属性与它覆写的函数不同"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:1965
msgctxt "diagnostic"
msgid "Virtual function %0 has more than one final overrider in %1"
msgstr "虚函数 %0 在 %1 中有多个最终覆盖者"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3075
msgctxt "diagnostic"
msgid "Virtual function cannot be constexpr"
msgstr "虚函数不能为 constexpr"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3202
msgctxt "diagnostic"
msgid "Virtual function cannot have a requires clause"
msgstr "虚函数不能带有 requires 子句"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1467
msgctxt "diagnostic"
msgid "Virtual functions are not supported in C++ for OpenCL"
msgstr "C++ for OpenCL 不支持虚函数"

#: clang/include/clang/Basic/DiagnosticParseKinds.td:1907
msgctxt "diagnostic"
msgid "Virtual functions are unsupported in HLSL"
