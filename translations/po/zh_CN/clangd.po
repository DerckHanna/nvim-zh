#: clang/include/clang/Basic/DiagnosticSemaKinds.td:403
msgctxt "diagnostic"
msgid "Omitting the parameter name in a function definition is a C23 extension"
msgstr "在函数定义中省略形参名称是 C23 扩展"

#: clang/include/clang/Basic/DiagnosticSemaKinds.td:3450
msgctxt "diagnostic"
