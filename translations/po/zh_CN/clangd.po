#: clang/include/clang/Basic/DiagnosticCommonKinds.td:300
msgctxt "diagnostic"
msgid "Pointer to predefined '%3' variable is not allowed in a template argument"
msgstr "模板实参中不允许使用指向 预定义的 '%3' 变量 的指针"

