#: lua/nvim-treesitter/health.lua:24
msgctxt "health"
msgid "Requirements"
msgstr "依赖要求"

#: lua/nvim-treesitter/health.lua:28
msgctxt "health"
msgid "Nvim-treesitter requires Neovim 0.12.0 or later."
msgstr "nvim-treesitter 需要 Neovim 0.12.0 或更高版本。"

#: lua/nvim-treesitter/health.lua:33
msgctxt "health"
msgid "Neovim was compiled with tree-sitter runtime ABI version %d (required >=%d)."
msgstr "Neovim 编译时使用的 tree-sitter 运行时 ABI 版本为 %d（要求 >=%d）。"

#: lua/nvim-treesitter/health.lua:41
msgctxt "health"
msgid ""
"Neovim was compiled with tree-sitter runtime ABI version %d.\n"
"nvim-treesitter expects at least ABI version %d\n"
"Please make sure that Neovim is linked against a recent tree-sitter library when building or raise an issue at your Neovim packager. Parsers must be compatible with runtime ABI."
msgstr ""
"Neovim 编译时使用的 tree-sitter 运行时 ABI 版本为 %d。\n"
"nvim-treesitter 需要至少 ABI 版本 %d\n"
"请确保构建 Neovim 时链接了较新的 tree-sitter 库，或向你的 Neovim 打包维护者反馈。解析器必须与运行时 ABI 兼容。"

#: lua/nvim-treesitter/health.lua:60
msgctxt "health"
msgid "tree-sitter-cli v%d.%d.%d is required"
msgstr "需要 tree-sitter-cli v%d.%d.%d"

