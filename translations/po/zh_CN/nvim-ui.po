# Display strings Neovim itself sends through vim.notify() while a user drives
# LSP features. All sources are pinned Neovim 0.12.6 Lua files; the msgid must
# match the upstream literal exactly, otherwise it never triggers.

#: lua/vim/lsp/buf.lua
msgid "No information available"
msgstr "没有可用的信息"

#: lua/vim/lsp/buf.lua
msgid "Empty hover response"
msgstr "悬停响应为空"

#: lua/vim/lsp/buf.lua
msgid "No locations found"
msgstr "未找到位置"

#: lua/vim/lsp/buf.lua
msgid "No references found"
msgstr "未找到引用"

#: lua/vim/lsp/buf.lua
msgid "No code actions available"
msgstr "没有可用的代码操作"

#: lua/vim/lsp/buf.lua
msgid "No signature help available"
msgstr "没有可用的签名帮助"

#: lua/vim/lsp/codelens.lua
msgid "No codelens at current line"
msgstr "当前行没有代码透镜"

# Prompt strings Neovim passes as opts.prompt to vim.ui.input()/vim.ui.select().
# Trailing spaces follow the upstream literal; the translation keeps the same
# "label: " shape so the prompt still reads naturally next to typed input.

#: lua/vim/lsp/buf.lua
msgctxt "input"
msgid "New Name: "
msgstr "新名称："

#: lua/vim/lsp/buf.lua
msgctxt "select"
msgid "Code actions:"
msgstr "代码操作："

#: lua/vim/lsp/codelens.lua
msgctxt "select"
msgid "Code lenses: "
msgstr "代码透镜："

# Further Neovim-owned display strings, all reached through vim.notify() while a
# user drives LSP features: format-on-save, rename, hierarchy and document
# color. Each msgid is verified against the pinned Neovim 0.12.6 source by
# tests/integration/nvim/lsp_literals_spec.lua.

#: lua/vim/lsp/buf.lua
msgid "[LSP] Format request failed, no matching language servers."
msgstr "[LSP] 格式化请求失败，没有匹配的语言服务器。"

#: lua/vim/lsp/buf.lua
msgid "[LSP] Rename, no matching language servers with rename capability."
msgstr "[LSP] 重命名：没有支持重命名能力的语言服务器。"

#: lua/vim/lsp/buf.lua
msgid "No item resolved"
msgstr "未解析出条目"

#: lua/vim/lsp/handlers.lua
msgid "Language server couldn't provide rename result"
msgstr "语言服务器无法提供重命名结果"

#: lua/vim/lsp/document_color.lua
msgid "documentColor is not enabled for this buffer."
msgstr "该 buffer 未启用 documentColor。"

#: lua/vim/lsp/document_color.lua
msgid "No color information under cursor."
msgstr "光标下没有颜色信息。"

#: lua/vim/lsp/linked_editing_range.lua
msgid "[LSP] Server does not support linked editing ranges"
msgstr "[LSP] 服务器不支持关联编辑范围"

#: lua/vim/lsp/protocol.lua
msgid "Invalid server TextDocumentSyncKind for textDocumentSync"
msgstr "textDocumentSync 的 TextDocumentSyncKind 无效"
