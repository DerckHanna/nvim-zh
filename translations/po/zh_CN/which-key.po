# registers 插件在 OSC 52 剪贴板下的固定说明（registers.lua:50）。
# Register 内容本身是用户数据，不翻译。
#: lua/which-key/plugins/registers.lua:50
msgctxt "register_notice"
msgid "OSC 52 detected, register not checked to maintain compatibility"
msgstr "检测到 OSC 52，为保持兼容未检查该 Register"

# 健康报告固定文本（health.lua）。动态部分（provider 名、模式、按键、
# spec 内容）以 %s 模板保留；|DON'T| 等帮助链接与代码片段原样保留。
#: lua/which-key/health.lua:24
msgctxt "health"
msgid ""
"Most of these checks are for informational purposes only.\n"
"WARNINGS should be treated as a warning, and don't necessarily indicate a problem with your config.\n"
"Please |DON'T| report these warnings as an issue."
msgstr ""
"这些检查大多仅供参考。\n"
"WARNINGS 应视为警告，不一定表示你的配置有问题。\n"
"请|DON'T|将这些警告作为 issue 上报。"

